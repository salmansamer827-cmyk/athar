: 1790258844:0;cd ~/EXCORA\
\
cat << 'EOF' > public/api.js\
const EXCORA_API =\
    window.EXCORA_API_URL ||\
    "http://127.0.0.1:8000"\;\
\
async function apiRequest(path, options = {}) {\
    const response = await fetch(EXCORA_API + path, {\
        method: options.method || "GET",\
        headers: {\
            "Content-Type": "application/json",\
            ...(options.headers || {})\
        },\
        body: options.body\
    });\
\
    const text = await response.text();\
\
    let data;\
\
    try {\
        data = text ? JSON.parse(text) : {};\
    } catch {\
        data = { raw: text };\
    }\
\
    if (!response.ok) {\
        throw new Error(\
            data.detail ||\
            data.message ||\
            `API Error ${response.status}`\
        );\
    }\
\
    return data;\
}\
\
/* =========================\
   HEALTH\
========================= */\
\
async function getHealth() {\
    return await apiRequest("/health");\
}\
\
/* =========================\
   MARKETS\
========================= */\
\
async function getMarkets() {\
    return await apiRequest("/markets");\
}\
\
/* =========================\
   WALLET\
========================= */\
\
async function getWallet(userId, asset) {\
    return await apiRequest(\
        `/wallet/${encodeURIComponent(userId)}/${encodeURIComponent(asset)}`\
    );\
}\
\
/* =========================\
   ORDERS\
========================= */\
\
async function createOrder(order) {\
    return await apiRequest("/order", {\
        method: "POST",\
        body: JSON.stringify(order)\
    });\
}\
\
/* =========================\
   BACKEND STATUS\
========================= */\
\
async function checkBackend() {\
    try {\
        const data = await getHealth();\
\
        console.log("EXCORA API ONLINE:", data);\
\
        return {\
            online: true,\
            data\
        };\
\
    } catch (error) {\
\
        console.error("EXCORA API OFFLINE:", error);\
\
        return {\
            online: false,\
            error: error.message\
        };\
    }\
}\
\
window.EXCORA = {\
    API: EXCORA_API,\
    request: apiRequest,\
    health: getHealth,\
    markets: getMarkets,\
    wallet: getWallet,\
    createOrder,\
    checkBackend\
};\
EOF
