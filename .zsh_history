: 1790259474:0;cat << 'EOF' > public/trading.js\
(function () {\
    "use strict";\
\
    let currentUserId = localStorage.getItem("excora_user_id") || "demo-user";\
\
    window.EXCORA_USER_ID = currentUserId;\
\
    async function placeOrder({\
        symbol,\
        side,\
        orderType,\
        price,\
        quantity\
    }) {\
        const order = {\
            user_id: currentUserId,\
            symbol: symbol,\
            side: side,\
            order_type: orderType,\
            price: String(price),\
            quantity: String(quantity)\
        };\
\
        console.log("EXCORA ORDER REQUEST:", order);\
\
        return await EXCORA.request("/orders", {\
            method: "POST",\
            body: order\
        });\
    }\
\
    async function getOrders() {\
        return await EXCORA.request(\
            `/orders/${encodeURIComponent(currentUserId)}`\
        );\
    }\
\
    async function cancelOrder(orderId) {\
        return await EXCORA.request(\
            `/orders/${encodeURIComponent(orderId)}`,\
            {\
                method: "DELETE"\
            }\
        );\
    }\
\
    async function getOrderBook(symbol) {\
        return await EXCORA.request(\
            `/orderbook/${encodeURIComponent(symbol)}`\
        );\
    }\
\
    async function getWallet(asset) {\
        return await EXCORA.wallet(currentUserId, asset);\
    }\
\
    async function getLedger() {\
        return await EXCORA.request(\
            `/ledger/${encodeURIComponent(currentUserId)}`\
        );\
    }\
\
    async function deposit(asset, amount) {\
        return await EXCORA.request("/wallet/deposit", {\
            method: "POST",\
            body: {\
                user_id: currentUserId,\
                asset: asset,\
                amount: String(amount)\
            }\
        });\
    }\
\
    window.EXCORA_TRADING = {\
        userId: currentUserId,\
        placeOrder,\
        getOrders,\
        cancelOrder,\
        getOrderBook,\
        getWallet,\
        getLedger,\
        deposit\
    };\
\
    console.log(\
        "EXCORA Trading API ready. User:",\
        currentUserId\
    );\
})();\
EOF
