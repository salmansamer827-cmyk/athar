cat > backend/exchange/orderbook.py <<'EOF'\
from __future__ import annotations\
\
from typing import List\
\
\
class OrderBook:\
\
    def __init__(self, symbol: str):\
        self.symbol = symbol.upper()\
        self.bids = []\
        self.asks = []\
\
    def add(self, order):\
\
        if order.side == "BUY":\
            self.bids.append(order)\
\
            # Highest BUY price first.\
            # For equal prices, older order first.\
            self.bids.sort(\
                key=lambda x: (\
                    -x.price,\
                    x.created_at,\
                )\
            )\
\
        elif order.side == "SELL":\
            self.asks.append(order)\
\
            # Lowest SELL price first.\
            # For equal prices, older order first.\
            self.asks.sort(\
                key=lambda x: (\
                    x.price,\
                    x.created_at,\
                )\
            )\
\
        else:\
            raise ValueError(\
                f"Invalid order side: {order.side}"\
            )\
\
    def remove(self, order):\
\
        if order.side == "BUY":\
\
            if order in self.bids:\
                self.bids.remove(order)\
                return True\
\
        elif order.side == "SELL":\
\
            if order in self.asks:\
                self.asks.remove(order)\
                return True\
\
        return False\
\
    def find_order(self, order_id):\
\
        for order in self.bids:\
            if order.order_id == order_id:\
                return order\
\
        for order in self.asks:\
            if order.order_id == order_id:\
                return order\
\
        return None\
\
    def best_bid(self):\
\
        if not self.bids:\
            return None\
\
        return self.bids[0]\
\
    def best_ask(self):\
\
        if not self.asks:\
            return None\
\
        return self.asks[0]\
\
    def best_opposite(self, incoming_order):\
\
        if incoming_order.side == "BUY":\
            return self.best_ask()\
\
        if incoming_order.side == "SELL":\
            return self.best_bid()\
\
        raise ValueError(\
            f"Invalid order side: {incoming_order.side}"\
        )\
\
    def snapshot(self, depth: int = 20):\
\
        depth = max(1, int(depth))\
\
        bids = [\
            {\
                "price": str(order.price),\
                "quantity": str(\
                    order.remaining_quantity\
                ),\
                "order_id": order.order_id,\
            }\
            for order in self.bids[:depth]\
            if order.remaining_quantity > 0\
        ]\
\
        asks = [\
            {\
                "price": str(order.price),\
                "quantity": str(\
                    order.remaining_quantity\
                ),\
                "order_id": order.order_id,\
            }\
            for order in self.asks[:depth]\
            if order.remaining_quantity > 0\
        ]\
\
        return {\
            "symbol": self.symbol,\
            "bids": bids,\
            "asks": asks,\
        }\
EOF
