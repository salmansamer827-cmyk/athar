\
.main-viewport {\
    flex: 1;\
    padding: 10px;\
    display: flex;\
    flex-direction: column;\
    gap: 10px;\
    padding-bottom: 70px;\
}\
\
.panel-box {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 8px;\
    padding: 10px 12px;\
}\
\
.p-title {\
    font-size: 13px;\
    font-weight: 700;\
    color: #f0b90b;\
    margin-bottom: 2px;\
}\
\
.p-sub {\
    font-size: 10px;\
    color: #848e9c;\
}\
\
.chart-wrapper {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 8px;\
    overflow: hidden;\
}\
\
.chart-top-bar {\
    background: #12141c;\
    border-bottom: 1px solid #1f2329;\
    padding: 6px 12px;\
    display: flex;\
    align-items: center;\
    gap: 8px;\
}\
\
.pair-name {\
    font-size: 12px;\
    font-weight: 700;\
    color: #fff;\
    margin-left: auto;\
}\
\
.tf-badge {\
    font-size: 10px;\
    color: #848e9c;\
    background: #1f2329;\
    padding: 2px 6px;\
    border-radius: 4px;\
}\
\
.tf-badge.active {\
    background: #0052ff;\
    color: #fff;\
}\
\
.chart-content {\
    padding: 10px;\
    background: #0b0e11;\
}\
\
.asset-info {\
    margin-bottom: 8px;\
}\
\
.asset-info strong {\
    display: block;\
    font-size: 12px;\
    color: #fff;\
    margin-bottom: 2px;\
}\
\
.asset-info span {\
    font-size: 10px;\
}\
\
.candles-flex {\
    height: 120px;\
    display: flex;\
    align-items: flex-end;\
    justify-content: space-around;\
    padding-top: 10px;\
}\
\
.cand {\
    width: 12px;\
    border-radius: 2px;\
}\
\
.green-c {\
    background: #0ecb81;\
}\
\
.red-c {\
    background: #f6465d;\
}\
\
.action-buttons-grid {\
    display: grid;\
    grid-template-columns: 1fr 1fr;\
    gap: 10px;\
}\
\
.btn-buy {\
    background: #0ecb81;\
    color: #0b0e11;\
    border: none;\
    padding: 12px;\
    border-radius: 6px;\
    font-size: 13px;\
    font-weight: 700;\
    cursor: pointer;\
    text-align: center;\
}\
\
.btn-sell {\
    background: #f6465d;\
    color: #fff;\
    border: none;\
    padding: 12px;\
    border-radius: 6px;\
    font-size: 13px;\
    font-weight: 700;\
    cursor: pointer;\
    text-align: center;\
}\
\
.info-row {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 6px;\
    padding: 12px 14px;\
    display: flex;\
    justify-content: space-between;\
    font-size: 12px;\
}\
\
.bottom-navigation {\
    position: fixed;\
    bottom: 0;\
    left: 0;\
    right: 0;\
    height: 56px;\
    background: #181a20;\
    border-top: 1px solid #1f2329;\
    display: flex;\
    max-width: 480px;\
    margin: 0 auto;\
    z-index: 1000;\
}\
\
.nav-tab {\
    flex: 1;\
    background: transparent;\
    border: none;\
    color: #848e9c;\
    display: flex;\
    flex-direction: column;\
    align-items: center;\
    justify-content: center;\
    gap: 2px;\
    cursor: pointer;\
}\
\
.nav-tab i {\
    font-size: 16px;\
}\
\
.nav-tab span {\
    font-size: 9px;\
}\
\
.nav-tab.active, .nav-tab.active i, .nav-tab.active span {\
    color: #f0b90b;\
}\
EOF\
\
