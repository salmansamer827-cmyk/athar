cat << 'EOF' > public/index.html\
<!DOCTYPE html>\
<html lang="ar" dir="rtl">\
<head>\
<meta charset="UTF-8">\
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">\
\
<title>EXCORA Exchange</title>\
\
<style>\
:root{\
    --bg:#0b0e11;\
    --panel:#161a1e;\
    --panel2:#1e2329;\
    --border:#2b3139;\
    --text:#eaecef;\
    --muted:#848e9c;\
    --blue:#1677ff;\
    --green:#0ecb81;\
    --red:#f6465d;\
    --yellow:#f0b90b;\
}\
\
*{\
    box-sizing:border-box;\
    -webkit-tap-highlight-color:transparent;\
}\
\
html,body{\
    margin:0;\
    padding:0;\
    background:var(--bg);\
    color:var(--text);\
    font-family:Arial,"Segoe UI",sans-serif;\
}\
\
body{\
    padding-bottom:75px;\
}\
\
button,input,select{\
    font:inherit;\
}\
\
button{\
    cursor:pointer;\
}\
\
header{\
    height:58px;\
    display:flex;\
    align-items:center;\
    justify-content:space-between;\
    padding:0 14px;\
    background:var(--panel);\
    border-bottom:1px solid var(--border);\
    position:sticky;\
    top:0;\
    z-index:1000;\
}\
\
.brand{\
    display:flex;\
    align-items:center;\
    gap:10px;\
}\
\
.logo{\
    height:30px;\
    max-width:130px;\
    object-fit:contain;\
}\
\
.header-right{\
    display:flex;\
    align-items:center;\
    gap:12px;\
}\
\
.status{\
    font-size:11px;\
    color:var(--green);\
}\
\
.menu-btn{\
    background:none;\
    border:0;\
    color:var(--text);\
    font-size:22px;\
}\
\
.ticker{\
    height:36px;\
    display:flex;\
    gap:25px;\
    align-items:center;\
    overflow-x:auto;\
    white-space:nowrap;\
    padding:0 14px;\
    background:#111418;\
    border-bottom:1px solid var(--border);\
    font-size:11px;\
}\
\
.ticker::-webkit-scrollbar{\
    display:none;\
}\
\
.ticker span{\
    color:var(--muted);\
}\
\
.ticker b{\
    color:var(--text);\
    margin-right:4px;\
}\
\
.container{\
    width:100%;\
    max-width:1100px;\
    margin:auto;\
    padding:12px;\
}\
\
.page{\
    display:none;\
}\
\
.page.active{\
    display:block;\
}\
\
.market-header{\
    background:var(--panel);\
    border:1px solid var(--border);\
    border-radius:8px;\
    padding:12px;\
    margin-bottom:10px;\
}\
\
.symbol-row{\
    display:flex;\
    align-items:center;\
    justify-content:space-between;\
    gap:10px;\
}\
\
.symbol{\
    font-size:21px;\
    font-weight:bold;\
}\
\
.price{\
    font-size:21px;\
    font-weight:bold;\
}\
\
.green{\
    color:var(--green)!important;\
}\
\
.red{\
    color:var(--red)!important;\
}\
\
.muted{\
    color:var(--muted);\
}\
\
.market-select{\
    margin-top:10px;\
    width:100%;\
    background:#0b0e11;\
    color:var(--text);\
    border:1px solid var(--border);\
    border-radius:6px;\
    padding:10px;\
}\
\
.chart{\
    height:360px;\
    background:#0b0e11;\
    border:1px solid var(--border);\
    border-radius:8px;\
    overflow:hidden;\
}\
\
.trade-layout{\
    display:grid;\
    grid-template-columns:1fr 1fr;\
    gap:10px;\
    margin-top:10px;\
}\
\
.panel{\
    background:var(--panel);\
    border:1px solid var(--border);\
    border-radius:8px;\
    padding:12px;\
}\
\
.panel-title{\
    font-size:13px;\
    font-weight:bold;\
    margin-bottom:10px;\
}\
\
.orderbook{\
    min-height:260px;\
}\
\
.orderbook-head,\
.order-row{\
    display:grid;\
    grid-template-columns:1fr 1fr;\
    gap:10px;\
    font-size:11px;\
    padding:5px 0;\
}\
\
.orderbook-head{\
    color:var(--muted);\
    border-bottom:1px solid var(--border);\
}\
\
.order-row{\
    color:var(--text);\
}\
\
.ask{\
    color:var(--red);\
}\
\
.bid{\
    color:var(--green);\
}\
\
.spread{\
    text-align:center;\
    padding:7px 0;\
    color:var(--muted);\
    font-size:10px;\
    border-top:1px solid var(--border);\
    border-bottom:1px solid var(--border);\
}\
\
.form-group{\
    margin-bottom:9px;\
}\
\
.form-group label{\
    display:block;\
    color:var(--muted);\
    font-size:10px;\
    margin-bottom:5px;\
}\
\
.form-group input,\
.form-group select{\
    width:100%;\
    background:#0b0e11;\
    color:var(--text);\
    border:1px solid var(--border);\
    border-radius:6px;\
    padding:10px;\
    outline:none;\
}\
\
.form-group input:focus,\
.form-group select:focus{\
    border-color:var(--blue);\
}\
\
.side-buttons{\
    display:grid;\
    grid-template-columns:1fr 1fr;\
    gap:8px;\
    margin-bottom:10px;\
}\
\
.side-btn{\
    padding:11px;\
    border:0;\
    border-radius:6px;\
    font-weight:bold;\
}\
\
.buy-btn{\
    background:var(--green);\
    color:#000;\
}\
\
.sell-btn{\
    background:var(--red);\
    color:#fff;\
}\
\
.submit{\
    width:100%;\
    padding:12px;\
    border:0;\
    border-radius:6px;\
    font-weight:bold;\
    background:var(--blue);\
    color:white;\
}\
\
.submit:disabled{\
    opacity:.5;\
}\
\
.balance-line{\
    display:flex;\
    justify-content:space-between;\
    font-size:11px;\
    margin:7px 0;\
}\
\
.card-grid{\
    display:grid;\
    grid-template-columns:repeat(2,1fr);\
    gap:10px;\
}\
\
.asset-card{\
    background:var(--panel);\
    border:1px solid var(--border);\
    border-radius:8px;\
    padding:14px;\
}\
\
.asset-name{\
    font-weight:bold;\
    margin-bottom:7px;\
}\
\
.asset-value{\
    font-size:18px;\
}\
\
.market-list{\
    background:var(--panel);\
    border:1px solid var(--border);\
    border-radius:8px;\
    overflow:hidden;\
}\
\
.market-row{\
    display:grid;\
    grid-template-columns:1.4fr 1fr 1fr 70px;\
    align-items:center;\
    gap:8px;\
    padding:13px 10px;\
    border-bottom:1px solid var(--border);\
    cursor:pointer;\
}\
\
.market-row:last-child{\
    border-bottom:0;\
}\
\
.market-row:hover{\
    background:var(--panel2);\
}\
\
.market-name{\
    font-weight:bold;\
}\
\
.market-price{\
    text-align:left;\
}\
\
.market-change{\
    text-align:left;\
}\
\
.open-orders{\
    overflow-x:auto;\
}\
\
table{\
    width:100%;\
    border-collapse:collapse;\
    font-size:10px;\
}\
\
th,td{\
    padding:9px 6px;\
    border-bottom:1px solid var(--border);\
    text-align:right;\
    white-space:nowrap;\
}\
\
th{\
    color:var(--muted);\
}\
\
.cancel{\
    border:1px solid var(--red);\
    color:var(--red);\
    background:transparent;\
    border-radius:4px;\
    padding:4px 8px;\
}\
\
.notice{\
    background:#111827;\
    border:1px solid #24324a;\
    border-radius:7px;\
    padding:10px;\
    color:var(--muted);\
    font-size:11px;\
    line-height:1.7;\
    margin-bottom:10px;\
}\
\
.toast{\
    position:fixed;\
    left:12px;\
    right:12px;\
    bottom:85px;\
    background:#20252b;\
    border:1px solid var(--border);\
    border-radius:7px;\
    padding:12px;\
    text-align:center;\
    font-size:12px;\
    z-index:5000;\
    display:none;\
}\
\
.bottom-nav{\
    position:fixed;\
    bottom:0;\
    left:0;\
    right:0;\
    height:70px;\
    background:#161a1e;\
    border-top:1px solid var(--border);\
    display:grid;\
    grid-template-columns:repeat(5,1fr);\
    z-index:3000;\
}\
\
.nav-item{\
    border:0;\
    background:none;\
    color:var(--muted);\
    display:flex;\
    flex-direction:column;\
    align-items:center;\
    justify-content:center;\
    gap:4px;\
    font-size:10px;\
}\
\
.nav-item .icon{\
    font-size:19px;\
}\
\
.nav-item.active{\
    color:var(--blue);\
}\
\
@media(max-width:700px){\
\
    .trade-layout{\
        grid-template-columns:1fr;\
    }\
\
    .chart{\
        height:300px;\
    }\
\
    .card-grid{\
        grid-template-columns:1fr 1fr;\
    }\
}\
\
@media(min-width:900px){\
\
    .trade-layout{\
        grid-template-columns:1fr 1fr;\
    }\
\
    .chart{\
        height:450px;\
    }\
}\
</style>\
</head>\
\
<body>\
\
<header>\
\
    <div class="brand">\
        <img src="logo.png" class="logo" alt="EXCORA">\
    </div>\
\
    <div class="header-right">\
