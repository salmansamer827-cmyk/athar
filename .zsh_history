: 1789908762:0;cat << 'EOF' > excora_api_server.py\
import os\
import ccxt\
import pandas as pd\
import numpy as np\
import requests\
from fastapi import FastAPI, HTTPException\
from fastapi.middleware.cors import CORSMiddleware\
from pydantic import BaseModel\
from dotenv import load_dotenv\
\
load_dotenv()\
\
TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")\
TELEGRAM_CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")\
\
app = FastAPI(\
    title="EXCORA Platform Intelligence API",\
    description="ك�حرك� اك�تحك�ك�ك� اك�رك�اضك� ك�اك�تك�بك�ك�ات اك�فك�رك�ة ك�ك�ك�صة EXCORA",\
    version="2.3.0"\
)\
\
app.add_middleware(\
    CORSMiddleware,\
    allow_origins=["*"],\
    allow_credentials=True,\
    allow_methods=["*"],\
    allow_headers=["*"],\
)\
\
SYMBOLS = [\
    'BTC/USDT', 'ETH/USDT', 'XRP/USDT', 'XAU/USDT',\
    'LINK/USDT', 'BNB/USDT', 'ADA/USDT', 'SOL/USDT',\
    'TAO/USDT', 'PENDLE/USDT', 'HBAR/USDT', 'ONDO/USDT'\
]\
\
binance_exchange = ccxt.binance({\
    'enableRateLimit': True,\
    'options': {'defaultType': 'future', 'adjustForTimeDifference': True}\
})\
\
class RiskCalculationRequest(BaseModel):\
    capital: float\
    risk_percentage: float\
    entry_price: float\
    stop_loss: float\
    reward_ratio: float = 2.0\
\
class TelegramAlertRequest(BaseModel):\
    symbol: str\
    signal: str\
    price: float\
\
def send_telegram_notification(message: str):\
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:\
        return False\
    try:\
        url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"\
        payload = {\
            "chat_id": TELEGRAM_CHAT_ID,\
            "text": message,\
            "parse_mode": "Markdown"\
        }\
        response = requests.post(url, json=payload, timeout=5)\
        return response.status_code == 200\
    except Exception as e:\
        print(f"[-] خطأ فك� إرساك� تك�بك�ك� تك�ك�ك�جراك�: {e}")\
        return False\
\
def fetch_market_data(symbol, timeframe, limit=250):\
    try:\
        ohlcv = binance_exchange.fetch_ohlcv(symbol, timeframe, limit=limit)\
        df = pd.DataFrame(ohlcv, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])\
        df['timestamp'] = pd.to_datetime(df['timestamp'], unit='ms')\
        return df\
    except Exception as e:\
        print(f"[-] خطأ فك� جك�ب بك�اك�ات {symbol}: {e}")\
        return None\
\
def calculate_mathematical_indicators(df):\
    df['EMA50'] = df['close'].ewm(span=50, adjust=False).mean()\
    df['EMA200'] = df['close'].ewm(span=200, adjust=False).mean()\
    delta = df['close'].diff()\
    gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()\
    loss = (-delta.where(delta < 0, 0)).abs().rolling(window=14).mean()\
    rs = gain / loss\
    df['RSI'] = 100 - (100 / (1 + rs))\
    \
    high_low = df['high'] - df['low']\
    high_close = (df['high'] - df['high'].shift()).abs()\
    low_close = (df['low'] - df['low'].shift()).abs()\
    ranges = pd.concat([high_low, high_close, low_close], axis=1)\
    df['ATR'] = ranges.max(axis=1).rolling(window=14).mean()\
    df['Volume_EMA20'] = df['volume'].ewm(span=20, adjust=False).mean()\
    return df\
\
def calculate_true_volume_profile(df, bins=100):\
    try:\
        if df is None or len(df) == 0:\
            return 0.0, 0.0, 0.0\
        price_min, price_max = df['low'].min(), df['high'].max()\
        if price_min == price_max:\
            return price_min, price_max, price_min\
        \
        bin_edges = np.linspace(price_min, price_max, bins + 1)\
        bin_volumes = np.zeros(bins)\
        \
        for _, row in df.iterrows():\
            h, l, v = row['high'], row['low'], row['volume']\
            if h == l or v <= 0:\
                continue\
            for i in range(bins):\
                overlap_low = max(l, bin_edges[i])\
                overlap_high = min(h, bin_edges[i+1])\
                if overlap_high > overlap_low:\
                    bin_volumes[i] += v * ((overlap_high - overlap_low) / (h - l))\
                    \
        bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2\
        poc = float(bin_centers[np.argmax(bin_volumes)])\
        return poc, float(price_max), float(price_min)\
    except Exception:\
        return 0.0, 0.0, 0.0\
\
@app.get("/")\
def read_root():\
    return {"status": "online", "platform": "EXCORA Intelligence Core", "version": "2.3"}\
\
@app.get("/api/market-analysis")\
def get_market_analysis():\
    results = []\
    for symbol in SYMBOLS:\
        df_1d = fetch_market_data(symbol, '1d', limit=200)\
        df_4h = fetch_market_data(symbol, '4h', limit=200)\
        df_1h = fetch_market_data(symbol, '1h', limit=100)\
        \
        if df_1d is None or df_4h is None or df_1h is None:\
            continue\
            \
        df_1d = calculate_mathematical_indicators(df_1d)\
        df_4h = calculate_mathematical_indicators(df_4h)\
        df_1h = calculate_mathematical_indicators(df_1h)\
        \
        c_1d = df_1d.iloc[-1]\
        c_4h = df_4h.iloc[-1]\
        c_1h = df_1h.iloc[-1]\
        \
        trend_1d = "BULLISH" if c_1d['close'] > c_1d['EMA200'] and c_1d['EMA50'] > c_1d['EMA200'] else "BEARISH"\
        trend_4h = "BULLISH" if c_4h['close'] > c_4h['EMA200'] else "BEARISH"\
        \
        poc, vah, val = calculate_true_volume_profile(df_4h)\
        volume_confirmed = bool(c_1h['volume'] > c_1h['Volume_EMA20'])\
        \
        signal_state = "NEUTRAL"\
        if trend_1d == "BULLISH" and trend_4h == "BULLISH":\
            signal_state = "LONG_OPPORTUNITY" if volume_confirmed else "ACCUMULATION"\
        elif trend_1d == "BEARISH" and trend_4h == "BEARISH":\
            signal_state = "SHORT_OPPORTUNITY" if volume_confirmed else "DISTRIBUTION"\
            \
        results.append({\
            "symbol": symbol,\
            "current_price": float(c_1h['close']),\
            "trend_1d": trend_1d,\
            "trend_4h": trend_4h,\
            "rsi_1h": round(float(c_1h['RSI']), 2),\
            "volume_poc": poc,\
            "volume_confirmed": volume_confirmed,\
            "signal": signal_state\
        })\
    return {"timestamp": pd.Timestamp.now().isoformat(), "data": results}\
\
@app.post("/api/send-alert")\
def trigger_alert(alert: TelegramAlertRequest):\
    """إرساك� تك�بك�ك� فك�رك� عبر بك�ت تك�ك�ك�جراك�"""\
    msg = f"������ *EXCORA Alert System*\n\n������ *Asset:* `{alert.symbol}`\n������� *Signal:* `{alert.signal}`\n������ *Price:* `${alert.price}`"\
    success = send_telegram_notification(msg)\
    if not success:\
        raise HTTPException(status_code=500, detail="Failed to send telegram notification.")\
    return {"status": "success", "message": "Alert sent successfully."}\
\
@app.post("/api/calculate-risk")\
def calculate_risk_management(data: RiskCalculationRequest):\
    try:\
        risk_amount = data.capital * (data.risk_percentage / 100.0)\
        price_difference = abs(data.entry_price - data.stop_loss)\
        \
        if price_difference == 0:\
            raise HTTPException(status_code=400, detail="Entry and stop loss cannot be identical.")\
            \
        position_size = risk_amount / price_difference\
        total_position_value = position_size * data.entry_price\
        is_long = data.entry_price > data.stop_loss\
        take_profit = data.entry_price + (price_difference * data.reward_ratio) if is_long else data.entry_price - (price_difference * data.reward_ratio)\
        \
        return {\
            "status": "success",\
            "risk_amount_usdt": round(risk_amount, 2),\
            "position_size": round(position_size, 4),\
            "total_position_value_usdt": round(total_position_value, 2),\
            "stop_loss": data.stop_loss,\
            "take_profit": round(take_profit, 4),\
            "risk_reward_ratio": f"1:{data.reward_ratio}"\
        }\
    except Exception as e:\
        raise HTTPException(status_code=400, detail=str(e))\
\
if __name__ == "__main__":\
    import uvicorn\
    uvicorn.run(app, host="0.0.0.0", port=8000)\
EOF\

