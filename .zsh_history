<!DOCTYPE html>\
<html lang="ar" dir="rtl">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>EXCORA - ك�ك�صة اك�تداك�ك� اك�ذك�ك�</title>\
    <link rel="stylesheet" href="style.css">\
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">\
</head>\
<body>\
    <div class="app-container">\
        <header class="top-header">\
            <div class="logo-area">\
                <span class="logo-text">EXCORA</span>\
            </div>\
            <div class="ticker-box">\
                <span>BTC/USDT: <strong id="btcTicker">81,610.00</strong></span>\
            </div>\
        </header>\
\
        <main class="main-content">\
            <div id="home-tab" class="tab-content active">\
                <div class="card balance-card">\
                    <h3>إجك�اك�ك� اك�أصك�ك� اك�ك�قدرة</h3>\
                    <div id="balanceDisplay" class="balance-amount">-- <span style="font-size: 13px; color: var(--text-secondary);">USDT</span></div>\
                </div>\
                <div class="card">\
                    <h3>ك�ظرة عاك�ة عك�ك� اك�سك�ق</h3>\
                    <p style="color: var(--text-secondary); font-size: 13px; margin-top: 5px;">اك�ك�ظاك� ك�عك�ك� بتك�اسق تاك� ك�ع بك�اك�ات بك�ك�اك�س اك�حك�ة.</p>\
                </div>\
            </div>\
\
            <div id="trade-tab" class="tab-content">\
                <div class="card">\
                    <h3>اك�تك�فك�ذ اك�سرك�ع (Futures)</h3>\
                    <div class="trade-buttons" style="display: flex; gap: 12px; margin-top: 15px;">\
                        <button onclick="triggerAction('LONG')" style="flex: 1; background: var(--accent-green); color: #fff; padding: 14px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px;">شرا؃� (LONG)</button>\
                        <button onclick="triggerAction('SHORT')" style="flex: 1; background: var(--accent-red); color: #fff; padding: 14px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px;">بك�ع (SHORT)</button>\
                    </div>\
                </div>\
            </div>\
\
            <div id="positions-tab" class="tab-content">\
                <div class="card" style="border: none; background: transparent; padding: 0 0 10px 0;">\
                    <h3 style="font-size: 16px; color: var(--text-primary); font-weight: bold;">اك�ك�راك�ز اك�ك�شطة</h3>\
                </div>\
                <div id="positionsContainer">\
                    <div class="card" style="text-align: center; color: var(--text-secondary);">جارك� جك�ب اك�عقك�د اك�ك�فتك�حة...</div>\
                </div>\
            </div>\
\
            <div id="wallet-tab" class="tab-content">\
                <div class="card">\
                    <h3>تفاصك�ك� اك�ك�حفظة ك�اك�سك�ك�ك�ة اك�ك�تاحة</h3>\
                    <div style="margin-top: 10px; font-size: 15px; font-weight: bold;" id="walletDetails">-- USDT</div>\
                </div>\
            </div>\
        </main>\
\
        <nav class="bottom-nav">\
            <div class="nav-item active" onclick="switchTab('home', this)">\
                <i class="fas fa-home"></i>\
                <span>اك�رئك�سك�ة</span>\
            </div>\
            <div class="nav-item" onclick="switchTab('trade', this)">\
                <i class="fas fa-chart-line"></i>\
                <span>اك�تداك�ك�</span>\
            </div>\
            <div class="nav-item" onclick="switchTab('positions', this); fetchActivePositions();">\
                <i class="fas fa-file-contract"></i>\
                <span>اك�عقك�د</span>\
            </div>\
            <div class="nav-item" onclick="switchTab('wallet', this)">\
                <i class="fas fa-wallet"></i>\
                <span>اك�ك�حفظة</span>\
            </div>\
        </nav>\
    </div>\
\
    <script>\
        function switchTab(tabId, element) {\
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));\
            document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));\
            document.getElementById(tabId + '-tab').classList.add('active');\
            element.classList.add('active');\
            window.scrollTo(0, 0);\
            if (tabId === 'positions') fetchActivePositions();\
        }\
\
        async function fetchRealBalance() {\
            try {\
                const res = await fetch('/api/balance');\
                const data = await res.json();\
                if (data.success) {\
                    const formatted = Number(data.total).toLocaleString();\
                    document.getElementById('balanceDisplay').innerHTML = `${formatted} <span style="font-size: 13px; color: var(--text-secondary);">USDT</span>`;\
                    document.getElementById('walletDetails').innerHTML = `${formatted} USDT`;\
                }\
            } catch (e) { console.error(e); }\
        }\
\
        async function fetchActivePositions() {\
            const container = document.getElementById('positionsContainer');\
            try {\
                const res = await fetch('/api/positions');\
                const data = await res.json();\
                if (data.success && data.positions.length > 0) {\
                    let html = '';\
                    data.positions.forEach(pos => {\
                        const pnl = parseFloat(pos.unRealizedProfit || 0);\
                        const pnlColor = pnl >= 0 ? 'var(--accent-green)' : 'var(--accent-red)';\
                        const sideText = parseFloat(pos.positionAmt) > 0 ? 'LONG' : 'SHORT';\
                        html += `<div class="card">\
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">\
                                <span style="font-weight: bold; color: var(--text-primary);">${pos.symbol}</span>\
                                <span style="color: ${pnlColor}; font-weight: bold;">${sideText}</span>\
                            </div>\
                            <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-secondary);">\
                                <span>اك�ربح/اك�خسارة:</span>\
                                <span style="color: ${pnlColor}; font-weight: bold;">${pnl.toFixed(2)} USDT</span>\
                            </div>\
                        </div>`;\
                    });\
                    container.innerHTML = html;\
                } else {\
                    container.innerHTML = `<div class="card" style="text-align: center; color: var(--text-secondary);">ك�ا تك�جد عقك�د ك�فتك�حة حاك�ك�اك�.</div>`;\
                }\
            } catch (e) { container.innerHTML = `<div class="card" style="text-align: center; color: var(--accent-red);">فشك� اك�اتصاك� بجك�ب اك�ك�راك�ز.</div>`; }\
        }\
\
        fetchRealBalance();\
        setInterval(fetchRealBalance, 10000);\
    </script>\
</body>\
</html>\
EOF\
\
