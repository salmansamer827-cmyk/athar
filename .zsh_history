cat << 'EOF' > public/style.css\
:root {\
  --bg-color: #0B0E14;\
  --card-bg: #121620;\
  --border-color: #1E2530;\
  --accent-neon: #00FFCC;\
  --text-main: #FFFFFF;\
  --text-muted: #8A99AD;\
  --success: #00C853;\
}\
\
body {\
  background-color: var(--bg-color);\
  color: var(--text-main);\
  font-family: 'IBM Plex Sans Arabic', sans-serif;\
  margin: 0;\
  padding: 15px;\
  direction: rtl;\
}\
\
.app-container {\
  max-width: 900px;\
  margin: 0 auto;\
}\
\
.app-header {\
  display: flex;\
  justify-content: space-between;\
  align-items: center;\
  background: var(--card-bg);\
  border: 1px solid var(--border-color);\
  padding: 20px;\
  border-radius: 16px;\
  margin-bottom: 20px;\
}\
\
.logo-area h1 {\
  margin: 0;\
  font-size: 22px;\
  color: var(--text-main);\
}\
\
.logo-area h1 span {\
  color: var(--accent-neon);\
}\
\
.logo-area p {\
  margin: 5px 0 0 0;\
  font-size: 13px;\
  color: var(--text-muted);\
}\
\
.status-badge {\
  display: flex;\
  align-items: center;\
  gap: 8px;\
  background: rgba(0, 255, 204, 0.1);\
  color: var(--accent-neon);\
  padding: 6px 12px;\
  border-radius: 20px;\
  font-size: 13px;\
  border: 1px solid rgba(0, 255, 204, 0.2);\
}\
\
.dot {\
  width: 8px;\
  height: 8px;\
  background-color: var(--accent-neon);\
  border-radius: 50%;\
  box-shadow: 0 0 8px var(--accent-neon);\
}\
\
.dashboard-grid {\
  display: grid;\
  gap: 20px;\
}\
\
.card {\
  background: var(--card-bg);\
  border: 1px solid var(--border-color);\
  border-radius: 16px;\
  padding: 20px;\
}\
\
.card h2 {\
  margin-top: 0;\
  font-size: 16px;\
  color: var(--accent-neon);\
  margin-bottom: 15px;\
}\
\
.ticker-grid {\
  display: grid;\
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\
  gap: 15px;\
}\
\
.ticker-item {\
  background: rgba(255, 255, 204, 0.02);\
  border: 1px solid var(--border-color);\
  padding: 12px;\
  border-radius: 10px;\
  display: flex;\
  justify-content: space-between;\
  align-items: center;\
}\
\
.signal-box {\
  background: rgba(0, 0, 0, 0.3);\
  border: 1px solid var(--border-color);\
  padding: 15px;\
  border-radius: 10px;\
  min-height: 120px;\
  font-family: monospace;\
  color: var(--accent-neon);\
  font-size: 13px;\
}\
\
.placeholder-text {\
  color: var(--text-muted);\
  text-align: center;\
  margin-top: 40px;\
}\
EOF\
\
