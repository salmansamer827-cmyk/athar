            { symbol: 'XAU/USDT', tv: 'OANDA:XAUUSD', name: 'Gold Spot', price: 2380.00, change: '+0.65%' }\
        ];\
\
        function renderMarkets() {\
            const container = document.getElementById('marketsListContainer');\
            if (!container) return;\
            container.innerHTML = '';\
\
            marketPairs.forEach(item => {\
                const isPos = !item.change.startsWith('-');\
                const el = document.createElement('div');\
                el.className = 'ticker-item';\
                if(item.symbol === 'EXCORA/USDT') {\
                    el.style.borderColor = 'rgba(240, 185, 11, 0.4)';\
                }\
                el.onclick = () => selectCoinAndOpenChart(item.symbol, item.tv);\
                \
                el.innerHTML = `\
                    <div class="ticker-info">\
                        <div class="symbol" ${item.symbol === 'EXCORA/USDT' ? 'style="color: var(--accent-color);"' : ''}>${item.symbol}</div>\
                        <div class="name">${item.name}</div>\
                    </div>\
                    <div class="ticker-values">\
                        <div class="price">$${item.price.toLocaleString()}</div>\
                        <div class="change ${isPos ? 'positive' : 'negative'}">${item.change}</div>\
                    </div>\
                `;\
                container.appendChild(el);\
            });\
        }\
\
        function loadChartWidget(tvSymbol, displaySymbol) {\
            const wrapper = document.getElementById('tradingViewWrapper');\
            wrapper.innerHTML = `\
                <div class="tradingview-widget-container" style="height:100%;width:100%">\
                  <div class="tradingview-widget-container__widget" style="height:100%;width:100%"></div>\
                  <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js" async>\
                  {\
                    "autosize": true,\
                    "symbol": "${tvSymbol}",\
                    "interval": "60",\
                    "timezone": "Etc/UTC",\
                    "theme": "dark",\
                    "style": "1",\
                    "locale": "ar",\
                    "enable_publishing": false,\
                    "allow_symbol_change": true,\
                    "calendar": false,\
                    "support_host": "https://www.tradingview.com"\
                  }\
                  </script>\
                </div>\
            `;\
            document.getElementById('chartTitle').innerText = '������� شارت اك�تحك�ك�ك� اك�فك�ك�: ' + displaySymbol;\
            document.getElementById('activeSymbolHeader').innerText = '⃺�� EXCORA : ' + displaySymbol;\
        }\
\
        function selectCoinAndOpenChart(symbol, tvSymbol) {\
            loadChartWidget(tvSymbol, symbol);\
            const chartBtn = document.getElementById('navChartBtn');\
            switchTab('chart', chartBtn);\
        }\
\
        function switchTab(tabId, element) {\
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));\
            document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));\
            document.getElementById(tabId + '-tab').classList.add('active');\
            if (element) element.classList.add('active');\
            window.scrollTo(0, 0);\
        }\
\
        function executeTrade(type) {\
            const btn = event.target;\
            btn.style.transform = 'scale(0.92)';\
            setTimeout(() => btn.style.transform = 'scale(1)', 150);\
            alert('⃺�� تك� تك�فك�ذ أك�ر ' + type + ' بك�جاح عبر برك�تك�ك�ك�ك�ات اك�سك�ك�ك�ة اك�ك�ؤسسك�ة EXCORA.');\
        }\
\
        document.addEventListener("DOMContentLoaded", () => {\
            renderMarkets();\
            loadChartWidget('BINANCE:BTCUSDT', 'BTC/USDT');\
        });\
\
        // ك�حاك�اة تحدك�ث اك�أسعار اك�حك�ة بشك�ك� سك�س\
        setInterval(() => {\
            const btcEl = document.getElementById('topBtcTicker');\
            if(btcEl) {\
                let randomVal = (91400 + Math.random() * 40).toFixed(2);\
                btcEl.innerText = Number(randomVal).toLocaleString();\
            }\
        }, 3500);\
    </script>\
</body>\
</html>\
EOF\
