\
# ============================================================\
# EXCORA FUTURES API\
# ============================================================\
\
from backend.core.futures_engine import FuturesEngine, PositionSide\
\
futures_engine = FuturesEngine()\
\
\
class FuturesOpenPositionRequest(BaseModel):\
    user_id: str\
    symbol: str\
    side: str\
    quantity: Decimal\
    entry_price: Decimal\
    leverage: int = 1\
\
\
class FuturesClosePositionRequest(BaseModel):\
    user_id: str\
    symbol: str\
    side: str\
    exit_price: Decimal\
\
\
@app.post("/futures/position")\
def open_futures_position(request: FuturesOpenPositionRequest):\
    try:\
        side = request.side.upper().strip()\
\
        if side not in ("LONG", "SHORT"):\
            raise HTTPException(\
                status_code=400,\
                detail="Side must be LONG or SHORT",\
            )\
\
        position = futures_engine.open_position(\
            user_id=request.user_id,\
            symbol=request.symbol,\
            side=PositionSide(side),\
            quantity=request.quantity,\
            entry_price=request.entry_price,\
            leverage=request.leverage,\
        )\
\
        return {\
            "success": True,\
            "position": {\
                "user_id": position.user_id,\
                "symbol": position.symbol,\
                "side": position.side.value,\
                "quantity": str(position.quantity),\
                "entry_price": str(position.entry_price),\
                "leverage": position.leverage,\
                "notional": str(position.notional()),\
                "margin": str(position.margin),\
            },\
        }\
\
    except HTTPException:\
        raise\
\
    except ValueError as exc:\
        raise HTTPException(\
            status_code=400,\
            detail=str(exc),\
        )\
\
    except Exception as exc:\
        raise HTTPException(\
            status_code=500,\
            detail=str(exc),\
        )\
\
\
@app.get("/futures/positions/{user_id}")\
def get_futures_positions(user_id: str):\
    positions = []\
\
    for position in futures_engine.positions.values():\
\
        if position.user_id != user_id:\
            continue\
\
        positions.append({\
            "user_id": position.user_id,\
            "symbol": position.symbol,\
            "side": position.side.value,\
            "quantity": str(position.quantity),\
            "entry_price": str(position.entry_price),\
            "leverage": position.leverage,\
            "margin": str(position.margin),\
            "notional": str(position.notional()),\
        })\
\
    return {\
        "success": True,\
        "user_id": user_id,\
        "positions": positions,\
    }\
\
\
@app.post("/futures/position/close")\
def close_futures_position(\
    request: FuturesClosePositionRequest,\
):\
    try:\
        side = request.side.upper().strip()\
\
        if side not in ("LONG", "SHORT"):\
            raise HTTPException(\
                status_code=400,\
                detail="Side must be LONG or SHORT",\
            )\
\
        result = futures_engine.close_position(\
            user_id=request.user_id,\
            symbol=request.symbol,\
            side=PositionSide(side),\
            exit_price=request.exit_price,\
        )\
\
        return {\
            "success": True,\
            "result": result,\
        }\
\
    except HTTPException:\
        raise\
\
    except ValueError as exc:\
        raise HTTPException(\
            status_code=400,\
            detail=str(exc),\
        )\
\
    except Exception as exc:\
        raise HTTPException(\
            status_code=500,\
            detail=str(exc),\
        )\
PY
