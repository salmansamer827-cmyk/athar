import 'package:flutter/material.dart';\
import '../services/api_service.dart';\
\
class TradingScreen extends StatefulWidget {\
  @override\
  _TradingScreenState createState() => _TradingScreenState();\
}\
\
class _TradingScreenState extends State<TradingScreen> {\
  final _formKey = GlobalKey<FormState>();\
  final TextEditingController _userIdController = TextEditingController(text: 'user001');\
  final TextEditingController _symbolController = TextEditingController(text: 'EXC/USDT');\
  final TextEditingController _priceController = TextEditingController(text: '1.245');\
  final TextEditingController _quantityController = TextEditingController(text: '100');\
  \
  String _side = 'BUY';\
  String _orderType = 'LIMIT';\
  bool _isLoading = false;\
\
  void _submitOrder() async {\
    if (!_formKey.currentState!.validate()) return;\
\
    setState(() => _isLoading = true);\
\
    bool success = await ApiService.createOrder(\
      userId: _userIdController.text,\
      symbol: _symbolController.text,\
      side: _side,\
      orderType: _orderType,\
      price: double.parse(_priceController.text),\
      quantity: double.parse(_quantityController.text),\
    );\
\
    setState(() => _isLoading = false);\
\
    ScaffoldMessenger.of(context).showSnackBar(\
      SnackBar(\
        content: Text(success ? 'تك� تك�فك�ذ اك�أك�ر بك�جاح!' : 'فشك� فك� تك�فك�ذ اك�أك�ر'),\
        backgroundColor: success ? Colors.green : Colors.red,\
      ),\
    );\
  }\
\
  @override\
  Widget build(BuildContext context) {\
    return Scaffold(\
      backgroundColor: Color(0xFF0B0E14),\
      appBar: AppBar(\
        backgroundColor: Color(0xFF1E2329),\
        title: Text('ك�ك�صة اك�تداك�ك� ك�اك�أك�اك�ر (EXCORA)', style: TextStyle(color: Colors.white, fontSize: 16)),\
      ),\
      body: Padding(\
        padding: const EdgeInsets.all(16.0),\
        child: Form(\
          key: _formKey,\
          child: ListView(\
            children: [\
              Row(\
                children: [\
                  Expanded(\
                    child: ElevatedButton(\
                      style: ElevatedButton.styleFrom(\
                        backgroundColor: _side == 'BUY' ? Colors.green : Color(0xFF1E2329),\
                      ),\
                      onPressed: () => setState(() => _side = 'BUY'),\
                      child: Text('شرا؃� (BUY)', style: TextStyle(color: Colors.white)),\
                    ),\
                  ),\
                  SizedBox(width: 10),\
                  Expanded(\
                    child: ElevatedButton(\
                      style: ElevatedButton.styleFrom(\
                        backgroundColor: _side == 'SELL' ? Colors.red : Color(0xFF1E2329),\
                      ),\
                      onPressed: () => setState(() => _side = 'SELL'),\
                      child: Text('بك�ع (SELL)', style: TextStyle(color: Colors.white)),\
                    ),\
                  ),\
                ],\
              ),\
              SizedBox(height: 20),\
              TextFormField(\
                controller: _symbolController,\
                style: TextStyle(color: Colors.white),\
                decoration: InputDecoration(\
                  labelText: 'زك�ج اك�تداك�ك� (Symbol)',\
                  labelStyle: TextStyle(color: Colors.grey),\
                  filled: true,\
                  fillColor: Color(0xFF1E2329),\
                ),\
              ),\
              SizedBox(height: 15),\
              TextFormField(\
                controller: _priceController,\
                keyboardType: TextInputType.numberWithOptions(decimal: true),\
                style: TextStyle(color: Colors.white),\
                decoration: InputDecoration(\
                  labelText: 'اك�سعر (Price)',\
                  labelStyle: TextStyle(color: Colors.grey),\
                  filled: true,\
                  fillColor: Color(0xFF1E2329),\
                ),\
              ),\
              SizedBox(height: 15),\
              TextFormField(\
                controller: _quantityController,\
                keyboardType: TextInputType.numberWithOptions(decimal: true),\
                style: TextStyle(color: Colors.white),\
                decoration: InputDecoration(\
                  labelText: 'اك�ك�ك�ك�ة (Quantity)',\
                  labelStyle: TextStyle(color: Colors.grey),\
                  filled: true,\
                  fillColor: Color(0xFF1E2329),\
                ),\
              ),\
              SizedBox(height: 30),\
              SizedBox(\
                height: 50,\
                child: ElevatedButton(\
                  style: ElevatedButton.styleFrom(\
                    backgroundColor: Color(0xFFFCD535), // أصفر ك�ك�ك�ك� Binance\
                  ),\
                  onPressed: _isLoading ? null : _submitOrder,\
                  child: _isLoading\
                      ? CircularProgressIndicator(color: Colors.black)\
                      : Text('تك�فك�ذ اك�أك�ر اك�؃�ك�', style: TextStyle(color: Colors.black, fontSize: 16, fontWeight: FontWeight.bold)),\
                ),\
              ),\
            ],\
          ),\
        ),\
      ),\
    );\
  }\
}\
