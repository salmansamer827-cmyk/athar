\
            <!-- 3. اك�عقك�د ك�اك�ك�راك�ز اك�ك�فتك�حة -->\
            <div id="positions-tab" class="tab-content">\
                <div class="card" style="border: none; background: transparent; padding: 0 0 10px 0;">\
                    <h3 style="font-size: 16px; color: var(--text-primary); font-weight: bold;">اك�ك�راك�ز اك�ك�شطة</h3>\
                </div>\
                <div id="positionsContainer">\
                    <div class="card" style="text-align: center; color: var(--text-secondary);">جارك� جك�ب اك�عقك�د اك�ك�فتك�حة...</div>\
                </div>\
