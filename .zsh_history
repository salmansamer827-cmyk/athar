\
        <!-- اك�ك�حتك�ك� اك�رئك�سك� ك�تبك�ك�بات اك�تطبك�ق -->\
        <main class="main-content">\
            <!-- 1. اك�رئك�سك�ة -->\
            <div id="home-tab" class="tab-content active">\
                <div class="card balance-card">\
                    <h3>إجك�اك�ك� اك�أصك�ك�</h3>\
                    <div id="balanceDisplay" class="balance-amount">-- <span style="font-size: 12px; color: var(--text-secondary);">USDT</span></div>\
                </div>\
            </div>\
\
            <!-- 2. اك�تداك�ك� اك�ك�دك�ك� -->\
            <div id="trade-tab" class="tab-content">\
                <div class="card">\
                    <h3>تك�فك�ذ سرك�ع</h3>\
                    <div class="trade-buttons" style="display: flex; gap: 10px; margin-top: 15px;">\
                        <button onclick="triggerAction('شرا؃� (LONG)')" style="flex: 1; background: #0ecb81; color: #fff; padding: 12px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">شرا؃� (LONG)</button>\
                        <button onclick="triggerAction('بك�ع (SHORT)')" style="flex: 1; background: #f6465d; color: #fff; padding: 12px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">بك�ع (SHORT)</button>\
                    </div>\
                </div>\
            </div>\
\
            <!-- 3. اك�عقك�د ك�اك�ك�راك�ز اك�ك�فتك�حة -->\
            <div id="positions-tab" class="tab-content">\
                <div class="header-section" style="padding: 15px;">\
                    <h3>اك�ك�راك�ز ك�اك�عقك�د اك�ك�فتك�حة</h3>\
                    <p style="color: var(--text-secondary); font-size: 13px;">ك�تابعة اك�صفقات اك�ك�شطة عك�ك� بك�ك�اك�س ك�حظك�اك�</p>\
                </div>\
                <div id="positionsContainer" style="padding: 0 15px;">\
                    <div style="text-align: center; color: var(--text-secondary); margin-top: 40px;">جارك� جك�ب اك�عقك�د اك�ك�فتك�حة...</div>\
                </div>\
            </div>\
\
            <!-- 4. تبك�ك�ب اك�تداك�ك� اك�؃�ك�ك� اك�جدك�د -->\
            <div id="algo-tab" class="tab-content">\
                <div class="header-section" style="padding: 15px;">\
                    <h3>ك�حرك� EXCORA اك�؃�ك�ك� (Smart Money)</h3>\
                    <p style="color: var(--text-secondary); font-size: 13px;">اك�تحك�ك� ك�اك�ك�راقبة اك�حك�ة ك�ك�خك�ارزك�ك�ات اك�رك�اضك�ة</p>\
                </div>\
                <div style="padding: 0 15px;">\
                    <div style="background: var(--bg-card); border-radius: 12px; padding: 20px; margin-bottom: 15px; border: 1px solid var(--border-color); text-align: center;">\
                        <div id="algoStatusIndicator" style="font-size: 15px; font-weight: bold; margin-bottom: 15px; color: #f6465d;">\
                            ������ اك�ك�حرك� ك�تك�قف حاك�ك�اك�\
                        </div>\
                        <div style="display: flex; gap: 10px; justify-content: center;">\
                            <button onclick="controlAlgo('start')" style="background: #0ecb81; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer;">\
                                <i class="fas fa-play"></i> تشغك�ك� اك�بك�ت\
                            </button>\
                            <button onclick="controlAlgo('stop')" style="background: #f6465d; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer;">\
                                <i class="fas fa-stop"></i> إك�قاف\
                            </button>\
                        </div>\
                    </div>\
                </div>\
            </div>\
\
            <!-- 5. اك�ك�حفظة -->\
            <div id="wallet-tab" class="tab-content">\
