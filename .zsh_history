python - <<'PY'\
from pathlib import Path\
import re\
\
p = Path("core/pipeline/quant_pipeline.py")\
text = p.read_text()\
\
pattern = r"""(?ms)^        return QuantPipelineResult\(\
.*?^        \)\s*$"""\
\
replacement = """        return QuantPipelineResult(\
            symbol=symbol,\
            market=market,\
            timeframe=timeframe,\
\
            profile=profile,\
            dynamics=dynamics,\
            state=state,\
\
            # Statistical probability\
            probability=probability,\
            raw_probability=raw_probability,\
            adjusted_probability=adjusted_probability,\
            probability_uncertainty=probability_uncertainty,\
\
            # Expected value\
            expected_value_r=expected_value_r,\
            conservative_expected_value_r=(\
                conservative_expected_value_r\
            ),\
\
            # Decision\
            signal=signal,\
            risk=risk,\
        )"""\
\
matches = list(re.finditer(pattern, text))\
\
if len(matches) != 1:\
    raise SystemExit(\
        f"Expected exactly 1 QuantPipelineResult return block, "\
        f"found {len(matches)}. No changes made."\
    )\
\
text = text[:matches[0].start()] + replacement + text[matches[0].end():]\
\
p.write_text(text)\
\
print("UPDATED:", p)\
