\
cat > core/volume_profile/signal/engine.py <<'PY'\
from __future__ import annotations\
\
from dataclasses import dataclass\
from typing import Optional\
\
\
@dataclass(frozen=True)\
class ProfileSignalConfig:\
    """\
    Quantitative signal configuration.\
\
    No EMA / RSI / MACD / SMC.\
\
    The engine uses only quantitative\
    Volume Profile and statistical inputs.\
    """\
\
    # Probability\
    min_probability: float = 0.55\
    min_adjusted_probability: float = 0.55\
\
    # Expected value\
    min_ev_r: float = 0.0\
\
    # Value location\
    value_location_long: float = 0.60\
    value_location_short: float = 0.40\
\
    # POC dynamics\
    min_poc_velocity: float = 0.0\
\
    # Value area\
    require_expansion: bool = True\
\
    # Risk / reward\
    reward_risk: float = 3.0\
\
    # Transaction cost expressed in R\
    transaction_cost_r: float = 0.05\
\
    # Statistical uncertainty\
    max_uncertainty: float = 0.12\
\
    # Minimum quantitative score\
    min_score: float = 70.0\
\
\
class VolumeProfileSignalEngine:\
    """\
    CAPITAL WISE\
    High-quality quantitative Volume Profile signal engine.\
\
    Uses:\
\
        POC\
        VAH\
        VAL\
        Value Location\
        POC Velocity\
        Value Area Dynamics\
        Historical Probability\
        Probability Uncertainty\
        Expected Value\
        Risk / Reward\
\
    Does NOT use:\
\
        EMA\
        RSI\
        MACD\
        SMC\
\
    The engine is intentionally deterministic.\
    """\
\
    def __init__(\
        self,\
        config: ProfileSignalConfig | None = None,\
    ):\
        self.config = (\
            config\
            if config is not None\
            else ProfileSignalConfig()\
        )\
\
        self._validate_config()\
\
    # ==========================================================\
    # CONFIGURATION VALIDATION\
    # ==========================================================\
\
    def _validate_config(self) -> None:\
\
        if not 0.0 <= self.config.min_probability <= 1.0:\
            raise ValueError(\
                "min_probability must be between 0 and 1"\
            )\
\
        if not 0.0 <= self.config.min_adjusted_probability <= 1.0:\
            raise ValueError(\
                "min_adjusted_probability must be between 0 and 1"\
            )\
\
        if not 0.0 <= self.config.value_location_short <= 1.0:\
            raise ValueError(\
                "value_location_short must be between 0 and 1"\
            )\
\
        if not 0.0 <= self.config.value_location_long <= 1.0:\
            raise ValueError(\
                "value_location_long must be between 0 and 1"\
            )\
\
        if (\
            self.config.value_location_short\
            >= self.config.value_location_long\
        ):\
            raise ValueError(\
                "short value location must be below long value location"\
            )\
\
        if self.config.reward_risk <= 0:\
            raise ValueError(\
                "reward_risk must be > 0"\
            )\
\
        if self.config.transaction_cost_r < 0:\
            raise ValueError(\
                "transaction_cost_r cannot be negative"\
            )\
\
        if not 0.0 <= self.config.max_uncertainty <= 1.0:\
            raise ValueError(\
                "max_uncertainty must be between 0 and 1"\
            )\
\
        if not 0.0 <= self.config.min_score <= 100.0:\
            raise ValueError(\
                "min_score must be between 0 and 100"\
            )\
\
    # ==========================================================\
    # SIGNAL SCORE\
    # ==========================================================\
\
    def _score(\
        self,\
        *,\
        probability: float,\
        adjusted_probability: float,\
        ev_r: float,\
        value_location: float,\
        poc_velocity: float,\
        value_area_state: str,\
        uncertainty: float,\
        direction: str,\
    ) -> float:\
        """\
        Deterministic 0-100 quantitative score.\
\
        Components:\
\
            Probability        25%\
            Conservative prob  20%\
            Expected Value     20%\
            Value Location     15%\
            POC Momentum       10%\
            Value Expansion     5%\
            Statistical Cert.   5%\
        """\
\
        # ------------------------------------------------------\
        # Probability score\
        # ------------------------------------------------------\
\
        probability_score = min(\
            100.0,\
            max(\
                0.0,\
                probability * 100.0,\
            ),\
        )\
\
        adjusted_score = min(\
            100.0,\
            max(\
                0.0,\
                adjusted_probability * 100.0,\
            ),\
        )\
\
        # ------------------------------------------------------\
        # EV score\
        # ------------------------------------------------------\
\
        ev_score = min(\
            100.0,\
            max(\
                0.0,\
                50.0 + ev_r * 25.0,\
            ),\
        )\
\
        # ------------------------------------------------------\
        # Value location\
        # ------------------------------------------------------\
\
        if direction == "LONG":\
            location_score = min(\
                100.0,\
                max(\
                    0.0,\
                    value_location * 100.0,\
                ),\
            )\
        else:\
            location_score = min(\
                100.0,\
                max(\
                    0.0,\
                    (1.0 - value_location) * 100.0,\
                ),\
            )\
\
        # ------------------------------------------------------\
        # POC velocity\
        # ------------------------------------------------------\
\
        velocity_strength = min(\
            1.0,\
            abs(poc_velocity),\
        )\
\
        velocity_score = velocity_strength * 100.0\
\
        # ------------------------------------------------------\
        # Value area dynamics\
        # ------------------------------------------------------\
\
        expansion_score = (\
            100.0\
            if value_area_state == "EXPANDING"\
            else 50.0\
            if value_area_state == "STABLE"\
            else 25.0\
        )\
\
        # ------------------------------------------------------\
        # Statistical certainty\
        # ------------------------------------------------------\
\
        certainty_score = (\
            max(\
                0.0,\
                1.0 - uncertainty,\
            )\
            * 100.0\
        )\
\
        score = (\
            probability_score * 0.25\
            + adjusted_score * 0.20\
            + ev_score * 0.20\
            + location_score * 0.15\
            + velocity_score * 0.10\
            + expansion_score * 0.05\
            + certainty_score * 0.05\
        )\
\
        return round(\
            min(100.0, max(0.0, score)),\
            4,\
        )\
\
    # ==========================================================\
    # EVALUATION\
    # ==========================================================\
\
    def evaluate(\
        self,\
        profile: dict,\
        dynamics: dict,\
        probability: float,\
        ev_r: float,\
        entry: float,\
        adjusted_probability: Optional[float] = None,\
        uncertainty: float = 0.0,\
        reward_risk: Optional[float] = None,\
    ) -> Optional[dict]:\
\
        # ------------------------------------------------------\
        # BASIC VALIDATION\
        # ------------------------------------------------------\
\
        if entry <= 0:\
            raise ValueError(\
                "entry must be > 0"\
            )\
\
        if not 0.0 <= probability <= 1.0:\
            raise ValueError(\
                "probability must be between 0 and 1"\
            )\
\
        if adjusted_probability is None:\
            adjusted_probability = probability\
\
        if not 0.0 <= adjusted_probability <= 1.0:\
            raise ValueError(\
                "adjusted_probability must be between 0 and 1"\
            )\
\
        if not 0.0 <= uncertainty <= 1.0:\
            raise ValueError(\
                "uncertainty must be between 0 and 1"\
            )\
\
        # ------------------------------------------------------
