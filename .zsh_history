cat << 'EOF' > public/style.css\
* {\
    box-sizing: border-box;\
    margin: 0;\
    padding: 0;\
    font-family: 'IBM Plex Sans Arabic', sans-serif;\
}\
\
body {\
    background-color: #0b0e11;\
    color: #eaecef;\
    direction: rtl;\
    width: 100%;\
    min-height: 100vh;\
    display: flex;\
    justify-content: center;\
    align-items: center;\
}\
\
.app-screen {\
    width: 100%;\
    max-width: 480px;\
    height: 100vh;\
    background: #0b0e11;\
    display: flex;\
    flex-direction: column;\
    overflow: hidden;\
}\
\
.top-bar {\
    height: 48px;\
    background: #181a20;\
    border-bottom: 1px solid #1f2329;\
    display: flex;\
    align-items: center;\
    justify-content: space-between;\
    padding: 0 14px;\
    flex-shrink: 0;\
}\
\
.logo-box {\
    display: flex;\
    align-items: center;\
    gap: 6px;\
}\
\
.logo-text {\
    font-size: 15px;\
    font-weight: 700;\
    color: #fff;\
}\
\
.bolt-icon {\
    color: #f0b90b;\
    font-size: 13px;\
}\
\
.icons-box {\
    display: flex;\
    gap: 16px;\
    color: #848e9c;\
    font-size: 14px;\
}\
\
.ticker-line {\
    height: 30px;\
    background: #12141c;\
    border-bottom: 1px solid #1f2329;\
    display: flex;\
    align-items: center;\
    gap: 15px;\
    padding: 0 14px;\
    font-size: 11px;\
    overflow-x: auto;\
    white-space: nowrap;\
    flex-shrink: 0;\
}\
\
.ticker-line::-webkit-scrollbar {\
    display: none;\
}\
\
.t-elem {\
    color: #848e9c;\
}\
\
.green {\
    color: #0ecb81 !important;\
    font-weight: 600;\
}\
\
.scrollable-content {\
    flex: 1;\
    overflow-y: auto;\
    padding: 10px;\
    display: flex;\
    flex-direction: column;\
    gap: 10px;\
}\
\
.section-box {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 8px;\
    padding: 10px 12px;\
}\
\
.s-title {\
    font-size: 13px;\
    font-weight: 700;\
    color: #f0b90b;\
    margin-bottom: 2px;\
}\
\
.s-desc {\
    font-size: 10px;\
    color: #848e9c;\
}\
\
.chart-card {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 8px;\
    overflow: hidden;\
}\
\
.chart-header {\
    background: #12141c;\
    border-bottom: 1px solid #1f2329;\
    padding: 6px 12px;\
    display: flex;\
    align-items: center;\
    gap: 8px;\
}\
\
.sym {\
    font-size: 12px;\
    font-weight: 700;\
    color: #fff;\
    margin-left: auto;\
}\
\
.tf-btn {\
    font-size: 10px;\
    color: #848e9c;\
    background: #1f2329;\
    padding: 2px 6px;\
    border-radius: 4px;\
}\
\
.tf-btn.active {\
    background: #0052ff;\
    color: #fff;\
}\
\
.chart-body {\
    padding: 10px;\
    background: #0b0e11;\
}\
\
.price-info {\
    margin-bottom: 8px;\
}\
\
.price-info strong {\
    display: block;\
    font-size: 12px;\
    color: #fff;\
    margin-bottom: 2px;\
}\
\
.price-info span {\
    font-size: 10px;\
}\
\
.candles-container {\
    height: 130px;\
    display: flex;\
    align-items: flex-end;\
    justify-content: space-around;\
    padding-top: 10px;\
}\
\
.bar {\
    width: 12px;\
    border-radius: 2px;\
}\
\
.green-bar {\
    background: #0ecb81;\
}\
\
.red-bar {\
    background: #f6465d;\
}\
\
.trade-buttons {\
    display: grid;\
    grid-template-columns: 1fr 1fr;\
    gap: 10px;\
}\
\
.btn-buy {\
    background: #0ecb81;\
    color: #0b0e11;\
    border: none;\
    padding: 12px;\
    border-radius: 6px;\
    font-size: 13px;\
    font-weight: 700;\
    cursor: pointer;\
    text-align: center;\
}\
\
.btn-sell {\
    background: #f6465d;\
    color: #fff;\
    border: none;\
    padding: 12px;\
    border-radius: 6px;\
    font-size: 13px;\
    font-weight: 700;\
    cursor: pointer;\
    text-align: center;\
}\
\
.list-item {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 6px;\
    padding: 12px 14px;\
    display: flex;\
    justify-content: space-between;\
    font-size: 12px;\
}\
\
.bottom-bar {\
    height: 56px;\
    background: #181a20;\
    border-top: 1px solid #1f2329;\
    display: flex;\
    flex-shrink: 0;\
}\
\
.nav-elem {\
    flex: 1;\
    background: transparent;\
    border: none;\
    color: #848e9c;\
    display: flex;\
    flex-direction: column;\
    align-items: center;\
    justify-content: center;\
    gap: 2px;\
    cursor: pointer;\
}\
\
.nav-elem i {\
    font-size: 16px;\
}\
\
.nav-elem span {\
    font-size: 9px;\
}\
\
.nav-elem.active, .nav-elem.active i, .nav-elem.active span {\
    color: #f0b90b;\
}\
EOF\
\
