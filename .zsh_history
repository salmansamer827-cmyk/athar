            background-color: #0b0f19; /* خك�فك�ة داك�ك�ة عك�ك�قة تتك�اسب ك�ع اك�ك�ك�ك�ك� اك�أزرق */\
            color: #f8fafc;\
            padding-bottom: 70px;\
            position: relative;\
            min-height: 100vh;\
        }\
\
        /* اك�عك�اك�ة اك�ك�ائك�ة اك�شفافة ك�ك�شعار فك� خك�فك�ة اك�ك�ك�قع بجك�ك�ع اك�ك�فاصك� */\
        body::before {\
            content: "";\
            position: fixed;\
            top: 50%;\
            left: 50%;\
            transform: translate(-50%, -50%);\
            width: 420px;\
            height: 420px;\
            background: url('logo.png') no-repeat center center;\
            background-size: contain;\
            opacity: 0.035; /* شفافك�ة ك�ك�خفضة ك�تك�ك�ك� عك�اك�ة ك�ائك�ة بصرك�ة ك�تك�اسقة */\
            pointer-events: none;\
            z-index: 0;\
        }\
\
        header, .content, nav {\
            position: relative;\
            z-index: 1;\
        }\
        \
        /* اك�ك�ك�در اك�عك�ك�ك� */\
        header {\
            background-color: #0f172a;\
            padding: 12px 16px;\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            border-bottom: 1px solid #1e293b;\
            position: sticky;\
            top: 0;\
            z-index: 1000;\
            box-shadow: 0 4px 20px rgba(56, 189, 248, 0.15);\
        }\
        .brand {\
            display: flex;\
            align-items: center;\
            gap: 10px;\
        }\
        .header-logo {\
            width: 38px;\
            height: 38px;\
            border-radius: 8px;\
            border: 1px solid #38bdf8;\
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);\
            object-fit: cover;\
        }\
        h1 { margin: 0; color: #38bdf8; font-size: 1.2rem; font-weight: 700; text-shadow: 0 0 8px rgba(56, 189, 248, 0.3); }\
        \
        .header-icons {\
            display: flex;\
            gap: 15px;\
            color: #94a3b8;\
            font-size: 1.1rem;\
            cursor: pointer;\
        }\
\
        /* اك�ك�حتك�ك� اك�رئك�سك� */\
        .content {\
            padding: 12px;\
            max-width: 600px;\
            margin: 0 auto;\
        }\
        .section-view { display: none; }\
        .section-view.active { display: block; }\
\
        /* اك�تبك�ك�بات اك�فرعك�ة باك�أزرق */\
        .sub-tabs {\
            display: flex;\
            gap: 20px;\
            border-bottom: 1px solid #1e293b;\
            margin-bottom: 15px;\
            overflow-x: auto;\
            white-space: nowrap;\
        }\
        .sub-tab-btn {\
            background: none;\
            border: none;\
            color: #94a3b8;\
            padding: 8px 0;\
            font-size: 0.95rem;\
            font-weight: 600;\
            cursor: pointer;\
            position: relative;\
            transition: color 0.3s ease;\
        }\
        .sub-tab-btn.active {\
            color: #38bdf8;\
        }\
        .sub-tab-btn.active::after {\
            content: '';\
            position: absolute;\
            bottom: 0;\
            left: 0;\
            right: 0;\
            height: 2px;\
            background-color: #38bdf8;\
            box-shadow: 0 0 8px #38bdf8;\
            border-radius: 2px;\
        }\
        .sub-view { display: none; }\
        .sub-view.active { display: block; }\
\
        /* اك�بطاقات اك�حك�ة */\
        .card {\
            background-color: #0f172a;\
