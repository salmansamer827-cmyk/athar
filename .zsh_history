cat > backend/services/futures_position_service.py <<'PY'\
from decimal import Decimal\
import time\
\
from backend.database.db import get_connection\
from backend.services.wallet_service import WalletService\
\
\
class FuturesPositionService:\
\
    def __init__(self):\
        self.wallet = WalletService()\
\
    # =====================================================\
    # OPEN POSITION\
    # =====================================================\
\
    def open_position(\
        self,\
        user_id: str,\
        symbol: str,\
        side: str,\
        quantity,\
        entry_price,\
        leverage: int,\
    ):\
\
        symbol = symbol.upper().strip()\
        side = side.upper().strip()\
\
        quantity = Decimal(str(quantity))\
        entry_price = Decimal(str(entry_price))\
        leverage = int(leverage)\
\
        if not user_id:\
            raise ValueError("User ID is required")\
\
        if not symbol:\
            raise ValueError("Symbol is required")\
\
        if side not in ("LONG", "SHORT"):\
            raise ValueError("Side must be LONG or SHORT")\
\
        if quantity <= 0:\
            raise ValueError("Quantity must be greater than zero")\
\
        if entry_price <= 0:\
            raise ValueError("Entry price must be greater than zero")\
\
        if leverage < 1 or leverage > 125:\
            raise ValueError("Leverage must be between 1 and 125")\
\
        notional = quantity * entry_price\
        initial_margin = notional / Decimal(str(leverage))\
\
        now = int(time.time())\
\
        conn = get_connection()\
\
        try:\
            conn.execute("BEGIN")\
\
            # ---------------------------------------------\
            # Check existing open position\
            # ---------------------------------------------\
\
            existing = conn.execute(\
                """\
                SELECT id\
                FROM futures_positions\
                WHERE user_id = ?\
                  AND symbol = ?\
                  AND side = ?\
                  AND status = 'OPEN'\
                LIMIT 1\
                """,\
                (user_id, symbol, side)\
            ).fetchone()\
\
            if existing:\
                raise ValueError(\
                    "An open position already exists for this side"\
                )\
\
            # ---------------------------------------------\
            # Lock USDT margin atomically\
            # ---------------------------------------------\
\
            wallet = conn.execute(\
                """\
                SELECT available, locked\
                FROM wallets\
                WHERE user_id = ?\
                  AND asset = 'USDT'\
                """\
                ,\
                (user_id,)\
            ).fetchone()\
\
            if wallet is None:\
                raise ValueError("USDT wallet not found")\
\
            available = Decimal(str(wallet["available"]))\
            locked = Decimal(str(wallet["locked"]))\
\
            if available < initial_margin:\
                raise ValueError(\
                    f"Insufficient USDT margin. "\
                    f"Required: {initial_margin}, "\
                    f"Available: {available}"\
                )\
\
            new_available = available - initial_margin\
            new_locked = locked + initial_margin\
\
            conn.execute(\
                """\
                UPDATE wallets\
                SET available = ?,\
                    locked = ?\
                WHERE user_id = ?\
                  AND asset = 'USDT'\
                """,\
                (\
                    float(new_available),\
                    float(new_locked),\
                    user_id,\
                )\
            )\
\
            # ---------------------------------------------\
            # Create position\
            # ---------------------------------------------\
\
            cursor = conn.execute(\
                """\
                INSERT INTO futures_positions (\
                    user_id,\
                    symbol,\
                    side,\
                    quantity,\
                    entry_price,\
                    mark_price,\
                    leverage,\
                    initial_margin,\
                    maintenance_margin,\
                    unrealized_pnl,\
                    realized_pnl,\
                    liquidation_price,\
                    status,\
                    created_at,\
                    updated_at\
                )\
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\
                """,\
                (\
                    user_id,\
                    symbol,\
                    side,\
                    float(quantity),\
                    float(entry_price),\
                    float(entry_price),\
                    leverage,\
                    float(initial_margin),\
                    0.0,\
                    0.0,\
                    0.0,\
                    None,\
                    "OPEN",\
                    now,\
                    now,\
                )\
            )\
\
            position_id = cursor.lastrowid\
\
            # ---------------------------------------------\
            # Futures ledger\
            # ---------------------------------------------\
\
            conn.execute(\
                """\
                INSERT INTO futures_ledger (\
                    user_id,\
                    asset,\
                    amount,\
                    entry_type,\
                    reference_id,\
                    created_at\
                )\
                VALUES (?, ?, ?, ?, ?, ?)\
                """,\
                (\
                    user_id,\
                    "USDT",\
                    float(-initial_margin),\
                    "MARGIN_LOCK",\
                    str(position_id),\
                    now,\
                )\
            )\
\
            conn.commit()\
\
            return self.get_position(position_id)\
\
        except Exception:\
            conn.rollback()\
            raise\
\
        finally:\
            conn.close()\
\
    # =====================================================\
    # GET POSITION\
    # =====================================================\
\
    def get_position(self, position_id: int):\
\
        conn = get_connection()\
\
        try:\
            row = conn.execute(\
                """\
                SELECT *\
                FROM futures_positions\
                WHERE id = ?\
                """,\
                (position_id,)\
            ).fetchone()\
\
            if row is None:\
                raise ValueError("Position not found")\
\
            return dict(row)\
\
        finally:\
            conn.close()\
\
    # =====================================================\
    # USER POSITIONS\
    # =====================================================\
\
    def get_user_positions(self, user_id: str):\
\
        conn = get_connection()\
\
        try:\
            rows = conn.execute(\
                """\
                SELECT *\
                FROM futures_positions\
                WHERE user_id = ?\
                  AND status = 'OPEN'\
                ORDER BY id DESC\
                """,\
                (user_id,)\
            ).fetchall()\
\
            return [dict(row) for row in rows]\
\
        finally:\
            conn.close()\
\
    # =====================================================\
    # CLOSE POSITION\
    # =====================================================\
\
    def close_position(\
        self,\
        position_id: int,\
        exit_price\
    ):\
\
        exit_price = Decimal(str(exit_price))\
\
        if exit_price <= 0:\
            raise ValueError(\
                "Exit price must be greater than zero"\
            )\
\
        conn = get_connection()\
\
        try:\
            conn.execute("BEGIN")\
\
            row = conn.execute(\
                """\
                SELECT *\
                FROM futures_positions\
                WHERE id = ?\
                  AND status = 'OPEN'\
                """,\
                (position_id,)\
            ).fetchone()\
\
            if row is None:\
                raise ValueError(\
                    "Open position not found"\
                )\
\
            position = dict(row)\
\
            quantity = Decimal(str(position["quantity"]))\
            entry_price = Decimal(\
                str(position["entry_price"])\
            )\
            margin = Decimal(\
                str(position["initial_margin"])\
            )\
\
            side = position["side"]\
\
            # ---------------------------------------------\
            # Calculate PnL\
            # ---------------------------------------------\
\
            if side == "LONG":\
                pnl = (\
                    exit_price - entry_price\
                ) * quantity\
\
            else:\
                pnl = (\
                    entry_price - exit_price\
                ) * quantity\
\
            return_amount = margin + pnl\
\
            if return_amount < 0:\
                return_amount = Decimal("0")\
\
            # ---------------------------------------------\
            # Wallet\
            # ---------------------------------------------\
\
            wallet = conn.execute(\
                """\
                SELECT available, locked\
                FROM wallets\
                WHERE user_id = ?\
                  AND asset = 'USDT'\
                """,\
                (position["user_id"],)\
            ).fetchone()\
\
            if wallet is None:\
                raise ValueError(\
                    "USDT wallet not found"\
                )\
\
            available = Decimal(\
                str(wallet["available"])\
            )\
\
            locked = Decimal(\
                str(wallet["locked"])\
            )\
\
            if locked < margin:\
                raise ValueError(\
                    "Wallet locked balance is insufficient"\
                )\
\
            new_available = (\
                available + return_amount\
            )\
\
            new_locked = (\
                locked - margin\
            )\
\
            # ---------------------------------------------\
            # Update wallet\
            # ---------------------------------------------\
\
            conn.execute(\
                """\
                UPDATE wallets\
                SET available = ?,\
                    locked = ?\
                WHERE user_id = ?\
                  AND asset = 'USDT'\
                """,\
                (\
                    float(new_available),\
                    float(new_locked),\
                    position["user_id"],\
                )\
            )\
\
            now = int(time.time())\
\
            # ---------------------------------------------\
            # Close position\
            # ---------------------------------------------\
\
            conn.execute(\
                """\
                UPDATE futures_positions\
                SET mark_price = ?,\
                    unrealized_pnl = 0,\
                    realized_pnl = ?,\
                    status = 'CLOSED',\
                    updated_at = ?\
                WHERE id = ?\
                """,\
                (\
                    float(exit_price),\
                    float(pnl),\
                    now,\
                    position_id,\
                )\
            )\
\
            # ---------------------------------------------\
            # Ledger\
            # ---------------------------------------------\
\
            conn.execute(\
                """\
                INSERT INTO futures_ledger (\
                    user_id,\
                    asset,\
                    amount,\
                    entry_type,\
                    reference_id,\
                    created_at\
                )\
                VALUES (?, ?, ?, ?, ?, ?)\
                """,\
                (\
                    position["user_id"],\
                    "USDT",\
                    float(return_amount),\
                    "POSITION_CLOSE",\
                    str(position_id),\
                    now,\
                )\
            )\
\
            conn.commit()\
\
            return {\
                "position_id": position_id,\
                "user_id": position["user_id"],\
                "symbol": position["symbol"],\
                "side": side,\
                "quantity": str(quantity),\
                "entry_price": str(entry_price),\
                "exit_price": str(exit_price),\
                "margin": str(margin),\
                "realized_pnl": str(pnl),\
                "returned_margin": str(return_amount),\
                "status": "CLOSED",\
            }\
\
        except Exception:\
            conn.rollback()\
            raise\
\
        finally:\
            conn.close()\
