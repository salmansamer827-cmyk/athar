        </div>\
\
    </div>\
\
    <nav class="bottom-nav">\
        <button class="nav-item" onclick="switchTab('home', this)">\
            <span class="icon">�������</span>\
            <span>اك�رئك�سك�ة</span>\
        </button>\
        <button class="nav-item" onclick="switchTab('markets', this)">\
            <span class="icon">�������</span>\
            <span>اك�أسك�اق</span>\
        </button>\
        <button class="nav-item active" onclick="switchTab('chart', this)">\
            <span class="icon">�������</span>\
            <span>اك�تداك�ك�</span>\
        </button>\
        <button class="nav-item" onclick="switchTab('assets', this)">\
            <span class="icon">������</span>\
            <span>اك�أصك�ك�</span>\
        </button>\
    </nav>\
\
    <script>\
        // قائك�ة اك�عك�ك�ات ك�اك�أصك�ك� اك�ك�دعك�ك�ة اك�ك�طك�ك�بة\
        const supportedAssets = [\
            'EXCORA/USDT',\
            'BTC/USDT',\
            'ETH/USDT',\
            'XRP/USDT',\
            'XAU/USDT',\
            'LINK/USDT',\
            'BNB/USDT',\
            'ADA/USDT',\
            'SOL/USDT',\
            'TAO/USDT',\
            'PENDLE/USDT',\
            'HBAR/USDT',\
            'ONDO/USDT'\
        ];\
\
        // تعبئة قائك�ة اك�أسك�اق تك�قائك�اك�\
        function renderSupportedAssets() {\
            const listContainer = document.getElementById('dynamic-ticker-list');\
            if(!listContainer) return;\
            \
            listContainer.innerHTML = '';\
            supportedAssets.forEach(asset => {\
                let randomPrice = (Math.random() * 500 + 10).toFixed(2);\
                let randomChange = (Math.random() * 6 - 2).toFixed(2);\
                let isPositive = randomChange >= 0;\
                \
                const item = document.createElement('div');\
                item.className = 'ticker-item';\
                item.onclick = function() { flashElement(this); };\
                \
                item.innerHTML = `\
                    <div class="ticker-info">\
                        <div class="symbol">${asset}</div>\
                        <div class="name">Institutional Asset</div>\
                    </div>\
                    <div class="ticker-values">\
                        <div class="price">$${Number(randomPrice).toLocaleString()}</div>\
                        <div class="change ${isPositive ? 'positive' : 'negative'}">${isPositive ? '+' : ''}${randomChange}%</div>\
                    </div>\
                `;\
                listContainer.appendChild(item);\
            });\
        }\
\
        document.addEventListener("DOMContentLoaded", renderSupportedAssets);\
\
        function switchTab(tabId, element) {\
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));\
            document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));\
            document.getElementById(tabId + '-tab').classList.add('active');\
            element.classList.add('active');\
            window.scrollTo(0, 0);\
        }\
\
        function triggerAction(type) {\
            const btn = event.target;\
            btn.style.transform = 'scale(0.92)';\
            setTimeout(() => btn.style.transform = 'scale(1)', 150);\
            alert('⃺�� تك� تك�فك�ذ أك�ر ' + type + ' بك�جاح عبر خك�ارزك�ك�ات EXCORA.');\
        }\
\
        function flashElement(el) {\
            el.style.backgroundColor = 'rgba(240, 185, 11, 0.15)';\
            setTimeout(() => el.style.backgroundColor = '', 300);\
        }\
\
        setInterval(() => {\
            const btcEl = document.getElementById('btcTicker');\
            if(btcEl) {\
                let randomVal = (81610 + Math.random() * 15).toFixed(2);\
                btcEl.innerText = Number(randomVal).toLocaleString();\
            }\
        }, 4000);\
    </script>\
</body>\
</html>\
EOF\
\
# ك�شر اك�تحدك�ثات فك�راك� عك�ك� فاك�ربك�ز ك�تصبح حك�ة\
firebase deploy\

