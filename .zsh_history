\
        tp_id = tp_order.get("orderId")\
\
        if not tp_id:\
            try:\
                binance_exchange.fapiPrivateDeleteOrder({\
                    "symbol": clean_symbol,\
                    "orderId": sl_id,\
                })\
                cancel_result = "SL تك� إك�غاؤك� بك�جاح"\
