const express = require('express');\
const path = require('path');\
const bcrypt = require('bcryptjs');\
const jwt = require('jsonwebtoken');\
const sqlite3 = require('sqlite3').verbose();\
const ccxt = require('ccxt');\
require('dotenv').config();\
\
const app = express();\
app.use(express.json());\
app.use(express.static(path.join(__dirname, 'public')));\
\
const JWT_SECRET = process.env.JWT_SECRET || 'excora_master_secret_2026';\
const OWNER_EMAIL = process.env.OWNER_EMAIL || 'samer@excora.com'; // برك�دك� اك�خاص ك�ك�اك�ك� ك�ك�ك�ك�صة\
\
// قاعدة بك�اك�ات اك�ك�شترك�ك�ك�\
const db = new sqlite3.Database('./excora_saas.db');\
db.serialize(() => {\
    db.run(`CREATE TABLE IF NOT EXISTS users (\
        id INTEGER PRIMARY KEY AUTOINCREMENT,\
        email TEXT UNIQUE,\
        password_hash TEXT,\
        subscription_status TEXT DEFAULT 'inactive',\
        binance_api_key TEXT,\
        binance_secret_key TEXT,\
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP\
    )`);\
});\
\
// 1. تسجك�ك� اك�ك�ستخدك�ك�ك� اك�جدد\
app.post('/api/auth/register', async (req, res) => {\
    const { email, password } = req.body;\
    try {\
        const hashedPassword = await bcrypt.hash(password, 10);\
        // إذا ك�اك� اك�تسجك�ك� برك�دك� اك�شخصك�؃� ك�تك� تفعك�ك� اشتراك�ك� تك�قائك�اك� ك�ك�أبد\
        const initialStatus = (email === OWNER_EMAIL) ? 'active' : 'inactive';\
\
        db.run(`INSERT INTO users (email, password_hash, subscription_status) VALUES (?, ?, ?)`, \
        [email, hashedPassword, initialStatus], function(err) {\
            if (err) return res.status(400).json({ success: false, error: 'اك�برك�د اك�إك�ك�ترك�ك�ك� ك�سجك� ك�سبقاك�' });\
            res.json({ success: true, message: 'تك� إك�شا؃� اك�حساب بك�جاح. ك�رجك� إتك�اك� اك�اشتراك� ك�تفعك�ك� اك�تك�صك�ات.' });\
        });\
    } catch (e) {\
        res.status(500).json({ success: false, error: e.message });\
    }\
});\
\
// 2. تسجك�ك� اك�دخك�ك�\
app.post('/api/auth/login', (req, res) => {\
    const { email, password } = req.body;\
    db.get(`SELECT * FROM users WHERE email = ?`, [email], async (err, user) => {\
        if (!user || !(await bcrypt.compare(password, user.password_hash))) {\
            return res.status(401).json({ success: false, error: 'بك�اك�ات اك�دخك�ك� غك�ر صحك�حة' });\
        }\
        \
        // استثك�ا؃� ك�تجاك�ز تك�قائك� ك�ك� أك�ت (اك�ك�اك�ك�)\
        if (user.email === OWNER_EMAIL && user.subscription_status !== 'active') {\
            db.run(`UPDATE users SET subscription_status = 'active' WHERE email = ?`, [OWNER_EMAIL]);\
            user.subscription_status = 'active';\
        }\
\
        const token = jwt.sign({ id: user.id, email: user.email, role: user.email === OWNER_EMAIL ? 'admin' : 'user' }, JWT_SECRET, { expiresIn: '7d' });\
        res.json({ success: true, token, subscription: user.subscription_status, isOwner: user.email === OWNER_EMAIL });\
    });\
});\
\
// 3. ك�سك�ط حك�اك�ة ك�اك�تحقق ك�ك� اك�اشتراك� (ك�تخطاك� أك�ت تك�قائك�اك� ك�ك�طك�ب اك�دفع ك�ك� اك�بقك�ة)\
function checkAccess(req, res, next) {\
    const authHeader = req.headers['authorization'];\
    if (!authHeader) {\
        return res.status(403).json({ success: false, error: 'ك�طك�ك�ب تسجك�ك� اك�دخك�ك� ك�اك�اشتراك� ك�ك�ك�صك�ك� إك�ك� اك�تك�صك�ات' });\
    }\
\
    jwt.verify(authHeader.split(' ')[1], JWT_SECRET, (err, decoded) => {\
        if (err) return res.status(401).json({ success: false, error: 'جك�سة غك�ر صاك�حة' });\
\
        // استثك�ا؃� ك�اك�ك� اك�ك�ك�صة (أك�ت) - ك�صك�ك� ك�اك�ك� ك�جاك�ك� بدك�ك� اشتراك�\
        if (decoded.email === OWNER_EMAIL) {\
            req.user = decoded;\
            return next();\
        }\
\
        // فحص اشتراك� اك�ك�ستخدك� اك�عادك�\
        db.get(`SELECT subscription_status FROM users WHERE id = ?`, [decoded.id], (dbErr, user) => {\
            if (dbErr || !user || user.subscription_status !== 'active') {\
                return res.status(403).json({ \
                    success: false, \
                    error: 'عذراك�؃� ك�ك�زة اك�تك�صك�ات ك�اك�تداك�ك� تتطك�ب اشتراك�اك� ك�شطاك�. ك�رجك� إتك�اك� اك�دفع ك�تفعك�ك� اك�حساب.',\
                    requiresSubscription: true \
                });\
            }\
            req.user = decoded;\
            next();\
        });\
    });\
}\
\
// 4. ك�حرك� اك�تك�صك�ات ك�استراتك�جك�ة EXCORA (ك�حك�ك� ك�ك�ك�شترك�ك�ك� ك�ك�فتك�ح ك�ك�)\
app.get('/api/signals', checkAccess, (req, res) => {\
    const liveSignals = [\
        { symbol: 'BTC/USDT:USDT', type: 'LONG', entry: 64200, tp: 66500, sl: 63500, confidence: '96%', reason: 'Smart Money BOS + Fair Value Gap Fill' },\
        { symbol: 'ETH/USDT:USDT', type: 'SHORT', entry: 3450, tp: 3300, sl: 3520, confidence: '91%', reason: 'Volume Profile Point of Control Rejection' }\
    ];\
    res.json({ success: true, signals: liveSignals, ownerMode: req.user.email === OWNER_EMAIL });\
});\
\
// 5. ك�حاك�اة تفعك�ك� اك�اشتراك� بعد اك�دفع ك�ك�ك�ستخدك�ك�ك� (بك�ابة اك�دفع اك�ك�ك�ك�ك�ة/اك�حقك�قك�ة)\
app.post('/api/subscribe', checkAccess, (req, res) => {\
    // ك�ك�ا ك�تك� ربط بك�ابة اك�دفع ك�ثك� Stripe أك� USDT Crypto Payment ك�احقاك�\
    db.run(`UPDATE users SET subscription_status = 'active' WHERE id = ?`, [req.user.id], (err) => {\
        if (err) return res.status(500).json({ success: false, error: 'فشك� تفعك�ك� اك�اشتراك�' });\
        res.json({ success: true, message: 'تك� تفعك�ك� اشتراك�ك� بك�جاح! استك�تع بك�افة تك�صك�ات اك�ك�ك�صة.' });\
    });\
});\
\
const PORT = process.env.PORT || 3000;\
app.listen(PORT, () => {\
    console.log(`������ EXCORA Hybrid Platform running on port ${PORT} (Free for Owner, Subscription required for Users)`);\
});\
EOF\
