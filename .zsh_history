\
/* تك�سك�قات ك�ك�صة EXCORA اك�ك�تقدك�ة - Neo-Dark Theme */\
* {\
    box-sizing: border-box;\
}\
\
body {\
    margin: 0;\
    font-family: 'IBM Plex Sans Arabic', sans-serif;\
    background-color: #0b0f19;\
    color: #f8fafc;\
    padding-bottom: 80px;\
    position: relative;\
    min-height: 100vh;\
}\
\
/* تخصك�ص اك�خطك�ط اك�رقك�ك�ة ك�ك�أسعار ك�اك�أرقاك� ك�اك�عك�اك�ك�ك� */\
.pulsing-price, .market-row span, h1, h2, h3, .mini-bar-btn {\
    font-family: 'JetBrains Mono', 'IBM Plex Sans Arabic', monospace;\
}\
\
/* عك�اك�ة ك�ائك�ة شفافة ك�ك�شعار فك� اك�خك�فك�ة */\
body::before {\
    content: "";\
    position: fixed;\
    top: 50%;\
    left: 50%;\
    transform: translate(-50%, -50%);\
    width: 420px;\
    height: 420px;\
    background: url('logo.png') no-repeat center center;\
    background-size: contain;\
    opacity: 0.035;\
    pointer-events: none;\
    z-index: 0;\
}\
\
header, .mini-bar, .content, nav {\
    position: relative;\
    z-index: 1;\
}\
\
/* اك�ك�ك�در اك�عك�ك�ك� */\
header {\
    background-color: #0f172a;\
    padding: 12px 16px;\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    border-bottom: 1px solid #1e293b;\
    position: sticky;\
    top: 0;\
    z-index: 1000;\
    box-shadow: 0 4px 20px rgba(56, 189, 248, 0.15);\
}\
\
.brand {\
    display: flex;\
    align-items: center;\
    gap: 10px;\
}\
\
.header-logo {\
    width: 38px;\
    height: 38px;\
    border-radius: 8px;\
    border: 1px solid #38bdf8;\
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);\
    object-fit: cover;\
}\
\
h1 {\
    margin: 0;\
    color: #38bdf8;\
    font-size: 1.2rem;\
    font-weight: 700;\
    text-shadow: 0 0 8px rgba(56, 189, 248, 0.3);\
}\
\
.header-icons {\
    display: flex;\
    gap: 15px;\
    color: #94a3b8;\
    font-size: 1.1rem;\
    cursor: pointer;\
}\
\
/* اك�شرك�ط اك�سرك�ع تحت اك�ك�ك�در */\
.mini-bar {\
    display: flex;\
    gap: 8px;\
    padding: 8px 12px;\
    background-color: #0b0f19;\
    border-bottom: 1px solid #1e293b;\
    overflow-x: auto;\
    white-space: nowrap;\
    position: sticky;\
    top: 61px;\
    z-index: 999;\
}\
\
.mini-bar::-webkit-scrollbar {\
    display: none;\
}\
\
.mini-bar-btn {\
    background-color: #1e293b;\
    border: 1px solid #334155;\
    color: #94a3b8;\
    padding: 6px 12px;\
    border-radius: 20px;\
    font-size: 0.8rem;\
    cursor: pointer;\
    display: flex;\
    align-items: center;\
    gap: 6px;\
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\
}\
\
.mini-bar-btn:hover {\
    border-color: #38bdf8;\
    color: #38bdf8;\
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.2);\
}\
\
/* اك�ك�حتك�ك� اك�رئك�سك� */\
.content {\
    padding: 12px;\
    max-width: 600px;\
    margin: 0 auto;\
}\
\
.section-view {\
    display: none;\
}\
\
.section-view.active {\
    display: block;\
}\
\
/* اك�تبك�ك�بات اك�فرعك�ة */\
.sub-tabs {\
    display: flex;\
    gap: 20px;\
    border-bottom: 1px solid #1e293b;\
    margin-bottom: 15px;\
    overflow-x: auto;\
    white-space: nowrap;\
}\
\
.sub-tab-btn {\
    background: none;\
    border: none;\
    color: #94a3b8;\
    padding: 8px 0;\
    font-size: 0.95rem;\
    font-weight: 600;\
    cursor: pointer;\
    position: relative;\
    transition: color 0.3s ease;\
}\
\
.sub-tab-btn.active {\
    color: #38bdf8;\
    text-shadow: 0 0 8px rgba(56, 189, 248, 0.4);\
}\
\
.sub-tab-btn.active::after {\
    content: '';\
    position: absolute;\
    bottom: 0;\
    left: 0;\
    right: 0;\
    height: 2px;\
    background-color: #38bdf8;\
    box-shadow: 0 0 8px #38bdf8;\
    border-radius: 2px;\
}\
\
.sub-view {\
    display: none;\
}\
\
.sub-view.active {\
    display: block;\
}\
\
/* اك�بطاقات ك�اك�أسك�اق */\
.card {\
    background-color: #0f172a;\
    border-radius: 10px;\
    padding: 14px;\
    margin-bottom: 12px;\
    border: 1px solid #1e293b;\
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);\
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\
}\
\
.card:hover {\
    border-color: #38bdf8;\
}\
\
.market-row {\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    padding: 12px 0;\
    border-bottom: 1px solid #1e293b;\
}\
\
.market-row:last-child {\
    border-bottom: none;\
}\
\
.price-up {\
    color: #10b981;\
    font-weight: 600;\
}\
\
.price-down {\
    color: #ef4444;\
    font-weight: 600;\
}\
\
/* تأثك�ر ك�بض اك�ك�ك�ك�ك� ك�ك�أسعار */\
@keyframes pulse-neon {\
    0% { opacity: 1; text-shadow: 0 0 5px rgba(56, 189, 248, 0.5); }\
    50% { opacity: 0.5; text-shadow: 0 0 15px rgba(56, 189, 248, 0.9); }\
    100% { opacity: 1; text-shadow: 0 0 5px rgba(56, 189, 248, 0.5); }\
}\
\
.pulsing-price {\
    animation: pulse-neon 1.8s infinite;\
}\
\
.neon-glow {\
    text-shadow: 0 0 10px rgba(56, 189, 248, 0.6), 0 0 20px rgba(56, 189, 248, 0.3);\
}\
\
/* اك�أزرار ك�اك�حقك�ك� */\
.btn-group {\
    display: grid;\
    grid-template-columns: 1fr 1fr;\
    gap: 10px;\
    margin-top: 15px;\
}\
\
.btn-buy {\
    background-color: #10b981;\
    color: #ffffff;\
    border: none;\
    padding: 12px;\
    border-radius: 6px;\
    font-weight: bold;\
    cursor: pointer;\
    font-size: 0.95rem;\
}\
\
.btn-sell {\
    background-color: #ef4444;\
    color: #ffffff;\
    border: none;\
    padding: 12px;\
    border-radius: 6px;\
    font-weight: bold;\
    cursor: pointer;\
    font-size: 0.95rem;\
}\
\
.btn-action {\
    background-color: #38bdf8;\
    color: #0b0f19;\
    border: none;\
    padding: 12px;\
    border-radius: 6px;\
    font-weight: bold;\
    width: 100%;\
    cursor: pointer;\
    margin-top: 10px;\
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);\
    transition: background-color 0.2s;\
}\
\
.btn-action:hover {\
    background-color: #0ea5e9;\
}\
\
/* شرك�ط اك�تك�رك�ر (Scrollbar) اك�ك�تك�افق ك�ع اك�ثك�ك� */\
::-webkit-scrollbar {\
    width: 4px;\
    height: 4px;\
}\
\
::-webkit-scrollbar-track {\
    background: #0b0f19;\
}\
\
::-webkit-scrollbar-thumb {\
    background: #1e293b;\
    border-radius: 4px;\
}\
\
::-webkit-scrollbar-thumb:hover {\
    background: #38bdf8;\
}\
\
/* اك�تذك�ك�ك� ك�اك�تك�قك� اك�سفك�ك� */\
.footer-branding {\
    text-align: center;\
    margin: 20px 0 10px 0;\
    color: #94a3b8;\
    font-size: 0.8rem;\
    display: flex;\
    align-items: center;\
    justify-content: center;\
    gap: 8px;\
}\
\
.footer-logo {\
    width: 18px;\
    height: 18px;\
    border-radius: 4px;\
    object-fit: cover;\
    opacity: 0.8;\
}\
\
nav {\
    display: flex;\
    justify-content: space-around;\
    background-color: #0f172a;\
    position: fixed;\
    bottom: 0;\
    left: 0;\
    right: 0;\
    border-top: 1px solid #1e293b;\
    padding: 8px 0;\
    z-index: 1000;\
}\
\
nav button {\
    background: none;\
    border: none;\
    color: #94a3b8;\
    font-size: 0.75rem;\
    display: flex;\
    flex-direction: column;\
    align-items: center;\
    gap: 4px;\
    cursor: pointer;\
    transition: color 0.2s;\
}\
\
nav button span.icon {\
    font-size: 1.25rem;\
}\
\
nav button.active {\
    color: #38bdf8;\
    text-shadow: 0 0 8px rgba(56, 189, 248, 0.4);\
}\
EOF\
