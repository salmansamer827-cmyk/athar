<style>\
*{box-sizing:border-box;margin:0;padding:0}\
\
body{\
    background:#080c12;\
    color:#fff;\
    font-family:Arial,sans-serif;\
    padding-bottom:82px;\
}\
\
.app{\
    max-width:600px;\
    margin:auto;\
    min-height:100vh;\
}\
\
.header{\
    height:65px;\
    padding:0 18px;\
    display:flex;\
    align-items:center;\
    justify-content:space-between;\
    border-bottom:1px solid #1d2630;\
}\
\
.logo{\
    font-size:24px;\
    font-weight:bold;\
    letter-spacing:1px;\
}\
\
.content{\
    padding:20px 16px;\
}\
\
.page{display:none}\
.page.active{display:block}\
\
.card{\
    background:#111820;\
    border:1px solid #202a35;\
    border-radius:16px;\
    padding:18px;\
    margin-bottom:14px;\
}\
\
.muted{\
    color:#8996a3;\
    font-size:14px;\
}\
\
.balance{\
    font-size:30px;\
    font-weight:bold;\
    margin-top:8px;\
}\
\
.grid{\
    display:grid;\
    grid-template-columns:1fr 1fr;\
    gap:12px;\
}\
\
.market{\
    display:flex;\
    justify-content:space-between;\
    align-items:center;\
    padding:16px 4px;\
    border-bottom:1px solid #202a35;\
}\
\
.market:last-child{\
    border-bottom:none;\
}\
\
.nav{\
    position:fixed;\
    bottom:0;\
    left:0;\
    right:0;\
    height:78px;\
    background:#0e141b;\
    border-top:1px solid #202a35;\
    display:flex;\
    justify-content:space-around;\
    align-items:center;\
    z-index:100;\
}\
\
.nav button{\
    border:0;\
    background:none;\
    color:#778491;\
    cursor:pointer;\
    display:flex;\
    flex-direction:column;\
    align-items:center;\
    gap:5px;\
    font-size:11px;\
}\
\
.nav button.active{\
    color:#fff;\
}\
\
.icon{\
    font-size:22px;\
}\
\
.action{\
    width:100%;\
    border:1px solid #283542;\
    background:#17212b;\
    color:#fff;\
    border-radius:10px;\
    padding:14px;\
    margin-top:10px;\
    font-size:15px;\
}\
\
h1{margin-bottom:7px}\
h2{margin-bottom:10px}\
\
.status{\
    margin-top:10px;\
    color:#7f8d99;\
    font-size:13px;\
}\
</style>\
</head>\
\
