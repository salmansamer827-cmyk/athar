import json\
import time\
import urllib.request\
\
candles = []\
\
base = 100.0\
\
for i in range(100):\
    close = base + (i % 7) * 0.8\
    candles.append({\
        "timestamp": int(time.time() * 1000) + i * 900000,\
        "open": close - 0.3,\
        "high": close + 1.0,\
        "low": close - 1.0,\
        "close": close,\
        "volume": 1000.0 + i * 10,\
        "symbol": "BTC/USDT",\
        "market": "CRYPTO",\
        "timeframe": "15m"\
    })\
\
payload = {\
    "symbol": "BTC/USDT",\
    "market": "CRYPTO",\
    "timeframe": "15m",\
    "candles": candles,\
    "capital": 100.0,\
    "wins": 72,\
    "losses": 28\
}\
\
req = urllib.request.Request(\
    "http://127.0.0.1:8000/api/v1/quant/analyze",\
    data=json.dumps(payload).encode(),\
    headers={"Content-Type": "application/json"},\
    method="POST"\
)\
\
try:\
    with urllib.request.urlopen(req) as response:\
        print("HTTP:", response.status)\
        print(response.read().decode())\
except Exception as e:\
    print("ERROR:", e)\
