from decimal import Decimal\
\
from backend.database.db import init_db, get_connection\
from backend.services.wallet_service import WalletService\
from backend.services.order_service import OrderService\
\
\
init_db()\
\
USER = "cancel_test_user"\
SYMBOL = "BTC/USDT"\
\
wallet = WalletService()\
orders = OrderService()\
\
\
# تك�ظك�ف بك�اك�ات اك�اختبار\
conn = get_connection()\
\
try:\
    conn.execute("BEGIN")\
\
    conn.execute(\
        "DELETE FROM ledger_entries WHERE user_id = ?",\
        (USER,)\
    )\
\
    conn.execute(\
        """\
        DELETE FROM trades\
        WHERE buyer_user_id = ?\
           OR seller_user_id = ?\
        """,\
        (USER, USER)\
    )\
\
    conn.execute(\
        "DELETE FROM orders WHERE user_id = ?",\
        (USER,)\
    )\
\
    conn.execute(\
        "DELETE FROM wallets WHERE user_id = ?",\
        (USER,)\
    )\
\
    conn.commit()\
\
finally:\
    conn.close()\
\
\
print("====================================")\
print(" EXCORA CANCEL ORDER TEST")\
print("====================================")\
\
\
print("\n[1] Deposit buyer funds")\
\
wallet.deposit(\
    user_id=USER,\
    asset="USDT",\
    amount=Decimal("100")\
)\
\
print(wallet.get_wallet(USER, "USDT"))\
\
\
print("\n[2] Create BUY order")\
\
order = orders.create_limit_order(\
    user_id=USER,\
    symbol=SYMBOL,\
    side="BUY",\
    quantity=Decimal("0.001"),\
    price=Decimal("68000")\
)\
\
print(order)\
\
\
print("\n[3] Wallet after LOCK")\
\
before_cancel = wallet.get_wallet(USER, "USDT")\
\
print(before_cancel)\
\
\
print("\n[4] Cancel order")\
\
result = orders.cancel_order(\
    user_id=USER,\
    order_id=order["order_id"]\
)\
\
print(result)\
\
\
print("\n[5] Wallet after CANCEL")\
\
after_cancel = wallet.get_wallet(USER, "USDT")\
\
print(after_cancel)\
\
\
print("\n[6] Order after CANCEL")\
\
all_orders = orders.get_orders(USER)\
\
for item in all_orders:\
    print(item)\
\
\
print("\n====================================")\
print(" CHECKS")\
print("====================================")\
\
\
expected_available = Decimal("100")\
expected_locked = Decimal("0")\
\
actual_available = Decimal(\
    str(after_cancel["available"])\
)\
\
actual_locked = Decimal(\
    str(after_cancel["locked"])\
)\
\
\
if abs(actual_available - expected_available) > Decimal("0.00000001"):\
    raise AssertionError(\
        f"Available balance incorrect: {actual_available}"\
    )\
\
\
if abs(actual_locked - expected_locked) > Decimal("0.00000001"):\
    raise AssertionError(\
        f"Locked balance incorrect: {actual_locked}"\
    )\
\
\
if all_orders[0]["status"] != "CANCELED":\
    raise AssertionError(\
        f"Order status incorrect: {all_orders[0]['status']}"\
    )\
\
\
print("\n⃼�� CANCEL ORDER TEST PASSED")\
print("====================================")\
PY
