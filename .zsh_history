    font-size: 12px;\
}\
\
.bottom-bar {\
    height: 56px;\
    background: #181a20;\
    border-top: 1px solid #1f2329;\
    display: flex;\
    flex-shrink: 0;\
}\
\
.nav-elem {\
    flex: 1;\
    background: transparent;\
    border: none;\
    color: #848e9c;\
    display: flex;\
    flex-direction: column;\
    align-items: center;\
    justify-content: center;\
    gap: 2px;\
    cursor: pointer;\
}\
\
.nav-elem i {\
    font-size: 16px;\
}\
\
.nav-elem span {\
    font-size: 9px;\
}\
\
.nav-elem.active, .nav-elem.active i, .nav-elem.active span {\
    color: #f0b90b;\
}\
