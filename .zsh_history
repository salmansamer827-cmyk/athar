from decimal import Decimal\
\
from backend.orders.service import OrderService\
from backend.wallet.service import WalletService\
\
wallet = WalletService()\
orders = OrderService()\
\
wallet.deposit("debug", "USDT", "60000")\
\
order = orders.create_order(\
    user_id="debug",\
    symbol="BTCUSDT",\
    side="BUY",\
    order_type="LIMIT",\
    price=Decimal("60000"),\
    quantity=Decimal("1"),\
)\
\
print("ORDER OK:", order)\
\
reservation = wallet.reserve_for_order(\
    order_id=order.order_id,\
    user_id="debug",\
    asset="USDT",\
    amount=Decimal("60000"),\
)\
\
print("RESERVATION OK:", reservation)\
PY
