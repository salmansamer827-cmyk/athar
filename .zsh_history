                    <input type="text" id="title" required placeholder="ك�ثاك�: ك�ك�ك�ة شرك�ة اك�تقك�ك�ة اك�حدك�ثة" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500">\
                </div>\
                \
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">\
                    <div>\
                        <label class="block text-sm font-medium mb-1 text-slate-300">اك�عك�ك�اك� اك�فرعك� أك� اك�تخصص</label>\
                        <input type="text" id="subtitle" required placeholder="ك�ثاك�: Branding & Guidelines" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500">\
                    </div>\
                    <div>\
                        <label class="block text-sm font-medium mb-1 text-slate-300">اك�تصك�ك�ف</label>\
                        <input type="text" id="category" required placeholder="ك�ثاك�: Brand Identity" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500">\
                    </div>\
                </div>\
\
                <div>\
                    <label class="block text-sm font-medium mb-1 text-slate-300">رابط صك�رة اك�غك�اف (URL)</label>\
                    <input type="url" id="cover_image" required placeholder="https://images.unsplash.com/..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500">\
                </div>\
\
                <div>\
                    <label class="block text-sm font-medium mb-1 text-slate-300">ك�صف اك�ك�شرك�ع</label>\
                    <textarea id="description" rows="3" required placeholder="تفاصك�ك� حك�ك� فك�سفة اك�شعار ك�تصك�ك�ك� اك�ك�ك�ك�ة..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500"></textarea>\
                </div>\
\
