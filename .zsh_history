: 1786886525:0;cd ~/capital-wise && cat > core/volume_profile/signal/engine.py <<'PY'\
from __future__ import annotations\
\
from dataclasses import dataclass\
from typing import Optional\
\
\
@dataclass(frozen=True)\
class ProfileSignalConfig:\
    min_probability: float = 0.55\
    min_adjusted_probability: float = 0.60\
    min_ev_r: float = 0.10\
\
    value_location_long: float = 0.60\
    value_location_short: float = 0.40\
\
    min_poc_velocity: float = 0.0\
    require_expansion: bool = True\
\
    max_uncertainty: float = 0.15\
\
    reward_risk: float = 3.0\
    transaction_cost_r: float = 0.05\
\
\
class VolumeProfileSignalEngine:\
    """\
    CAPITAL WISE\
    Quantitative Volume Profile Signal Engine.\
\
    Decision model:\
\
        Historical Probability\
                ⃦��\
        Adjusted Probability\
                ⃦��\
        Uncertainty Filter\
                ⃦��\
        Expected Value\
                ⃦��\
        Value Location\
                ⃦��\
        POC Velocity\
                ⃦��\
        Value Area Dynamics\
                ⃦��\
        Direction\
                ⃦��\
        Risk / Reward\
\
    No EMA / RSI / MACD / SMC.\
    """\
\
    def __init__(\
        self,\
        config: ProfileSignalConfig | None = None,\
    ):\
        self.config = (\
            config\
            if config is not None\
            else ProfileSignalConfig()\
        )\
\
        if not 0.0 < self.config.min_probability <= 1.0:\
            raise ValueError("Invalid min_probability")\
\
        if not 0.0 < self.config.min_adjusted_probability <= 1.0:\
            raise ValueError("Invalid min_adjusted_probability")\
\
        if self.config.max_uncertainty < 0.0:\
            raise ValueError("max_uncertainty must be >= 0")\
\
        if self.config.reward_risk <= 0.0:\
            raise ValueError("reward_risk must be > 0")\
\
    @staticmethod\
    def _clamp(value: float, low: float, high: float) -> float:\
        return max(low, min(high, value))\
\
    def evaluate(\
        self,\
        profile: dict,\
        dynamics: dict,\
        probability: float,\
        ev_r: float,\
        entry: float,\
        adjusted_probability: float | None = None,\
        uncertainty: float = 0.0,\
    ) -> Optional[dict]:\
\
        if entry <= 0:\
            raise ValueError("entry must be > 0")\
\
        if not 0.0 <= probability <= 1.0:\
            raise ValueError(\
                "probability must be between 0 and 1"\
            )\
\
        if adjusted_probability is None:\
            adjusted_probability = probability\
\
        if not 0.0 <= adjusted_probability <= 1.0:\
            raise ValueError(\
                "adjusted_probability must be between 0 and 1"\
            )\
\
        if not 0.0 <= uncertainty <= 1.0:\
            raise ValueError(\
                "uncertainty must be between 0 and 1"\
            )\
\
        poc = float(profile["poc"])\
        vah = float(profile["vah"])\
        val = float(profile["val"])\
\
        if not val < poc < vah:\
            raise ValueError(\
                "Invalid Value Area: expected VAL < POC < VAH"\
            )\
\
        value_location = self._clamp(\
            float(dynamics["value_location"]),\
            0.0,\
            1.0,\
        )\
\
        poc_velocity = float(\
            dynamics["poc_velocity"]\
        )\
\
        value_area_state = str(\
            dynamics["value_area_state"]\
        ).upper()\
\
        # --------------------------------------------------\
        # STATISTICAL FILTER\
        # --------------------------------------------------\
\
        if probability < self.config.min_probability:\
            return None\
\
        if adjusted_probability < self.config.min_adjusted_probability:\
            return None\
\
        if uncertainty > self.config.max_uncertainty:\
            return None\
\
        # --------------------------------------------------\
        # NET EXPECTED VALUE\
        # --------------------------------------------------\
\
        net_ev_r = (\
            adjusted_probability\
            * self.config.reward_risk\
            - (1.0 - adjusted_probability)\
            - self.config.transaction_cost_r\
        )\
\
        # Use the externally calculated EV only as an\
        # additional consistency check.\
        if ev_r <= self.config.min_ev_r:\
            return None\
\
        if net_ev_r <= self.config.min_ev_r:\
            return None\
\
        # --------------------------------------------------\
        # VALUE AREA EXPANSION FILTER\
        # --------------------------------------------------\
\
        if (\
            self.config.require_expansion\
            and value_area_state != "EXPANDING"\
        ):\
            return None\
\
        # --------------------------------------------------\
        # LONG\
        # --------------------------------------------------\
\
        if (\
            value_location >= self.config.value_location_long\
            and poc_velocity > self.config.min_poc_velocity\
        ):\
            price_risk = abs(entry - val)\
\
            if price_risk <= 0:\
                return None\
\
            stop_loss = val\
\
            take_profit = (\
                entry\
                + self.config.reward_risk * price_risk\
            )\
\
            signal_strength = self._signal_strength(\
                probability=probability,\
                adjusted_probability=adjusted_probability,\
                uncertainty=uncertainty,\
                net_ev_r=net_ev_r,\
                value_location=value_location,\
                poc_velocity=poc_velocity,\
            )\
\
            return {\
                "direction": "LONG",\
                "entry": entry,\
                "stop_loss": stop_loss,\
                "take_profit": take_profit,\
\
                "probability": probability,\
                "adjusted_probability": adjusted_probability,\
                "uncertainty": uncertainty,\
\
                "ev_r": ev_r,\
                "net_ev_r": net_ev_r,\
\
                "value_location": value_location,\
                "poc_velocity": poc_velocity,\
                "value_area_state": value_area_state,\
\
                "market_state": "VALUE_MIGRATION_UP",\
\
                "signal_strength": signal_strength,\
\
                "transaction_cost_r":\
                    self.config.transaction_cost_r,\
\
                "reward_risk":\
                    self.config.reward_risk,\
            }\
\
        # --------------------------------------------------\
        # SHORT\
        # --------------------------------------------------\
\
        if (\
            value_location <= self.config.value_location_short\
            and poc_velocity < -self.config.min_poc_velocity\
        ):\
            price_risk = abs(vah - entry)\
\
            if price_risk <= 0:\
                return None\
\
            stop_loss = vah\
\
            take_profit = (\
                entry\
                - self.config.reward_risk * price_risk\
            )\
\
            signal_strength = self._signal_strength(\
                probability=probability,\
                adjusted_probability=adjusted_probability,\
                uncertainty=uncertainty,\
                net_ev_r=net_ev_r,\
                value_location=1.0 - value_location,\
                poc_velocity=abs(poc_velocity),\
            )\
\
            return {\
                "direction": "SHORT",\
                "entry": entry,\
                "stop_loss": stop_loss,\
                "take_profit": take_profit,\
\
                "probability": probability,\
                "adjusted_probability": adjusted_probability,\
                "uncertainty": uncertainty,\
\
                "ev_r": ev_r,\
                "net_ev_r": net_ev_r,\
\
                "value_location": value_location,\
                "poc_velocity": poc_velocity,\
                "value_area_state": value_area_state,\
\
                "market_state": "VALUE_MIGRATION_DOWN",\
\
                "signal_strength": signal_strength,\
\
                "transaction_cost_r":\
                    self.config.transaction_cost_r,\
\
                "reward_risk":\
                    self.config.reward_risk,\
            }\
\
        return None\
\
    @staticmethod\
    def _signal_strength(\
        probability: float,\
        adjusted_probability: float,\
        uncertainty: float,\
        net_ev_r: float,\
        value_location: float,\
        poc_velocity: float,\
    ) -> float:\
        """\
        Normalized quantitative signal strength [0, 100].\
\
        Components:\
            35% adjusted probability\
            25% statistical certainty\
            20% expected value\
            10% value location\
            10% POC velocity\
        """\
\
        probability_score = (\
            adjusted_probability * 100.0\
        )\
\
        certainty_score = (\
            (1.0 - uncertainty) * 100.0\
        )\
\
        ev_score = min(\
            100.0,\
            max(\
                0.0,\
                (net_ev_r / 3.0) * 100.0,\
            ),\
        )\
\
        location_score = (\
            min(\
                1.0,\
                max(\
                    0.0,\
                    value_location,\
                ),\
            )\
            * 100.0\
        )\
\
        velocity_score = min(\
            100.0,\
            abs(poc_velocity) * 100.0,\
        )\
\
        score = (\
            0.35 * probability_score\
            + 0.25 * certainty_score\
            + 0.20 * ev_score\
            + 0.10 * location_score\
            + 0.10 * velocity_score\
        )\
\
        return round(\
            max(0.0, min(100.0, score)),\
            2,\
        )\
