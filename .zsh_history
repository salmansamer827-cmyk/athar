                item.innerHTML = `\
                    <div class="ticker-info">\
                        <div class="symbol">${asset}</div>\
                        <div class="name">Institutional Asset</div>\
                    </div>\
                    <div class="ticker-values">\
                        <div class="price">$${Number(randomPrice).toLocaleString()}</div>\
                        <div class="change ${isPositive ? 'positive' : 'negative'}">${isPositive ? '+' : ''}${randomChange}%</div>\
