        }\
        \
        .market-row {\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            padding: 12px 0;\
            border-bottom: 1px solid #334155;\
        }\
        .market-row:last-child { border-bottom: none; }\
        \
