                    <h3>إدارة اك�ك�حفظة ك�اك�سك�ك�ك�ة</h3>\
                </div>\
            </div>\
        </main>\
\
        <!-- اك�شرك�ط اك�سفك�ك� ك�ك�تك�قك� -->\
        <nav class="bottom-nav">\
            <div class="nav-item active" onclick="switchTab('home', this)">\
                <i class="fas fa-home"></i>\
                <span>اك�رئك�سك�ة</span>\
            </div>\
            <div class="nav-item" onclick="switchTab('trade', this)">\
                <i class="fas fa-chart-line"></i>\
                <span>اك�تداك�ك�</span>\
            </div>\
            <div class="nav-item" onclick="switchTab('positions', this); fetchActivePositions();">\
                <i class="fas fa-file-contract"></i>\
                <span>اك�عقك�د</span>\
            </div>\
            <div class="nav-item" onclick="switchTab('algo', this); fetchAlgoStatus();">\
                <i class="fas fa-robot"></i>\
                <span>اك�تداك�ك� اك�؃�ك�ك�</span>\
            </div>\
            <div class="nav-item" onclick="switchTab('wallet', this)">\
                <i class="fas fa-wallet"></i>\
                <span>اك�ك�حفظة</span>\
            </div>\
        </nav>\
    </div>\
\
    <script>\
        function switchTab(tabId, element) {\
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));\
            document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));\
            document.getElementById(tabId + '-tab').classList.add('active');\
            element.classList.add('active');\
            window.scrollTo(0, 0);\
            if (tabId === 'positions') fetchActivePositions();\
            if (tabId === 'algo') fetchAlgoStatus();\
        }\
\
        async function fetchRealBalance() {\
            try {\
                const res = await fetch('/api/balance');\
                const data = await res.json();\
                if (data.success) {\
                    document.getElementById('balanceDisplay').innerHTML = \
                        `${Number(data.total).toLocaleString()} <span style="font-size: 12px; color: var(--text-secondary);">USDT</span>`;\
                }\
            } catch (e) { console.error(e); }\
        }\
\
        async function fetchActivePositions() {\
            const container = document.getElementById('positionsContainer');\
            try {\
                const res = await fetch('/api/positions');\
                const data = await res.json();\
                if (data.success && data.positions.length > 0) {\
                    let html = '';\
                    data.positions.forEach(pos => {\
                        const pnl = parseFloat(pos.unRealizedProfit || 0);\
                        const pnlColor = pnl >= 0 ? '#0ecb81' : '#f6465d';\
                        const sideText = parseFloat(pos.positionAmt) > 0 ? 'LONG (شرا؃�)' : 'SHORT (بك�ع)';\
                        html += `<div style="background: var(--bg-card); border-radius: 12px; padding: 15px; margin-bottom: 12px; border: 1px solid var(--border-color);">\
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">\
                                <span style="font-weight: bold;">${pos.symbol}</span>\
                                <span style="color: ${pnlColor}; font-weight: bold;">${sideText}</span>\
                            </div>\
                            <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-secondary);">\
                                <span>اك�ربح/اك�خسارة: ${pnl.toFixed(2)} USDT</span>\
                            </div>\
                        </div>`;\
                    });\
                    container.innerHTML = html;\
                } else {\
                    container.innerHTML = `<div style="text-align: center; color: var(--text-secondary); margin-top: 50px;">ك�ا تك�جد عقك�د ك�فتك�حة حاك�ك�اك�.</div>`;\
                }\
            } catch (e) { container.innerHTML = `<div style="text-align: center; color: #f6465d;">فشك� اك�اتصاك�.</div>`; }\
        }\
\
        async function controlAlgo(action) {\
            try {\
                const res = await fetch('/api/algo/control', {\
                    method: 'POST',\
                    headers: { 'Content-Type': 'application/json' },\
                    body: JSON.stringify({ action })\
                });\
                const data = await res.json();\
                alert(data.message);\
                fetchAlgoStatus();\
            } catch (e) { alert('خطأ فك� اك�اتصاك� باك�خادك�'); }\
        }\
\
        async function fetchAlgoStatus() {\
            try {\
                const res = await fetch('/api/algo/status');\
                const data = await res.json();\
                const indicator = document.getElementById('algoStatusIndicator');\
                if (data.success && data.isRunning) {\
                    indicator.innerHTML = '������� اك�ك�حرك� اك�؃�ك�ك� ك�عك�ك� بك�فا؃�ة ك�حك�ك�ك�ة';\
                    indicator.style.color = '#0ecb81';\
                } else {\
                    indicator.innerHTML = '������ اك�ك�حرك� ك�تك�قف حاك�ك�اك�';\
                    indicator.style.color = '#f6465d';\
                }\
            } catch (e) { console.error(e); }\
        }\
\
        fetchRealBalance();\
        setInterval(fetchRealBalance, 10000);\
    </script>\
</body>\
</html>\
EOF\

