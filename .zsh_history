from decimal import Decimal\
\
\
class SettlementService:\
\
    def __init__(self, wallet, ledger):\
        self.wallet = wallet\
        self.ledger = ledger\
\
    def settle_trade(\
        self,\
        buyer,\
        seller,\
        price,\
        quantity,\
    ):\
        price = Decimal(str(price))\
        quantity = Decimal(str(quantity))\
\
        if price <= 0:\
            raise ValueError(\
                "Trade price must be greater than zero"\
            )\
\
        if quantity <= 0:\
            raise ValueError(\
                "Trade quantity must be greater than zero"\
            )\
\
        symbol = buyer.symbol.upper()\
\
        if not symbol.endswith("USDT"):\
            raise ValueError(\
                "Only USDT markets are supported"\
            )\
\
        base_asset = symbol[:-4]\
        quote_asset = "USDT"\
\
        quote_amount = price * quantity\
\
        # --------------------------------------------------\
        # BUYER\
        # --------------------------------------------------\
        #\
        # Buyer has USDT reserved against buyer order.\
        # Debit the actual trade cost from that reservation.\
        #\
\
        self.wallet.debit_reserved(\
            buyer.order_id,\
            quote_amount,\
        )\
\
        # Credit BTC/base asset to buyer.\
        self.wallet.credit(\
            buyer.user_id,\
            base_asset,\
            quantity,\
        )\
\
        # --------------------------------------------------\
        # SELLER\
        # --------------------------------------------------\
        #\
        # Seller has BTC reserved against seller order.\
        # Debit the delivered BTC.\
        #\
\
        self.wallet.debit_reserved(\
            seller.order_id,\
            quantity,\
        )\
\
        # Credit USDT to seller.\
        self.wallet.credit(\
            seller.user_id,\
            quote_asset,\
            quote_amount,\
        )\
\
        # --------------------------------------------------\
        # LEDGER\
        # --------------------------------------------------\
\
        trade_reference = (\
            f"TRADE:"\
            f"{buyer.order_id}:"\
            f"{seller.order_id}"\
        )\
\
