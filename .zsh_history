    <script>\
        // أسعار اك�أسك�اق اك�ك�اك�ك�ة\
        let prices = {\
            btc: 81606.01,\
            eth: 2646.23,\
            sol: 184.50,\
            bnb: 612.40,\
            xrp: 1.35,\
            exc: 1.42,\
            ada: 0.78\
        };\
        let totalAssetVal = 150.00;\
\
        // ك�حاك�اة اك�تحدك�ث اك�حك� اك�ك�ستك�ر ك�ك�افة اك�أسك�اق ك�ك� 3 ثك�اك�ك�\
        setInterval(() => {\
            prices.btc += (Math.random() - 0.48) * 15;\
            prices.eth += (Math.random() - 0.48) * 4;\
            prices.sol += (Math.random() - 0.48) * 1.5;\
            prices.bnb += (Math.random() - 0.48) * 1.2;\
            prices.xrp += (Math.random() - 0.48) * 0.05;\
            prices.exc += (Math.random() - 0.48) * 0.02;\
            prices.ada += (Math.random() - 0.48) * 0.01;\
            \
            totalAssetVal += ((prices.btc - 81606.01) * 0.00001);\
\
            // تحدك�ث ك�اجك�ة اك�رئك�سك�ة\
            let btcElem = document.getElementById('btc-price');\
            let ethElem = document.getElementById('eth-price');\
            let assetElem = document.getElementById('total-assets');\
\
            if(btcElem) btcElem.innerText = '$' + prices.btc.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
            if(ethElem) ethElem.innerText = '$' + prices.eth.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
            if(assetElem) assetElem.innerText = '$' + totalAssetVal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
\
            // تحدك�ث ك�اجك�ة ك�افة اك�أسك�اق فك� اك�قائك�ة اك�ك�ك�سعة\
            let liveBtc = document.querySelector('.price-live-btc');\
            let liveEth = document.querySelector('.price-live-eth');\
            let liveSol = document.querySelector('.price-live-sol');\
            let liveBnb = document.querySelector('.price-live-bnb');\
            let liveXrp = document.querySelector('.price-live-xrp');\
            let liveExc = document.querySelector('.price-live-exc');\
            let liveAda = document.querySelector('.price-live-ada');\
\
            if(liveBtc) liveBtc.innerText = '$' + prices.btc.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
            if(liveEth) liveEth.innerText = '$' + prices.eth.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
            if(liveSol) liveSol.innerText = '$' + prices.sol.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
            if(liveBnb) liveBnb.innerText = '$' + prices.bnb.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
            if(liveXrp) liveXrp.innerText = '$' + prices.xrp.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
            if(liveExc) liveExc.innerText = '$' + prices.exc.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
            if(liveAda) liveAda.innerText = '$' + prices.ada.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
\
        }, 3000);\
\
        // اك�تك�قك� بك�ك� اك�تبك�ك�بات\
        function switchTab(tabId) {\
            document.querySelectorAll('.tab-section').forEach(sec => sec.classList.remove('active-tab'));\
            document.querySelectorAll('nav button').forEach(btn => btn.classList.remove('active'));\
            document.querySelectorAll('.mini-bar-btn').forEach(btn => btn.classList.remove('active'));\
\
            document.getElementById(tabId).classList.add('active-tab');\
            \
            if(document.getElementById('nav-' + tabId)) {\
                document.getElementById('nav-' + tabId).classList.add('active');\
            }\
        }\
