# تحدك�ث اك�أك�ك�اط ك�اك�ـ CSS\
cat << 'EOF' > public/style.css\
* {\
    box-sizing: border-box;\
    margin: 0;\
    padding: 0;\
    font-family: 'IBM Plex Sans Arabic', sans-serif;\
}\
body {\
    background-color: #0b0e11;\
    color: #eaecef;\
    direction: rtl;\
    max-width: 480px;\
    margin: 0 auto;\
    height: 100vh;\
    overflow: hidden;\
}\
.binance-mobile-app {\
    display: flex;\
    flex-direction: column;\
    height: 100vh;\
    background: #0b0e11;\
}\
.top-nav-bar {\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    padding: 12px 16px;\
    background: #181a20;\
    border-bottom: 1px solid #1f2329;\
}\
.logo-area { display: flex; align-items: center; gap: 6px; }\
.brand-name { font-size: 16px; font-weight: 700; color: #fff; }\
.bolt-icon { color: #f0b90b; font-size: 14px; }\
.qr-profile-icons { display: flex; gap: 18px; color: #848e9c; font-size: 16px; cursor: pointer; }\
\
.ticker-tape {\
    display: flex;\
    gap: 20px;\
    padding: 8px 16px;\
    background: #12141c;\
    font-size: 11px;\
    white-space: nowrap;\
    overflow-x: auto;\
    border-bottom: 1px solid #1f2329;\
}\
.ticker-tape::-webkit-scrollbar { display: none; }\
.t-item { color: #848e9c; }\
.t-item strong.up { color: #0ecb81; font-weight: 600; margin-right: 4px; }\
\
.main-content-area {\
    flex: 1;\
    overflow-y: auto;\
    padding: 12px;\
}\
.trading-view-screen { display: flex; flex-direction: column; gap: 12px; }\
.screen-header-title {\
    background: #181a20;\
    padding: 10px 14px;\
    border-radius: 8px;\
    border: 1px solid #1f2329;\
}\
.screen-header-title h3 { font-size: 14px; color: #f0b90b; margin-bottom: 2px; }\
.screen-header-title p { font-size: 11px; color: #848e9c; }\
\
.tradingview-container-mockup {\
    background: #181a20;\
    border-radius: 8px;\
    border: 1px solid #1f2329;\
    overflow: hidden;\
}\
.tv-top-bar {\
    display: flex;\
    gap: 10px;\
    padding: 8px 12px;\
    background: #12141c;\
    align-items: center;\
    border-bottom: 1px solid #1f2329;\
}\
.pair-label { font-size: 12px; font-weight: 700; color: #fff; margin-left: auto; }\
.tf-pill { font-size: 11px; color: #848e9c; padding: 2px 8px; border-radius: 4px; background: #1f2329; cursor: pointer; }\
.tf-pill.active { background: #0052ff; color: #fff; }\
\
.tv-chart-box {\
    height: 260px;\
    position: relative;\
    padding: 12px;\
    background: #0b0e11;\
}\
.asset-details-overlay { display: flex; flex-direction: column; gap: 2px; margin-bottom: 10px; }\
.asset-details-overlay strong { font-size: 13px; color: #fff; }\
.asset-details-overlay span.up { font-size: 11px; color: #0ecb81; }\
\
.candles-graphic {\
    display: flex;\
    align-items: flex-end;\
    justify-content: space-around;\
    height: 170px;\
    padding-top: 20px;\
}\
.candle { width: 14px; border-radius: 2px; }\
.candle.green { background: #0ecb81; }\
.candle.red { background: #f6465d; }\
\
.big-action-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 5px; }\
.btn-long {\
    background: #0ecb81; color: #0b0e11; border: none; padding: 14px;\
    border-radius: 6px; font-size: 14px; font-weight: 700; cursor: pointer; text-align: center;\
}\
.btn-short {\
    background: #f6465d; color: #fff; border: none; padding: 14px;\
    border-radius: 6px; font-size: 14px; font-weight: 700; cursor: pointer; text-align: center;\
}\
\
/* تك�سك�قات اك�صفحات اك�أخرك� */\
.page-container-custom { padding: 10px; display: flex; flex-direction: column; gap: 15px; }\
.page-title { font-size: 18px; color: #fff; font-weight: 700; }\
.card-box { background: #181a20; padding: 16px; border-radius: 8px; border: 1px solid #1f2329; }\
.card-box h4 { font-size: 12px; color: #848e9c; margin-bottom: 6px; }\
.balance-num { font-size: 22px; font-weight: 700; color: #0052ff; }\
.quick-links-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; text-align: center; }\
.q-card { background: #181a20; padding: 12px; border-radius: 8px; border: 1px solid #1f2329; font-size: 11px; color: #eaecef; }\
.q-card i { font-size: 16px; color: #0052ff; margin-bottom: 6px; display: block; }\
.market-list-box, .asset-details-list { background: #181a20; border-radius: 8px; border: 1px solid #1f2329; overflow: hidden; }\
.m-row, .as-item { display: flex; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid #1f2329; font-size: 13px; }\
.m-row span.up { color: #0ecb81; }\
.m-row span.down { color: #f6465d; }\
\
/* اك�شرك�ط اك�سفك�ك� */\
.binance-bottom-nav {\
    display: flex;\
    background: #181a20;\
    border-top: 1px solid #1f2329;\
    height: 60px;\
    padding-bottom: env(safe-area-inset-bottom);\
}\
.nav-item {\
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;\
    background: transparent; border: none; color: #848e9c; gap: 4px; cursor: pointer; font-size: 11px; transition: 0.2s;\
}\
.nav-item i { font-size: 18px; }\
.nav-item span { font-size: 10px; }\
.nav-item.active, .nav-item.active i, .nav-item.active span { color: #f0b90b; }\
EOF\
\
