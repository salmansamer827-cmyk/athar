            justify-content: center;\
            gap: 8px;\
        }\
        .footer-logo {\
            width: 18px;\
            height: 18px;\
            border-radius: 4px;\
            object-fit: cover;\
            opacity: 0.8;\
        }\
\
        /* شرك�ط اك�تك�قك� اك�سفك�ك� */\
        nav {\
            display: flex;\
            justify-content: space-around;\
            background-color: #0f172a;\
            position: fixed;\
            bottom: 0;\
            left: 0;\
            right: 0;\
            border-top: 1px solid #1e293b;\
            padding: 8px 0;\
            z-index: 1000;\
        }\
        nav button {\
            background: none;\
            border: none;\
            color: #94a3b8;\
            font-size: 0.75rem;\
            display: flex;\
            flex-direction: column;\
            align-items: center;\
            gap: 4px;\
            cursor: pointer;\
            transition: color 0.2s;\
        }\
        nav button span.icon {\
