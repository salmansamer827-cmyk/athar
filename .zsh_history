            let tvSymbol = "BINANCE:" + symbolPair.replace('/', '');\
            if(symbolPair === 'XAU/USDT') tvSymbol = "OANDA:XAUUSD";\
            if(symbolPair === 'EXCORA/USDT') tvSymbol = "BINANCE:BTCUSDT"; // ك�رك�ز افتراضك� ك�دعك� اك�ك�شرك�ع\
\
            container.innerHTML = `\
                <div class="tradingview-widget-container" style="height:100%;width:100%">\
                  <div class="tradingview-widget-container__widget" style="height:100%;width:100%"></div>\
                  <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js" async>\
                  {\
                    "autosize": true,\
                    "symbol": "${tvSymbol}",\
                    "interval": "60",\
                    "timezone": "Etc/UTC",\
                    "theme": "dark",\
                    "style": "1",\
                    "locale": "ar",\
                    "enable_publishing": false,\
                    "allow_symbol_change": true,\
                    "calendar": false,\
                    "support_host": "https://www.tradingview.com"\
                  }\
                  </script>\
                </div>\
            `;\
            \
            document.getElementById('chartTitle').innerText = '������� شارت اك�تحك�ك�ك� اك�فك�ك�: ' + symbolPair;\
            document.getElementById('activeSymbolHeader').innerText = '⃺�� EXCORA : ' + symbolPair;\
        }\
\
        function selectAssetAndOpenChart(symbolPair) {\
            loadTradingViewChart(symbolPair);\
            // اك�اك�تقاك� اك�تك�قائك� ك�تبك�ك�ب اك�تداك�ك�\
            const chartTabBtn = document.getElementById('navChartBtn');\
            switchTab('chart', chartTabBtn);\
        }\
\
        document.addEventListener("DOMContentLoaded", () => {\
            renderSupportedAssets();\
            loadTradingViewChart('BTC/USDT'); // اك�شارت اك�افتراضك� عك�د اك�فتح\
        });\
\
        function switchTab(tabId, element) {\
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));\
            document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));\
            document.getElementById(tabId + '-tab').classList.add('active');\
            if(element) element.classList.add('active');\
            window.scrollTo(0, 0);\
        }\
\
        function triggerAction(type) {\
            const btn = event.target;\
            btn.style.transform = 'scale(0.92)';\
            setTimeout(() => btn.style.transform = 'scale(1)', 150);\
            alert('⃺�� تك� تك�فك�ذ أك�ر ' + type + ' بك�جاح عبر خك�ارزك�ك�ات EXCORA.');\
        }\
\
        setInterval(() => {\
            const btcEl = document.getElementById('btcTicker');\
            if(btcEl) {\
                let randomVal = (81610 + Math.random() * 15).toFixed(2);\
                btcEl.innerText = Number(randomVal).toLocaleString();\
            }\
        }, 4000);\
    </script>\
</body>\
</html>\
EOF\
