CREATE TABLE IF NOT EXISTS futures_positions (\
    id INTEGER PRIMARY KEY AUTOINCREMENT,\
    user_id TEXT NOT NULL,\
    symbol TEXT NOT NULL,\
    side TEXT NOT NULL,\
    quantity REAL NOT NULL DEFAULT 0,\
    entry_price REAL NOT NULL DEFAULT 0,\
    mark_price REAL NOT NULL DEFAULT 0,\
    leverage INTEGER NOT NULL DEFAULT 1,\
    initial_margin REAL NOT NULL DEFAULT 0,\
    maintenance_margin REAL NOT NULL DEFAULT 0,\
    unrealized_pnl REAL NOT NULL DEFAULT 0,\
    realized_pnl REAL NOT NULL DEFAULT 0,\
    liquidation_price REAL,\
    status TEXT NOT NULL DEFAULT 'OPEN',\
    created_at INTEGER NOT NULL,\
    updated_at INTEGER NOT NULL\
);\
\
CREATE INDEX IF NOT EXISTS idx_futures_positions_user\
ON futures_positions(user_id);\
\
CREATE INDEX IF NOT EXISTS idx_futures_positions_symbol\
ON futures_positions(symbol);\
\
\
CREATE TABLE IF NOT EXISTS futures_orders (\
    id INTEGER PRIMARY KEY AUTOINCREMENT,\
    user_id TEXT NOT NULL,\
    client_order_id TEXT,\
    symbol TEXT NOT NULL,\
    side TEXT NOT NULL,\
    position_side TEXT NOT NULL,\
    type TEXT NOT NULL,\
    quantity REAL NOT NULL,\
    price REAL,\
    executed_quantity REAL NOT NULL DEFAULT 0,\
    remaining_quantity REAL NOT NULL DEFAULT 0,\
    leverage INTEGER NOT NULL DEFAULT 1,\
    reduce_only INTEGER NOT NULL DEFAULT 0,\
    status TEXT NOT NULL DEFAULT 'NEW',\
    created_at INTEGER NOT NULL,\
    updated_at INTEGER NOT NULL\
);\
\
CREATE INDEX IF NOT EXISTS idx_futures_orders_user\
ON futures_orders(user_id);\
\
CREATE INDEX IF NOT EXISTS idx_futures_orders_symbol\
ON futures_orders(symbol);\
\
\
CREATE TABLE IF NOT EXISTS futures_trades (\
    id INTEGER PRIMARY KEY AUTOINCREMENT,\
    symbol TEXT NOT NULL,\
    price REAL NOT NULL,\
    quantity REAL NOT NULL,\
    buyer_order_id INTEGER,\
    seller_order_id INTEGER,\
    created_at INTEGER NOT NULL\
);\
\
\
CREATE TABLE IF NOT EXISTS futures_ledger (\
    id INTEGER PRIMARY KEY AUTOINCREMENT,\
    user_id TEXT NOT NULL,\
    asset TEXT NOT NULL,\
    amount REAL NOT NULL,\
    entry_type TEXT NOT NULL,\
    reference_id TEXT,\
    created_at INTEGER NOT NULL\
);\
\
\
CREATE TABLE IF NOT EXISTS funding_payments (\
    id INTEGER PRIMARY KEY AUTOINCREMENT,\
    user_id TEXT NOT NULL,\
    symbol TEXT NOT NULL,\
    position_side TEXT NOT NULL,\
    amount REAL NOT NULL,\
    funding_rate REAL NOT NULL,\
    mark_price REAL NOT NULL,\
    quantity REAL NOT NULL,\
    created_at INTEGER NOT NULL\
);\
\
\
CREATE TABLE IF NOT EXISTS liquidations (\
    id INTEGER PRIMARY KEY AUTOINCREMENT,\
    user_id TEXT NOT NULL,\
    symbol TEXT NOT NULL,\
    position_side TEXT NOT NULL,\
    quantity REAL NOT NULL,\
    liquidation_price REAL NOT NULL,\
    mark_price REAL NOT NULL,\
    realized_pnl REAL NOT NULL DEFAULT 0,\
    created_at INTEGER NOT NULL\
);\
""")\
\
conn.commit()\
\
