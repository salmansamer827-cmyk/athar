            overflow-x: auto;\
            white-space: nowrap;\
            font-size: 12px;\
        }\
        .ticker-mini-item {\
            display: flex;\
            gap: 6px;\
            align-items: center;\
        }\
        .container {\
            max-width: 650px;\
            margin: 15px auto;\
            padding: 0 10px;\
        }\
        .tab-content {\
            display: none;\
            animation: fadeIn 0.3s ease-in-out;\
        }\
        .tab-content.active {\
            display: block;\
        }\
        @keyframes fadeIn {\
            from { opacity: 0; transform: translateY(5px); }\
            to { opacity: 1; transform: translateY(0); }\
        }\
        .card {\
            background-color: var(--card-bg);\
            border: 1px solid var(--border-color);\
            border-radius: 10px;\
            padding: 15px;\
            margin-bottom: 15px;\
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);\
            position: relative;\
            overflow: hidden;\
        }\
        .card:hover {\
            border-color: rgba(240, 185, 11, 0.4);\
            transform: translateY(-2px);\
        }\
        .card::before {\
            content: '';\
            position: absolute;\
            top: 0; right: 0; width: 4px; height: 100%;\
            background: var(--accent-color);\
        }\
        .section-title {\
            color: var(--accent-color);\
            font-size: 14px;\
            font-weight: bold;\
            margin-bottom: 4px;\
            display: flex;\
            align-items: center;\
            gap: 8px;\
        }\
        .section-desc {\
            color: var(--text-secondary);\
            font-size: 11px;\
            margin-bottom: 12px;\
        }\
        .ticker-list {\
            display: flex;\
            flex-direction: column;\
            gap: 8px;\
        }\
        .ticker-item {\
            background-color: rgba(255, 255, 255, 0.02);\
            border: 1px solid var(--border-color);\
            border-radius: 8px;\
