        .logo-area {\
            display: flex;\
            align-items: center;\
            gap: 10px;\
        }\
        .brand-logo {\
            height: 32px;\
            width: auto;\
            object-fit: contain;\
            border-radius: 4px;\
        }\
        .market-ticker-bar {\
            background-color: #161a1e;\
            border-bottom: 1px solid var(--border-color);\
            padding: 8px 15px;\
            display: flex;\
            gap: 20px;\
            overflow-x: auto;\
            white-space: nowrap;\
            font-size: 12px;\
        }\
        .ticker-mini-item {\
            display: flex;\
            gap: 6px;\
            align-items: center;\
        }\
        .container {\
            max-width: 650px;\
            margin: 15px auto;\
            padding: 0 10px;\
        }\
        .tab-content {\
            display: none;\
            animation: fadeIn 0.3s ease-in-out;\
        }\
        .tab-content.active {\
            display: block;\
        }\
        @keyframes fadeIn {\
            from { opacity: 0; transform: translateY(5px); }\
            to { opacity: 1; transform: translateY(0); }\
        }\
        .card {\
            background-color: var(--card-bg);\
            border: 1px solid var(--border-color);\
            border-radius: 10px;\
            padding: 15px;\
            margin-bottom: 15px;\
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);\
            position: relative;\
            overflow: hidden;\
        }\
        .card:hover {\
            border-color: rgba(240, 185, 11, 0.4);\
            transform: translateY(-2px);\
        }\
        .card::before {\
            content: '';\
            position: absolute;\
            top: 0; right: 0; width: 4px; height: 100%;\
            background: var(--accent-color);\
        }\
        .section-title {\
            color: var(--accent-color);\
            font-size: 14px;\
            font-weight: bold;\
            margin-bottom: 4px;\
            display: flex;\
            align-items: center;\
            gap: 8px;\
        }\
        .section-desc {\
            color: var(--text-secondary);\
            font-size: 11px;\
            margin-bottom: 12px;\
        }\
        .ticker-list {\
            display: flex;\
            flex-direction: column;\
            gap: 8px;\
            max-height: 400px;\
            overflow-y: auto;\
        }\
        .ticker-item {\
            background-color: rgba(255, 255, 255, 0.02);\
            border: 1px solid var(--border-color);\
            border-radius: 8px;\
            padding: 12px;\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            cursor: pointer;\
        }\
        .ticker-item:hover {\
            background-color: var(--card-hover);\
            border-color: var(--accent-color);\
        }\
        .ticker-info .symbol {\
            font-weight: bold;\
            font-size: 13px;\
            color: var(--text-main);\
        }\
        .ticker-info .name {\
            font-size: 10px;\
            color: var(--text-secondary);\
        }\
        .ticker-values {\
            text-align: left;\
        }\
        .ticker-values .price {\
            font-weight: bold;\
            font-size: 13px;\
            color: var(--text-main);\
        }\
        .ticker-values .change {\
            font-size: 11px;\
            font-weight: 600;\
            padding: 2px 6px;\
            border-radius: 4px;\
        }\
        .change.positive { background-color: rgba(14, 203, 129, 0.15); color: var(--green); }\
        .change.negative { background-color: rgba(246, 70, 93, 0.15); color: var(--red); }\
\
        .tradingview-container {\
            width: 100%;\
            height: 380px;\
            background-color: var(--bg-color);\
            border-radius: 8px;\
            overflow: hidden;\
            border: 1px solid var(--border-color);\
        }\
\
        .trade-actions {\
            display: grid;\
            grid-template-columns: 1fr 1fr;\
            gap: 10px;\
            margin-top: 12px;\
        }\
        .btn-trade {\
            padding: 12px;\
            font-weight: bold;\
            border-radius: 8px;\
            border: none;\
            cursor: pointer;\
            font-size: 13px;\
            text-align: center;\
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);\
        }\
        .btn-buy { background-color: var(--green); color: #000; }\
        .btn-sell { background-color: var(--red); color: #fff; }\
        .btn-trade:active { transform: scale(0.96); }\
\
        .bottom-nav {\
            position: fixed;\
            bottom: 0;\
            left: 0;\
            right: 0;\
            background-color: #161a1e;\
            border-top: 1px solid var(--border-color);\
            display: flex;\
            justify-content: space-around;\
            padding: 10px 0;\
            z-index: 99999;\
            box-shadow: 0 -4px 20px rgba(0,0,0,0.6);\
        }\
        .nav-item {\
            display: flex;\
            flex-direction: column;\
            align-items: center;\
            color: var(--text-secondary);\
            font-size: 11px;\
            text-decoration: none;\
            cursor: pointer;\
            background: none;\
            border: none;\
            flex: 1;\
            padding: 4px;\
            border-radius: 8px;\
        }\
        .nav-item.active {\
            color: var(--accent-color);\
            background-color: rgba(240, 185, 11, 0.08);\
        }\
        .nav-item span.icon {\
            font-size: 18px;\
            margin-bottom: 2px;\
        }\
    </style>\
</head>\
<body>\
\
    <header>\
        <div class="logo-area">\
            <img src="logo.png" alt="EXCORA Logo" class="brand-logo">\
        </div>\
        <div style="font-size: 12px; color: var(--text-secondary);">⃺�� EXCORA</div>\
