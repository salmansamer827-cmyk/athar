\
/* =========================\
   MARKET CHART\
========================= */\
\
.chart-panel {\
  margin-top: 14px;\
  padding: 16px;\
\
  background:\
    linear-gradient(\
      145deg,\
      rgba(7, 16, 29, 0.99),\
      rgba(4, 10, 19, 0.99)\
    );\
\
  border: 1px solid var(--border);\
  border-radius: var(--radius);\
\
  box-shadow:\
    0 12px 40px rgba(0, 0, 0, 0.28);\
\
  overflow: hidden;\
}\
\
.chart-header {\
  display: flex;\
  align-items: center;\
  justify-content: space-between;\
\
  gap: 16px;\
\
  margin-bottom: 12px;\
\
  padding: 10px 12px;\
\
  background: rgba(8, 18, 32, 0.85);\
\
  border: 1px solid rgba(22, 52, 90, 0.7);\
\
  border-radius: 9px;\
}\
\
.chart-header strong {\
  display: inline-block;\
\
  color: #eaf6ff;\
\
  font-size: 18px;\
  font-weight: 900;\
}\
\
.chart-header span {\
  margin-left: 10px;\
\
  color: var(--text-muted);\
\
  font-size: 12px;\
  font-weight: 800;\
\
  text-transform: uppercase;\
}\
\
.chart-stats {\
  display: flex;\
\
  flex-wrap: wrap;\
\
  justify-content: flex-end;\
\
  gap: 8px;\
}\
\
.chart-stats span {\
  margin: 0;\
\
  padding: 5px 8px;\
\
  color: #bcdcff;\
\
  background: rgba(22, 140, 255, 0.08);\
\
  border: 1px solid rgba(22, 140, 255, 0.2);\
\
  border-radius: 6px;\
\
  font-size: 11px;\
  font-weight: 800;\
}\
\
.chart-container {\
  position: relative;\
\
  width: 100%;\
\
  min-height: 280px;\
\
  overflow: hidden;\
\
  background:\
    linear-gradient(\
      180deg,\
      #050b14 0%,\
      #03070d 100%\
    );\
\
  border: 1px solid rgba(22, 52, 90, 0.8);\
\
  border-radius: 9px;\
}\
\
.market-chart {\
  display: block;\
\
  width: 100%;\
\
  height: auto;\
\
  min-height: 280px;\
\
  background: #03070d;\
}\
\
.chart-background {\
  fill: #03070d;\
}\
\
.chart-grid {\
  stroke: rgba(80, 130, 180, 0.16);\
\
  stroke-width: 1;\
\
  vector-effect: non-scaling-stroke;\
}\
\
.candle-wick {\
  stroke-width: 1.2;\
\
  vector-effect: non-scaling-stroke;\
}\
\
.candle-wick.bullish {\
  stroke: var(--success);\
}\
\
.candle-wick.bearish {\
  stroke: var(--danger);\
}\
\
.candle-body {\
  stroke-width: 1;\
\
  vector-effect: non-scaling-stroke;\
}\
\
.candle-body.bullish {\
  fill: var(--success);\
  stroke: var(--success);\
}\
\
.candle-body.bearish {\
  fill: var(--danger);\
  stroke: var(--danger);\
}\
\
.volume-bar {\
  opacity: 0.55;\
}\
\
.volume-bar.bullish {\
  fill: var(--success);\
}\
\
.volume-bar.bearish {\
  fill: var(--danger);\
}\
\
.value-area-line {\
  stroke-width: 1.5;\
\
  stroke-dasharray: 7 5;\
\
  vector-effect: non-scaling-stroke;\
}\
\
.value-area-line.poc {\
  stroke: #ffffff;\
\
  stroke-width: 2;\
}\
\
.value-area-line.vah {\
  stroke: var(--warning);\
}\
\
.value-area-line.val {\
  stroke: var(--blue-bright);\
}\
\
.chart-price-label {\
  position: absolute;\
\
  right: 6px;\
\
  padding: 3px 6px;\
\
  border-radius: 4px;\
\
  font-size: 10px;\
  font-weight: 900;\
\
  pointer-events: none;\
\
  background: rgba(3, 9, 17, 0.9);\
\
  border: 1px solid rgba(100, 150, 200, 0.2);\
\
  backdrop-filter: blur(4px);\
}\
\
.poc-label {\
  top: 45%;\
  color: #ffffff;\
}\
\
.vah-label {\
  top: 20%;\
  color: var(--warning);\
}\
\
.val-label {\
  top: 70%;\
  color: var(--blue-bright);\
}\
\
.chart-loading,\
.chart-error {\
  min-height: 280px;\
\
  display: grid;\
\
  place-items: center;\
\
  padding: 30px;\
\
  text-align: center;\
\
  color: var(--text-muted);\
\
  background: #03070d;\
\
  border: 1px solid rgba(22, 52, 90, 0.8);\
\
  border-radius: 9px;\
}\
\
.chart-error {\
  color: #ffb9c3;\
\
  border-color: rgba(255, 93, 115, 0.35);\
\
  background: rgba(255, 55, 82, 0.06);\
}\
\
.chart-footer {\
  display: flex;\
\
  align-items: center;\
\
  justify-content: space-between;\
\
  gap: 12px;\
\
  margin-top: 8px;\
\
  padding: 7px 4px 0;\
\
  color: var(--text-muted);\
\
  font-size: 10px;\
  font-weight: 700;\
}\
\
/* =========================\
   CHART RESPONSIVE\
========================= */\
\
@media (max-width: 700px) {\
  .chart-panel {\
    padding: 10px;\
  }\
\
  .chart-header {\
    align-items: flex-start;\
\
    flex-direction: column;\
\
    gap: 8px;\
  }\
\
  .chart-stats {\
    width: 100%;\
\
    justify-content: flex-start;\
  }\
\
  .chart-container {\
    min-height: 250px;\
  }\
\
  .market-chart {\
    min-height: 250px;\
  }\
\
  .chart-footer {\
    font-size: 9px;\
  }\
}\
\
EOF
