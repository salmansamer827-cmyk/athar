: 1786852722:0;cat > src/App.tsx <<'EOF'\
import { useState } from "react";\
import { analyzeQuant } from "./api/client";\
import type { QuantResponse } from "./types/quant";\
import "./index.css";\
\
function App() {\
  const [data, setData] = useState<QuantResponse | null>(null);\
  const [loading, setLoading] = useState(false);\
  const [error, setError] = useState("");\
\
  async function runAnalysis() {\
    setLoading(true);\
    setError("");\
\
    try {\
      const result = await analyzeQuant({\
        symbol: "BTC/USDT",\
        market: "CRYPTO",\
        timeframe: "15m",\
        capital: 100,\
        limit: 200,\
        tick_size: 0.01,\
        wins: 72,\
        losses: 28,\
      });\
\
      setData(result);\
    } catch (err) {\
      console.error(err);\
      setError(\
        "Unable to connect to CAPITAL WISE Quant API"\
      );\
    } finally {\
      setLoading(false);\
    }\
  }\
\
  const signal = data?.signal;\
  const risk = data?.risk;\
\
  return (\
    <main className="app">\
\
      <header className="topbar">\
        <div>\
          <div className="brand">\
            CAPITAL WISE\
          </div>\
\
          <div className="subtitle">\
            Quantitative Trading Analytics\
          </div>\
        </div>\
\
        <button\
          onClick={runAnalysis}\
          disabled={loading}\
        >\
          {loading\
            ? "ANALYZING..."\
            : "RUN LIVE ANALYSIS"}\
        </button>\
      </header>\
\
      {error && (\
        <div className="error">\
          {error}\
        </div>\
      )}\
\
      {!data && !loading && (\
        <section className="welcome">\
          <h1>\
            Quantitative Market Intelligence\
          </h1>\
\
          <p>\
            Analyze live Binance market data using\
            the CAPITAL WISE quantitative engine.\
          </p>\
\
          <button onClick={runAnalysis}>\
            START LIVE ANALYSIS\
          </button>\
        </section>\
      )}\
\
      {data && (\
        <>\
\
          {/* MARKET HEADER */}\
\
          <section className="market-header">\
\
            <div>\
              <span className="label">\
                SYMBOL\
              </span>\
\
              <strong>\
                {data.symbol}\
              </strong>\
            </div>\
\
            <div>\
              <span className="label">\
                MARKET\
              </span>\
\
              <strong>\
                {data.market}\
              </strong>\
            </div>\
\
            <div>\
              <span className="label">\
                TIMEFRAME\
              </span>\
\
              <strong>\
                {data.timeframe}\
              </strong>\
            </div>\
\
            <div>\
              <span className="label">\
                DATA SOURCE\
              </span>\
\
              <strong>\
                {data.data_source ?? "BINANCE"}\
              </strong>\
            </div>\
\
            <div>\
              <span className="label">\
                LAST PRICE\
              </span>\
\
              <strong>\
                {format(data.last_price)}\
              </strong>\
            </div>\
\
          </section>\
\
\
          {/* QUANT METRICS */}\
\
          <section className="grid">\
\
            <Card\
              title="PROBABILITY"\
              value={`${(\
                data.probability.probability * 100\
              ).toFixed(1)}%`}\
              detail={`${data.probability.wins} wins / ${data.probability.losses} losses`}\
            />\
\
            <Card\
              title="EXPECTED VALUE"\
              value={`${data.expected_value_r.toFixed(2)}R`}\
              detail="Statistical expectancy"\
            />\
\
            <Card\
              title="CONFIDENCE"\
              value={`${(\
                data.state.confidence * 100\
              ).toFixed(1)}%`}\
              detail={data.state.state}\
            />\
\
            <Card\
              title="POC"\
              value={format(data.profile.poc)}\
              detail={`VA ${format(\
                data.profile.val\
              )} ⃦�� ${format(data.profile.vah)}`}\
            />\
\
          </section>\
\
\
          {/* DATA QUALITY */}\
\
          <section className="panel">\
\
            <h2>\
              LIVE MARKET DATA\
            </h2>\
\
            <div className="profile-grid">\
\
              <Metric\
                label="STATUS"\
                value={data.status}\
              />\
\
              <Metric\
                label="SOURCE"\
                value={data.data_source}\
              />\
\
              <Metric\
                label="CANDLES"\
                value={data.candles_count}\
              />\
\
              <Metric\
                label="VOLUME"\
                value={format(data.volume_sum)}\
              />\
\
              <Metric\
                label="LAST PRICE"\
                value={format(data.last_price)}\
              />\
\
            </div>\
\
          </section>\
\
\
          {/* TRADE DECISION */}\
\
          <section className="panel">\
\
            <h2>\
              TRADE DECISION\
            </h2>\
\
            {signal || risk ? (\
\
              <div className="trade-grid">\
\
                <Metric\
                  label="STATUS"\
                  value={\
                    risk?.status ??\
                    signal?.status ??\
                    "N/A"\
                  }\
                />\
\
                <Metric\
                  label="DIRECTION"\
                  value={\
                    risk?.direction ??\
                    signal?.direction ??\
                    "N/A"\
                  }\
                />\
\
                <Metric\
                  label="ENTRY"\
                  value={format(\
                    risk?.entry ??\
                    signal?.entry\
                  )}\
                />\
\
                <Metric\
                  label="STOP LOSS"\
                  value={format(\
                    risk?.stop_loss ??\
                    signal?.stop_loss\
                  )}\
                />\
\
                <Metric\
                  label="TAKE PROFIT"\
                  value={format(\
                    risk?.take_profit ??\
                    signal?.take_profit\
                  )}\
                />\
\
                <Metric\
                  label="PROBABILITY"\
                  value={\
                    risk?.probability !== undefined\
                      ? `${(\
                          risk.probability * 100\
                        ).toFixed(2)}%`\
                      : "N/A"\
                  }\
                />\
\
                <Metric\
                  label="RISK AMOUNT"\
                  value={format(\
                    risk?.risk_amount\
                  )}\
                />\
\
                <Metric\
                  label="POSITION SIZE"\
                  value={format(\
                    risk?.position_size\
                  )}\
                />\
\
                <Metric\
                  label="NOTIONAL"\
                  value={format(\
                    risk?.notional\
                  )}\
                />\
\
                <Metric\
                  label="RR"\
                  value={format(\
                    risk?.reward_risk\
                  )}\
                />\
\
              </div>\
\
            ) : (\
\
              <div className="neutral">\
                No trade decision returned.\
              </div>\
\
            )}\
\
          </section>\
\
\
          {/* VOLUME PROFILE */}\
\
          <section className="panel">\
\
            <h2>\
              VOLUME PROFILE\
            </h2>\
\
            <div className="profile-grid">\
\
              <Metric\
                label="POC"\
                value={format(\
                  data.profile.poc\
                )}\
              />\
\
              <Metric\
                label="VAH"\
                value={format(\
                  data.profile.vah\
                )}\
              />\
\
              <Metric\
                label="VAL"\
                value={format(\
                  data.profile.val\
                )}\
              />\
\
              <Metric\
                label="TOTAL VOLUME"\
                value={format(\
                  data.profile.total_volume\
                )}\
              />\
\
              <Metric\
                label="WEIGHTED MEAN"\
                value={format(\
                  data.profile.weighted_mean\
                )}\
              />\
\
              <Metric\
                label="STD"\
                value={format(\
                  data.profile.std\
                )}\
              />\
\
            </div>\
\
          </section>\
\
\
          {/* MARKET DYNAMICS */}\
\
          <section className="panel">\
\
            <h2>\
              MARKET DYNAMICS\
            </h2>\
\
            <div className="profile-grid">\
\
              <Metric\
                label="POC DIRECTION"\
                value={\
                  data.dynamics.poc_direction\
                }\
              />\
\
              <Metric\
                label="VALUE AREA"\
                value={\
                  data.dynamics.value_area_state\
                }\
              />\
\
              <Metric\
                label="BALANCE SCORE"\
                value={`${(\
                  data.state.balance_score * 100\
                ).toFixed(2)}%`}\
              />\
\
              <Metric\
                label="MIGRATION SCORE"\
                value={`${(\
                  data.state.migration_score * 100\
                ).toFixed(2)}%`}\
              />\
\
              <Metric\
                label="EXPANSION SCORE"\
                value={`${(\
                  data.state.expansion_score * 100\
                ).toFixed(2)}%`}\
              />\
\
              <Metric\
                label="CONCENTRATION"\
                value={`${(\
                  data.state.concentration_score * 100\
                ).toFixed(2)}%`}\
              />\
\
            </div>\
\
          </section>\
\
        </>\
      )}\
\
    </main>\
  );\
}\
\
\
function Card({\
  title,\
  value,\
  detail,\
}: {\
  title: string;\
  value: string;\
  detail: string;\
}) {\
  return (\
    <div className="card">\
      <span className="label">\
        {title}\
      </span>\
\
      <strong>\
        {value}\
      </strong>\
\
      <small>\
        {detail}\
      </small>\
    </div>\
  );\
}\
\
\
function Metric({\
  label,\
  value,\
}: {\
  label: string;\
  value: string | number | undefined;\
}) {\
  return (\
    <div className="metric">\
      <span>\
        {label}\
      </span>\
\
      <strong>\
        {value ?? "N/A"}\
      </strong>\
    </div>\
  );\
}\
\
\
function format(\
  value: number | undefined\
) {\
  if (\
    value === undefined ||\
    value === null ||\
    !Number.isFinite(value)\
  ) {\
    return "N/A";\
  }\
\
  return Number(value).toFixed(4);\
}\
\
\
export default App;\
EOF
