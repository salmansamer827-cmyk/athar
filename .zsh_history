print("Entropy:", result.profile.entropy)\
print("Concentration:", result.profile.volume_concentration)\
\
print("\n[DYNAMICS]")\
print("POC Velocity:", result.dynamics.poc_velocity)\
print("POC Direction:", result.dynamics.poc_direction)\
print("VA State:", result.dynamics.value_area_state)\
print("Value Location:", result.dynamics.value_location)\
\
print("\n[STATE]")\
print("State:", result.state.state)\
print("Confidence:", result.state.confidence)\
\
print("\n[PROBABILITY]")\
print("Raw:", result.raw_probability)\
print("Adjusted:", result.adjusted_probability)\
print("Uncertainty:", result.probability_uncertainty)\
print("Wilson Lower:", result.probability.lower_bound)\
print("Wilson Upper:", result.probability.upper_bound)\
\
print("\n[EXPECTED VALUE]")\
print("EV:", result.expected_value_r)\
print("Conservative EV:",\
