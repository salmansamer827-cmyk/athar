from decimal import Decimal, InvalidOperation\
\
from fastapi import FastAPI, HTTPException\
from pydantic import BaseModel\
\
from backend.wallet.service import WalletService\
from backend.ledger.service import LedgerService\
from backend.orders.service import OrderService\
from backend.exchange.matching_engine import MatchingEngine\
from backend.exchange.settlement import SettlementService\
\
\
app = FastAPI(\
    title="EXCORA Broker API",\
    version="2.1.0",\
    description="EXCORA Spot Trading Broker API",\
)\
\
\
wallet_service = WalletService()\
ledger_service = LedgerService()\
order_service = OrderService()\
matching_engine = MatchingEngine()\
\
settlement_service = SettlementService(\
    wallet_service,\
    ledger_service,\
)\
\
\
class DepositRequest(BaseModel):\
    user_id: str\
    asset: str\
    amount: str\
\
\
class OrderRequest(BaseModel):\
    user_id: str\
    symbol: str\
    side: str\
    order_type: str\
    price: str\
    quantity: str\
\
\
def parse_decimal(value, field):\
    try:\
        result = Decimal(str(value))\
    except (InvalidOperation, ValueError):\
        raise HTTPException(\
            status_code=400,\
            detail=f"Invalid {field}",\
        )\
\
    if not result.is_finite():\
        raise HTTPException(\
            status_code=400,\
            detail=f"Invalid {field}",\
        )\
\
    return result\
\
\
def split_symbol(symbol):\
    symbol = symbol.upper()\
\
    if not symbol.endswith("USDT"):\
        raise ValueError(\
            "Only USDT markets are currently supported"\
        )\
\
    base = symbol[:-4]\
\
    if not base:\
        raise ValueError("Invalid symbol")\
\
    return base, "USDT"\
\
\
@app.get("/health")\
def health():\
    return {\
        "status": "healthy",\
        "service": "EXCORA Broker",\
        "version": "2.1.0",\
    }\
\
\
@app.get("/markets")\
def markets():\
    return {\
        "markets": [\
            {\
                "symbol": "BTCUSDT",\
                "base": "BTC",\
                "quote": "USDT",\
                "type": "spot",\
                "status": "TRADING",\
            },\
            {\
                "symbol": "ETHUSDT",\
                "base": "ETH",\
                "quote": "USDT",\
                "type": "spot",\
                "status": "TRADING",\
            },\
            {\
                "symbol": "SOLUSDT",\
                "base": "SOL",\
                "quote": "USDT",\
                "type": "spot",\
                "status": "TRADING",\
            },\
        ]\
    }\
\
\
@app.post("/wallet/deposit")\
def deposit(request: DepositRequest):\
\
    amount = parse_decimal(\
        request.amount,\
        "amount",\
    )\
\
    if amount <= 0:\
        raise HTTPException(\
            status_code=400,\
            detail="Amount must be greater than zero",\
        )\
\
    asset = request.asset.upper()\
\
    try:\
        balance = wallet_service.deposit(\
            request.user_id,\
            asset,\
            amount,\
        )\
\
        ledger_service.record(\
            user_id=request.user_id,\
            asset=asset,\
            amount=amount,\
            entry_type="DEPOSIT",\
            reference="manual-deposit",\
        )\
\
        return {\
            "status": "success",\
            "balance": balance,\
        }\
\
    except ValueError as exc:\
        raise HTTPException(\
            status_code=400,\
            detail=str(exc),\
        )\
\
\
