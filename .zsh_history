from fastapi import FastAPI\
from fastapi.middleware.cors import CORSMiddleware\
import subprocess\
import json\
\
app = FastAPI()\
\
# اك�سك�اح ك�ك�اتصاك�ات اك�خارجك�ة ك�ك� أك� ك�طاق (ك�ثك� ك�اجك�ة Firebase)\
app.add_middleware(\
    CORSMiddleware,\
    allow_origins=["*"],\
    allow_credentials=True,\
    allow_methods=["*"],\
    allow_headers=["*"],\
)\
\
@app.get("/api/analysis")\
def run_analysis_script():\
    try:\
        # تشغك�ك� ك�ك�ف اك�تحك�ك�ك� excora_pro.py ك�جك�ب ك�خرجاتك�\
        process = subprocess.run(\
            ["python", "excora_pro.py"], \
            capture_output=True, \
            text=True, \
            check=True\
        )\
        \
        # ك�حاك�ك�ة تحك�ك�ك� اك�ك�خرجات ك�ـ JSON إذا ك�اك�ت ك�ذك�ك�\
        try:\
            output_data = json.loads(process.stdout)\
        except json.JSONDecodeError:\
            output_data = {"result": process.stdout}\
            \
        return {\
            "status": "success",\
            "analysis": output_data\
        }\
    except subprocess.CalledProcessError as e:\
        return {\
            "status": "error",\
            "message": e.stderr\
        }\
    except Exception as e:\
        return {\
            "status": "error",\
            "message": str(e)\
        }\
EOF
