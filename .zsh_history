import excora_pro\
\
def test(side, entry, stop):\
    risk_distance = abs(entry - stop)\
\
    if side == "LONG":\
        sl = entry - risk_distance\
        tp = entry + (risk_distance * excora_pro.REWARD_RATIO)\
    else:\
        sl = entry + risk_distance\
        tp = entry - (risk_distance * excora_pro.REWARD_RATIO)\
\
    print(\
        side,\
        "| Entry =", entry,\
        "| SL =", sl,\
        "| TP =", tp,\
        "| RR =", round(abs(tp-entry) / abs(entry-sl), 2)\
    )\
\
test("LONG", 100000, 99000)\
test("SHORT", 100000, 101000)\
