from pathlib import Path\
\
p = Path("core/pipeline/quant_pipeline.py")\
text = p.read_text()\
\
old = '''        return QuantPipelineResult(\
            symbol=symbol,\
            market=market,\
            timeframe=timeframe,\
\
            profile=profile,\
            dynamics=dynamics,\
            state=state,\
\
            probability=probability,\
            expected_value_r=(\
                expected_value_r\
            ),\
\
            signal=signal,\
            risk=risk,\
        )\
'''\
\
new = '''        return QuantPipelineResult(\
            symbol=symbol,\
            market=market,\
            timeframe=timeframe,\
\
            profile=profile,\
            dynamics=dynamics,\
            state=state,\
\
            # --------------------------------------------------\
            # Statistical probability layer\
            # --------------------------------------------------\
            probability=probability,\
\
            raw_probability=raw_probability,\
\
            adjusted_probability=(\
                adjusted_probability\
            ),\
\
            probability_uncertainty=(\
                probability_uncertainty\
            ),\
\
            # --------------------------------------------------\
            # Expected value layer\
            # --------------------------------------------------\
            expected_value_r=(\
                expected_value_r\
            ),\
\
            conservative_expected_value_r=(\
                conservative_expected_value_r\
            ),\
\
            # --------------------------------------------------\
            # Decision layer\
            # --------------------------------------------------\
            signal=signal,\
            risk=risk,\
        )\
'''\
\
if old not in text:\
    raise SystemExit(\
        "QuantPipelineResult return block not found. "\
        "No changes made."\
    )\
\
text = text.replace(old, new, 1)\
\
p.write_text(text)\
\
print("UPDATED:", p)\
