from pathlib import Path\
\
p = Path("core/volume_profile/signal/engine.py")\
text = p.read_text()\
\
old = '''        probability_base = max(\
            1e-12,\
            1.0 - self.config.min_adjusted_probability,\
        )\
\
        probability_strength = max(\
            0.0,\
            min(\
                1.0,\
                (\
                    effective_probability\
                    - self.config.min_adjusted_probability\
                )\
                / probability_base,\
            ),\
        )\
'''\
\
new = '''        # ------------------------------------------------------\
        # Probability normalization\
        #\
        # Maps effective probability into [0, 1]\
        # relative to the minimum admissible probability.\
        #\
        # The normalization is intentionally nonlinear:\
        # higher probabilities receive progressively more weight.\
        # ------------------------------------------------------\
\
        probability_floor = (\
            self.config.min_adjusted_probability\
        )\
\
        probability_base = max(\
            1e-12,\
            1.0 - probability_floor,\
        )\
\
        probability_ratio = max(\
            0.0,\
            min(\
                1.0,\
                (\
                    effective_probability\
                    - probability_floor\
                )\
                / probability_base,\
            ),\
        )\
\
        probability_strength = (\
            probability_ratio ** 0.50\
        )\
'''\
\
if old not in text:\
    raise SystemExit(\
        "Probability normalization block not found. "\
        "No changes made."\
    )\
\
text = text.replace(old, new, 1)\
\
# Improve EV normalization\
old_ev = '''        ev_strength = max(\
            0.0,\
            min(\
                1.0,\
                conservative_ev\
                / max(\
                    self.config.reward_risk,\
                    1e-12,\
                ),\
            ),\
        )\
'''\
\
new_ev = '''        # ------------------------------------------------------\
        # Expected-value normalization\
        #\
        # EV is normalized against the maximum theoretical\
        # reward and compressed with sqrt so strong positive\
        # expectancy receives meaningful quantitative weight\
        # without allowing EV alone to dominate the model.\
        # ------------------------------------------------------\
\
        ev_ratio = (\
            conservative_ev\
            / max(\
                self.config.reward_risk,\
                1e-12,\
            )\
        )\
\
        ev_strength = max(\
            0.0,\
            min(\
                1.0,\
                ev_ratio,\
            ),\
        )\
\
        ev_strength = (\
            ev_strength ** 0.50\
        )\
'''\
\
if old_ev not in text:\
    raise SystemExit(\
        "EV normalization block not found. "\
        "No changes made."\
    )\
\
text = text.replace(old_ev, new_ev, 1)\
\
p.write_text(text)\
\
print("UPDATED QUANTITATIVE NORMALIZATION:", p)\
