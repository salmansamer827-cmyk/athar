async function apiRequest(path, options = {}) {\
    const config = {\
        ...options,\
        headers: {\
            "Content-Type": "application/json",\
            ...(options.headers || {})\
        }\
    };\
\
    const response = await fetch(EXCORA_API + path, config);\
