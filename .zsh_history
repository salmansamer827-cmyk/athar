from decimal import Decimal\
\
from backend.database.db import init_db, get_connection\
from backend.services.wallet_service import WalletService\
from backend.services.order_service import OrderService\
from backend.services.execution_service import ExecutionService\
\
\
init_db()\
\
BUYER1 = "partial_full_buyer1"\
BUYER2 = "partial_full_buyer2"\
SELLER = "partial_full_seller"\
\
SYMBOL = "BTC/USDT"\
PRICE = Decimal("68000")\
\
SELL_QTY = Decimal("0.001")\
BUY1_QTY = Decimal("0.0004")\
BUY2_QTY = Decimal("0.0006")\
\
wallet = WalletService()\
orders = OrderService()\
execution = ExecutionService()\
\
\
print("====================================")\
print(" EXCORA PARTIAL -> FULL TEST")\
print("====================================")\
\
\
# ============================================================\
# CLEAN\
# ============================================================\
\
users = (BUYER1, BUYER2, SELLER)\
\
conn = get_connection()\
\
try:\
    conn.execute("BEGIN")\
\
    for user in users:\
        conn.execute(\
            "DELETE FROM ledger_entries WHERE user_id = ?",\
            (user,)\
        )\
\
    conn.execute(\
        """\
        DELETE FROM trades\
        WHERE buyer_user_id IN (?, ?, ?)\
           OR seller_user_id IN (?, ?, ?)\
        """,\
        users + users\
    )\
\
    for user in users:\
        conn.execute(\
            "DELETE FROM orders WHERE user_id = ?",\
            (user,)\
        )\
\
        conn.execute(\
            "DELETE FROM wallets WHERE user_id = ?",\
            (user,)\
        )\
\
    conn.commit()\
\
finally:\
    conn.close()\
\
\
# ============================================================\
# FUND\
# ============================================================\
\
print("\n[1] Funding users")\
\
wallet.deposit(\
    BUYER1,\
    "USDT",\
    Decimal("100")\
)\
\
wallet.deposit(\
    BUYER2,\
    "USDT",\
    Decimal("100")\
)\
\
wallet.deposit(\
    SELLER,\
    "BTC",\
    SELL_QTY\
)\
\
\
# ============================================================\
# SELLER ORDER\
# ============================================================\
\
print("\n[2] SELLER creates 0.001 BTC SELL")\
\
sell_order = orders.create_limit_order(\
    user_id=SELLER,\
    symbol=SYMBOL,\
    side="SELL",\
    quantity=SELL_QTY,\
    price=PRICE,\
)\
\
print(sell_order)\
\
\
print("\n[3] Add SELL order to matching engine")\
\
sell_result = execution.execute_limit_order(\
    order_id=sell_order["order_id"],\
    user_id=SELLER,\
    symbol=SYMBOL,\
    side="SELL",\
    quantity=SELL_QTY,\
    price=PRICE,\
)\
\
print(sell_result)\
\
\
# ============================================================\
# BUYER 1\
# ============================================================\
\
print("\n[4] BUYER1 buys 0.0004 BTC")\
\
buy1 = orders.create_limit_order(\
    user_id=BUYER1,\
    symbol=SYMBOL,\
    side="BUY",\
    quantity=BUY1_QTY,\
    price=PRICE,\
)\
\
print(buy1)\
\
\
buy1_result = execution.execute_limit_order(\
    order_id=buy1["order_id"],\
    user_id=BUYER1,\
    symbol=SYMBOL,\
    side="BUY",\
    quantity=BUY1_QTY,\
    price=PRICE,\
)\
\
print(buy1_result)\
\
\
print("\n[5] SELLER after first partial fill")\
\
print(orders.get_orders(SELLER)[0])\
\
print(wallet.get_wallet(SELLER, "BTC"))\
\
\
# ============================================================\
# BUYER 2\
# ============================================================\
\
print("\n[6] BUYER2 buys remaining 0.0006 BTC")\
\
buy2 = orders.create_limit_order(\
    user_id=BUYER2,\
    symbol=SYMBOL,\
    side="BUY",\
    quantity=BUY2_QTY,\
    price=PRICE,\
)\
\
print(buy2)\
\
\
buy2_result = execution.execute_limit_order(\
    order_id=buy2["order_id"],\
    user_id=BUYER2,\
    symbol=SYMBOL,\
    side="BUY",\
    quantity=BUY2_QTY,\
    price=PRICE,\
)\
\
print(buy2_result)\
\
\
# ============================================================\
# FINAL\
# ============================================================\
\
print("\n====================================")\
print(" FINAL STATE")\
print("====================================")\
\
\
print("\nSELLER ORDER:")\
print(orders.get_orders(SELLER)[0])\
\
\
print("\nSELLER BTC:")\
print(wallet.get_wallet(SELLER, "BTC"))\
\
\
print("\nSELLER USDT:")\
print(wallet.get_wallet(SELLER, "USDT"))\
\
\
print("\nBUYER1 BTC:")\
print(wallet.get_wallet(BUYER1, "BTC"))\
\
\
print("\nBUYER2 BTC:")\
print(wallet.get_wallet(BUYER2, "BTC"))\
\
\
print("\nORDER BOOK:")\
print(execution.snapshot(SYMBOL))\
\
\
# ============================================================\
# CHECKS\
# ============================================================\
\
print("\n====================================")\
print(" CHECKS")\
print("====================================")\
\
\
seller_order = orders.get_orders(SELLER)[0]\
\
if seller_order["status"] != "FILLED":\
    raise AssertionError(\
        f"Seller should be FILLED: {seller_order['status']}"\
    )\
\
\
seller_remaining = Decimal(\
    str(seller_order["remaining_quantity"])\
)\
\
if abs(seller_remaining) > Decimal("0.00000001"):\
    raise AssertionError(\
        f"Seller remaining should be zero: {seller_remaining}"\
    )\
\
\
seller_wallet = wallet.get_wallet(\
    SELLER,\
    "BTC"\
)\
\
seller_available = Decimal(\
    str(seller_wallet["available"])\
)\
\
seller_locked = Decimal(\
    str(seller_wallet["locked"])\
)\
\
\
if abs(seller_available) > Decimal("0.00000001"):\
    raise AssertionError(\
        f"Seller BTC available should be zero: {seller_available}"\
    )\
\
\
if abs(seller_locked) > Decimal("0.00000001"):\
    raise AssertionError(\
        f"Seller BTC locked should be zero: {seller_locked}"\
    )\
\
\
buyer1_btc = wallet.get_wallet(\
    BUYER1,\
    "BTC"\
)\
\
buyer2_btc = wallet.get_wallet(\
    BUYER2,\
    "BTC"\
)\
\
\
if abs(\
    Decimal(str(buyer1_btc["available"])) - BUY1_QTY\
) > Decimal("0.00000001"):\
    raise AssertionError("Buyer1 BTC incorrect")\
\
\
if abs(\
    Decimal(str(buyer2_btc["available"])) - BUY2_QTY\
) > Decimal("0.00000001"):\
    raise AssertionError("Buyer2 BTC incorrect")\
\
\
book = execution.snapshot(SYMBOL)\
\
if book["asks"]:\
    raise AssertionError(\
        f"Order book should have no asks: {book['asks']}"\
    )\
\
\
print("\n⃼�� PARTIAL -> FULL TEST PASSED")\
\
print("====================================")\
PY
