    <style>\
        * { box-sizing: border-box; }\
        body {\
            margin: 0;\
            font-family: 'IBM Plex Sans Arabic', sans-serif;\
            background-color: #0b0f19; /* خك�فك�ة داك�ك�ة عك�ك�قة تتك�اسب ك�ع اك�ك�ك�ك�ك� اك�أزرق */\
            color: #f8fafc;\
            padding-bottom: 80px;\
            position: relative;\
            min-height: 100vh;\
        }\
\
        /* تخصك�ص اك�خطك�ط اك�رقك�ك�ة ك�ك�أسعار ك�اك�أرقاك� ك�اك�عك�اك�ك�ك� ك�تبدك� ك�ثك� TradingView / Binance */\
        .pulsing-price, .market-row span, h1, h2, h3, .mini-bar-btn {\
            font-family: 'JetBrains Mono', 'IBM Plex Sans Arabic', monospace;\
        }\
\
        /* اك�عك�اك�ة اك�ك�ائك�ة اك�شفافة ك�ك�شعار فك� خك�فك�ة اك�ك�ك�قع بجك�ك�ع اك�ك�فاصك� */\
        body::before {\
            content: "";\
            position: fixed;\
            top: 50%;\
            left: 50%;\
            transform: translate(-50%, -50%);\
            width: 420px;\
            height: 420px;\
            background: url('logo.png') no-repeat center center;\
            background-size: contain;\
            opacity: 0.035; /* شفافك�ة ك�ك�خفضة ك�تك�ك�ك� عك�اك�ة ك�ائك�ة بصرك�ة ك�تك�اسقة */\
            pointer-events: none;\
            z-index: 0;\
        }\
\
        header, .mini-bar, .content, nav {\
            position: relative;\
            z-index: 1;\
        }\
        \
        /* اك�ك�ك�در اك�عك�ك�ك� */\
        header {\
            background-color: #0f172a;\
            padding: 12px 16px;\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            border-bottom: 1px solid #1e293b;\
            position: sticky;\
            top: 0;\
            z-index: 1000;\
            box-shadow: 0 4px 20px rgba(56, 189, 248, 0.15);\
        }\
        .brand {\
            display: flex;\
            align-items: center;\
            gap: 10px;\
        }\
        .header-logo {\
            width: 38px;\
            height: 38px;\
            border-radius: 8px;\
            border: 1px solid #38bdf8;\
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);\
            object-fit: cover;\
        }\
        h1 { margin: 0; color: #38bdf8; font-size: 1.2rem; font-weight: 700; text-shadow: 0 0 8px rgba(56, 189, 248, 0.3); }\
        \
        .header-icons {\
            display: flex;\
            gap: 15px;\
            color: #94a3b8;\
            font-size: 1.1rem;\
            cursor: pointer;\
        }\
\
        /* تصك�ك�ك� اك�ك�ك�ك�ك� بار اك�سرك�ع تحت اك�ك�ك�در */\
        .mini-bar {\
            display: flex;\
            gap: 8px;\
            padding: 8px 12px;\
            background-color: #0b0f19;\
            border-bottom: 1px solid #1e293b;\
            overflow-x: auto;\
            white-space: nowrap;\
            position: sticky;\
            top: 61px;\
            z-index: 999;\
        }\
        .mini-bar::-webkit-scrollbar {\
            display: none;\
        }\
        .mini-bar-btn {\
            background-color: #1e293b;\
            border: 1px solid #334155;\
            color: #94a3b8;\
            padding: 6px 12px;\
            border-radius: 20px;\
            font-size: 0.8rem;\
            cursor: pointer;\
            display: flex;\
            align-items: center;\
            gap: 6px;\
            transition: all 0.2s ease;\
        }\
        .mini-bar-btn:hover {\
            border-color: #38bdf8;\
            color: #38bdf8;\
            box-shadow: 0 0 8px rgba(56, 189, 248, 0.2);\
        }\
\
        /* اك�ك�حتك�ك� اك�رئك�سك� */\
        .content {\
            padding: 12px;\
            max-width: 600px;\
            margin: 0 auto;\
        }\
        .section-view { display: none; }\
        .section-view.active { display: block; }\
\
        /* اك�تبك�ك�بات اك�فرعك�ة باك�أزرق */\
        .sub-tabs {\
            display: flex;\
            gap: 20px;\
            border-bottom: 1px solid #1e293b;\
            margin-bottom: 15px;\
            overflow-x: auto;\
            white-space: nowrap;\
        }\
        .sub-tab-btn {\
            background: none;\
            border: none;\
            color: #94a3b8;\
            padding: 8px 0;\
            font-size: 0.95rem;\
            font-weight: 600;\
            cursor: pointer;\
            position: relative;\
            transition: color 0.3s ease;\
        }\
        .sub-tab-btn.active {\
            color: #38bdf8;\
        }\
        .sub-tab-btn.active::after {\
            content: '';\
            position: absolute;\
            bottom: 0;\
            left: 0;\
            right: 0;\
            height: 2px;\
            background-color: #38bdf8;\
            box-shadow: 0 0 8px #38bdf8;\
            border-radius: 2px;\
        }\
        .sub-view { display: none; }\
        .sub-view.active { display: block; }\
\
        /* اك�بطاقات اك�حك�ة */\
        .card {\
            background-color: #0f172a;\
            border-radius: 10px;\
            padding: 14px;\
            margin-bottom: 12px;\
            border: 1px solid #1e293b;\
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);\
            transition: transform 0.2s ease, border-color 0.2s ease;\
        }\
        .card:hover {\
            border-color: #38bdf8;\
        }\
        \
        .market-row {\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            padding: 12px 0;\
            border-bottom: 1px solid #1e293b;\
        }\
        .market-row:last-child { border-bottom: none; }\
        \
        .price-up { color: #10b981; font-weight: 600; } \
        .price-down { color: #ef4444; font-weight: 600; } \
        \
        /* ك�ؤشر اك�ك�بض اك�حقك�قك� ك�ك�أصك�ك� ك�اك�أسعار */\
        @keyframes pulse-neon {\
            0% { opacity: 1; text-shadow: 0 0 5px rgba(56, 189, 248, 0.5); }\
            50% { opacity: 0.5; text-shadow: 0 0 15px rgba(56, 189, 248, 0.9); }\
            100% { opacity: 1; text-shadow: 0 0 5px rgba(56, 189, 248, 0.5); }\
        }\
        .pulsing-price {\
            animation: pulse-neon 1.8s infinite;\
        }\
\
        /* اك�أزرار اك�دك�ك�اك�ك�ك�ك�ة */\
        .btn-group {\
            display: grid;\
            grid-template-columns: 1fr 1fr;\
            gap: 10px;\
            margin-top: 15px;\
        }\
        .btn-buy {\
            background-color: #10b981;\
