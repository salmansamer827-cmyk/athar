cat << 'EOF' > public/index.html\
<!DOCTYPE html>\
<html lang="ar" dir="rtl">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>EXCORA - ك�ك�صة اك�تداك�ك� ك�تعددة اك�أسك�اق</title>\
    <link rel="stylesheet" href="style.css">\
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;600;700&display=swap" rel="stylesheet">\
</head>\
<body>\
    <div class="app-container">\
        <!-- شرك�ط اك�تك�قك� اك�عك�ك�ك� -->\
        <header class="navbar">\
            <div class="logo">⃺�� EXCORA <span>Multi-Market SaaS</span></div>\
            <div class="user-status" id="userStatus">غك�ر ك�سجك� اك�دخك�ك�</div>\
        </header>\
\
        <!-- تبك�ك�بات اك�أسك�اق اك�ك�اك�ك�ة -->\
        <nav class="market-tabs">\
            <button class="tab-btn active" onclick="switchMarket('crypto')">������ اك�عك�ك�ات اك�رقك�ك�ة</button>\
            <button class="tab-btn" onclick="switchMarket('forex')">������ اك�فك�رك�س</button>\
            <button class="tab-btn" onclick="switchMarket('commodities')">�������︃� اك�سك�ع ك�اك�ذك�ب</button>\
            <button class="tab-btn" onclick="switchMarket('stocks')">������� اك�أسك�ك� اك�عاك�ك�ك�ة</button>\
        </nav>\
\
        <!-- ك�حتك�ك� اك�تك�صك�ات ك�اك�تحك�ك�ك�ات -->\
        <main class="dashboard">\
            <section class="signals-section">\
                <h2>تك�صك�ات اك�ذك�ا؃� اك�اصطك�اعك� (SMC & Volume Profile)</h2>\
                <div id="signalsContainer" class="signals-grid">\
                    <p class="loading">جارك� جك�ب اك�تك�صك�ات اك�حك�ة ك�ك�أسك�اق...</p>\
                </div>\
            </section>\
        </main>\
    </div>\
\
    <script>\
        let currentMarket = 'crypto';\
        const token = localStorage.getItem('excora_token') || '';\
\
        async function switchMarket(market) {\
            currentMarket = market;\
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));\
            event.target.classList.add('active');\
            fetchSignals();\
        }\
\
        async function fetchSignals() {\
            const container = document.getElementById('signalsContainer');\
            container.innerHTML = '<p class="loading">جارك� تحك�ك�ك� سك�ك�ك�ة اك�سك�ق ك�استخراج اك�ك�ك�اذج...</p>';\
            \
            try {\
                const res = await fetch(`/api/signals?market=${currentMarket}`, {\
                    headers: { 'Authorization': 'Bearer ' + token }\
                });\
                const data = await res.json();\
                \
                if (!data.success) {\
                    container.innerHTML = `<div class="error-box">⃺��︃� ${data.error} <br><a href="#" onclick="alert('ك�رجك� اك�تك�اصك� ك�ع اك�إدارة ك�تفعك�ك� اك�اشتراك�')">اشترك� اك�؃�ك� ك�تفعك�ك� اك�تك�صك�ات</a></div>`;\
                    return;\
                }\
\
                container.innerHTML = data.signals.map(sig => `\
                    <div class="signal-card ${sig.type.toLowerCase()}">\
                        <div class="sig-header">\
                            <span class="symbol">${sig.symbol}</span>\
                            <span class="type-badge ${sig.type.toLowerCase()}">${sig.type}</span>\
                        </div>\
                        <div class="sig-details">\
                            <p><strong>اك�دخك�ك�:</strong> ${sig.entry}</p>\
                            <p><strong>اك�ك�دف (TP):</strong> ${sig.tp}</p>\
                            <p><strong>ك�قف اك�خسارة (SL):</strong> ${sig.sl}</p>\
                            <p><strong>ك�سبة اك�ثقة:</strong> <span class="confidence">${sig.confidence}</span></p>\
                        </div>\
                        <div class="sig-reason"><strong>اك�تحك�ك�ك�:</strong> ${sig.reason}</div>\
                    </div>\
                `).join('');\
\
                if(data.ownerMode) {\
                    document.getElementById('userStatus').innerHTML = '������� ك�ضع اك�ك�اك�ك� (ك�صك�ك� حر ك�جاك�ك�)';\
                }\
            } catch (e) {\
                container.innerHTML = '<p class="error-box">فشك� اك�اتصاك� باك�خادك� اك�رئك�سك�.</p>';\
            }\
        }\
\
        fetchSignals();\
    </script>\
</body>\
</html>\
EOF\
