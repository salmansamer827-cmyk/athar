python - <<'PY'\
from pathlib import Path\
\
p = Path("backend/main.py")\
text = p.read_text()\
\
start = text.index("# MARKET ORDER")\
new_block = '''# MARKET ORDER\
# =========================================================\
\
class MarketOrderRequest(BaseModel):\
    user_id: str\
    symbol: str\
    side: str\
    quantity: Decimal\
\
\
@app.post("/order/market")\
def create_market_order(\
    request: MarketOrderRequest,\
):\
    try:\
\
        side = request.side.upper().strip()\
\
        # -------------------------------------------------\
        # MARKET SELL ONLY\
        # -------------------------------------------------\
\
        if side != "SELL":\
            raise HTTPException(\
                status_code=400,\
                detail=(\
                    "Only MARKET SELL is enabled currently. "\
                    "MARKET BUY will be enabled after "\
                    "quote-asset reservation is implemented."\
                ),\
            )\
\
        # -------------------------------------------------\
        # 1. CREATE MARKET ORDER + LOCK BTC\
        # -------------------------------------------------\
\
        created = order_service.create_market_order(\
            user_id=request.user_id,\
            symbol=request.symbol,\
            side=side,\
            quantity=request.quantity,\
        )\
\
        # -------------------------------------------------\
        # 2. EXECUTE THROUGH MATCHING ENGINE\
        # -------------------------------------------------\
\
        result = execution_service.execute_market_order(\
            order_id=created["order_id"],\
            user_id=request.user_id,\
            symbol=request.symbol,\
            side=side,\
            quantity=request.quantity,\
        )\
\
        return result\
\
    except HTTPException:\
        raise\
\
    except ValueError as exc:\
        raise HTTPException(\
            status_code=400,\
            detail=str(exc),\
        )\
\
    except Exception as exc:\
        raise HTTPException(\
            status_code=500,\
            detail=str(exc),\
        )\
'''\
\
text = text[:start] + new_block + "\\n"\
\
p.write_text(text)\
\
print("MARKET SELL API ENABLED")\
PY
