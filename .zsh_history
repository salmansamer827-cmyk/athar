cat > backend/wallet/service.py <<'EOF'\
from decimal import Decimal\
from threading import RLock\
\
\
class WalletService:\
\
    def __init__(self):\
        self._lock = RLock()\
        self._balances = {}\
\
        # order_id -> reservation\
        self._reservations = {}\
\
    def _key(self, user_id, asset):\
        return (user_id, asset.upper())\
\
    def _balance_unlocked(self, user_id, asset):\
        key = self._key(user_id, asset)\
\
        if key not in self._balances:\
            self._balances[key] = {\
                "total": Decimal("0"),\
                "reserved": Decimal("0"),\
            }\
\
        return self._balances[key]\
\
    def deposit(self, user_id, asset, amount):\
\
        amount = Decimal(amount)\
\
        if amount <= 0:\
            raise ValueError("Deposit amount must be greater than zero")\
\
        with self._lock:\
            balance = self._balance_unlocked(user_id, asset)\
\
            balance["total"] += amount\
\
            return self.get_balance(user_id, asset)\
\
    def get_balance(self, user_id, asset):\
\
        with self._lock:\
            balance = self._balance_unlocked(user_id, asset)\
\
            available = (\
                balance["total"] - balance["reserved"]\
            )\
\
            return {\
                "asset": asset.upper(),\
                "total": str(balance["total"]),\
                "reserved": str(balance["reserved"]),\
                "available": str(available),\
            }\
\
    def reserve_for_order(\
        self,\
        order_id,\
        user_id,\
        asset,\
        amount,\
    ):\
\
        amount = Decimal(amount)\
\
        if amount <= 0:\
            raise ValueError(\
                "Reservation amount must be greater than zero"\
            )\
\
        with self._lock:\
\
            if order_id in self._reservations:\
                raise ValueError(\
                    "Order already has a reservation"\
                )\
\
            balance = self._balance_unlocked(\
                user_id,\
                asset,\
            )\
\
            available = (\
                balance["total"] - balance["reserved"]\
            )\
\
            if amount > available:\
                raise ValueError(\
                    f"Insufficient available {asset.upper()} balance"\
                )\
\
            balance["reserved"] += amount\
\
            self._reservations[order_id] = {\
                "order_id": order_id,\
                "user_id": user_id,\
                "asset": asset.upper(),\
                "amount": amount,\
                "remaining": amount,\
            }\
\
            return self.get_reservation(order_id)\
\
    def get_reservation(self, order_id):\
\
        with self._lock:\
\
            reservation = self._reservations.get(order_id)\
\
            if reservation is None:\
                return None\
\
            return {\
                "order_id": reservation["order_id"],\
                "user_id": reservation["user_id"],\
                "asset": reservation["asset"],\
                "amount": str(reservation["amount"]),\
                "remaining": str(reservation["remaining"]),\
            }\
\
    def consume_reservation(\
        self,\
        order_id,\
        amount,\
    ):\
\
        amount = Decimal(amount)\
\
        if amount <= 0:\
            raise ValueError(\
                "Consumed amount must be greater than zero"\
            )\
\
        with self._lock:\
\
            reservation = self._reservations.get(order_id)\
\
            if reservation is None:\
                raise ValueError(\
                    "Reservation not found"\
                )\
\
            remaining = reservation["remaining"]\
\
            if amount > remaining:\
                raise ValueError(\
                    "Amount exceeds order reservation"\
                )\
\
            balance = self._balance_unlocked(\
                reservation["user_id"],\
                reservation["asset"],\
            )\
\
            reservation["remaining"] -= amount\
            balance["reserved"] -= amount\
\
            if reservation["remaining"] == Decimal("0"):\
                del self._reservations[order_id]\
\
            return {\
                "order_id": order_id,\
                "consumed": str(amount),\
                "remaining": str(\
                    max(reservation["remaining"], Decimal("0"))\
                    if order_id in self._reservations\
                    else Decimal("0")\
                ),\
            }\
\
    def release_order_reservation(\
        self,\
        order_id,\
    ):\
\
        with self._lock:\
\
            reservation = self._reservations.get(order_id)\
\
            if reservation is None:\
                return {\
                    "order_id": order_id,\
                    "released": "0",\
                }\
\
            amount = reservation["remaining"]\
\
            balance = self._balance_unlocked(\
                reservation["user_id"],\
                reservation["asset"],\
            )\
\
            balance["reserved"] -= amount\
\
            del self._reservations[order_id]\
\
            return {\
                "order_id": order_id,\
                "released": str(amount),\
            }\
\
    def debit_reserved(\
        self,\
        order_id,\
        amount,\
    ):\
\
        amount = Decimal(amount)\
\
        with self._lock:\
\
            reservation = self._reservations.get(order_id)\
\
            if reservation is None:\
                raise ValueError(\
                    "Reservation not found"\
                )\
\
            if amount <= 0:\
                raise ValueError(\
                    "Debit amount must be greater than zero"\
                )\
\
            if amount > reservation["remaining"]:\
                raise ValueError(\
                    "Debit exceeds reserved amount"\
                )\
\
            balance = self._balance_unlocked(\
                reservation["user_id"],\
                reservation["asset"],\
            )\
\
            balance["total"] -= amount\
            balance["reserved"] -= amount\
            reservation["remaining"] -= amount\
\
            if reservation["remaining"] == Decimal("0"):\
                del self._reservations[order_id]\
\
            return self.get_balance(\
                reservation["user_id"],\
                reservation["asset"],\
            )\
\
    def credit(\
        self,\
        user_id,\
        asset,\
        amount,\
    ):\
\
        amount = Decimal(amount)\
\
        if amount <= 0:\
            raise ValueError(\
                "Credit amount must be greater than zero"\
            )\
\
        with self._lock:\
\
            balance = self._balance_unlocked(\
                user_id,\
                asset,\
            )\
\
            balance["total"] += amount\
\
            return self.get_balance(\
                user_id,\
                asset,\
            )\
\
    def reserved_amount(self, user_id, asset):\
\
        with self._lock:\
\
            balance = self._balance_unlocked(\
                user_id,\
                asset,\
            )\
\
            return balance["reserved"]\
\
    def clear(self):\
\
        with self._lock:\
            self._balances.clear()\
            self._reservations.clear()\
EOF
