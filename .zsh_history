from __future__ import annotations\
\
from decimal import Decimal\
from threading import RLock\
from typing import Dict, List\
\
from backend.exchange.orderbook import OrderBook\
from backend.orders.service import Order\
\
\
class MatchingEngine:\
\
    def __init__(self):\
        self._books: Dict[str, OrderBook] = {}\
        self._lock = RLock()\
\
    def _book(self, symbol: str) -> OrderBook:\
        symbol = symbol.upper()\
\
        if symbol not in self._books:\
            self._books[symbol] = OrderBook(symbol)\
\
        return self._books[symbol]\
\
    def submit(self, order: Order) -> List[dict]:\
\
        with self._lock:\
\
            book = self._book(order.symbol)\
            trades = []\
\
            incoming_remaining = Decimal(\
                order.remaining_quantity\
            )\
\
            side = str(order.side).upper()\
\
            while incoming_remaining > Decimal("0"):\
\
                resting = book.best_opposite(order)\
\
                if resting is None:\
                    break\
\
                resting_remaining = Decimal(\
                    resting.remaining_quantity\
                )\
\
                if resting_remaining <= 0:\
                    book.remove(resting)\
                    continue\
\
                resting_price = Decimal(resting.price)\
                incoming_price = Decimal(order.price)\
\
                if side == "BUY":\
\
                    if incoming_price < resting_price:\
                        break\
\
                elif side == "SELL":\
\
                    if incoming_price > resting_price:\
                        break\
\
                else:\
                    raise ValueError(\
                        f"Invalid order side: {side}"\
                    )\
\
                trade_quantity = min(\
                    incoming_remaining,\
                    resting_remaining,\
                )\
\
                if trade_quantity <= 0:\
                    break\
\
                trades.append(\
                    {\
                        "symbol": order.symbol.upper(),\
                        "price": str(resting_price),\
                        "quantity": str(trade_quantity),\
                        "maker_order_id": resting.order_id,\
                        "taker_order_id": order.order_id,\
                        "maker_user_id": resting.user_id,\
                        "taker_user_id": order.user_id,\
                    }\
                )\
\
                incoming_remaining -= trade_quantity\
\
                # The actual order state is changed later\
                # by OrderService.fill().\
\
                if trade_quantity >= resting_remaining:\
                    book.remove(resting)\
\
            if incoming_remaining > 0:\
                book.add(order)\
\
            return trades\
\
    def remove_order(self, order_id: str):\
\
        with self._lock:\
\
            for book in self._books.values():\
\
                order = book.find_order(order_id)\
\
                if order is not None:\
                    book.remove(order)\
                    return
