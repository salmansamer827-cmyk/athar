from decimal import Decimal\
import time\
\
from backend.database.db import get_connection\
\
\
class FuturesPnLService:\
\
    @staticmethod\
    def calculate_pnl(\
        side: str,\
        quantity,\
        entry_price,\
        mark_price,\
    ) -> Decimal:\
\
        side = side.upper().strip()\
\
        quantity = Decimal(str(quantity))\
        entry_price = Decimal(str(entry_price))\
        mark_price = Decimal(str(mark_price))\
\
        if quantity <= 0:\
            raise ValueError("Quantity must be greater than zero")\
\
        if entry_price <= 0:\
            raise ValueError("Entry price must be greater than zero")\
\
        if mark_price <= 0:\
            raise ValueError("Mark price must be greater than zero")\
\
        if side == "LONG":\
            return (mark_price - entry_price) * quantity\
\
        if side == "SHORT":\
            return (entry_price - mark_price) * quantity\
\
        raise ValueError("Side must be LONG or SHORT")\
\
    def update_position_mark_price(\
        self,\
        position_id: int,\
        mark_price,\
    ):\
\
        mark_price = Decimal(str(mark_price))\
\
        if mark_price <= 0:\
            raise ValueError("Mark price must be greater than zero")\
\
        conn = get_connection()\
\
        try:\
            conn.execute("BEGIN")\
\
            row = conn.execute(\
                """\
                SELECT *\
                FROM futures_positions\
                WHERE id = ?\
                  AND status = 'OPEN'\
                """,\
                (position_id,),\
            ).fetchone()\
\
            if row is None:\
                raise ValueError("Open position not found")\
\
            position = dict(row)\
\
            pnl = self.calculate_pnl(\
                side=position["side"],\
                quantity=position["quantity"],\
                entry_price=position["entry_price"],\
                mark_price=mark_price,\
            )\
\
            now = int(time.time())\
\
            conn.execute(\
                """\
                UPDATE futures_positions\
                SET mark_price = ?,\
                    unrealized_pnl = ?,\
                    updated_at = ?\
                WHERE id = ?\
                  AND status = 'OPEN'\
                """,\
                (\
                    float(mark_price),\
                    float(pnl),\
                    now,\
                    position_id,\
                ),\
            )\
\
            conn.commit()\
\
            return {\
                "position_id": position_id,\
                "user_id": position["user_id"],\
                "symbol": position["symbol"],\
                "side": position["side"],\
                "quantity": str(position["quantity"]),\
                "entry_price": str(position["entry_price"]),\
                "mark_price": str(mark_price),\
                "unrealized_pnl": str(pnl),\
            }\
\
        except Exception:\
            conn.rollback()\
            raise\
\
        finally:\
            conn.close()\
\
    def update_symbol_mark_price(\
        self,\
        symbol: str,\
        mark_price,\
    ):\
\
        symbol = symbol.upper().strip()\
        mark_price = Decimal(str(mark_price))\
\
        if not symbol:\
            raise ValueError("Symbol is required")\
\
        if mark_price <= 0:\
            raise ValueError("Mark price must be greater than zero")\
\
        conn = get_connection()\
\
        try:\
