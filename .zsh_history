    font-size: 19px;\
}\
\
.ticker {\
    height: 52px;\
    display: flex;\
    gap: 35px;\
    align-items: center;\
    overflow-x: auto;\
    white-space: nowrap;\
    padding: 0 20px;\
    background: #11161c;\
    border-bottom: 1px solid #272d35;\
}\
\
.ticker strong {\
    color: #00d99b;\
    margin-right: 8px;\
}\
\
main {\
    max-width: 900px;\
    margin: auto;\
    padding: 20px;\
}\
\
.markets-header {\
    display: flex;\
    align-items: center;\
    justify-content: space-between;\
    gap: 15px;\
    margin-bottom: 20px;\
}\
\
.markets-header h1 {\
    font-size: 25px;\
}\
\
.search {\
    display: flex;\
    align-items: center;\
    gap: 8px;\
    background: #171c23;\
    border: 1px solid #2b333d;\
    border-radius: 12px;\
    padding: 10px 14px;\
    width: 260px;\
}\
\
.search input {\
    width: 100%;\
    border: 0;\
    outline: 0;\
    background: transparent;\
    color: white;\
}\
\
.trading-card {\
    background: #171c23;\
    border: 1px solid #2a323c;\
    border-radius: 18px;\
    padding: 15px;\
    box-shadow: 0 10px 40px rgba(0,0,0,.35);\
}\
\
.market-title {\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    margin-bottom: 12px;\
}\
\
.market-title > div:first-child {\
    display: flex;\
    align-items: center;\
    gap: 10px;\
}\
\
.coin {\
    width: 42px;\
    height: 42px;\
    display: grid;\
    place-items: center;\
    border-radius: 50%;\
    background: #f7931a;\
    font-size: 23px;\
}\
\
.market-title h2 {\
    font-size: 18px;\
}\
\
.market-title small {\
    color: #87919d;\
}\
\
.price-box {\
    text-align: left;\
}\
\
.price-box strong {\
    display: block;\
    font-size: 20px;\
}\
\
.positive {\
    color: #00d99b;\
    font-size: 14px;\
}\
\
.timeframes {\
    display: flex;\
    gap: 5px;\
    margin-bottom: 8px;\
    overflow-x: auto;\
}\
\
.timeframes button {\
    border: 0;\
    background: transparent;\
    color: #9ba5b1;\
    padding: 9px 14px;\
    border-radius: 9px;\
}\
\
.timeframes .active {\
    background: #343b45;\
    color: white;\
}\
\
#tradingview_chart {\
    height: 470px;\
    width: 100%;\
    border-radius: 12px;\
    overflow: hidden;\
    background: #0d1014;\
}\
\
.orderbook {\
    margin-top: 15px;\
    padding: 14px;\
    background: #10151b;\
    border-radius: 12px;\
}\
\
.orderbook-title {\
    display: flex;\
    justify-content: space-between;\
    color: #89939f;\
    margin-bottom: 10px;\
}\
\
.asks div,\
.bids div {\
    display: flex;\
    justify-content: space-between;\
    padding: 5px 0;\
    font-size: 13px;\
}\
\
.asks span:first-child {\
    color: #ff5268;\
}\
\
.bids span:first-child {\
    color: #00d99b;\
}\
\
.current-order-price {\
    text-align: center;\
    font-size: 18px;\
    color: #00d4ff;\
    padding: 10px;\
    border-top: 1px solid #252d36;\
    border-bottom: 1px solid #252d36;\
    margin: 5px 0;\
}\
\
.trade-panel {\
    margin-top: 15px;\
}\
\
.trade-tabs {\
    display: flex;\
    gap: 8px;\
    margin-bottom: 15px;\
}\
\
.trade-tabs button {\
    flex: 1;\
    padding: 13px;\
    border: 0;\
    border-radius: 10px;\
    background: #252b33;\
    color: #aeb7c2;\
    font-size: 16px;\
}\
\
.trade-tabs .active {\
    background: #00c98b;\
    color: #07120f;\
    font-weight: bold;\
}\
\
.trade-panel label {\
    display: block;\
    margin: 9px 0 5px;\
    color: #929ca8;\
    font-size: 13px;\
}\
\
.trade-panel input {\
    width: 100%;\
    padding: 13px;\
    border: 1px solid #303944;\
    border-radius: 9px;\
    background: #0d1217;\
    color: white;\
    outline: none;\
}\
\
.order-summary {\
    display: flex;\
    justify-content: space-between;\
    padding: 15px 0;\
    color: #8f99a5;\
}\
\
.order-summary strong {\
    color: white;\
}\
\
.submit-buy {\
    width: 100%;\
    padding: 15px;\
    border: 0;\
    border-radius: 10px;\
    background: #00d394;\
    color: #03130e;\
    font-size: 17px;\
    font-weight: bold;\
}\
\
.bottom-nav {\
    position: fixed;\
    bottom: 0;\
    left: 0;\
    right: 0;\
    height: 76px;\
    display: flex;\
    justify-content: space-around;\
    align-items: center;\
    background: #151a20;\
    border-top: 1px solid #292f37;\
    z-index: 1000;\
}\
\
.bottom-nav a {\
    min-width: 18%;\
    text-align: center;\
    color: #89929d;\
    font-size: 11px;\
}\
\
.bottom-nav span {\
    display: block;\
    font-size: 22px;\
    margin-bottom: 4px;\
}\
\
.bottom-nav .selected {\
    color: #00d394;\
}\
\
@media (max-width: 600px) {\
\
    main {\
        padding: 12px;\
    }\
\
    .markets-header {\
        display: block;\
    }\
\
    .search {\
        width: 100%;\
        margin-top: 12px;\
    }\
\
    .market-title {\
        align-items: flex-start;\
    }\
\
    #tradingview_chart {\
        height: 430px;\
    }\
\
    .ticker {\
        gap: 25px;\
    }\
}\
