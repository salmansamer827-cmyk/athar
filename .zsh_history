\
<!-- ================= TRADE ================= -->\
\
<section id="trade-page" class="page active">\
\
    <div class="market-header">\
\
        <div class="symbol-row">\
\
            <div>\
                <div class="symbol" id="currentSymbol">\
                    BTC/USDT\
                </div>\
\
