from google import genai\
from google.genai import types\
\
# 1. تك�ك�ئة اك�عك�ك�ك� (ك�أخذ اك�ك�فتاح تك�قائك�اك� ك�ك� اك�ك�تغك�رات اك�بك�ئك�ة GEMINI_API_KEY)\
client = genai.Client()\
\
# 2. تعرك�ف اك�أدك�ات اك�تك� ك�ك�ك�ك� ك�ك�ك�ك�ك�ك� استخداك�ك�ا\
# سك�عرف داك�ة بسك�طة ك�حساب اك�عك�ك�ك�ات أك� جك�ب ك�عك�ك�ك�ات اك�ك�ظاك� ك�أداة ك�ك�ك�ك�ك�ك�\
def calculate_rectangle_area(length: float, width: float) -> float:\
    """حساب ك�ساحة اك�ك�ستطك�ك� بك�ا؃�ك� عك�ك� اك�طك�ك� ك�اك�عرض.\
    Args:\
        length: اك�طك�ك�\
        width: اك�عرض\
    """\
    return length * width\
\
# 3. إعداد خك�ارات اك�ك�ك�ك�ك� ك�تزك�ك�دك� باك�أدك�ات اك�ك�تاحة\
config = types.GenerateContentConfig(\
    tools=[calculate_rectangle_area],\
    temperature=0.0,\
    system_instruction="أك�ت ك�ك�ك�ك� ذك�ا؃� اصطك�اعك� ك�ساعد. استخدك� اك�أدك�ات اك�ك�تاحة ك�ك� بدقة ك�إك�جاز اك�ك�ك�اك� اك�تك� ك�طك�بك�ا اك�ك�ستخدك�."\
)\
\
# 4. إرساك� اك�طك�ب ك�ك�ك�ك�ك�ك�\
prompt = "أحتاج إك�ك� حساب ك�ساحة ك�ستطك�ك� طك�ك�ك� 15.5 ك�عرضك� 6.2؃� اك�رجا؃� استخداك� اك�أداة اك�ك�خصصة ك�ذك�ك�."\
\
print(f"اك�ك�ستخدك�: {prompt}\n")\
\
response = client.models.generate_content(\
    model="gemini-2.5-flash",\
    contents=prompt,\
    config=config\
)\
\
# 5. ك�عاك�جة رد اك�ك�ك�ك�ك� (اك�تحقق ك�ك�ا إذا ك�اك� بحاجة ك�استخداك� أداة)\
if response.function_calls:\
    for function_call in response.function_calls:\
        print(f"-> اك�ك�ك�ك�ك� قرر استخداك� اك�أداة: {function_call.name}")\
        print(f"-> باك�ك�دخك�ات: {function_call.args}")\
        \
        # تك�فك�ذ اك�داك�ة ك�حك�ك�اك� بك�ا؃�ك� عك�ك� طك�ب اك�ك�ك�ك�ك�\
        if function_call.name == "calculate_rectangle_area":\
            args = function_call.args\
            result = calculate_rectangle_area(args["length"], args["width"])\
            print(f"-> ك�تك�جة تك�فك�ذ اك�أداة: {result}")\
else:\
    print(response.text)\

