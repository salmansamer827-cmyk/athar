from core.data.providers.mock import MockMarketProvider\
from core.backtest.engine import BacktestEngine, BacktestConfig\
\
provider = MockMarketProvider("CRYPTO")\
\
candles = provider.fetch_ohlcv(\
    symbol="BTC/USDT",\
    timeframe="15m",\
    limit=500,\
)\
\
\
def test_signal_generator(\
    candles,\
    index,\
    capital,\
):\
\
    candle = candles[index]\
\
    # اختبار ك�ك�دسك� فقط\
    if index % 50 != 0:\
        return None\
\
    entry = candle.close\
    stop = entry - 0.30\
    target = entry + 0.90\
\
    return {\
        "direction": "LONG",\
        "entry": entry,\
        "stop_loss": stop,\
        "take_profit": target,\
\
        "score": 85.0,\
        "probability": 0.72,\
        "adjusted_probability": 0.62,\
        "uncertainty": 0.08,\
        "expected_value_r": 1.45,\
    }\
\
\
engine = BacktestEngine(\
    BacktestConfig(\
        initial_capital=100.0,\
        risk_percent=1.0,\
        reward_risk=3.0,\
    )\
)\
\
result = engine.run(\
    candles=candles,\
    signal_generator=test_signal_generator,\
    symbol="BTC/USDT",\
    market="CRYPTO",\
    timeframe="15m",\
)\
\
print("=" * 70)\
print("EXCORA FULL BACKTEST ENGINE")\
print("=" * 70)\
\
print("Initial Capital :", result.initial_capital)\
print("Final Capital   :", result.final_capital)\
\
print("Total Trades    :", result.total_trades)\
print("Wins            :", result.wins)\
print("Losses          :", result.losses)\
\
print("Win Rate        :", result.win_rate)\
print("Profit Factor   :", result.profit_factor)\
\
print("Net Profit      :", result.net_profit)\
print("Net R           :", result.net_r)\
print("Expectancy R    :", result.expectancy_r)\
\
print("Max Drawdown    :", result.max_drawdown)\
print("Max DD %        :", result.max_drawdown_percent)\
\
print(\
    "Max Consecutive Losses:",\
    result.max_consecutive_losses,\
)\
\
print("=" * 70)\
\
if result.trades:\
    print("\nFIRST TRADE:")\
    print(result.trades[0])\
\
    print("\nLAST TRADE:")\
    print(result.trades[-1])\
\
print("=" * 70)\
print("STATUS: FULL BACKTEST ENGINE TEST COMPLETE")\
print("=" * 70)\
PY
