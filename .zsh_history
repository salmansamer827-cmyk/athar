# تصك�ك�ك� اك�برك�ك�ر باك�أزرق ك�اك�أبك�ض اك�داك�ك� (Dark Blue & Neon White)\
cat << 'EOF' > public/style.css\
* {\
    box-sizing: border-box;\
    margin: 0;\
    padding: 0;\
    font-family: 'IBM Plex Sans Arabic', sans-serif;\
}\
body {\
    background-color: #080b11; /* أزرق داك�ك� جداك� عك�ك�ق */\
    color: #f0f4f8;\
    direction: rtl;\
}\
.broker-container {\
    max-width: 1400px;\
    margin: 0 auto;\
    padding: 15px;\
}\
.broker-header {\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    background: #0f172a; /* أزرق داك�ك� فخك� */\
    padding: 12px 25px;\
    border-radius: 10px;\
    border: 1px solid #1e293b;\
    margin-bottom: 15px;\
}\
.brand h1 {\
    font-size: 20px;\
    color: #38bdf8; /* أزرق ك�ك�ك�ك�ك� ك�شرق */\
}\
.brand span {\
    font-size: 11px;\
    color: #94a3b8;\
    margin-right: 8px;\
}\
.market-ticker-bar {\
    display: flex;\
    gap: 20px;\
    font-size: 13px;\
}\
.ticker-item strong.up { color: #34d399; }\
.ticker-item strong.down { color: #f87171; }\
.user-panel {\
    display: flex;\
    gap: 15px;\
    align-items: center;\
    font-size: 13px;\
}\
.wallet-balance strong {\
    color: #38bdf8;\
}\
.badge-owner {\
    background: #1e3a8a;\
    color: #93c5fd;\
    padding: 4px 10px;\
    border-radius: 6px;\
    font-size: 12px;\
}\
.broker-nav {\
    display: flex;\
    gap: 10px;\
    margin-bottom: 15px;\
}\
.nav-tab {\
    background: #0f172a;\
    color: #94a3b8;\
    border: 1px solid #1e293b;\
    padding: 8px 18px;\
    border-radius: 6px;\
    cursor: pointer;\
    font-weight: 600;\
    transition: 0.3s;\
}\
.nav-tab.active, .nav-tab:hover {\
    background: #0284c7; /* أزرق برك�ك�ر ك�اصع */\
    color: #ffffff;\
    border-color: #38bdf8;\
}\
.broker-main-grid {\
    display: grid;\
    grid-template-columns: 320px 1fr;\
    gap: 15px;\
}\
.markets-list-panel, .trading-terminal {\
    background: #0f172a;\
    border-radius: 10px;\
    border: 1px solid #1e293b;\
    padding: 20px;\
    min-height: 500px;\
}\
.markets-list-panel h3, .trading-terminal h3 {\
    font-size: 16px;\
    margin-bottom: 15px;\
    color: #e2e8f0;\
}\
.asset-row {\
    display: flex;\
    justify-content: space-between;\
    padding: 12px 10px;\
    border-bottom: 1px solid #1e293b;\
    cursor: pointer;\
    transition: 0.2s;\
    border-radius: 6px;\
}\
.asset-row:hover {\
    background: #1e293b;\
}\
.asset-row .sym { font-weight: 700; color: #f8fafc; }\
.asset-row .prc { color: #cbd5e1; }\
.asset-row .chg.up { color: #34d399; }\
.asset-row .chg.down { color: #f87171; }\
\
.terminal-header {\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    margin-bottom: 15px;\
}\
.leverage-badge {\
    background: #1e293b;\
    color: #38bdf8;\
    padding: 4px 8px;\
    border-radius: 4px;\
    font-size: 11px;\
    border: 1px solid #0284c7;\
}\
.chart-mockup {\
    background: #020617;\
    border-radius: 8px;\
    height: 300px;\
    display: flex;\
    align-items: center;\
    justify-content: center;\
    border: 1px solid #1e293b;\
    margin-bottom: 20px;\
}\
.live-pulse-screen {\
    text-align: center;\
    color: #64748b;\
}\
.price-display-box {\
    font-size: 32px;\
    font-weight: 700;\
    color: #38bdf8;\
    margin-top: 10px;\
}\
.trade-execution-box {\
    display: flex;\
    flex-direction: column;\
    gap: 12px;\
}\
.input-group label {\
    font-size: 13px;\
    color: #94a3b8;\
    display: block;\
    margin-bottom: 5px;\
}\
.input-group input {\
    width: 100%;\
    background: #020617;\
    border: 1px solid #1e293b;\
    padding: 10px;\
    border-radius: 6px;\
    color: #fff;\
    font-size: 16px;\
}\
.action-buttons {\
    display: grid;\
    grid-template-columns: 1fr 1fr;\
    gap: 15px;\
    margin-top: 10px;\
}\
.btn-buy {\
    background: #059669; /* أخضر تداك�ك�ك� */\
    color: #fff;\
    border: none;\
    padding: 12px;\
    border-radius: 6px;\
    font-size: 16px;\
    font-weight: 700;\
    cursor: pointer;\
    transition: 0.2s;\
}\
.btn-buy:hover { background: #10b981; }\
.btn-sell {\
    background: #dc2626; /* أحك�ر تداك�ك�ك� */\
    color: #fff;\
    border: none;\
    padding: 12px;\
    border-radius: 6px;\
    font-size: 16px;\
    font-weight: 700;\
    cursor: pointer;\
    transition: 0.2s;\
}\
.btn-sell:hover { background: #ef4444; }\
EOF\
\
