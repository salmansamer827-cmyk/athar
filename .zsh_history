from pathlib import Path\
\
p = Path("backend/main.py")\
text = p.read_text()\
\
imp = "from backend.services.futures_risk_service import FuturesRiskService"\
\
if imp not in text:\
    anchor = "from backend.services.futures_pnl_service import FuturesPnLService"\
\
    if anchor not in text:\
        raise SystemExit(\
            "PnL import not found"\
        )\
\
    text = text.replace(\
        anchor,\
        anchor + "\n" + imp,\
        1\
    )\
\
instance = "futures_risk_service = FuturesRiskService()"\
\
if instance not in text:\
    anchor = "futures_pnl_service = FuturesPnLService()"\
\
    if anchor not in text:\
        raise SystemExit(\
            "PnL service instance not found"\
        )\
\
    text = text.replace(\
        anchor,\
        anchor + "\n" + instance,\
        1\
    )\
\
p.write_text(text)\
\
print("⃼�� Risk Engine connected")\
