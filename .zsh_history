    font-family: 'IBM Plex Sans Arabic', sans-serif;\
}\
body {\
    background-color: #0b0e11;\
    color: #eaecef;\
    direction: rtl;\
    max-width: 480px;\
    margin: 0 auto;\
    height: 100vh;\
    overflow: hidden;\
}\
.binance-mobile-app {\
    display: flex;\
    flex-direction: column;\
    height: 100vh;\
    background: #0b0e11;\
}\
\
/* اك�شرك�ط اك�عك�ك�ك� */\
.top-nav-bar {\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    padding: 12px 16px;\
    background: #181a20;\
    border-bottom: 1px solid #1f2329;\
}\
.logo-area {\
    display: flex;\
    align-items: center;\
    gap: 6px;\
}\
.brand-name {\
    font-size: 16px;\
    font-weight: 700;\
    color: #fff;\
    letter-spacing: 0.5px;\
}\
.bolt-icon {\
    color: #f0b90b;\
    font-size: 14px;\
}\
.qr-profile-icons {\
    display: flex;\
    gap: 18px;\
    color: #848e9c;\
    font-size: 16px;\
}\
\
/* شرك�ط اك�تك�ك�ر اك�ك�تحرك� */\
.ticker-tape {\
    display: flex;\
    gap: 20px;\
    padding: 8px 16px;\
    background: #12141c;\
    font-size: 11px;\
    white-space: nowrap;\
    overflow-x: auto;\
    border-bottom: 1px solid #1f2329;\
}\
.ticker-tape::-webkit-scrollbar { display: none; }\
.t-item { color: #848e9c; }\
.t-item strong.up { color: #0ecb81; font-weight: 600; margin-right: 4px; }\
\
/* ك�ك�طقة اك�ك�حتك�ك� */\
.main-content-area {\
    flex: 1;\
    overflow-y: auto;\
    padding: 12px;\
}\
.trading-view-screen {\
    display: flex;\
    flex-direction: column;\
    gap: 12px;\
}\
.screen-header-title {\
    background: #181a20;\
    padding: 10px 14px;\
    border-radius: 8px;\
    border: 1px solid #1f2329;\
}\
.screen-header-title h3 {\
    font-size: 14px;\
    color: #f0b90b;\
    margin-bottom: 2px;\
}\
.screen-header-title p {\
    font-size: 11px;\
    color: #848e9c;\
}\
\
.tradingview-container-mockup {\
    background: #181a20;\
    border-radius: 8px;\
    border: 1px solid #1f2329;\
    overflow: hidden;\
}\
.tv-top-bar {\
    display: flex;\
    gap: 10px;\
    padding: 8px 12px;\
    background: #12141c;\
    align-items: center;\
    border-bottom: 1px solid #1f2329;\
}\
.pair-label {\
    font-size: 12px;\
    font-weight: 700;\
    color: #fff;\
    margin-left: auto;\
}\
.tf-pill {\
    font-size: 11px;\
    color: #848e9c;\
    padding: 2px 8px;\
    border-radius: 4px;\
    background: #1f2329;\
}\
.tf-pill.active {\
    background: #0052ff;\
    color: #fff;\
}\
\
.tv-chart-box {\
    height: 260px;\
    position: relative;\
    padding: 12px;\
    background: #0b0e11;\
}\
.asset-details-overlay {\
    display: flex;\
    flex-direction: column;\
    gap: 2px;\
    margin-bottom: 10px;\
}\
.asset-details-overlay strong { font-size: 13px; color: #fff; }\
.asset-details-overlay span.up { font-size: 11px; color: #0ecb81; }\
\
.candles-graphic {\
    display: flex;\
    align-items: flex-end;\
    justify-content: space-around;\
    height: 170px;\
    padding-top: 20px;\
}\
.candle {\
    width: 14px;\
    border-radius: 2px;\
    position: relative;\
}\
.candle.green { background: #0ecb81; }\
.candle.red { background: #f6465d; }\
\
/* أزرار اك�شرا؃� ك�اك�بك�ع اك�ك�طابقة ك�ك�صك�رة */\
.big-action-buttons {\
    display: grid;\
    grid-template-columns: 1fr 1fr;\
    gap: 10px;\
    margin-top: 5px;\
}\
.btn-long {\
    background: #0ecb81;\
    color: #0b0e11;\
    border: none;\
    padding: 14px;\
    border-radius: 6px;\
    font-size: 14px;\
    font-weight: 700;\
    cursor: pointer;\
    text-align: center;\
}\
.btn-short {\
    background: #f6465d;\
    color: #fff;\
    border: none;\
    padding: 14px;\
    border-radius: 6px;\
    font-size: 14px;\
    font-weight: 700;\
    cursor: pointer;\
    text-align: center;\
}\
\
.page-placeholder {\
    text-align: center;\
    padding: 60px 20px;\
    color: #848e9c;\
}\
.page-placeholder h2 { color: #fff; margin-bottom: 10px; }\
\
/* اك�شرك�ط اك�سفك�ك� اك�ك�طابق تك�اك�اك� ك�تطبك�ق بك�ك�اك�س فك� اك�صك�رة */\
.binance-bottom-nav {\
    display: flex;\
    background: #181a20;\
    border-top: 1px solid #1f2329;\
    height: 60px;\
    padding-bottom: env(safe-area-inset-bottom);\
}\
.nav-item {\
    flex: 1;\
    display: flex;\
    flex-direction: column;\
    align-items: center;\
    justify-content: center;\
    background: transparent;\
    border: none;\
    color: #848e9c;\
    gap: 4px;\
    cursor: pointer;\
    font-size: 11px;\
    transition: 0.2s;\
}\
.nav-item i {\
    font-size: 18px;\
}\
.nav-item span {\
    font-size: 10px;\
}\
.nav-item.active {\
    color: #f0b90b; /* ك�ك�ك� اك�تحدك�د اك�أصفر اك�ك�ك�ك�ز ك�بك�ك�اك�س */\
}\
.nav-item.active i, .nav-item.active span {\
    color: #f0b90b;\
}\
EOF\
