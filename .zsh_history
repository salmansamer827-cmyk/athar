        header {\
            background-color: var(--card-bg);\
            border-bottom: 1px solid var(--border-color);\
            padding: 10px 15px;\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            position: sticky;\
            top: 0;\
            z-index: 100;\
        }\
        .logo-area {\
            display: flex;\
            align-items: center;\
            gap: 10px;\
