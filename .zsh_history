                        "locale": "ar",\
                        "enable_publishing": false,\
                        "allow_symbol_change": true,\
                        "calendar": false,\
                        "support_host": "https://www.tradingview.com"\
                      }\
                      </script>\
                    </div>\
                </div>\
\
                <div class="trade-actions">\
                    <button class="btn-trade btn-sell" onclick="triggerAction('بك�ع (SHORT)')">بك�ع ������ (SHORT)</button>\
                    <button class="btn-trade btn-buy" onclick="triggerAction('شرا؃� (LONG)')">شرا؃� ������� (LONG)</button>\
                </div>\
            </div>\
        </div>\
\
        <!-- اك�أصك�ك� -->\
        <div id="assets-tab" class="tab-content">\
            <div class="card">\
                <div class="section-title">������ ك�حفظة اك�أصك�ك� اك�تفاعك�ك�ة</div>\
                <div class="section-desc">رصك�د اك�حساب اك�ك�تاح ك�اك�ك�ك�زع</div>\
                <div style="font-size: 22px; font-weight: bold; color: var(--green); margin-top: 10px;" id="balanceDisplay">\
                    $24,850.00 <span style="font-size: 12px; color: var(--text-secondary);">USDT</span>\
                </div>\
            </div>\
        </div>\
\
    </div>\
\
    <nav class="bottom-nav">\
        <button class="nav-item" onclick="switchTab('home', this)">\
            <span class="icon">�������</span>\
            <span>اك�رئك�سك�ة</span>\
        </button>\
        <button class="nav-item" onclick="switchTab('markets', this)">\
            <span class="icon">�������</span>\
            <span>اك�أسك�اق</span>\
        </button>\
        <button class="nav-item active" onclick="switchTab('chart', this)">\
            <span class="icon">�������</span>\
            <span>اك�تداك�ك�</span>\
        </button>\
        <button class="nav-item" onclick="switchTab('assets', this)">\
            <span class="icon">������</span>\
            <span>اك�أصك�ك�</span>\
        </button>\
    </nav>\
\
    <script>\
        // اك�اتصاك� بخادك� اك�خك�فك�ة (تأك�د ك�ك� ك�طابقة اك�ك�ك�فذ ك�ع ك�ك�ف server.js)\
        const socket = io('http://localhost:5000');\
\
        socket.on('connect', () => {\
            document.getElementById('connectionStatus').innerText = '⃺�� ك�تصك� ك�باشر';\
            document.getElementById('connectionStatus').style.color = 'var(--green)';\
        });\
\
        socket.on('disconnect', () => {\
            document.getElementById('connectionStatus').innerText = '⃽�� ك�قطك�ع';\
            document.getElementById('connectionStatus').style.color = 'var(--red)';\
        });\
\
        // استقباك� اك�تحدك�ثات اك�حك�ة ك�ك�أسعار\
        socket.on('marketUpdate', (data) => {\
            if (data.btc) {\
                document.getElementById('btcTicker').innerText = data.btc.price.toLocaleString();\
                const mBtc = document.getElementById('marketBtcPrice');\
                if(mBtc) mBtc.innerText = '$' + data.btc.price.toLocaleString();\
            }\
            if (data.eth) {\
                document.getElementById('ethTicker').innerText = data.eth.price.toLocaleString();\
                const mEth = document.getElementById('marketEthPrice');\
                if(mEth) mEth.innerText = '$' + data.eth.price.toLocaleString();\
            }\
        });\
\
        // جك�ب بك�اك�ات أك�ردر بك�ك�ك� ك�اك�تحك�ك�ك� ك�ك� اك�سك�رفر\
        fetch('http://localhost:5000/api/analytics/order-blocks')\
            .then(res => res.json())\
            .then(result => {\
                if(result.status === 'success') {\
                    const zones = result.data.institutionalZones;\
                    let html = `<b>اك�رك�ز اك�ك�درج:</b> ${result.data.symbol}<br>`;\
                    html += `<b>ك�ؤشر اك�سك�ك�ك�ة Delta:</b> <span style="color:var(--green);">${result.data.liquidityDelta}</span><br><br>`;\
                    html += `<b>ك�ك�اطق اك�أك�اك�ر اك�ك�ؤسسك�ة:</b><br>`;\
                    zones.forEach(z => {\
                        html += `- ${z.type}: ك�طاق ${z.priceRange} (اك�قك�ة: ${z.strength})<br>`;\
                    });\
                    document.getElementById('analyticsBox').innerHTML = html;\
                }\
            })\
            .catch(err => {\
                document.getElementById('analyticsBox').innerText = 'تعذر اك�اتصاك� بخدك�ة اك�تحك�ك�ك� اك�ك�تقدك�.';\
            });\
\
        function switchTab(tabId, element) {\
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));\
            document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));\
            document.getElementById(tabId + '-tab').classList.add('active');\
            element.classList.add('active');\
            window.scrollTo(0, 0);\
        }\
\
        function triggerAction(type) {\
            const btn = event.target;\
            btn.style.transform = 'scale(0.92)';\
            setTimeout(() => btn.style.transform = 'scale(1)', 150);\
            alert('⃺�� تك� تك�فك�ذ أك�ر ' + type + ' بك�جاح عبر خك�ارزك�ك�ات EXCORA.');\
        }\
\
        function flashElement(el) {\
            el.style.backgroundColor = 'rgba(240, 185, 11, 0.15)';\
            setTimeout(() => el.style.backgroundColor = '', 300);\
        }\
    </script>\
</body>\
</html>\
EO\
