            border-color: rgba(240, 185, 11, 0.4);\
            transform: translateY(-2px);\
        }\
        .card::before {\
            content: '';\
            position: absolute;\
            top: 0; right: 0; width: 4px; height: 100%;\
            background: var(--accent-color);\
        }\
        .section-title {\
            color: var(--accent-color);\
            font-size: 14px;\
            font-weight: bold;\
            margin-bottom: 4px;\
            display: flex;\
            align-items: center;\
            gap: 8px;\
        }\
        .section-desc {\
            color: var(--text-secondary);\
            font-size: 11px;\
            margin-bottom: 12px;\
        }\
        .ticker-list {\
            display: flex;\
            flex-direction: column;\
            gap: 8px;\
        }\
        .ticker-item {\
            background-color: rgba(255, 255, 255, 0.02);\
            border: 1px solid var(--border-color);\
            border-radius: 8px;\
            padding: 12px;\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            cursor: pointer;\
        }\
        .ticker-item:hover {\
            background-color: var(--card-hover);\
            border-color: var(--accent-color);\
        }\
        .ticker-info .symbol {\
            font-weight: bold;\
            font-size: 13px;\
            color: var(--text-main);\
        }\
        .ticker-info .name {\
            font-size: 10px;\
            color: var(--text-secondary);\
        }\
        .ticker-values {\
            text-align: left;\
        }\
        .ticker-values .price {\
            font-weight: bold;\
            font-size: 13px;\
            color: var(--text-main);\
        }\
        .ticker-values .change {\
            font-size: 11px;\
            font-weight: 600;\
            padding: 2px 6px;\
            border-radius: 4px;\
        }\
        .change.positive { background-color: rgba(14, 203, 129, 0.15); color: var(--green); }\
        .change.negative { background-color: rgba(246, 70, 93, 0.15); color: var(--red); }\
\
        .tradingview-container {\
            width: 100%;\
            height: 380px;\
            background-color: var(--bg-color);\
            border-radius: 8px;\
            overflow: hidden;\
            border: 1px solid var(--border-color);\
        }\
\
        .trade-actions {\
            display: grid;\
            grid-template-columns: 1fr 1fr;\
            gap: 10px;\
            margin-top: 12px;\
        }\
        .btn-trade {\
            padding: 12px;\
            font-weight: bold;\
            border-radius: 8px;\
            border: none;\
            cursor: pointer;\
            font-size: 13px;\
            text-align: center;\
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);\
        }\
        .btn-buy { background-color: var(--green); color: #000; }\
        .btn-sell { background-color: var(--red); color: #fff; }\
        .btn-trade:active { transform: scale(0.96); }\
\
        .bottom-nav {\
            position: fixed;\
            bottom: 0;\
            left: 0;\
            right: 0;\
            background-color: #161a1e;\
            border-top: 1px solid var(--border-color);\
            display: flex;\
            justify-content: space-around;\
            padding: 10px 0;\
            z-index: 99999;\
            box-shadow: 0 -4px 20px rgba(0,0,0,0.6);\
        }\
        .nav-item {\
            display: flex;\
            flex-direction: column;\
            align-items: center;\
            color: var(--text-secondary);\
            font-size: 11px;\
            text-decoration: none;\
            cursor: pointer;\
            background: none;\
            border: none;\
            flex: 1;\
            padding: 4px;\
            border-radius: 8px;\
        }\
        .nav-item.active {\
            color: var(--accent-color);\
            background-color: rgba(240, 185, 11, 0.08);\
        }\
        .nav-item span.icon {\
            font-size: 18px;\
            margin-bottom: 2px;\
        }\
    </style>\
</head>\
<body>\
\
    <header>\
        <div class="logo-area">\
            <img src="logo.png" alt="EXCORA Logo" class="brand-logo">\
        </div>\
        <div style="font-size: 12px; color: var(--accent-color);" id="connectionStatus">⃺�� ك�تصك� باك�خادك� اك�حك�</div>\
    </header>\
\
    <div class="market-ticker-bar">\
        <div class="ticker-mini-item"><span>BTC/USDT</span> <b style="color: var(--green);" id="btcTicker">--</b></div>\
        <div class="ticker-mini-item"><span>ETH/USDT</span> <b style="color: var(--green);" id="ethTicker">--</b></div>\
        <div class="ticker-mini-item"><span>EXCORA/USDT</span> <b style="color: var(--accent-color);" id="excoraTicker">1.44</b></div>\
    </div>\
\
    <div class="container">\
        \
        <!-- اك�رئك�سك�ة -->\
        <div id="home-tab" class="tab-content">\
            <div class="card">\
                <div class="section-title">������ ك�ك�حة اك�تحك�ك� ك�اك�تصفك�ات اك�ك�ؤسسك�ة</div>\
                <div class="section-desc">ك�راقبة اك�سك�ك�ك�ة اك�حك�ة ك�ك�ظاك� أك�ردر بك�ك�ك� اك�ك�عتك�د</div>\
                <div id="analyticsBox" style="font-size: 12px; color: var(--text-secondary); line-height: 1.6; margin-top: 10px;">\
                    جارك� جك�ب تحك�ك�ك� اك�سك�ك�ك�ة ك�ك� اك�سك�رفر...\
                </div>\
            </div>\
        </div>\
\
        <!-- اك�أسك�اق -->\
        <div id="markets-tab" class="tab-content">\
            <div class="card">\
                <div class="section-title">������� اك�أسك�اق اك�فك�رك�ة اك�ك�شطة</div>\
                <div class="section-desc">تحدك�ث ك�باشر ك�ك�أسعار عبر اك�باك� إك�د</div>\
                <div class="ticker-list">\
                    <div class="ticker-item" onclick="flashElement(this)">\
                        <div class="ticker-info"><div class="symbol">BTC/USDT</div><div class="name">Bitcoin</div></div>\
                        <div class="ticker-values"><div class="price" id="marketBtcPrice">--</div><div class="change positive">ك�شط</div></div>\
                    </div>\
                    <div class="ticker-item" onclick="flashElement(this)">\
                        <div class="ticker-info"><div class="symbol">ETH/USDT</div><div class="name">Ethereum</div></div>\
                        <div class="ticker-values"><div class="price" id="marketEthPrice">--</div><div class="change positive">ك�شط</div></div>\
                    </div>\
                </div>\
            </div>\
        </div>\
\
        <!-- اك�تداك�ك� ك�اك�شارت -->\
        <div id="chart-tab" class="tab-content active">\
            <div class="card">\
                <div class="section-title">������� شارت اك�تحك�ك�ك� اك�فك�ك� اك�ك�تقدك�</div>\
                <div class="section-desc">أسعار حك�ة ك�ك�ؤشرات تداك�ك� احترافك�ة</div>\
                \
                <div class="tradingview-container">\
                    <div class="tradingview-widget-container" style="height:100%;width:100%">\
                      <div class="tradingview-widget-container__widget" style="height:100%;width:100%"></div>\
                      <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js" async>\
                      {\
                        "autosize": true,\
                        "symbol": "BINANCE:BTCUSDT",\
                        "interval": "60",\
                        "timezone": "Etc/UTC",\
