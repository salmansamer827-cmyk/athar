            <div class="chart-header">\
                <div class="section-title">������� شارت اك�تحك�ك�ك� اك�فك�ك� (BTC/USDT)</div>\
                <div class="timeframes">\
                    <button class="tf-btn" onclick="changeTf('1m')">1د</button>\
                    <button class="tf-btn" onclick="changeTf('15m')">15د</button>\
