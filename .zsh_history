cat << 'EOF' > public/style.css\
* { box-sizing: border-box; margin: 0; padding: 0; font-family: 'IBM Plex Sans Arabic', sans-serif; }\
body { background-color: #0b0e11; color: #eaecef; direction: rtl; width: 100%; height: 100vh; overflow: hidden; }\
\
.app-container {\
    width: 100%;\
    max-width: 480px;\
    height: 100vh;\
    margin: 0 auto;\
    background: #0b0e11;\
    display: block;\
    position: relative;\
}\
\
.header {\
    height: 50px;\
    background: #181a20;\
    border-bottom: 1px solid #1f2329;\
    display: flex;\
    align-items: center;\
    justify-content: space-between;\
    padding: 0 16px;\
}\
.logo-box { display: flex; align-items: center; gap: 6px; }\
.logo-text { font-size: 16px; font-weight: bold; color: #fff; }\
.bolt-c { color: #f0b90b; font-size: 14px; }\
.header-icons { display: flex; gap: 16px; color: #848e9c; font-size: 15px; }\
\
.ticker-bar {\
    height: 32px;\
    background: #12141c;\
    border-bottom: 1px solid #1f2329;\
    display: flex;\
    align-items: center;\
    gap: 20px;\
    padding: 0 16px;\
    font-size: 11px;\
    overflow-x: auto;\
    white-space: nowrap;\
}\
.ticker-bar::-webkit-scrollbar { display: none; }\
.gr { color: #0ecb81 !important; }\
.rd { color: #f6465d !important; }\
\
.content-body {\
    position: absolute;\
    top: 82px;\
    bottom: 56px;\
    left: 0;\
    right: 0;\
    overflow-y: auto;\
    padding: 12px;\
}\
\
.card-section {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 8px;\
    padding: 10px 14px;\
    margin-bottom: 10px;\
}\
.sec-title { font-size: 13px; font-weight: bold; color: #f0b90b; margin-bottom: 2px; }\
.sec-sub { font-size: 10px; color: #848e9c; }\
\
.chart-box {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 8px;\
    overflow: hidden;\
    margin-bottom: 10px;\
}\
.chart-top {\
    background: #12141c;\
    border-bottom: 1px solid #1f2329;\
    padding: 8px 12px;\
    display: flex;\
    align-items: center;\
    gap: 10px;\
}\
.pair { font-size: 12px; font-weight: bold; color: #fff; margin-left: auto; }\
.tf { font-size: 10px; color: #848e9c; background: #1f2329; padding: 2px 8px; border-radius: 4px; }\
.tf.active { background: #0052ff; color: #fff; }\
\
.chart-area { padding: 12px; background: #0b0e11; }\
.pair-info { margin-bottom: 10px; }\
.pair-info strong { display: block; font-size: 12px; color: #fff; margin-bottom: 2px; }\
.pair-info span { font-size: 10px; }\
\
.candles-row {\
    height: 140px;\
    display: flex;\
    align-items: flex-end;\
    justify-content: space-around;\
    padding-top: 10px;\
}\
.c { width: 12px; border-radius: 2px; }\
.gr-c { background: #0ecb81; }\
.rd-c { background: #f6465d; }\
\
.actions-grid {\
    display: grid;\
    grid-template-columns: 1fr 1fr;\
    gap: 10px;\
}\
.btn-l { background: #0ecb81; color: #0b0e11; border: none; padding: 12px; border-radius: 6px; font-size: 13px; font-weight: bold; cursor: pointer; text-align: center; }\
.btn-s { background: #f6465d; color: #fff; border: none; padding: 12px; border-radius: 6px; font-size: 13px; font-weight: bold; cursor: pointer; text-align: center; }\
\
.market-row {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 6px;\
    padding: 12px 14px;\
    margin-bottom: 8px;\
    display: flex;\
    justify-content: space-between;\
    font-size: 12px;\
}\
\
.bottom-nav {\
    position: absolute;\
    bottom: 0;\
    left: 0;\
    right: 0;\
    height: 56px;\
    background: #181a20;\
    border-top: 1px solid #1f2329;\
    display: flex;\
}\
.nav-btn {\
    flex: 1;\
    background: none;\
    border: none;\
    color: #848e9c;\
    display: flex;\
    flex-direction: column;\
    align-items: center;\
    justify-content: center;\
    gap: 2px;\
    cursor: pointer;\
}\
.nav-btn i { font-size: 16px; }\
.nav-btn span { font-size: 9px; }\
.nav-btn.active, .nav-btn.active i, .nav-btn.active span { color: #f0b90b; }\
EOF\
\
