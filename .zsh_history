            output_data = json.loads(process.stdout)\
        except json.JSONDecodeError:\
            output_data = {"result": process.stdout}\
            \
        return {\
            "status": "success",\
            "analysis": output_data\
        }\
    except subprocess.CalledProcessError as e:\
        return {\
            "status": "error",\
            "message": e.stderr\
        }\
    except Exception as e:\
        return {\
            "status": "error",\
            "message": str(e)\
        }\
EOF\

