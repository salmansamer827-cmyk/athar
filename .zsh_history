from api.services.binance_data import BinanceDataService\
from core.pipeline.quant_pipeline import QuantPipeline\
\
service = BinanceDataService()\
\
candles = service.fetch_ohlcv(\
    symbol="BTCUSDT",\
    timeframe="15m",\
    limit=300,\
    market="CRYPTO",\
)\
\
print("CANDLES:", len(candles))\
\
pipeline = QuantPipeline(\
    risk_percent=0.01,\
    reward_risk=3.0,\
    value_area=0.70,\
)\
\
result = pipeline.run(\
    candles=candles,\
    symbol="BTCUSDT",\
    market="CRYPTO",\
    timeframe="15m",\
    capital=100.0,\
    entry=float(candles[-1].close),\
)\
\
print("\n========== QUANT PIPELINE ==========")\
print("Symbol:", result.symbol)\
print("Timeframe:", result.timeframe)\
\
print("\n--- PROFILE ---")\
print("POC:", result.profile.poc)\
print("VAH:", result.profile.vah)\
print("VAL:", result.profile.val)\
print("Entropy:", result.profile.entropy)\
print("Concentration:", result.profile.volume_concentration)\
\
print("\n--- DYNAMICS ---")\
print("POC Change:", result.dynamics.poc_change)\
print("POC Velocity:", result.dynamics.poc_velocity)\
print("VA Width:", result.dynamics.value_area_width)\
print("VA Width Change:", result.dynamics.value_area_width_change)\
print("Value Location:", result.dynamics.value_location)\
print("POC Direction:", result.dynamics.poc_direction)\
print("VA State:", result.dynamics.value_area_state)\
\
print("\n--- STATE ---")\
print(result.state)\
\
print("\n--- PROBABILITY ---")\
print("Raw:", result.probability.probability)\
print("Wilson Lower:", result.probability.lower_bound)\
print("Wilson Upper:", result.probability.upper_bound)\
\
print("\n--- EV ---")\
print("Expected Value R:", result.expected_value_r)\
print("Conservative EV R:",\
      getattr(result, "conservative_expected_value_r", None))\
\
print("\n--- SIGNAL ---")\
print(result.signal)\
\
print("\n--- RISK ---")\
print(result.risk)\
\
print("====================================")\
