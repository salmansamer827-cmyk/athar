            border: none;\
            padding: 12px;\
            border-radius: 6px;\
            font-weight: bold;\
            cursor: pointer;\
            font-size: 0.95rem;\
        }\
        .btn-sell {\
            background-color: #ef4444;\
            color: #ffffff;\
            border: none;\
            padding: 12px;\
            border-radius: 6px;\
            font-weight: bold;\
            cursor: pointer;\
            font-size: 0.95rem;\
        }\
        .btn-action {\
            background-color: #38bdf8;\
            color: #0b0f19;\
            border: none;\
            padding: 12px;\
            border-radius: 6px;\
            font-weight: bold;\
            width: 100%;\
            cursor: pointer;\
            margin-top: 10px;\
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);\
            transition: background-color 0.2s;\
        }\
        .btn-action:hover {\
            background-color: #0ea5e9;\
        }\
\
        /* تذك�ك�ك� اك�صفحة ك�ع اك�شعار ك�اك�اعتك�ادك�ة */\
        .footer-branding {\
            text-align: center;\
            margin: 20px 0 10px 0;\
            color: #94a3b8;\
            font-size: 0.8rem;\
            display: flex;\
