\
            <!-- 2. اك�تداك�ك� اك�ك�دك�ك� -->\
            <div id="trade-tab" class="tab-content">\
                <div class="card">\
                    <h3>اك�تك�فك�ذ اك�سرك�ع (Futures)</h3>\
                    <div class="trade-buttons" style="display: flex; gap: 12px; margin-top: 15px;">\
                        <button onclick="triggerAction('LONG')" style="flex: 1; background: var(--accent-green); color: #fff; padding: 14px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px;">شرا؃� (LONG)</button>\
                        <button onclick="triggerAction('SHORT')" style="flex: 1; background: var(--accent-red); color: #fff; padding: 14px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px;">بك�ع (SHORT)</button>\
                    </div>\
