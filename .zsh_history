import 'package:flutter/material.dart';\
import 'excora_api_service.dart';\
import 'trading_asset_card.dart';\
\
class DashboardScreen extends StatefulWidget {\
  const DashboardScreen({Key? key}) : super(key: key);\
\
  @override\
  _DashboardScreenState createState() => _DashboardScreenState();\
}\
\
class _DashboardScreenState extends State<DashboardScreen> {\
  late Future<List<dynamic>?> _marketDataFuture;\
\
  @override\
  void initState() {\
    super.initState();\
    _marketDataFuture = ExcoraApiService.fetchExcoraMarketData();\
  }\
\
  @override\
  Widget build(BuildContext context) {\
    return Scaffold(\
      backgroundColor: const Color(0xFF0B0E14), // خك�فك�ة اك�داشبك�رد اك�داك�ك�ة\
      appBar: AppBar(\
        backgroundColor: const Color(0xFF161A25),\
        title: const Text(\
          'EXCORA PRO-BOT',\
          style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold),\
        ),\
        actions: [\
          IconButton(\
            icon: const Icon(Icons.refresh, color: Colors.cyanAccent),\
            onPressed: () {\
              setState(() {\
                _marketDataFuture = ExcoraApiService.fetchExcoraMarketData();\
              });\
            },\
          ),\
        ],\
      ),\
      body: FutureBuilder<List<dynamic>?>(\
        future: _marketDataFuture,\
        builder: (context, snapshot) {\
          if (snapshot.connectionState == ConnectionState.waiting) {\
            return const Center(\
              child: CircularProgressIndicator(color: Colors.cyanAccent),\
            );\
          } else if (snapshot.hasError || snapshot.data == null || snapshot.data!.isEmpty) {\
            // عرض بك�اك�ات افتراضك�ة تجرك�بك�ة فك� حاك� ك�ك� تتك�فر اك�بك�اك�ات اك�حك�ة حاك�ك�اك�\
            return ListView(\
              children: [\
                const Padding(\
                  padding: EdgeInsets.all(16.0),\
                  child: Text(\
                    'Market Live Assets (Demo Mode)',\
                    style: TextStyle(color: Colors.grey, fontSize: 14),\
                  ),\
                ),\
                TradingAssetCard(\
                  assetName: 'BTC/USDT',\
                  assetSymbol: 'Bitcoin',\
                  currentPrice: '\$64,250.00',\
                  priceChange: '+3.45%',\
                  isPositive: true,\
                  onTap: () {},\
                ),\
                TradingAssetCard(\
                  assetName: 'ETH/USDT',\
                  assetSymbol: 'Ethereum',\
                  currentPrice: '\$3,480.00',\
                  priceChange: '-1.20%',\
                  isPositive: false,\
                  onTap: () {},\
                ),\
              ],\
            );\
          }\
\
          final assets = snapshot.data!;\
          return ListView.builder(\
            itemCount: assets.length,\
            itemBuilder: (context, index) {\
              final item = assets[index];\
              return TradingAssetCard(\
                assetName: item['symbol'] ?? 'UNKNOWN',\
                assetSymbol: item['name'] ?? 'Asset',\
                currentPrice: '\$${item['price'] ?? '0.00'}',\
                priceChange: '${item['change'] ?? '0.0%'}',\
                isPositive: (item['change'] ?? '').toString().contains('+'),\
                onTap: () {\
                  // تفاصك�ك� اك�أصك� عك�د اك�ضغط\
                },\
              );\
            },\
          );\
        },\
      ),\
    );\
  }\
}\
EOF\

