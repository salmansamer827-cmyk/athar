# ============================================================\
\
marker = """    @staticmethod\
    def _to_dataframe(\
        candles,\
    ) -> pd.DataFrame:\
"""\
\
method = """    @staticmethod\
    def _volatility_ratio(\
        df: pd.DataFrame,\
        recent_window: int = 20,\
        baseline_window: int = 100,\
    ) -> float:\
        \"\"\"\
        Normalized realized-volatility ratio.\
\
        recent volatility / baseline volatility\
\
        Values:\
            1.0  = normal volatility\
            >1.0 = volatility expansion\
            <1.0 = volatility contraction\
        \"\"\"\
\
        if len(df) < 3:\
            return 1.0\
\
        close = pd.to_numeric(\
            df["close"],\
            errors="coerce",\
        ).dropna()\
\
        if len(close) < 3:\
            return 1.0\
\
        returns = (\
            close.pct_change()\
            .replace([float("inf"), float("-inf")], pd.NA)\
            .dropna()\
        )\
\
        if len(returns) < 2:\
            return 1.0\
\
        recent = returns.tail(\
            min(recent_window, len(returns))\
        )\
\
        baseline = returns.tail(\
            min(baseline_window, len(returns))\
        )\
\
        current_volatility = float(\
            recent.std(ddof=1)\
        )\
\
        baseline_volatility = float(\
            baseline.std(ddof=1)\
        )\
\
        if (\
            not pd.notna(current_volatility)\
            or not pd.notna(baseline_volatility)\
            or baseline_volatility <= 0\
        ):\
            return 1.0\
\
        ratio = (\
            current_volatility\
            / baseline_volatility\
        )\
\
        return max(\
            0.01,\
            float(ratio),\
        )\
\
"""\
\
if "def _volatility_ratio(" not in s:\
    if marker not in s:\
        raise SystemExit("ERROR: to_dataframe marker not found")\
