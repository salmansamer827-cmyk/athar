        .market-row:last-child { border-bottom: none; }\
        \
        .price-up { color: #10b981; font-weight: 600; } \
        .price-down { color: #ef4444; font-weight: 600; } \
        \
        /* ك�ؤشر اك�ك�بض اك�حقك�قك� ك�ك�أصك�ك� ك�اك�أسعار */\
        @keyframes pulse-neon {\
            0% { opacity: 1; text-shadow: 0 0 5px rgba(56, 189, 248, 0.5); }\
            50% { opacity: 0.5; text-shadow: 0 0 15px rgba(56, 189, 248, 0.9); }\
            100% { opacity: 1; text-shadow: 0 0 5px rgba(56, 189, 248, 0.5); }\
        }\
        .pulsing-price {\
            animation: pulse-neon 1.8s infinite;\
