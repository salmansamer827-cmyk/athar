import sys\
import json\
\
data = json.load(sys.stdin)\
\
print("\n===== EXCORA BROKER v2.0.0 =====\n")\
\
for path, methods in data.get("paths", {}).items():\
\
    print(f"\n{path}")\
\
    for method, info in methods.items():\
\
        print(f"  {method.upper()}")\
\
        if "summary" in info:\
            print(f"    summary: {info['summary']}")\
\
        for param in info.get("parameters", []):\
            print(\
                "    parameter:",\
                param.get("name"),\
                "|",\
                param.get("in"),\
                "| required:",\
                param.get("required")\
            )\
\
        body = info.get("requestBody")\
\
        if body:\
            print("    requestBody:")\
\
            content = body.get("content", {})\
\
            for content_type, schema_info in content.items():\
                print(\
                    "      ",\
                    content_type,\
                    schema_info.get("schema")\
                )\
\
print("\n===== SCHEMAS =====\n")\
\
for name, schema in data.get(\
    "components", {}\
).get("schemas", {}).items():\
\
    print(f"\n{name}:")\
    print(json.dumps(\
        schema,\
        indent=2,\
        ensure_ascii=False\
    ))\
