cat > backend/exchange/matching_engine.py <<'PY'\
from __future__ import annotations\
\
from decimal import Decimal\
from threading import RLock\
from typing import Dict, List\
\
from backend.exchange.orderbook import OrderBook\
from backend.orders.service import Order\
\
\
class MatchingEngine:\
    """\
    EXCORA Matching Engine\
\
    The matching engine discovers trades but does not mutate\
    order.remaining_quantity.\
\
    OrderService.fill() is responsible for changing fill state.\
    """\
\
    def __init__(self):\
        self._books: Dict[str, OrderBook] = {}\
        self._lock = RLock()\
\
    def _book(self, symbol: str) -> OrderBook:\
        if symbol not in self._books:\
            self._books[symbol] = OrderBook(symbol)\
        return self._books[symbol]\
\
    def submit(self, order: Order) -> List[dict]:\
        with self._lock:\
            book = self._book(order.symbol)\
            trades: List[dict] = []\
\
            incoming_remaining = Decimal(order.remaining_quantity)\
\
            while incoming_remaining > Decimal("0"):\
                resting = book.best_opposite(order)\
\
                if resting is None:\
                    break\
\
                resting_remaining = Decimal(resting.remaining_quantity)\
\
                if resting_remaining <= Decimal("0"):\
                    book.remove(resting)\
                    continue\
\
                # BUY can match SELL at or below its limit price.\
                if order.side.value == "BUY":\
                    if Decimal(order.price) < Decimal(resting.price):\
                        break\
\
                # SELL can match BUY at or above its limit price.\
                else:\
                    if Decimal(order.price) > Decimal(resting.price):\
                        break\
\
                trade_quantity = min(\
                    incoming_remaining,\
                    resting_remaining,\
                )\
\
                if trade_quantity <= Decimal("0"):\
                    break\
\
                trade_price = Decimal(resting.price)\
\
                trades.append(\
                    {\
                        "symbol": order.symbol,\
                        "price": str(trade_price),\
                        "quantity": str(trade_quantity),\
                        "maker_order_id": resting.order_id,\
                        "taker_order_id": order.order_id,\
                        "maker_user_id": resting.user_id,\
                        "taker_user_id": order.user_id,\
                    }\
                )\
\
                # IMPORTANT:\
                # Do NOT modify either order here.\
                # OrderService.fill() owns quantity mutation.\
                incoming_remaining -= trade_quantity\
\
                # Remove a fully consumed resting order from the book.\
                if trade_quantity >= resting_remaining:\
                    book.remove(resting)\
\
            # If incoming order has remaining quantity,\
            # keep it in the order book.\
            if incoming_remaining > Decimal("0"):\
                book.add(order)\
\
            return trades\
\
    def snapshot(self, symbol: str, depth: int = 20) -> dict:\
        with self._lock:\
            return self._book(symbol).snapshot(depth=depth)\
\
    def clear(self):\
        with self._lock:\
            self._books.clear()\
PY
