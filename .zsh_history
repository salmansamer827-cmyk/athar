                    {\
                        "position_id": position["id"],\
                        "user_id": position["user_id"],\
                        "symbol": symbol,\
                        "side": position["side"],\
                        "quantity": str(position["quantity"]),\
                        "entry_price": str(position["entry_price"]),\
                        "mark_price": str(mark_price),\
                        "unrealized_pnl": str(pnl),\
                    }\
                )\
\
            conn.commit()\
\
            return updated\
\
        except Exception:\
            conn.rollback()\
            raise\
\
        finally:\
            conn.close()\
