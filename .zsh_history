: 1786829219:0;cat > src/App.tsx <<'EOF'\
import { useState } from "react";\
import { analyzeQuant } from "./api/client";\
import type { QuantResponse } from "./types/quant";\
import "./index.css";\
\
function App() {\
  const [data, setData] = useState<QuantResponse | null>(null);\
  const [loading, setLoading] = useState(false);\
  const [error, setError] = useState("");\
\
  async function runAnalysis() {\
    setLoading(true);\
    setError("");\
\
    try {\
      const result = await analyzeQuant({\
        symbol: "BTC/USDT",\
        market: "CRYPTO",\
        timeframe: "15m",\
        capital: 100,\
        entry: 103.8,\
        stop_price: 100.43568454427916,\
        tick_size: 0.01,\
        wins: 72,\
        losses: 28,\
        candles: [\
          {\
            timestamp: 1,\
            open: 100,\
            high: 101,\
            low: 99,\
            close: 100.5,\
            volume: 1000,\
            symbol: "BTC/USDT",\
            market: "CRYPTO",\
            timeframe: "15m",\
          },\
          {\
            timestamp: 2,\
            open: 100.5,\
            high: 102,\
            low: 100,\
            close: 101.5,\
            volume: 1200,\
            symbol: "BTC/USDT",\
            market: "CRYPTO",\
            timeframe: "15m",\
          },\
          {\
            timestamp: 3,\
            open: 101.5,\
            high: 104,\
            low: 101,\
            close: 103.8,\
            volume: 1500,\
            symbol: "BTC/USDT",\
            market: "CRYPTO",\
            timeframe: "15m",\
          },\
        ],\
      });\
\
      setData(result);\
    } catch (err) {\
      console.error(err);\
      setError("Quant API request failed");\
    } finally {\
      setLoading(false);\
    }\
  }\
\
  const signal = data?.signal;\
  const risk = data?.risk;\
\
  return (\
    <main className="app">\
      <header className="topbar">\
        <div>\
          <div className="brand">CAPITAL WISE</div>\
          <div className="subtitle">\
            Quantitative Trading Analytics\
          </div>\
        </div>\
\
        <button onClick={runAnalysis} disabled={loading}>\
          {loading ? "ANALYZING..." : "RUN QUANT ANALYSIS"}\
        </button>\
      </header>\
\
      {error && <div className="error">{error}</div>}\
\
      {!data && !loading && (\
        <section className="welcome">\
          <h1>Quantitative Market Intelligence</h1>\
          <p>\
            Connect CAPITAL WISE to the quantitative engine\
            and generate a complete market analysis.\
          </p>\
\
          <button onClick={runAnalysis}>\
            START ANALYSIS\
          </button>\
        </section>\
      )}\
\
      {data && (\
        <>\
          <section className="market-header">\
            <div>\
              <span className="label">SYMBOL</span>\
              <strong>{data.symbol}</strong>\
            </div>\
\
            <div>\
              <span className="label">MARKET</span>\
              <strong>{data.market}</strong>\
            </div>\
\
            <div>\
              <span className="label">TIMEFRAME</span>\
              <strong>{data.timeframe}</strong>\
            </div>\
\
            <div>\
              <span className="label">STATE</span>\
              <strong>{data.state.state}</strong>\
            </div>\
          </section>\
\
          <section className="grid">\
            <Card\
              title="PROBABILITY"\
              value={`${(\
                data.probability.probability * 100\
              ).toFixed(1)}%`}\
              detail={`${data.probability.wins} wins / ${data.probability.losses} losses`}\
            />\
\
            <Card\
              title="EXPECTED VALUE"\
              value={`${data.expected_value_r.toFixed(2)}R`}\
              detail="Statistical expectancy"\
            />\
\
            <Card\
              title="CONFIDENCE"\
              value={`${(\
                data.state.confidence * 100\
              ).toFixed(1)}%`}\
              detail={data.state.state}\
            />\
\
            <Card\
              title="POC"\
              value={data.profile.poc.toFixed(4)}\
              detail={`VA ${data.profile.val.toFixed(\
                4\
              )} ⃦�� ${data.profile.vah.toFixed(4)}`}\
            />\
          </section>\
\
          <section className="panel">\
            <h2>TRADE DECISION</h2>\
\
            {signal || risk ? (\
              <div className="trade-grid">\
                <Metric\
                  label="DIRECTION"\
                  value={\
                    risk?.direction ??\
                    signal?.direction ??\
                    "N/A"\
                  }\
                />\
\
                <Metric\
                  label="ENTRY"\
                  value={format(\
                    risk?.entry ?? signal?.entry\
                  )}\
                />\
\
                <Metric\
                  label="STOP LOSS"\
                  value={format(\
                    risk?.stop_loss ??\
                      signal?.stop_loss\
                  )}\
                />\
\
                <Metric\
                  label="TAKE PROFIT"\
                  value={format(\
                    risk?.take_profit ??\
                      signal?.take_profit\
                  )}\
                />\
\
                <Metric\
                  label="RISK AMOUNT"\
                  value={format(\
                    risk?.risk_amount\
                  )}\
                />\
\
                <Metric\
                  label="POSITION SIZE"\
                  value={format(\
                    risk?.position_size\
                  )}\
                />\
\
                <Metric\
                  label="NOTIONAL"\
                  value={format(risk?.notional)}\
                />\
\
                <Metric\
                  label="RR"\
                  value={format(\
                    risk?.reward_risk\
                  )}\
                />\
              </div>\
            ) : (\
              <div className="neutral">\
                No trade decision returned.\
              </div>\
            )}\
          </section>\
\
          <section className="panel">\
            <h2>VOLUME PROFILE</h2>\
\
            <div className="profile-grid">\
              <Metric\
                label="POC"\
                value={format(data.profile.poc)}\
              />\
\
              <Metric\
                label="VAH"\
                value={format(data.profile.vah)}\
              />\
\
              <Metric\
                label="VAL"\
                value={format(data.profile.val)}\
              />\
\
              <Metric\
                label="TOTAL VOLUME"\
                value={format(\
                  data.profile.total_volume\
                )}\
              />\
\
              <Metric\
                label="WEIGHTED MEAN"\
                value={format(\
                  data.profile.weighted_mean\
                )}\
              />\
\
              <Metric\
                label="STD"\
                value={format(data.profile.std)}\
              />\
            </div>\
          </section>\
\
          <section className="panel">\
            <h2>MARKET DYNAMICS</h2>\
\
            <div className="profile-grid">\
              <Metric\
                label="POC DIRECTION"\
                value={data.dynamics.poc_direction}\
              />\
\
              <Metric\
                label="VALUE AREA"\
                value={data.dynamics.value_area_state}\
              />\
\
              <Metric\
                label="BALANCE SCORE"\
                value={(\
                  data.state.balance_score * 100\
                ).toFixed(2) + "%"}\
              />\
\
              <Metric\
                label="MIGRATION SCORE"\
                value={(\
                  data.state.migration_score * 100\
                ).toFixed(2) + "%"}\
              />\
            </div>\
          </section>\
        </>\
      )}\
    </main>\
  );\
}\
\
function Card({\
  title,\
  value,\
  detail,\
}: {\
  title: string;\
  value: string;\
  detail: string;\
}) {\
  return (\
    <div className="card">\
      <span className="label">{title}</span>\
      <strong>{value}</strong>\
      <small>{detail}</small>\
    </div>\
  );\
}\
\
function Metric({\
  label,\
  value,\
}: {\
  label: string;\
  value: string | number | undefined;\
}) {\
  return (\
    <div className="metric">\
      <span>{label}</span>\
      <strong>{value ?? "N/A"}</strong>\
    </div>\
  );\
}\
\
function format(value: number | undefined) {\
  if (value === undefined || value === null) {\
    return "N/A";\
  }\
\
  return Number(value).toFixed(4);\
}\
\
export default App;\
EOF
: 1786829236:0;cat > src/index.css <<'EOF'\
* {\
  box-sizing: border-box;\
}\
\
body {\
  margin: 0;\
  font-family: Inter, system-ui, sans-serif;\
  background: #070b12;\
  color: #e7edf5;\
}\
\
button {\
  border: 0;\
  border-radius: 8px;\
  padding: 12px 18px;\
  background: #1f8fff;\
  color: white;\
  font-weight: 700;\
  cursor: pointer;\
}\
\
button:disabled {\
  opacity: 0.6;\
  cursor: wait;\
}\
\
.app {\
  min-height: 100vh;\
  padding: 24px;\
  max-width: 1500px;\
  margin: auto;\
}\
\
.topbar {\
  display: flex;\
  align-items: center;\
  justify-content: space-between;\
  gap: 20px;\
  margin-bottom: 28px;\
}\
\
.brand {\
  font-size: 28px;\
  font-weight: 900;\
  letter-spacing: 2px;\
}\
\
.subtitle {\
  color: #7f8da3;\
  margin-top: 4px;\
}\
\
.market-header,\
.grid,\
.trade-grid,\
.profile-grid {\
  display: grid;\
  gap: 14px;\
}\
\
.market-header {\
  grid-template-columns: repeat(4, 1fr);\
  margin-bottom: 14px;\
}\
\
.grid {\
  grid-template-columns: repeat(4, 1fr);\
}\
\
.card,\
.market-header > div,\
.panel {\
  background: #0d131d;\
  border: 1px solid #1c2735;\
  border-radius: 12px;\
}\
\
.card {\
  padding: 20px;\
}\
\
.card strong {\
  display: block;\
  font-size: 27px;\
  margin: 12px 0 5px;\
}\
\
.card small {\
  color: #738197;\
}\
\
.market-header > div {\
  padding: 16px;\
}\
\
.market-header strong {\
  display: block;\
  margin-top: 8px;\
  font-size: 18px;\
}\
\
.label,\
.metric span {\
  color: #718096;\
  font-size: 11px;\
  font-weight: 800;\
  letter-spacing: 1px;\
}\
\
.panel {\
  margin-top: 14px;\
  padding: 20px;\
}\
\
.panel h2 {\
  margin-top: 0;\
  font-size: 15px;\
  letter-spacing: 1px;\
}\
\
.trade-grid,\
.profile-grid {\
  grid-template-columns: repeat(4, 1fr);\
}\
\
.metric {\
  background: #090f18;\
  border-radius: 8px;\
  padding: 14px;\
}\
\
.metric strong {\
  display: block;\
  margin-top: 7px;\
  font-size: 18px;\
}\
\
.welcome {\
  min-height: 65vh;\
  display: grid;\
  place-content: center;\
  text-align: center;\
}\
\
.welcome h1 {\
  font-size: 42px;\
  margin-bottom: 10px;\
}\
\
.welcome p {\
  color: #7f8da3;\
  max-width: 600px;\
  margin: 0 auto 24px;\
}\
\
.error {\
  padding: 14px;\
  background: #35151a;\
  border: 1px solid #74242f;\
  border-radius: 8px;\
  margin-bottom: 14px;\
}\
\
.neutral {\
  color: #7f8da3;\
}\
\
@media (max-width: 900px) {\
  .market-header,\
  .grid,\
  .trade-grid,\
  .profile-grid {\
    grid-template-columns: repeat(2, 1fr);\
  }\
}\
\
@media (max-width: 600px) {\
  .app {\
    padding: 14px;\
  }\
\
  .topbar {\
    align-items: flex-start;\
    flex-direction: column;\
  }\
\
  .market-header,\
  .grid,\
  .trade-grid,\
  .profile-grid {\
    grid-template-columns: 1fr;\
  }\
\
  .welcome h1 {\
    font-size: 30px;\
  }\
}\
EOF
