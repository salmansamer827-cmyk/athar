\
from api.services.quant_service import QuantService\
from core.data.models import OHLCV\
\
candles = []\
\
for i in range(100):\
    base = 100.0 + i * 0.05\
\
    candles.append(\
        OHLCV(\
            timestamp=1000000000 + i * 900000,\
            open=base,\
            high=base + 1.0,\
            low=base - 1.0,\
            close=base + 0.5,\
            volume=1000.0 + i,\
            symbol="BTC/USDT",\
            market="CRYPTO",\
            timeframe="15m",\
        )\
    )\
\
class Request:\
    symbol = "BTC/USDT"\
    market = "CRYPTO"\
    timeframe = "15m"\
    capital = 100.0\
    entry = None\
    stop_price = None\
    tick_size = None\
    wins = 72\
    losses = 28\
    candles = candles\
\
try:\
    result = QuantService().analyze(Request())\
\
    print("=" * 70)\
    print("CAPITAL WISE QUANT SERVICE OK")\
    print("=" * 70)\
    print(result)\
\
except Exception:\
    print("=" * 70)\
    print("CAPITAL WISE INTERNAL ERROR")\
    print("=" * 70)\
    traceback.print_exc()\
