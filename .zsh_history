: 1790259093:0;cd ~/EXCORA\
\
cat << 'EOF' > public/api.js\
const EXCORA_API =\
    window.EXCORA_API_URL ||\
    "http://127.0.0.1:8000"\;\
\
async function apiRequest(path, options = {}) {\
\
    const config = {\
        method: options.method || "GET",\
        headers: {\
            "Content-Type": "application/json",\
            ...(options.headers || {})\
        }\
    };\
\
    if (options.body !== undefined) {\
        config.body =\
            typeof options.body === "string"\
                ? options.body\
                : JSON.stringify(options.body);\
    }\
\
    const response = await fetch(EXCORA_API + path, config);\
\
    const text = await response.text();\
\
    let data = {};\
\
    try {\
        data = text ? JSON.parse(text) : {};\
    } catch {\
        data = { raw: text };\
    }\
\
    if (!response.ok) {\
        throw new Error(\
            data.detail ||\
            data.message ||\
            `API Error ${response.status}`\
        );\
    }\
\
    return data;\
}\
\
\
/* =========================\
   HEALTH\
========================= */\
\
async function getHealth() {\
    return await apiRequest("/health");\
}\
\
\
/* =========================\
   MARKETS\
========================= */\
\
async function getMarkets() {\
    return await apiRequest("/markets");\
}\
\
\
/* =========================\
   WALLET\
========================= */\
\
async function getWallet(userId, asset) {\
\
    return await apiRequest(\
        `/wallet/${encodeURIComponent(userId)}/${encodeURIComponent(asset)}`\
    );\
}\
\
\
/* =========================\
   ORDER\
========================= */\
\
async function createOrder(order) {\
\
    return await apiRequest("/order", {\
        method: "POST",\
        body: order\
    });\
}\
\
\
/* =========================\
   API TEST\
========================= */\
\
async function checkBackend() {\
\
    try {\
\
        const health = await getHealth();\
\
        console.log(\
            "EXCORA BROKER ONLINE",\
            health\
        );\
\
        return {\
            online: true,\
            data: health\
        };\
\
    } catch (error) {\
\
        console.error(\
            "EXCORA BROKER ERROR",\
            error\
        );\
\
        return {\
            online: false,\
            error: error.message\
        };\
    }\
}\
\
\
/* =========================\
   PUBLIC API\
========================= */\
\
window.EXCORA = {\
\
    API: EXCORA_API,\
\
    request: apiRequest,\
\
    health: getHealth,\
\
    markets: getMarkets,\
\
    wallet: getWallet,\
\
    createOrder: createOrder,\
\
    checkBackend: checkBackend\
};\
EOF
: 1790259108:0;cat << 'EOF' > public/markets.js\
async function loadMarkets() {\
\
    const container =\
        document.querySelector(".ticker-list");\
\
    if (!container) {\
        return;\
    }\
\
    try {\
\
        const result =\
            await EXCORA.markets();\
\
        const markets =\
            result.markets || [];\
\
        if (!markets.length) {\
\
            container.innerHTML = `\
                <div style="\
                    padding:20px;\
                    text-align:center;\
                    color:#848e9c;\
                ">\
                    ك�ا تك�جد أسك�اق ك�تاحة\
                </div>\
            `;\
\
            return;\
        }\
\
        container.innerHTML = markets.map(market => {\
\
            const symbol =\
                market.symbol || "";\
\
            const base =\
                market.base || "";\
\
            const quote =\
                market.quote || "";\
\
            const status =\
                market.status || "";\
\
            return `\
                <div\
                    class="ticker-item"\
                    data-symbol="${symbol}"\
                    onclick="selectMarket('${symbol}')"\
                >\
\
                    <div class="ticker-info">\
\
                        <div class="symbol">\
                            ${base}/${quote}\
                        </div>\
\
                        <div class="name">\
                            ${base}\
                        </div>\
\
                    </div>\
\
                    <div class="ticker-values">\
\
                        <div\
                            class="price"\
                            id="price-${symbol}"\
                        >\
                            --\
                        </div>\
\
                        <div\
                            class="change positive"\
                        >\
                            ${status}\
                        </div>\
\
                    </div>\
\
                </div>\
            `;\
\
        }).join("");\
\
        console.log(\
            "EXCORA MARKETS:",\
            markets\
        );\
\
    } catch (error) {\
\
        console.error(\
            "MARKETS ERROR:",\
            error\
        );\
\
        container.innerHTML = `\
            <div style="\
                padding:20px;\
                text-align:center;\
                color:#f6465d;\
            ">\
                تعذر اك�اتصاك� باك�أسك�اق\
            </div>\
        `;\
    }\
}\
\
\
function selectMarket(symbol) {\
\
    console.log(\
        "Selected market:",\
        symbol\
    );\
\
    const chartSymbol =\
        document.querySelector(\
            ".tradingview-widget-container"\
        );\
\
    if (chartSymbol) {\
        chartSymbol.dataset.symbol =\
            symbol;\
    }\
\
    alert(\
        "تك� اختك�ار اك�سك�ق: " +\
        symbol\
    );\
}\
\
\
document.addEventListener(\
    "DOMContentLoaded",\
    () => {\
\
        setTimeout(\
            loadMarkets,\
            500\
        );\
\
    }\
);\
EOF
