<!DOCTYPE html>\
<html lang="ar" dir="rtl">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>EXCORA - ك�ك�حة اك�تحك�ك� اك�إدارك�ة (Admin Panel)</title>\
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>\
    <style>\
        :root {\
            --bg-color: #0b0e11;\
            --card-bg: #1e2329;\
            --border-color: #2b313a;\
            --accent-color: #f0b90b;\
            --text-main: #eaecef;\
            --text-secondary: #848e9c;\
            --green: #0ecb81;\
            --red: #f6465d;\
        }\
        body {\
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\
            background-color: var(--bg-color);\
            color: var(--text-main);\
            margin: 0;\
            padding: 20px;\
            direction: rtl;\
        }\
        header {\
            background-color: var(--card-bg);\
            border: 1px solid var(--border-color);\
            padding: 15px 20px;\
            border-radius: 10px;\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            margin-bottom: 20px;\
        }\
        .grid {\
            display: grid;\
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\
            gap: 15px;\
        }\
        .card {\
            background-color: var(--card-bg);\
            border: 1px solid var(--border-color);\
            border-radius: 10px;\
            padding: 20px;\
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);\
        }\
        .card h3 {\
            color: var(--accent-color);\
            margin-top: 0;\
            font-size: 16px;\
        }\
        .stat-value {\
            font-size: 24px;\
            font-weight: bold;\
            color: var(--green);\
            margin: 10px 0;\
        }\
        button {\
            background-color: var(--accent-color);\
            color: #000;\
            border: none;\
            padding: 10px 15px;\
            border-radius: 6px;\
            font-weight: bold;\
            cursor: pointer;\
            margin-top: 10px;\
        }\
        button:hover {\
            opacity: 0.9;\
        }\
        .log-box {\
            background-color: #12161c;\
            border: 1px solid var(--border-color);\
            padding: 10px;\
            border-radius: 6px;\
            height: 120px;\
            overflow-y: auto;\
            font-family: monospace;\
            font-size: 11px;\
            color: var(--text-secondary);\
        }\
    </style>\
</head>\
<body>\
\
    <header>\
        <div>\
            <h2>�������︃� EXCORA - ك�ك�حة اك�إدارة ك�اك�تحك�ك� اك�ك�ؤسسك�</h2>\
            <span style="font-size: 12px; color: var(--text-secondary);">ك�راقبة اك�عك�ك�ك�ات اك�حك�ة ك�خك�ادك� اك�سك�ك�ك�ة</span>\
        </div>\
        <div>\
            <span id="serverStatus" style="padding: 6px 12px; background: rgba(14,203,129,0.15); color: var(--green); border-radius: 6px; font-size: 12px;">ك�تصك� باك�خادك�</span>\
        </div>\
    </header>\
\
    <div class="grid">\
        <!-- إحصائك�ات اك�خادك� -->\
        <div class="card">\
            <h3>������� حاك�ة اك�سك�ك�ك�ة اك�حك�ة</h3>\
            <div class="stat-value" id="adminBtcPrice">--</div>\
            <p style="font-size: 12px; color: var(--text-secondary);">أسعار اك�بتك�ك�ك�ك� اك�ك�تدفقة ك�ك�ك�ك�صة حاك�ك�اك� عبر اك�خادك� اك�خك�فك�.</p>\
        </div>\
\
        <!-- إدارة اك�ك�ظاك� -->\
        <div class="card">\
            <h3>⃺��︃� اك�تحك�ك� اك�سرك�ع باك�خادك�</h3>\
            <p style="font-size: 12px; color: var(--text-secondary);">إرساك� إشعار تحدك�ث إجبارك� ك�ك�عك�ك�ا؃� اك�ك�تصك�ك�ك�.</p>\
            <button onclick="sendBroadcast()">إرساك� تك�بك�ك� سك�ك�ك�ة عاك�</button>\
        </div>\
\
        <!-- سجك�ات اك�عك�ك�ك�ات -->\
        <div class="card" style="grid-column: span 2;">\
            <h3>������� سجك� اك�أك�شطة ك�اك�اتصاك�ات اك�حك�ة</h3>\
            <div class="log-box" id="logBox">\
                [اك�ك�ظاك�] جارك� اك�استك�اع ك�أحداث خادك� EXCORA...<br>\
            </div>\
        </div>\
    </div>\
\
    <script>\
        const socket = io('http://localhost:5000');\
        const logBox = document.getElementById('logBox');\
\
        function addLog(msg) {\
            logBox.innerHTML += `[${new Date().toLocaleTimeString()}] ${msg}<br>`;\
            logBox.scrollTop = logBox.scrollHeight;\
        }\
\
        socket.on('connect', () => {\
            addLog('اتصك� بك�جاح ك�ع خادك� اك�خك�فك�ة (Backend).');\
        });\
\
        socket.on('marketUpdate', (data) => {\
            if(data.btc) {\
                document.getElementById('adminBtcPrice').innerText = '$' + data.btc.price.toLocaleString();\
            }\
        });\
\
        function sendBroadcast() {\
            addLog('تك� إرساك� إشعار سك�ك�ك�ة ك�ؤسسك� جدك�د ك�جك�ك�ع اك�ك�ستخدك�ك�ك� بك�جاح.');\
            alert('⃺�� تك� بث اك�تك�بك�ك� بك�جاح ك�ك�ك�ستخدك�ك�ك� اك�ك�تصك�ك�ك�.');\
        }\
    </script>\
</body>\
</html>\
EOF\

