cat > backend/services/futures_margin_service.py <<'PY'\
from decimal import Decimal\
\
from backend.services.wallet_service import WalletService\
\
\
class FuturesMarginService:\
\
    def __init__(self, wallet_service=None):\
        self.wallet = wallet_service or WalletService()\
\
    # =====================================================\
    # INITIAL MARGIN\
    # =====================================================\
\
    @staticmethod\
    def calculate_initial_margin(\
        quantity,\
        entry_price,\
        leverage: int\
    ) -> Decimal:\
\
        quantity = Decimal(str(quantity))\
        entry_price = Decimal(str(entry_price))\
\
        if quantity <= 0:\
            raise ValueError("Quantity must be greater than zero")\
\
        if entry_price <= 0:\
            raise ValueError("Entry price must be greater than zero")\
\
        if leverage < 1:\
            raise ValueError("Leverage must be at least 1")\
\
        notional = quantity * entry_price\
\
        return notional / Decimal(str(leverage))\
\
    # =====================================================\
    # RESERVE MARGIN\
    # =====================================================\
\
    def reserve_margin(\
        self,\
        user_id: str,\
        amount\
    ):\
\
        amount = Decimal(str(amount))\
\
        if amount <= 0:\
            raise ValueError(\
                "Margin amount must be greater than zero"\
            )\
\
        return self.wallet.lock(\
            user_id=user_id,\
            asset="USDT",\
            amount=amount\
        )\
\
    # =====================================================\
    # RELEASE MARGIN\
    # =====================================================\
\
    def release_margin(\
        self,\
        user_id: str,\
        amount\
    ):\
\
        amount = Decimal(str(amount))\
\
        if amount <= 0:\
            raise ValueError(\
                "Margin amount must be greater than zero"\
            )\
\
        return self.wallet.release(\
            user_id=user_id,\
            asset="USDT",\
            amount=amount\
        )\
PY\
