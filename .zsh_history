\
TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")\
TELEGRAM_CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")\
BINANCE_API_KEY = os.getenv("BINANCE_API_KEY")\
BINANCE_SECRET_KEY = os.getenv("BINANCE_SECRET_KEY")\
\
# إعداد رأس اك�ك�اك� ك�اك�ك�خاطرة ك�إعدادات ATR ك�اك�تأك�ك�ك�\
INITIAL_CAPITAL = 100.0     \
RISK_PERCENT = 0.01         \
REWARD_RATIO = 3.0          \
ATR_MULTIPLIER = 1.5        \
BREAKEVEN_TRIGGER_PCT = 1.0 \
\
# تخصك�ص اك�بك�ت ك�ك�تداك�ك� عك�ك� اك�ذك�ب فقط (ك�ع إك�ك�اك�ك�ة تك�سك�ع اك�فك�اتر ك�احقاك� ك�رفع دقة اك�دخك�ك�)\
SYMBOLS = [\
    'XAUUSDT'\
]\
\
binance_exchange = ccxt.binance({\
    'apiKey': BINANCE_API_KEY,\
    'secret': BINANCE_SECRET_KEY,\
    'enableRateLimit': True,\
    'options': {'defaultType': 'future', 'recvWindow': 60000, 'adjustForTimeDifference': True}\
})\
\
def sign_tradfi_agreement():\
    try:\
        response = binance_exchange.request('stock/contract', 'fapiPrivate', 'POST', {})\
        print("[+] تك� تك�قك�ع اتفاقك�ة TradFi-Perps بك�جاح:", response)\
    except Exception as e:\
        print("[*] حاك�ة اتفاقك�ة TradFi (تك� تخطك�ك�ا بأك�اك�):", e)\
\
_previous_active_symbols = set()\
secured_trades = set()\
executed_symbols_cache = set() # سجك� ك�ك�ك�ع تك�رار اك�صفقات ك�ك�فس اك�عك�ك�ة\
\
def send_telegram_message(message):\
    try:\
        url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"\
        payload = {"chat_id": TELEGRAM_CHAT_ID, "text": message, "parse_mode": "Markdown"}\
        requests.post(url, json=payload, timeout=10)\
    except Exception as e:\
        print(f"[-] خطأ فك� إرساك� تك�ك�ك�جراك�: {e}")\
\
def check_internet_connection(host="fapi.binance.com", port=443, timeout=4):\
    try:\
        socket.setdefaulttimeout(timeout)\
        socket.socket(socket.AF_INET, socket.SOCK_STREAM).connect((host, port))\
        return True\
    except socket.error:\
        try:\
            socket.socket(socket.AF_INET, socket.SOCK_STREAM).connect(("8.8.8.8", 53))\
            return True\
        except socket.error:\
            return False\
\
