from core.risk.adaptive import AdaptiveRiskEngine\
\
engine = AdaptiveRiskEngine(\
    base_risk_percent=0.01,\
    base_reward_risk=3.0,\
)\
\
tests = [\
    ("WEAK", 0.52, 0.30, 1.00, 0.0),\
    ("NORMAL", 0.60, 0.20, 1.00, 0.0),\
    ("GOOD", 0.66, 0.15, 1.00, 0.0),\
    ("STRONG", 0.72, 0.10, 1.00, 0.0),\
    ("HIGH VOL", 0.66, 0.15, 2.00, 0.0),\
    ("DRAWDOWN", 0.66, 0.15, 1.00, 10.0),\
]\
\
print("=" * 75)\
print("EXCORA AUTO ADAPTIVE RISK TEST")\
print("=" * 75)\
\
for name, probability, uncertainty, volatility, drawdown in tests:\
\
    result = engine.calculate(\
        probability=probability,\
        uncertainty=uncertainty,\
        volatility_ratio=volatility,\
        drawdown_percent=drawdown,\
    )\
\
    print(f"\n{name}")\
    print("-" * 40)\
    print(f"Probability       : {probability:.2%}")\
    print(f"Uncertainty       : {uncertainty:.2%}")\
    print(f"Volatility Ratio  : {volatility:.2f}")\
    print(f"Drawdown          : {drawdown:.2f}%")\
    print(f"Risk              : {result.risk_percent:.4%}")\
    print(f"RR                : {result.reward_risk:.2f}")\
    print(f"Risk Score        : {result.risk_score:.2f}")\
    print(f"Allowed           : {result.allowed}")\
\
print("\n" + "=" * 75)\
print("STATUS: ADAPTIVE ENGINE TEST COMPLETE")\
print("=" * 75)\
