                    statusDiv.innerText = 'فشك� اك�تك�فك�ذ: ' + (data.error || 'خطأ غك�ر ك�عرك�ف');\
                }\
            } catch (e) {\
                statusDiv.style.color = 'var(--accent-red)';\
                statusDiv.innerText = 'خطأ فك� اك�اتصاك� باك�خادك�.';\
            }\
        }\
\
        async function fetchActivePositions() {\
            const container = document.getElementById('positionsContainer');\
            try {\
                const res = await fetch('/api/positions');\
                const data = await res.json();\
                if (data.success && data.positions.length > 0) {\
                    let html = '';\
                    data.positions.forEach(pos => {\
                        const pnl = parseFloat(pos.unRealizedProfit || 0);\
                        const pnlColor = pnl >= 0 ? 'var(--accent-green)' : 'var(--accent-red)';\
                        const sideText = parseFloat(pos.positionAmt) > 0 ? 'LONG' : 'SHORT';\
                        html += `<div class="card">\
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">\
                                <span style="font-weight: bold; color: var(--text-primary);">${pos.symbol}</span>\
                                <span style="color: ${pnlColor}; font-weight: bold;">${sideText}</span>\
                            </div>\
                            <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-secondary); margin-bottom: 4px;">\
                                <span>اك�ك�ك�ك�ة:</span>\
                                <span>${pos.positionAmt}</span>\
                            </div>\
                            <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-secondary);">\
                                <span>اك�ربح/اك�خسارة:</span>\
                                <span style="color: ${pnlColor}; font-weight: bold;">${pnl.toFixed(2)} USDT</span>\
                            </div>\
                        </div>`;\
                    });\
                    container.innerHTML = html;\
                } else {\
                    container.innerHTML = `<div class="card" style="text-align: center; color: var(--text-secondary);">ك�ا تك�جد عقك�د ك�فتك�حة حاك�ك�اك�.</div>`;\
                }\
            } catch (e) { container.innerHTML = `<div class="card" style="text-align: center; color: var(--accent-red);">فشك� اك�اتصاك� بجك�ب اك�ك�راك�ز.</div>`; }\
        }\
\
        fetchMarketPrice();\
        fetchRealBalance();\
        setInterval(fetchMarketPrice, 5000);\
        setInterval(fetchRealBalance, 10000);\
    </script>\
</body>\
</html>\
