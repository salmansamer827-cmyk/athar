            <button class="tab-btn" onclick="switchMarket('commodities', event)">�������︃� اك�سك�ع ك�اك�ذك�ب</button>\
            <button class="tab-btn" onclick="switchMarket('stocks', event)">������� اك�أسك�ك� اك�عاك�ك�ك�ة</button>\
        </nav>\
\
        <!-- ك�حتك�ك� اك�تك�صك�ات ك�اك�تحك�ك�ك�ات اك�حك�ة -->\
        <main class="dashboard">\
            <section class="signals-section">\
                <h2>تك�صك�ات اك�ذك�ا؃� اك�اصطك�اعك� اك�حك�ة (SMC & Volume Profile)</h2>\
                <div id="signalsContainer" class="signals-grid">\
                    <p class="loading">جارك� تحك�ك�ك� اك�سك�ك�ك�ة ك�تك�ك�ك�د اك�صفقات اك�ك�حظك�ة...</p>\
                </div>\
            </section>\
        </main>\
    </div>\
\
    <script>\
        let currentMarket = 'crypto';\
\
        const marketData = {\
            crypto: [\
                { symbol: 'BTC/USDT', type: 'LONG', entry: 64250, tp: 66800, sl: 63400, confidence: '97%', reason: 'Smart Money BOS + Fair Value Gap Fill' },\
                { symbol: 'ETH/USDT', type: 'SHORT', entry: 3460, tp: 3300, sl: 3530, confidence: '92%', reason: 'Volume Profile Point of Control Rejection' },\
                { symbol: 'SOL/USDT', type: 'LONG', entry: 148.5, tp: 158.0, sl: 144.0, confidence: '95%', reason: 'Order Block Mitigation + Liquidity Sweep' }\
            ],\
            forex: [\
                { symbol: 'EUR/USD', type: 'LONG', entry: 1.0865, tp: 1.0940, sl: 1.0830, confidence: '94%', reason: 'Institutional Order Block Re-test' },\
                { symbol: 'GBP/USD', type: 'SHORT', entry: 1.2750, tp: 1.2640, sl: 1.2790, confidence: '90%', reason: 'Premium Zone Bearish Mitigation' },\
                { symbol: 'USD/JPY', type: 'LONG', entry: 155.20, tp: 157.00, sl: 154.50, confidence: '93%', reason: 'Asian Session Liquidity Grab' }\
            ],\
            commodities: [\
                { symbol: 'XAU/USD (Gold)', type: 'LONG', entry: 2385.0, tp: 2420.0, sl: 2370.0, confidence: '98%', reason: 'Smart Money Accumulation + Volume POC' },\
                { symbol: 'USOIL', type: 'SHORT', entry: 78.40, tp: 75.20, sl: 79.80, confidence: '89%', reason: 'Market Structure Shift (MSS) Downward' }\
            ],\
            stocks: [\
                { symbol: 'AAPL', type: 'LONG', entry: 216.5, tp: 226.0, sl: 212.0, confidence: '92%', reason: 'Break of Structure (BOS) + Institutional Buying' },\
                { symbol: 'TSLA', type: 'SHORT', entry: 242.0, tp: 225.0, sl: 249.0, confidence: '88%', reason: 'Fair Value Gap Resistance Rejection' }\
            ]\
        };\
\
        function switchMarket(market, event) {\
            currentMarket = market;\
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));\
            event.target.classList.add('active');\
            renderSignals();\
        }\
\
        function renderSignals() {\
            const container = document.getElementById('signalsContainer');\
            const signals = marketData[currentMarket] || [];\
\
            container.innerHTML = signals.map(sig => {\
                // ك�حاك�اة ك�بض اك�أسعار طك�اك� اك�ك�قت\
                const liveEntry = (sig.entry + (Math.random() * 2 - 1)).toFixed(2);\
                return `\
                    <div class="signal-card ${sig.type.toLowerCase()}">\
                        <div class="sig-header">\
                            <span class="symbol">${sig.symbol}</span>\
                            <span class="type-badge ${sig.type.toLowerCase()}">${sig.type}</span>\
                        </div>\
                        <div class="sig-details">\
                            <p><strong>سعر اك�دخك�ك� اك�ك�باشر:</strong> <span class="live-price">${liveEntry}</span></p>\
                            <p><strong>اك�ك�دف (TP):</strong> ${sig.tp}</p>\
                            <p><strong>ك�قف اك�خسارة (SL):</strong> ${sig.sl}</p>\
                            <p><strong>ك�سبة اك�ثقة:</strong> <span class="confidence">${sig.confidence}</span></p>\
                        </div>\
                        <div class="sig-reason"><strong>اك�تحك�ك�ك� اك�فك�ك�:</strong> ${sig.reason}</div>\
                    </div>\
                `;\
            }).join('');\
        }\
\
        // تحدك�ث اك�بك�اك�ات ك�ك�بض اك�أسعار ك�ك� 3 ثك�اك�ك� تك�قائك�اك� ك�جعك� اك�ك�ك�صة تك�بض باك�حك�اة\
        setInterval(renderSignals, 3000);\
        renderSignals();\
    </script>\
</body>\
</html>\
