import 'package:http/http.dart' as http;\
import 'dart:convert';\
\
class ExcoraApiService {\
  static const String baseUrl = 'http://10.0.2.2:8000'\;\
\
  static Future<List<dynamic>?> fetchExcoraMarketData() async {\
    try {\
      final response = await http.get(Uri.parse('$baseUrl/api/market-analysis'));\
      if (response.statusCode == 200) {\
        final decodedData = jsonDecode(response.body);\
        return decodedData['data'];\
      }\
    } catch (e) {\
      print('Error: $e');\
    }\
    return null;\
  }\
}\
