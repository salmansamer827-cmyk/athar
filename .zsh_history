            padding: 12px;\
            border-radius: 6px;\
            font-weight: bold;\
            width: 100%;\
            cursor: pointer;\
            margin-top: 10px;\
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);\
            transition: background-color 0.2s;\
        }\
        .btn-action:hover {\
            background-color: #0ea5e9;\
        }\
\
        /* تذك�ك�ك� اك�صفحة (Footer) ك�ع اك�شعار اك�ك�دك�ج */\
        .footer-branding {\
            text-align: center;\
