from decimal import Decimal\
\
from backend.exchange.services.wallet_service import WalletService\
from backend.exchange.services.settlement_service import SettlementService\
from backend.exchange.models.trade import Trade\
\
\
wallet = WalletService()\
settlement = SettlementService(wallet)\
\
buyer = "user_001"\
seller = "user_002"\
\
# Buyer ك�دك�ك� 100 USDT\
wallet.deposit(\
    buyer,\
    "USDT",\
    Decimal("100")\
)\
\
# Seller ك�دك�ك� 0.001 BTC\
wallet.deposit(\
    seller,\
    "BTC",\
    Decimal("0.001")\
)\
\
# حجز أك�ك�اك� اك�ك�شترك�\
wallet.lock(\
    buyer,\
    "USDT",\
    Decimal("10")\
)\
\
# حجز BTC ك�ك�بائع\
wallet.lock(\
    seller,\
    "BTC",\
    Decimal("0.001")\
)\
\
print("BEFORE SETTLEMENT")\
\
print(\
    "BUYER USDT:",\
    wallet.get_wallet(buyer, "USDT").available,\
    "available /",\
    wallet.get_wallet(buyer, "USDT").locked,\
    "locked"\
)\
\
print(\
    "SELLER BTC:",\
    wallet.get_wallet(seller, "BTC").available,\
    "available /",\
    wallet.get_wallet(seller, "BTC").locked,\
    "locked"\
)\
\
trade = Trade.create(\
    symbol="BTC/USDT",\
    buyer_user_id=buyer,\
    seller_user_id=seller,\
    buyer_order_id="BUY-001",\
    seller_order_id="SELL-001",\
    price=Decimal("10000"),\
    quantity=Decimal("0.001"),\
)\
\
result = settlement.settle_trade(trade)\
\
print("\nTRADE SETTLED")\
print("Trade ID:", result["trade_id"])\
print("Quote Amount:", result["quote_amount"])\
\
print("\nAFTER SETTLEMENT")\
\
buyer_usdt = wallet.get_wallet(buyer, "USDT")\
buyer_btc = wallet.get_wallet(buyer, "BTC")\
\
seller_usdt = wallet.get_wallet(seller, "USDT")\
seller_btc = wallet.get_wallet(seller, "BTC")\
\
print(\
    "BUYER USDT:",\
    buyer_usdt.available,\
    "available /",\
    buyer_usdt.locked,\
    "locked"\
)\
\
print(\
    "BUYER BTC:",\
    buyer_btc.available,\
    "available /",\
    buyer_btc.locked,\
    "locked"\
)\
\
print(\
    "SELLER USDT:",\
    seller_usdt.available,\
    "available /",\
    seller_usdt.locked,\
    "locked"\
)\
\
print(\
    "SELLER BTC:",\
    seller_btc.available,\
    "available /",\
    seller_btc.locked,\
    "locked"\
)\
