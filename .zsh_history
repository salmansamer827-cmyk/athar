@app.get("/futures/risk/{position_id}")\
def get_futures_position_risk(position_id: int):\
\
    try:\
\
        result = futures_risk_service.get_position_risk(\
            position_id\
        )\
\
        return {\
            "success": True,\
            "risk": result,\
        }\
\
    except ValueError as exc:\
\
        raise HTTPException(\
            status_code=404,\
            detail=str(exc),\
        )\
\
    except Exception as exc:\
\
        raise HTTPException(\
            status_code=500,\
            detail=str(exc),\
        )\
\
\
@app.get("/futures/risk/user/{user_id}")\
def get_futures_user_risk(user_id: str):\
\
    try:\
\
        result = futures_risk_service.get_user_risk(\
            user_id\
        )\
\
        return {\
            "success": True,\
            "user_id": user_id,\
            "positions": result,\
        }\
\
    except Exception as exc:\
\
        raise HTTPException(\
            status_code=500,\
            detail=str(exc),\
        )\
