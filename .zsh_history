                        <span class="lbl">اك�سعر اك�أخك�ر</span>\
                        <span class="val up" id="topPrice">64,250.00</span>\
                    </div>\
                    <div class="stat-block">\
                        <span class="lbl">اك�تغك�ر خك�اك� 24س</span>\
                        <span class="val up">+2.45%</span>\
                    </div>\
                    <div class="stat-block">\
                        <span class="lbl">أعك�ك� سعر 24س</span>\
                        <span class="val">65,100.00</span>\
                    </div>\
                    <div class="stat-block">\
                        <span class="lbl">حجك� اك�تداك�ك� 24س (USDT)</span>\
                        <span class="val">1,425,890.50</span>\
                    </div>\
                </div>\
            </div>\
            <div class="header-right">\
                <div class="wallet-badge">\
                    <span>اك�رصك�د اك�ك�تاح:</span>\
                    <strong>$100,000.00 USDT</strong>\
                </div>\
                <div class="user-profile-icon">������� ساك�ر سك�ك�اك�</div>\
            </div>\
        </header>\
\
        <!-- ك�ك�حة اك�تداك�ك� اك�رئك�سك�ة (Grid ك�شابك� ك�بك�ك�اك�س) -->\
        <main class="binance-workspace">\
            \
            <!-- 1. قائك�ة اك�أسك�اق اك�جاك�بك�ة (Market Watch) -->\
            <aside class="panel market-watch">\
                <div class="panel-tabs">\
                    <button class="tab-btn active" onclick="switchTab('crypto')">اك�عك�ك�ات</button>\
                    <button class="tab-btn" onclick="switchTab('futures')">اك�عقك�د اك�؃�جك�ة</button>\
                    <button class="tab-btn" onclick="switchTab('favorites')">اك�ك�فضك�ة</button>\
                </div>\
                <div class="search-box">\
                    <input type="text" placeholder="بحث عك� أصك� (ك�ثاك�: BTC)..." id="searchAsset" onkeyup="filterAssets()">\
                </div>\
                <div class="markets-scroll-list" id="marketsList">\
                    <!-- تعبئة دك�ك�اك�ك�ك�ك�ة -->\
                </div>\
            </aside>\
\
            <!-- 2. ك�ك�طقة اك�رسك� اك�بك�اك�ك� ك�اك�تحك�ك�ك� (TradingView Style Center) -->\
            <section class="panel center-chart-area">\
                <div class="chart-top-toolbar">\
                    <div class="timeframes">\
                        <button class="tf-btn">1د</button>\
                        <button class="tf-btn">15د</button>\
                        <button class="tf-btn active">1س</button>\
                        <button class="tf-btn">4س</button>\
                        <button class="tf-btn">1ك�</button>\
                    </div>\
                    <div class="indicators-selector">\
                        <span>ك�ؤشرات:</span>\
                        <span class="ind-tag">SMC</span>\
                        <span class="ind-tag">Volume Profile</span>\
                        <span class="ind-tag">EMA 200</span>\
                    </div>\
                </div>\
                <div class="main-chart-screen">\
                    <div class="chart-watermark">EXCORA ADVANCED CHART ENGINE</div>\
                    <div class="live-price-overlay">\
                        <h2 id="centerPriceDisplay">64,250.00</h2>\
                        <p>تحدك�ث ك�حظك� ك�بك�اك�ات اك�سك�ق اك�ك�باشرة</p>\
                    </div>\
                </div>\
                <!-- سجك� اك�صفقات اك�ك�فتك�حة ك�أك�اك�ر اك�ك�ستخدك� -->\
                <div class="user-positions-table">\
                    <div class="table-header-tabs">\
                        <span class="active">اك�صفقات اك�ك�فتك�حة (0)</span>\
                        <span>سجك� اك�أك�اك�ر</span>\
                        <span>سجك� اك�تداك�ك�</span>\
                        <span>اك�أصك�ك�</span>\
                    </div>\
                    <div class="table-empty-state">\
                        ك�ا تك�جد صفقات ك�فتك�حة حاك�ك�اك�. اختر حجك�اك� ك�ك�فذ صفقتك� اك�أك�ك�ك�.\
                    </div>\
                </div>\
            </section>\
\
            <!-- 3. دفتر اك�طك�بات (Order Book) -->\
            <aside class="panel order-book-panel">\
                <div class="panel-title">دفتر اك�طك�بات (Order Book)</div>\
                <div class="ob-header-row">\
                    <span>اك�سعر (USDT)</span>\
                    <span>اك�ك�ك�ك�ة</span>\
                    <span>اك�ك�جك�ك�ع</span>\
                </div>\
                <!-- طك�بات اك�بك�ع (عاك�ك�ة) -->\
                <div class="asks-list" id="asksList"></div>\
                <!-- اك�سعر اك�حاك�ك� فك� اك�ك�ك�تصف -->\
                <div class="current-price-banner">\
                    <span id="obCurrentPrice" class="up">64,250.00 USD</span>\
                    <span class="spread">اك�سبرك�د: 0.1</span>\
                </div>\
                <!-- طك�بات اك�شرا؃� (ك�ك�خفضة) -->\
                <div class="bids-list" id="bidsList"></div>\
            </aside>\
\
            <!-- 4. ك�ك�حة تك�فك�ذ اك�صفقات (Spot/Futures Order Form ك�ثك� بك�ك�اك�س) -->\
            <aside class="panel trade-execution-panel">\
                <div class="order-type-tabs">\
                    <button class="otype-btn active" onclick="setOrderType('CROSS')">Cross 10x</button>\
                    <button class="otype-btn" onclick="setOrderType('ISOLATED')">Isolated</button>\
                </div>\
\
                <div class="order-mode-selector">\
                    <span class="omode active" onclick="setMode('limit')">Limit</span>\
                    <span class="omode" onclick="setMode('market')">Market</span>\
                    <span class="omode" onclick="setMode('stop')">Stop-Limit</span>\
                </div>\
\
                <div class="form-group" id="priceInputGroup">\
                    <label>سعر اك�دخك�ك� (Limit Price)</label>\
                    <div class="input-with-unit">\
                        <input type="number" id="limitPriceVal" value="64250.00">\
                        <span>USDT</span>\
                    </div>\
                </div>\
\
                <div class="form-group">\
                    <label>اك�ك�ك�ك�ة (Amount)</label>\
                    <div class="input-with-unit">\
                        <input type="number" id="orderAmount" value="0.5" step="0.01" oninput="calculateTotal()">\
                        <span id="assetUnitLabel">BTC</span>\
                    </div>\
                </div>\
\
                <div class="slider-container">\
                    <input type="range" min="0" max="100" value="25" class="percentage-slider" id="fundSlider">\
                    <div class="slider-marks">\
                        <span>25%</span><span>50%</span><span>75%</span><span>100%</span>\
                    </div>\
                </div>\
\
                <div class="total-estimation">\
                    <span>اك�إجك�اك�ك� اك�تقدك�رك�:</span>\
                    <strong id="estimatedTotal">32,125.00 USDT</strong>\
                </div>\
\
                <!-- أزرار اك�تك�فك�ذ اك�ك�طابقة ك�بك�ك�اك�س تك�اك�اك� -->\
                <div class="binance-action-buttons">\
                    <button class="btn-binance-buy" onclick="placeOrder('BUY')">\
                        شرا؃� / دخك�ك� طك�ك�ك� (LONG)\
                    </button>\
                    <button class="btn-binance-sell" onclick="placeOrder('SELL')">\
                        بك�ع / دخك�ك� قصك�ر (SHORT)\
                    </button>\
                </div>\
            </aside>\
\
        </main>\
    </div>\
\
    <script>\
        let selectedSymbol = 'BTC/USDT';\
        let currentPriceNum = 64250.00;\
\
        const marketData = {\
            crypto: [\
                { symbol: 'BTC/USDT', price: '64,250.00', change: '+2.45%' },\
                { symbol: 'ETH/USDT', price: '3,460.00', change: '+1.80%' },\
                { symbol: 'SOL/USDT', price: '148.50', change: '-0.50%' },\
                { symbol: 'BNB/USDT', price: '585.20', change: '+1.10%' },\
                { symbol: 'XRP/USDT', price: '0.5820', change: '+3.40%' },\
                { symbol: 'ADA/USDT', price: '0.3950', change: '-1.20%' },\
                { symbol: 'DOGE/USDT', price: '0.1240', change: '+4.80%' }\
            ],\
            futures: [\
                { symbol: 'BTCUSDT-PERP', price: '64,260.00', change: '+2.48%' },\
                { symbol: 'ETHUSDT-PERP', price: '3,462.50', change: '+1.85%' },\
                { symbol: 'SOLUSDT-PERP', price: '148.70', change: '-0.45%' }\
            ],\
            favorites: [\
                { symbol: 'BTC/USDT', price: '64,250.00', change: '+2.45%' },\
                { symbol: 'ETH/USDT', price: '3,460.00', change: '+1.80%' }\
            ]\
        };\
\
        function switchTab(tabName) {\
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\
            event.target.classList.add('active');\
            renderMarketList(tabName);\
        }\
\
        function renderMarketList(category = 'crypto') {\
            const container = document.getElementById('marketsList');\
            const items = marketData[category] || [];\
            \
            container.innerHTML = items.map(item => `\
                <div class="market-row" onclick="selectAssetPair('${item.symbol}', '${item.price}')">\
                    <span class="m-sym">${item.symbol}</span>\
                    <span class="m-prc">${item.price}</span>\
                    <span class="m-chg ${item.change.includes('+') ? 'up' : 'down'}">${item.change}</span>\
                </div>\
            `).join('');\
        }\
\
        function selectAssetPair(symbol, price) {\
            selectedSymbol = symbol;\
            currentPriceNum = parseFloat(price.replace(/,/g, ''));\
            document.getElementById('activePairTitle').innerText = symbol;\
            document.getElementById('topPrice').innerText = price;\
            document.getElementById('centerPriceDisplay').innerText = price;\
            document.getElementById('obCurrentPrice').innerText = price + ' USD';\
            document.getElementById('limitPriceVal').value = price;\
            document.getElementById('assetUnitLabel').innerText = symbol.split('/')[0];\
            generateOrderBook();\
            calculateTotal();\
        }\
\
        function generateOrderBook() {\
            let asksHTML = '';\
            let bidsHTML = '';\
            \
            // تك�ك�ك�د طك�بات اك�بك�ع اك�ك�ك�ك�ك�ة فك�ق اك�سعر اك�حاك�ك�\
            for(let i = 5; i >= 1; i--) {\
                let askP = (currentPriceNum + i * 2.5).toFixed(2);\
                let askQ = (Math.random() * 1.5).toFixed(4);\
                asksHTML += `\
                    <div class="ob-row ask">\
                        <span class="price-val">${askP}</span>\
                        <span class="qty-val">${askQ}</span>\
                        <span class="depth-bar" style="width: ${Math.random()*80}%"></span>\
                    </div>\
                `;\
            }\
\
            // تك�ك�ك�د طك�بات اك�شرا؃� اك�ك�ك�ك�ك�ة تحت اك�سعر اك�حاك�ك�\
            for(let i = 1; i <= 5; i++) {\
                let bidP = (currentPriceNum - i * 2.5).toFixed(2);\
                let bidQ = (Math.random() * 1.5).toFixed(4);\
                bidsHTML += `\
                    <div class="ob-row bid">\
                        <span class="price-val">${bidP}</span>\
                        <span class="qty-val">${bidQ}</span>\
                        <span class="depth-bar" style="width: ${Math.random()*80}%"></span>\
                    </div>\
                `;\
            }\
\
            document.getElementById('asksList').innerHTML = asksHTML;\
            document.getElementById('bidsList').innerHTML = bidsHTML;\
        }\
\
        function calculateTotal() {\
            let qty = parseFloat(document.getElementById('orderAmount').value) || 0;\
            let total = (qty * currentPriceNum).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\
            document.getElementById('estimatedTotal').innerText = total + ' USDT';\
        }\
\
        function setMode(mode) {\
            document.querySelectorAll('.omode').forEach(m => m.classList.remove('active'));\
            event.target.classList.add('active');\
            const priceGrp = document.getElementById('priceInputGroup');\
            if(mode === 'market') {\
                priceGrp.style.display = 'none';\
            } else {\
                priceGrp.style.display = 'block';\
            }\
        }\
\
        function placeOrder(type) {\
            let qty = document.getElementById('orderAmount').value;\
            let actionName = type === 'BUY' ? 'شرا؃� (LONG)' : 'بك�ع (SHORT)';\
            alert(`تك� إرساك� أك�ر اك�ـ ${actionName} بك�جاح ك�ك�أصك� ${selectedSymbol} باك�ك�ك�ك�ة ${qty} عبر ك�حطة EXCORA اك�ك�تطك�رة.`);\
        }\
\
        // اك�تك�ك�ئة اك�أك�ك�ك�ة\
        renderMarketList('crypto');\
        generateOrderBook();\
        calculateTotal();\
    </script>\
</body>\
</html>\
EOF\
\
# تصك�ك�ك� ك�اجك�ة بك�ك�اك�س باك�أزرق ك�اك�أبك�ض اك�داك�ك� (Binance Dark Blue & White Theme)\
cat << 'EOF' > public/style.css\
* {\
    box-sizing: border-box;\
    margin: 0;\
    padding: 0;\
    font-family: 'IBM Plex Sans Arabic', sans-serif;\
}\
body {\
    background-color: #0b0e11; /* ك�ك�ك� خك�فك�ة بك�ك�اك�س اك�داك�ك� اك�أصك�ك� */\
    color: #eaecef;\
    direction: rtl;\
    overflow-x: hidden;\
}\
.binance-container {\
    display: flex;\
    flex-direction: column;\
    height: 100vh;\
    padding: 8px;\
    gap: 8px;\
}\
/* اك�شرك�ط اك�عك�ك�ك� */\
.binance-header {\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    background: #181a20;\
    padding: 10px 16px;\
    border-radius: 6px;\
    border: 1px solid #23272e;\
}\
.header-left {\
    display: flex;\
    align-items: center;\
    gap: 25px;\
}\
.logo {\
    font-size: 18px;\
    font-weight: 700;\
    color: #0052ff; /* أزرق بك�ك�اك�س اك�ك�ضك�؃� */\
}\
.logo span { color: #fff; }\
.pair-selector {\
    display: flex;\
    flex-direction: column;\
}\
.pair-selector span#activePairTitle {\
    font-size: 16px;\
    font-weight: 700;\
    color: #fff;\
}\
.pair-tag {\
    font-size: 10px;\
    color: #848e9c;\
}\
.header-ticker-stats {\
    display: flex;\
    gap: 20px;\
}\
.stat-block {\
    display: flex;\
    flex-direction: column;\
}\
.stat-block .lbl {\
    font-size: 11px;\
    color: #848e9c;\
}\
.stat-block .val {\
    font-size: 13px;\
    font-weight: 600;\
}\
.stat-block .val.up { color: #0ecb81; }\
.header-right {\
    display: flex;\
    align-items: center;\
    gap: 20px;\
}\
.wallet-badge {\
    background: #23272e;\
    padding: 6px 12px;\
    border-radius: 4px;\
    font-size: 12px;\
}\
.wallet-badge strong { color: #0052ff; }\
.user-profile-icon {\
    font-size: 13px;\
    color: #f0b90b;\
    font-weight: 600;\
}\
\
/* ك�ساحة اك�عك�ك� اك�رئك�سك�ة Grid ك�طابقة ك�بك�ك�اك�س */\
.binance-workspace {\
    display: grid;\
    grid-template-columns: 260px 1fr 280px 300px;\
    gap: 8px;\
    flex: 1;\
    height: calc(100vh - 75px);\
}\
.panel {\
    background: #181a20;\
    border: 1px solid #23272e;\
    border-radius: 6px;\
    display: flex;\
    flex-direction: column;\
    overflow: hidden;\
}\
\
/* 1. قائك�ة اك�أسك�اق */\
.panel-tabs {\
    display: flex;\
    border-bottom: 1px solid #23272e;\
}\
.tab-btn {\
    flex: 1;\
    background: transparent;\
    border: none;\
    color: #848e9c;\
    padding: 10px 0;\
    font-size: 12px;\
    cursor: pointer;\
    font-weight: 600;\
}\
.tab-btn.active {\
    color: #fff;\
    border-bottom: 2px solid #0052ff;\
}\
.search-box {\
    padding: 8px;\
}\
.search-box input {\
    width: 100%;\
    background: #0b0e11;\
    border: 1px solid #23272e;\
    padding: 6px 10px;\
    border-radius: 4px;\
    color: #fff;\
    font-size: 12px;\
}\
.markets-scroll-list {\
    flex: 1;\
    overflow-y: auto;\
}\
.market-row {\
    display: flex;\
    justify-content: space-between;\
    padding: 8px 12px;\
    font-size: 12px;\
    cursor: pointer;\
    border-bottom: 1px solid #181a20;\
}\
.market-row:hover { background: #23272e; }\
.market-row .m-sym { font-weight: 600; color: #fff; }\
.market-row .m-chg.up { color: #0ecb81; }\
.market-row .m-chg.down { color: #f6465d; }\
\
/* 2. ك�ك�طقة اك�رسك� اك�بك�اك�ك� */\
.chart-top-toolbar {\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    padding: 8px 12px;\
    border-bottom: 1px solid #23272e;\
}\
.timeframes { display: flex; gap: 5px; }\
.tf-btn {\
    background: transparent;\
    border: none;\
    color: #848e9c;\
    padding: 4px 8px;\
    font-size: 11px;\
    cursor: pointer;\
    border-radius: 3px;\
}\
.tf-btn.active, .tf-btn:hover { background: #23272e; color: #fff; }\
.indicators-selector { display: flex; gap: 8px; align-items: center; font-size: 11px; color: #848e9c; }\
.ind-tag { background: #23272e; color: #0052ff; padding: 2px 6px; border-radius: 3px; }\
\
.main-chart-screen {\
    flex: 1;\
    background: #0b0e11;\
    position: relative;\
    display: flex;\
    align-items: center;\
    justify-content: center;\
}\
.chart-watermark {\
    position: absolute;\
    top: 15px;\
    left: 15px;\
    font-size: 11px;\
    color: #23272e;\
    font-weight: 700;\
}\
.live-price-overlay { text-align: center; }\
.live-price-overlay h2 { font-size: 36px; color: #0052ff; margin-bottom: 5px; }\
.live-price-overlay p { font-size: 12px; color: #848e9c; }\
\
.user-positions-table {\
    height: 120px;\
    border-top: 1px solid #23272e;\
    background: #181a20;\
}\
.table-header-tabs {\
    display: flex;\
    gap: 20px;\
    padding: 8px 12px;\
    border-bottom: 1px solid #23272e;\
    font-size: 12px;\
}\
.table-header-tabs span { color: #848e9c; cursor: pointer; }\
.table-header-tabs span.active { color: #fff; border-bottom: 1px solid #0052ff; }\
.table-empty-state {\
    padding: 25px;\
    text-align: center;\
    color: #848e9c;\
    font-size: 12px;\
}\
\
/* 3. دفتر اك�طك�بات (Order Book) */\
.panel-title {\
    padding: 10px 12px;\
    font-size: 12px;\
    font-weight: 600;\
    border-bottom: 1px solid #23272e;\
}\
.ob-header-row {\
    display: flex;\
    justify-content: space-between;\
    padding: 6px 12px;\
    font-size: 11px;\
    color: #848e9c;\
}\
.asks-list, .bids-list {\
    display: flex;\
    flex-direction: column;\
    gap: 2px;\
    padding: 0 6px;\
    max-height: 180px;\
    overflow: hidden;\
}\
.ob-row {\
    display: flex;\
    justify-content: space-between;\
    font-size: 11px;\
    padding: 2px 6px;\
    position: relative;\
}\
.ob-row.ask .price-val { color: #f6465d; }\
.ob-row.bid .price-val { color: #0ecb81; }\
.current-price-banner {\
    padding: 10px 12px;\
    background: #1e2329;\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
    margin: 6px 0;\
}\
.current-price-banner span.up { font-size: 15px; font-weight: 700; color: #0ecb81; }\
.spread { font-size: 10px; color: #848e9c; }\
\
/* 4. ك�ك�حة تك�فك�ذ اك�صفقات */\
.trade-execution-panel {\
    padding: 12px;\
    gap: 12px;\
}\
.order-type-tabs {\
    display: flex;\
    gap: 6px;\
}\
.otype-btn {\
    flex: 1;\
    background: #0b0e11;\
    border: 1px solid #23272e;\
    color: #848e9c;\
    padding: 6px;\
    border-radius: 4px;\
    font-size: 11px;\
    cursor: pointer;\
}\
.otype-btn.active { border-color: #0052ff; color: #fff; }\
\
.order-mode-selector {\
    display: flex;\
    gap: 10px;\
    font-size: 12px;\
    border-bottom: 1px solid #23272e;\
    padding-bottom: 6px;\
}\
.omode { color: #848e9c; cursor: pointer; }\
.omode.active { color: #fff; font-weight: 600; }\
\
.form-group label {\
    font-size: 11px;\
    color: #848e9c;\
    display: block;\
    margin-bottom: 4px;\
}\
.input-with-unit {\
    display: flex;\
    background: #0b0e11;\
    border: 1px solid #23272e;\
    border-radius: 4px;\
    align-items: center;\
    padding: 0 8px;\
}\
.input-with-unit input {\
    flex: 1;\
    background: transparent;\
    border: none;\
    padding: 8px 0;\
    color: #fff;\
    font-size: 13px;\
}\
.input-with-unit span { font-size: 11px; color: #848e9c; }\
\
.slider-container { margin: 6px 0; }\
.percentage-slider { width: 100%; accent-color: #0052ff; }\
.slider-marks { display: flex; justify-content: space-between; font-size: 9px; color: #848e9c; }\
\
.total-estimation {\
    display: flex;\
    justify-content: space-between;\
    font-size: 12px;\
    background: #0b0e11;\
    padding: 8px;\
    border-radius: 4px;\
}\
.total-estimation strong { color: #0052ff; }\
\
.binance-action-buttons {\
    display: grid;\
    grid-template-columns: 1fr 1fr;\
    gap: 8px;\
    margin-top: auto;\
}\
.btn-binance-buy {\
    background: #0ecb81;\
    color: #0b0e11;\
    border: none;\
    padding: 10px;\
    border-radius: 4px;\
    font-weight: 700;\
    font-size: 12px;\
    cursor: pointer;\
    transition: 0.2s;\
}\
.btn-binance-buy:hover { opacity: 0.9; }\
.btn-binance-sell {\
    background: #f6465d;\
    color: #fff;\
    border: none;\
    padding: 10px;\
    border-radius: 4px;\
    font-weight: 700;\
    font-size: 12px;\
    cursor: pointer;\
    transition: 0.2s;\
}\
