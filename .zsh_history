        .section-desc {\
            color: var(--text-secondary);\
            font-size: 11px;\
            margin-bottom: 12px;\
        }\
        .ticker-list {\
            display: flex;\
            flex-direction: column;\
            gap: 8px;\
        }\
        .ticker-item {\
            background-color: rgba(255, 255, 255, 0.02);\
            border: 1px solid var(--border-color);\
            border-radius: 8px;\
            padding: 12px;\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            cursor: pointer;\
        }\
        .ticker-item:hover {\
            background-color: var(--card-hover);\
            border-color: var(--accent-color);\
        }\
        .ticker-info .symbol {\
            font-weight: bold;\
