cat > backend/wallet/service.py <<'EOF'\
from decimal import Decimal\
from threading import RLock\
\
\
class WalletService:\
    def __init__(self):\
        self._lock = RLock()\
        self._balances = {}\
        self._reserved = {}\
\
    def _ensure_asset(self, user_id: str, asset: str):\
        asset = asset.upper()\
\
        self._balances.setdefault(user_id, {})\
        self._reserved.setdefault(user_id, {})\
\
        self._balances[user_id].setdefault(asset, Decimal("0"))\
        self._reserved[user_id].setdefault(asset, Decimal("0"))\
\
    def deposit(self, user_id: str, asset: str, amount: Decimal):\
        if amount <= 0:\
            raise ValueError("Deposit amount must be greater than zero")\
\
        asset = asset.upper()\
\
        with self._lock:\
            self._ensure_asset(user_id, asset)\
            self._balances[user_id][asset] += amount\
            return self._balance_unlocked(user_id, asset)\
\
    def _balance_unlocked(self, user_id: str, asset: str):\
        asset = asset.upper()\
        self._ensure_asset(user_id, asset)\
\
        total = self._balances[user_id][asset]\
        reserved = self._reserved[user_id][asset]\
        available = total - reserved\
\
        return {\
            "asset": asset,\
            "total": str(total),\
            "reserved": str(reserved),\
            "available": str(available),\
        }\
\
    def get_balance(self, user_id: str, asset: str):\
        with self._lock:\
            return self._balance_unlocked(user_id, asset)\
\
    def reserve(self, user_id: str, asset: str, amount: Decimal):\
        if amount <= 0:\
            raise ValueError("Reserve amount must be greater than zero")\
\
        asset = asset.upper()\
\
        with self._lock:\
            self._ensure_asset(user_id, asset)\
\
            total = self._balances[user_id][asset]\
            reserved = self._reserved[user_id][asset]\
            available = total - reserved\
\
            if available < amount:\
                raise ValueError(\
                    f"Insufficient available {asset} balance"\
                )\
\
            self._reserved[user_id][asset] += amount\
\
            return self._balance_unlocked(user_id, asset)\
\
    def release(self, user_id: str, asset: str, amount: Decimal):\
        if amount <= 0:\
            raise ValueError("Release amount must be greater than zero")\
\
        asset = asset.upper()\
\
        with self._lock:\
            self._ensure_asset(user_id, asset)\
\
            reserved = self._reserved[user_id][asset]\
\
            if reserved < amount:\
                raise ValueError(\
                    f"Cannot release more than reserved {asset}"\
                )\
\
            self._reserved[user_id][asset] -= amount\
\
            return self._balance_unlocked(user_id, asset)\
\
    def debit_reserved(\
        self,\
        user_id: str,\
        asset: str,\
        amount: Decimal,\
    ):\
        if amount <= 0:\
            raise ValueError("Debit amount must be greater than zero")\
\
        asset = asset.upper()\
\
        with self._lock:\
            self._ensure_asset(user_id, asset)\
\
            reserved = self._reserved[user_id][asset]\
            total = self._balances[user_id][asset]\
\
            if reserved < amount:\
                raise ValueError(\
                    f"Insufficient reserved {asset} balance"\
                )\
\
            if total < amount:\
                raise ValueError(\
                    f"Insufficient total {asset} balance"\
                )\
\
            self._reserved[user_id][asset] -= amount\
            self._balances[user_id][asset] -= amount\
\
            return self._balance_unlocked(user_id, asset)\
\
    def credit(\
        self,\
        user_id: str,\
        asset: str,\
        amount: Decimal,\
    ):\
        if amount <= 0:\
            raise ValueError("Credit amount must be greater than zero")\
\
        asset = asset.upper()\
\
        with self._lock:\
            self._ensure_asset(user_id, asset)\
            self._balances[user_id][asset] += amount\
\
            return self._balance_unlocked(user_id, asset)\
\
    def reserved_amount(\
        self,\
        user_id: str,\
        asset: str,\
    ) -> Decimal:\
        asset = asset.upper()\
\
        with self._lock:\
            self._ensure_asset(user_id, asset)\
            return self._reserved[user_id][asset]\
EOF
: 1789936750:0;cat > backend/orders/service.py <<'EOF'\
from dataclasses import dataclass\
from decimal import Decimal\
from enum import Enum\
from threading import RLock\
from uuid import uuid4\
from datetime import datetime, timezone\
\
\
class OrderSide(str, Enum):\
    BUY = "BUY"\
    SELL = "SELL"\
\
\
class OrderType(str, Enum):\
    LIMIT = "LIMIT"\
    MARKET = "MARKET"\
\
\
class OrderStatus(str, Enum):\
    NEW = "NEW"\
    PARTIALLY_FILLED = "PARTIALLY_FILLED"\
    FILLED = "FILLED"\
    CANCELED = "CANCELED"\
\
\
@dataclass\
class Order:\
    order_id: str\
    user_id: str\
    symbol: str\
    side: str\
    order_type: str\
    price: Decimal\
    quantity: Decimal\
    remaining_quantity: Decimal\
    status: str\
    created_at: str\
\
\
class OrderService:\
    def __init__(self):\
        self._lock = RLock()\
        self._orders = {}\
\
    def create_order(\
        self,\
        user_id: str,\
        symbol: str,\
        side: str,\
        order_type: str,\
        price: Decimal,\
        quantity: Decimal,\
    ):\
        if quantity <= 0:\
            raise ValueError("Quantity must be greater than zero")\
\
        side = side.upper()\
        order_type = order_type.upper()\
\
        if side not in ("BUY", "SELL"):\
            raise ValueError("Invalid side. Use BUY or SELL")\
\
        if order_type not in ("LIMIT", "MARKET"):\
            raise ValueError("Invalid order type. Use LIMIT or MARKET")\
\
        if order_type == "LIMIT" and price <= 0:\
            raise ValueError("Limit price must be greater than zero")\
\
        if order_type == "MARKET" and price < 0:\
            raise ValueError("Market price cannot be negative")\
\
        order = Order(\
            order_id=str(uuid4()),\
            user_id=user_id,\
            symbol=symbol.upper(),\
            side=side,\
            order_type=order_type,\
            price=price,\
            quantity=quantity,\
            remaining_quantity=quantity,\
            status=OrderStatus.NEW.value,\
            created_at=datetime.now(timezone.utc).isoformat(),\
        )\
\
        with self._lock:\
            self._orders[order.order_id] = order\
\
        return order\
\
    def get_order(self, order_id: str):\
        with self._lock:\
            return self._orders.get(order_id)\
\
    def get_user_orders(self, user_id: str):\
        with self._lock:\
            return [\
                order\
                for order in self._orders.values()\
                if order.user_id == user_id\
            ]\
\
    def fill(\
        self,\
        order_id: str,\
        quantity: Decimal,\
    ):\
        with self._lock:\
            order = self._orders.get(order_id)\
\
            if order is None:\
                raise ValueError("Order not found")\
\
            if order.status == OrderStatus.CANCELED.value:\
                raise ValueError("Cannot fill canceled order")\
\
            if quantity <= 0:\
                raise ValueError("Fill quantity must be greater than zero")\
\
            if quantity > order.remaining_quantity:\
                raise ValueError("Fill quantity exceeds remaining quantity")\
\
            order.remaining_quantity -= quantity\
\
            if order.remaining_quantity == 0:\
                order.status = OrderStatus.FILLED.value\
            else:\
                order.status = OrderStatus.PARTIALLY_FILLED.value\
\
            return order\
\
    def cancel_order(self, order_id: str):\
        with self._lock:\
            order = self._orders.get(order_id)\
\
            if order is None:\
                raise ValueError("Order not found")\
\
            if order.status in (\
                OrderStatus.FILLED.value,\
                OrderStatus.CANCELED.value,\
            ):\
                raise ValueError(\
                    f"Cannot cancel order with status {order.status}"\
                )\
\
            order.status = OrderStatus.CANCELED.value\
\
            return order\
EOF
: 1789936764:0;cat > backend/exchange/orderbook.py <<'EOF'\
from decimal import Decimal\
from threading import RLock\
\
\
class OrderBook:\
    def __init__(self, symbol: str):\
        self.symbol = symbol.upper()\
        self._lock = RLock()\
        self.bids = []\
        self.asks = []\
\
    def add(self, order):\
        with self._lock:\
            book = self.bids if order.side == "BUY" else self.asks\
            book.append(order)\
\
            self._sort()\
\
    def _sort(self):\
        self.bids.sort(\
            key=lambda order: (\
                -order.price,\
                order.created_at,\
            )\
        )\
\
        self.asks.sort(\
            key=lambda order: (\
                order.price,\
                order.created_at,\
            )\
        )\
\
    def remove(self, order):\
        with self._lock:\
            book = self.bids if order.side == "BUY" else self.asks\
\
            self.bids = [\
                item for item in book\
                if item.order_id != order.order_id\
            ] if order.side == "BUY" else self.bids\
\
            self.asks = [\
                item for item in book\
                if item.order_id != order.order_id\
            ] if order.side == "SELL" else self.asks\
\
    def best_opposite(self, incoming):\
        with self._lock:\
            opposite = self.asks if incoming.side == "BUY" else self.bids\
\
            if not opposite:\
                return None\
\
            best = opposite[0]\
\
            if incoming.order_type == "MARKET":\
                return best\
\
            if incoming.side == "BUY":\
                if incoming.price >= best.price:\
                    return best\
            else:\
                if incoming.price <= best.price:\
                    return best\
\
            return None\
\
    def snapshot(self, depth: int = 10):\
        with self._lock:\
            bids = [\
                {\
                    "price": str(order.price),\
                    "quantity": str(order.remaining_quantity),\
                    "order_id": order.order_id,\
                }\
                for order in self.bids[:depth]\
                if order.remaining_quantity > 0\
            ]\
\
            asks = [\
                {\
                    "price": str(order.price),\
                    "quantity": str(order.remaining_quantity),\
                    "order_id": order.order_id,\
                }\
                for order in self.asks[:depth]\
                if order.remaining_quantity > 0\
            ]\
\
            return {\
                "symbol": self.symbol,\
                "bids": bids,\
                "asks": asks,\
            }\
EOF
: 1789936776:0;cat > backend/exchange/matching_engine.py <<'EOF'\
from decimal import Decimal\
from threading import RLock\
\
\
class MatchingEngine:\
    def __init__(self):\
        self._lock = RLock()\
        self._books = {}\
\
    def get_book(self, symbol: str):\
        symbol = symbol.upper()\
\
        if symbol not in self._books:\
            from backend.exchange.orderbook import OrderBook\
            self._books[symbol] = OrderBook(symbol)\
\
        return self._books[symbol]\
\
    def submit(self, order):\
        book = self.get_book(order.symbol)\
        trades = []\
\
        with self._lock:\
\
            while order.remaining_quantity > 0:\
\
                resting = book.best_opposite(order)\
\
                if resting is None:\
                    break\
\
                trade_quantity = min(\
                    order.remaining_quantity,\
                    resting.remaining_quantity,\
                )\
\
                trade_price = resting.price\
\
                trades.append(\
                    {\
                        "symbol": order.symbol,\
                        "price": trade_price,\
                        "quantity": trade_quantity,\
                        "buyer_order_id": (\
                            order.order_id\
                            if order.side == "BUY"\
                            else resting.order_id\
                        ),\
                        "seller_order_id": (\
                            order.order_id\
                            if order.side == "SELL"\
                            else resting.order_id\
                        ),\
                    }\
                )\
\
                order.remaining_quantity -= trade_quantity\
                resting.remaining_quantity -= trade_quantity\
\
                if resting.remaining_quantity == 0:\
                    book.remove(resting)\
\
                if order.remaining_quantity == 0:\
                    break\
\
            if order.remaining_quantity > 0:\
                if order.order_type == "LIMIT":\
                    book.add(order)\
\
            return trades\
\
    def snapshot(self, symbol: str, depth: int = 10):\
        return self.get_book(symbol).snapshot(depth)\
EOF
: 1789936792:0;cat > backend/exchange/settlement.py <<'EOF'\
from decimal import Decimal\
\
\
class SettlementService:\
    def __init__(self, wallet_service, ledger_service):\
        self.wallet = wallet_service\
        self.ledger = ledger_service\
\
    def settle_trade(\
        self,\
        buyer,\
        seller,\
        price: Decimal,\
        quantity: Decimal,\
    ):\
        symbol = buyer.symbol\
\
        if not symbol.endswith("USDT"):\
            raise ValueError(\
                "Only USDT quote markets are currently supported"\
            )\
\
        base_asset = symbol[:-4]\
        quote_asset = "USDT"\
\
        quote_amount = price * quantity\
\
        # Buyer\
        self.wallet.debit_reserved(\
            buyer.user_id,\
            quote_asset,\
            quote_amount,\
        )\
\
        self.wallet.credit(\
            buyer.user_id,\
            base_asset,\
            quantity,\
        )\
\
        # Seller\
        self.wallet.debit_reserved(\
            seller.user_id,\
            base_asset,\
            quantity,\
        )\
\
        self.wallet.credit(\
            seller.user_id,\
            quote_asset,\
            quote_amount,\
        )\
\
        trade_reference = (\
            f"trade:{buyer.order_id}:{seller.order_id}"\
        )\
\
        self.ledger.record(\
            user_id=buyer.user_id,\
            asset=quote_asset,\
            amount=-quote_amount,\
            entry_type="TRADE_BUY",\
            reference=trade_reference,\
        )\
\
        self.ledger.record(\
            user_id=buyer.user_id,\
            asset=base_asset,\
            amount=quantity,\
            entry_type="TRADE_BUY",\
            reference=trade_reference,\
        )\
\
        self.ledger.record(\
            user_id=seller.user_id,\
            asset=base_asset,\
            amount=-quantity,\
            entry_type="TRADE_SELL",\
            reference=trade_reference,\
        )\
\
        self.ledger.record(\
            user_id=seller.user_id,\
            asset=quote_asset,\
            amount=quote_amount,\
            entry_type="TRADE_SELL",\
            reference=trade_reference,\
        )\
\
        return {\
            "symbol": symbol,\
            "price": str(price),\
            "quantity": str(quantity),\
            "quote_amount": str(quote_amount),\
            "buyer_id": buyer.user_id,\
            "seller_id": seller.user_id,\
            "buyer_order_id": buyer.order_id,\
            "seller_order_id": seller.order_id,\
        }\
EOF
: 1789936823:0;cat > backend/main.py <<'EOF'\
from decimal import Decimal, InvalidOperation\
from fastapi import FastAPI, HTTPException\
from pydantic import BaseModel\
\
from backend.wallet.service import WalletService\
from backend.ledger.service import LedgerService\
from backend.orders.service import OrderService\
from backend.exchange.matching_engine import MatchingEngine\
from backend.exchange.settlement import SettlementService\
\
\
app = FastAPI(\
    title="EXCORA Broker API",\
    version="2.0.0",\
    description="EXCORA Spot Trading Broker API",\
)\
\
\
wallet_service = WalletService()\
ledger_service = LedgerService()\
order_service = OrderService()\
matching_engine = MatchingEngine()\
settlement_service = SettlementService(\
    wallet_service,\
    ledger_service,\
)\
\
\
class DepositRequest(BaseModel):\
    user_id: str\
    asset: str\
    amount: str\
\
\
class OrderRequest(BaseModel):\
    user_id: str\
    symbol: str\
    side: str\
    order_type: str\
    price: str\
    quantity: str\
\
\
@app.get("/health")\
def health():\
    return {\
        "status": "healthy",\
        "service": "EXCORA Broker",\
        "version": "2.0.0",\
    }\
\
\
@app.get("/markets")\
def markets():\
    return {\
        "markets": [\
            {\
                "symbol": "BTCUSDT",\
                "base": "BTC",\
                "quote": "USDT",\
                "type": "spot",\
                "status": "TRADING",\
            },\
            {\
                "symbol": "ETHUSDT",\
                "base": "ETH",\
                "quote": "USDT",\
                "type": "spot",\
                "status": "TRADING",\
            },\
            {\
                "symbol": "SOLUSDT",\
                "base": "SOL",\
                "quote": "USDT",\
                "type": "spot",\
                "status": "TRADING",\
            },\
        ]\
    }\
\
\
@app.post("/wallet/deposit")\
def deposit(request: DepositRequest):\
\
    try:\
        amount = Decimal(request.amount)\
    except InvalidOperation:\
        raise HTTPException(\
            status_code=400,\
