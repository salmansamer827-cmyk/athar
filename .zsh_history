\
    <div class="market-ticker-bar">\
        <div class="ticker-mini-item"><span>BTC/USDT</span> <b style="color: var(--green);" id="btcTicker">81,617.67</b></div>\
        <div class="ticker-mini-item"><span>ETH/USDT</span> <b style="color: var(--green);">2,646.64</b></div>\
        <div class="ticker-mini-item"><span>EXCORA/USDT</span> <b style="color: var(--accent-color);">1.44</b></div>\
