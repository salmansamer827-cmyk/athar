from pathlib import Path\
from datetime import datetime\
import shutil\
import sys\
import subprocess\
\
path = Path("core/pipeline/quant_pipeline.py")\
\
print("=" * 70)\
print("EXCORA AUTO REPAIR")\
print("=" * 70)\
\
if not path.exists():\
    raise SystemExit("[ERROR] quant_pipeline.py not found")\
\
# Backup\
backup_dir = Path("backups")\
backup_dir.mkdir(exist_ok=True)\
\
stamp = datetime.now().strftime("%Y%m%d_%H%M%S")\
backup = backup_dir / f"quant_pipeline.py.{stamp}.bak"\
\
shutil.copy2(path, backup)\
\
print("[BACKUP]", backup)\
\
text = path.read_text(encoding="utf-8")\
\
old = "risk_percent: float = 1.0\n"\
new = "risk_percent: float = 1.0,\n"\
\
if old not in text:\
    print("[ERROR] Target line not found.")\
    raise SystemExit(1)\
\
text = text.replace(old, new, 1)\
\
path.write_text(text, encoding="utf-8")\
\
print("[PATCH] Applied comma fix.")\
\
# Compile\
result = subprocess.run(\
    [\
        sys.executable,\
        "-m",\
        "py_compile",\
        str(path),\
    ]\
)\
\
if result.returncode != 0:\
    print("[FAILED] Compilation failed.")\
    shutil.copy2(backup, path)\
    print("[ROLLBACK] Original file restored.")\
    raise SystemExit(1)\
\
print("[SUCCESS] quant_pipeline.py compiles correctly.")\
print("=" * 70)\
PY
