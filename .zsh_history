from core.backtest.engine import (\
    BacktestEngine,\
    BacktestConfig,\
)\
\
from core.data.providers.mock import (\
    MockMarketProvider,\
)\
\
\
provider = MockMarketProvider("CRYPTO")\
\
candles = provider.fetch_ohlcv(\
    symbol="BTC/USDT",\
    timeframe="15m",\
    limit=50,\
)\
\
\
signal = {\
    "direction": "LONG",\
\
    "entry": 100.1,\
    "stop_loss": 99.8,\
    "take_profit": 101.0,\
\
    "score": 85.0,\
    "probability": 0.72,\
    "adjusted_probability": 0.62,\
    "uncertainty": 0.08,\
    "expected_value_r": 1.45,\
}\
\
\
engine = BacktestEngine(\
    BacktestConfig(\
        initial_capital=100.0,\
        risk_percent=1.0,\
    )\
)\
\
\
trade = engine.simulate_trade(\
    signal=signal,\
    future_candles=candles[1:],\
    symbol="BTC/USDT",\
    market="CRYPTO",\
    timeframe="15m",\
)\
\
\
print("=" * 60)\
print("EXCORA BACKTEST ENGINE TEST")\
print("=" * 60)\
\
print("Direction:", trade.direction)\
print("Entry:", trade.entry_price)\
print("SL:", trade.stop_loss)\
print("TP:", trade.take_profit)\
print("Exit:", trade.exit_price)\
\
print("Result:", trade.result)\
\
print("Risk:", trade.risk_amount)\
print("PnL:", trade.pnl)\
print("R:", trade.r_multiple)\
\
print("Score:", trade.score)\
print("Probability:", trade.probability)\
print("Adjusted:", trade.adjusted_probability)\
print("Uncertainty:", trade.uncertainty)\
print("EV:", trade.expected_value_r)\
\
print("=" * 60)\
print("STATUS: BACKTEST ENGINE OK")\
print("=" * 60)\
