\
\
<!-- ================= MARKETS ================= -->\
\
<section id="markets-page" class="page">\
\
    <div class="panel">\
\
        <div class="panel-title">\
            اك�أسك�اق\
        </div>\
\
        <div class="market-list" id="marketList">\
\
            <div class="market-row">\
