    return "CONSOLIDATION"\
\
def detect_fvg(df):\
    if len(df) < 3:\
        return False, 0, 0\
    \
    c1_high = df['high'].iloc[-3]\
    c3_low = df['low'].iloc[-1]\
    c1_low = df['low'].iloc[-3]\
    c3_high = df['high'].iloc[-1]\
    \
    if c3_low > c1_high:\
        return "BULLISH", c1_high, c3_low\
    elif c3_high < c1_low:\
        return "BEARISH", c3_high, c1_low\
    \
    return None, 0, 0\
\
def detect_order_block(df):\
    if len(df) < 3:\
        return None\
    \
    prev_candle = df.iloc[-2]\
    body = abs(prev_candle['close'] - prev_candle['open'])\
    total_range = prev_candle['high'] - prev_candle['low']\
    \
    if total_range == 0:\
        return None\
        \
    upper_wick = prev_candle['high'] - max(prev_candle['open'], prev_candle['close'])\
    lower_wick = min(prev_candle['open'], prev_candle['close']) - prev_candle['low']\
    \
    if lower_wick >= (body * 1.5):\
        return "BULLISH_REJECTION"\
    elif upper_wick >= (body * 1.5):\
        return "BEARISH_REJECTION"\
        \
    return None\
\
def monitor_active_trades():\
    global _previous_active_symbols, secured_trades, executed_symbols_cache\
    try:\
        positions = get_binance_positions()\
        current_active_symbols = set()\
\
        for pos in positions:\
            position_amt = float(pos.get('positionAmt', 0))\
            if position_amt != 0:\
                raw_symbol = pos.get('symbol', '')\
                symbol = raw_symbol[:-4] + '/' + raw_symbol[-4:] if len(raw_symbol) >= 7 else raw_symbol\
                current_active_symbols.add(symbol)\
                executed_symbols_cache.add(symbol)\
\
                entry_price = float(pos.get('entryPrice', 0))\
                mark_price = float(pos.get('markPrice', 0))\
                unrealized_pnl = float(pos.get('unRealizedProfit', 0))\
                initial_margin = (abs(position_amt) * entry_price) / 10  \
                pnl_percentage = (unrealized_pnl / initial_margin) * 100 if initial_margin > 0 else 0.0\
                side = 'LONG' if position_amt > 0 else 'SHORT'\
\
                if pnl_percentage >= BREAKEVEN_TRIGGER_PCT and symbol not in secured_trades:\
                    secured_trades.add(symbol)\
                    send_telegram_message(f"�������︃� *تأك�ك�ك� اك�صفقة تك�قائك�اك� (Breakeven)*\n������ اك�أصك�: `{symbol}` | اك�ربح: `{pnl_percentage:.2f}%`")\
\
        closed_symbols = _previous_active_symbols - current_active_symbols\
        for symbol in closed_symbols:\
            if symbol in secured_trades:\
                secured_trades.remove(symbol)\
            if symbol in executed_symbols_cache:\
                executed_symbols_cache.remove(symbol)\
            \
            # إرساك� تقرك�ر اك�أدا؃� اك�ك�حدث فك�ر إغك�اق اك�صفقة باك�اسك� اك�صحك�ح ك�ك�أصك�\
            perf_report = generate_trade_report_summary()\
            send_telegram_message(f"������� *إغك�اق صفقة:* `{symbol}`\n\n{perf_report}")\
\
        _previous_active_symbols = current_active_symbols\
    except Exception as e:\
        print(f"[-] خطأ تتبع اك�صفقات: {e}")\
\
# ==================== اك�دك�رة اك�تحك�ك�ك�ك�ة اك�رئك�سك�ة ====================\
def analyze_market():\
    global executed_symbols_cache\
    signals_to_send = []\
\
    for symbol in SYMBOLS:\
        if symbol in executed_symbols_cache or has_open_position(symbol):\
            continue\
\
        df_4h = fetch_data(symbol, '4h')\
        df_1h = fetch_data(symbol, '1h')\
        df_15m = fetch_data(symbol, '15m')\
\
        if df_4h is None or df_1h is None or df_15m is None:\
            continue\
\
        df_4h = calculate_indicators_smc(df_4h)\
        df_1h = calculate_indicators_smc(df_1h)\
        df_15m = calculate_indicators_smc(df_15m)\
\
        trend_4h = "BULLISH" if df_4h.iloc[-1]['close'] > df_4h.iloc[-1]['EMA200'] else "BEARISH"\
        structure_1h = detect_market_structure(df_1h)\
        fvg_type, fvg_low, fvg_high = detect_fvg(df_15m)\
        reversal_candle = detect_order_block(df_15m)\
\
        current_signal = None\
        \
        # تحسك�ك� دقة اك�فك�اتر ك�ك�ا ك�احقاك� إذا ك�زك� اك�أك�ر ك�رفع ك�سبة اك�ك�جاح فك�ق 40%\
        if trend_4h == "BULLISH" and "BULLISH" in structure_1h:\
            if fvg_type == "BULLISH" or reversal_candle == "BULLISH_REJECTION":\
                current_signal = "LONG"\
\
        elif trend_4h == "BEARISH" and "BEARISH" in structure_1h:\
            if fvg_type == "BEARISH" or reversal_candle == "BEARISH_REJECTION":\
                current_signal = "SHORT"\
\
        if current_signal:\
            executed_symbols_cache.add(symbol)\
            \
            entry_price = df_15m.iloc[-1]['close']\
            risk_amount = INITIAL_CAPITAL * RISK_PERCENT\
            current_atr = df_15m.iloc[-1]['ATR']\
            if pd.isna(current_atr) or current_atr <= 0:\
                current_atr = entry_price * 0.015\
\
            if current_signal == "LONG":\
                stop_loss = entry_price - (current_atr * ATR_MULTIPLIER)\
                take_profit = entry_price + ((entry_price - stop_loss) * REWARD_RATIO)\
                position_size = (risk_amount / (entry_price - stop_loss)) * entry_price\
                exec_res = execute_binance_order(symbol, "LONG", position_size, entry_price)\
                \
                signals_to_send.append(f"������ *إشارة شرا؃� ك�ؤسسك�ة (LONG - SMC)*\n������ اك�أصك�: `{symbol}`\n������� ك�قف: `{stop_loss:.4f}` | اك�ك�دف: `{take_profit:.4f}`\n⃺�� {exec_res}")\
\
            elif current_signal == "SHORT":\
                stop_loss = entry_price + (current_atr * ATR_MULTIPLIER)\
                take_profit = entry_price - ((stop_loss - entry_price) * REWARD_RATIO)\
                position_size = (risk_amount / (stop_loss - entry_price)) * entry_price\
                exec_res = execute_binance_order(symbol, "SHORT", position_size, entry_price)\
                \
                signals_to_send.append(f"������ *إشارة بك�ع ك�ؤسسك�ة (SHORT - SMC)*\n������ اك�أصك�: `{symbol}`\n������� ك�قف: `{stop_loss:.4f}` | اك�ك�دف: `{take_profit:.4f}`\n⃺�� {exec_res}")\
\
    for sig in signals_to_send:\
        send_telegram_message(sig)\
\
def fetch_data(symbol, timeframe, limit=100):\
    try:\
        ohlcv = binance_exchange.fetch_ohlcv(symbol, timeframe, limit=limit)\
        df = pd.DataFrame(ohlcv, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])\
        df['timestamp'] = pd.to_datetime(df['timestamp'], unit='ms')\
        return df\
    except Exception:\
        return None\
\
if __name__ == "__main__":\
    send_telegram_message("������ *تك� تشغك�ك� بك�ت EXCORA ك�ك�ذك�ب (XAUUSDT) بك�جاح.*")\
    sign_tradfi_agreement()\
\
    while True:\
        try:\
            if not check_internet_connection():\
                time.sleep(15)\
                continue\
\
            analyze_market()\
            monitor_active_trades()\
            time.sleep(300)\
        except Exception as e:\
            print(f"[-] خطأ رئك�سك�: {e}")\
            time.sleep(120)\

