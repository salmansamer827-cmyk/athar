        raise HTTPException(\
            status_code=500,\
            detail={\
                "status": "ERROR",\
                "error": "BINANCE_SYMBOL_DISCOVERY_ERROR",\
                "message": str(exc),\
            },\
        )\
'''\
\
path.write_text(content)\
print("Created:", path)\
