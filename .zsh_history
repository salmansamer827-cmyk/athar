path = Path("src/App.tsx")\
text = path.read_text()\
\
text = text.replace(\
    'import { useState } from "react";',\
    'import { useEffect, useState } from "react";'\
)\
\
text = text.replace(\
    'import { analyzeQuant } from "./api/client";',\
    'import { analyzeQuant, fetchSymbols } from "./api/client";'\
)\
\
# إزاك�ة اك�قائك�ة اك�ثابتة\
start = text.find('const SYMBOLS = [')\
if start != -1:\
    end = text.find('];', start)\
    if end != -1:\
        text = text[:start] + text[end + 2:]\
\
# إضافة اك�حاك�ة اك�جدك�دة بعد symbol/timeframe\
old = '''  const [symbol, setSymbol] = useState("BTC/USDT");\
  const [timeframe, setTimeframe] = useState("15m");'''\
\
new = '''  const [symbol, setSymbol] = useState("BTC/USDT");\
  const [symbols, setSymbols] = useState<string[]>([]);\
  const [symbolSearch, setSymbolSearch] = useState("");\
  const [symbolsLoading, setSymbolsLoading] = useState(true);\
  const [timeframe, setTimeframe] = useState("15m");'''\
\
text = text.replace(old, new)\
\
# إضافة تحك�ك�ك� اك�رك�ك�ز قبك� runAnalysis\
marker = '''  async function runAnalysis() {'''\
\
effect = '''  useEffect(() => {\
    let mounted = true;\
\
    async function loadSymbols() {\
      try {\
        setSymbolsLoading(true);\
\
        const result = await fetchSymbols();\
\
        if (mounted) {\
          setSymbols(result);\
\
          if (result.includes("BTC/USDT")) {\
            setSymbol("BTC/USDT");\
          } else if (result.length > 0) {\
            setSymbol(result[0]);\
          }\
        }\
      } catch (err) {\
        console.error("Symbol discovery failed:", err);\
      } finally {\
        if (mounted) {\
          setSymbolsLoading(false);\
        }\
      }\
    }\
\
    loadSymbols();\
\
    return () => {\
      mounted = false;\
    };\
  }, []);\
\
  const filteredSymbols = symbols.filter((item) =>\
    item.toLowerCase().includes(symbolSearch.toLowerCase())\
  );\
\
'''\
\
if effect not in text:\
    text = text.replace(marker, effect + marker)\
\
# استبداك� select اك�قدك�ك�\
old_select = '''            <select\
              value={symbol}\
              onChange={(e) =>\
                setSymbol(e.target.value)\
              }\
              disabled={loading}\
            >\
              {SYMBOLS.map((item) => (\
                <option\
                  key={item}\
                  value={item}\
                >\
                  {item}\
                </option>\
              ))}\
            </select>'''\
\
new_select = '''            <input\
              type="text"\
              placeholder={\
                symbolsLoading\
                  ? "LOADING BINANCE SYMBOLS..."\
                  : "SEARCH SYMBOL..."\
              }\
              value={symbolSearch}\
              onChange={(e) =>\
                setSymbolSearch(e.target.value)\
              }\
              disabled={loading || symbolsLoading}\
            />\
\
            <select\
              value={symbol}\
              onChange={(e) =>\
                setSymbol(e.target.value)\
              }\
              disabled={loading || symbolsLoading}\
            >\
              {filteredSymbols.map((item) => (\
                <option\
                  key={item}\
                  value={item}\
                >\
                  {item}\
                </option>\
              ))}\
            </select>\
\
            <small>\
              {symbolsLoading\
                ? "Loading Binance symbols..."\
                : `${filteredSymbols.length} symbols available`}\
            </small>'''\
\
if old_select in text:\
    text = text.replace(old_select, new_select)\
\
path.write_text(text)\
\
print("App.tsx updated automatically.")\
