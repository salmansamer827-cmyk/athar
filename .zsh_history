from urllib.parse import urlparse\
\
\
class LeadQualificationEngine:\
\
    def __init__(self):\
        self.blocked_domains = {\
            "youtube.com",\
            "youtu.be",\
            "facebook.com",\
            "instagram.com",\
            "linkedin.com",\
            "reddit.com",\
            "wikipedia.org",\
            "medium.com",\
            "hubspot.com",\
            "taskade.com",\
            "godaddy.com"\
        }\
\
        self.blocked_keywords = [\
            "best",\
            "guide",\
            "blog",\
            "news",\
            "article",\
            "tools",\
            "tool",\
            "automation platform",\
            "ai agent",\
            "youtube",\
            "tutorial",\
            "course",\
            "review"\
        ]\
\
        self.business_keywords = [\
            "company",\
            "business",\
            "agency",\
            "studio",\
            "services",\
            "solutions",\
            "shop",\
            "store",\
            "consulting",\
            "marketing",\
            "restaurant",\
            "real estate",\
            "law",\
            "accounting",\
            "clinic",\
            "construction"\
        ]\
\
    def get_domain(self, url: str):\
\
        try:\
            domain = urlparse(url).netloc.lower()\
\
            if domain.startswith("www."):\
                domain = domain[4:]\
\
            return domain\
\
        except Exception:\
            return ""\
\
    def is_blocked_domain(self, domain: str):\
\
        for blocked in self.blocked_domains:\
\
            if (\
                domain == blocked\
                or domain.endswith("." + blocked)\
            ):\
                return True\
\
        return False\
\
    def contains_blocked_keyword(\
        self,\
        title: str,\
        snippet: str\
    ):\
\
        text = (\
            f"{title} {snippet}"\
        ).lower()\
\
        for keyword in self.blocked_keywords:\
\
            if keyword in text:\
                return True\
\
        return False\
\
    def detect_business_signals(\
        self,\
        title: str,\
        snippet: str\
    ):\
\
        text = (\
            f"{title} {snippet}"\
        ).lower()\
\
        signals = []\
\
        for keyword in self.business_keywords:\
\
            if keyword in text:\
                signals.append(keyword)\
\
        return signals\
\
    def qualify(self, results):\
\
        leads = []\
\
        print()\
        print("=" * 60)\
        print("LEAD QUALIFICATION")\
        print("=" * 60)\
\
        for result in results:\
\
            title = result.get(\
                "title",\
                ""\
            )\
\
            url = result.get(\
                "url",\
                ""\
            )\
\
            snippet = result.get(\
                "snippet",\
                ""\
            )\
\
            domain = self.get_domain(url)\
\
            if not domain:\
                continue\
\
            if self.is_blocked_domain(domain):\
\
                print(\
                    f"[FILTERED] {domain} "\
                    f"⃦�� blocked domain"\
                )\
\
                continue\
\
            if self.contains_blocked_keyword(\
                title,\
                snippet\
            ):\
\
                print(\
                    f"[FILTERED] {title} "\
                    f"⃦�� content/tool result"\
                )\
\
                continue\
\
            signals = self.detect_business_signals(\
                title,\
                snippet\
            )\
\
            if not signals:\
\
                print(\
                    f"[LOW FIT] {domain} "\
                    f"⃦�� no clear business signal"\
                )\
\
                continue\
\
            if len(signals) >= 3:\
                fit = "HIGH"\
            elif len(signals) >= 2:\
                fit = "MEDIUM"\
            else:\
                fit = "LOW"\
\
            lead = {\
                "business": title,\
                "website": url,\
                "domain": domain,\
                "potential_need": (\
                    "AI automation, "\
                    "customer support, "\
                    "marketing or workflow automation"\
                ),\
                "signals": signals,\
                "fit": fit,\
                "status": "PROSPECT"\
            }\
\
            leads.append(lead)\
\
            print()\
            print(\
                f"[LEAD {len(leads)}]"\
            )\
            print(\
                f"Business: {lead['business']}"\
            )\
            print(\
                f"Website: {lead['website']}"\
            )\
            print(\
                f"Industry signals: "\
                f"{', '.join(signals)}"\
            )\
            print(\
                f"Potential Need: "\
                f"{lead['potential_need']}"\
            )\
            print(\
                f"Fit: {fit}"\
            )\
            print(\
                f"Status: PROSPECT"\
            )\
\
        print()\
        print(\
            f"Qualified leads: "\
            f"{len(leads)}"\
        )\
\
        return leads\
