from decimal import Decimal\
\
from backend.database.db import init_db, get_connection\
from backend.services.wallet_service import WalletService\
from backend.services.order_service import OrderService\
from backend.services.execution_service import ExecutionService\
\
\
init_db()\
\
BUYER = "partial_buyer_test"\
SELLER = "partial_seller_test"\
\
SYMBOL = "BTC/USDT"\
PRICE = Decimal("68000")\
\
SELL_QTY = Decimal("0.001")\
BUY_QTY = Decimal("0.0004")\
\
wallet = WalletService()\
orders = OrderService()\
execution = ExecutionService()\
\
\
print("====================================")\
print(" EXCORA PARTIAL FILL TEST")\
print("====================================")\
\
\
# ============================================================\
# CLEAN\
# ============================================================\
\
conn = get_connection()\
\
try:\
    conn.execute("BEGIN")\
\
    for user in (BUYER, SELLER):\
        conn.execute(\
            "DELETE FROM ledger_entries WHERE user_id = ?",\
            (user,)\
        )\
\
    conn.execute(\
        """\
        DELETE FROM trades\
        WHERE buyer_user_id IN (?, ?)\
           OR seller_user_id IN (?, ?)\
        """,\
        (BUYER, SELLER, BUYER, SELLER)\
    )\
\
    for user in (BUYER, SELLER):\
        conn.execute(\
            "DELETE FROM orders WHERE user_id = ?",\
            (user,)\
        )\
\
        conn.execute(\
            "DELETE FROM wallets WHERE user_id = ?",\
            (user,)\
        )\
\
    conn.commit()\
\
finally:\
    conn.close()\
\
\
# ============================================================\
# FUNDING\
# ============================================================\
\
print("\n[1] Funding buyer")\
\
wallet.deposit(\
    BUYER,\
    "USDT",\
    Decimal("100")\
)\
\
\
print("\n[2] Funding seller")\
\
wallet.deposit(\
    SELLER,\
    "BTC",\
    Decimal("0.001")\
)\
\
\
print("\nBUYER:")\
print(wallet.get_wallet(BUYER, "USDT"))\
\
print("\nSELLER:")\
print(wallet.get_wallet(SELLER, "BTC"))\
\
\
# ============================================================\
# SELL ORDER\
# ============================================================\
\
print("\n[3] Creating SELL 0.001 BTC")\
\
sell_order = orders.create_limit_order(\
    user_id=SELLER,\
    symbol=SYMBOL,\
    side="SELL",\
    quantity=SELL_QTY,\
    price=PRICE,\
)\
\
print(sell_order)\
\
\
print("\n[4] Executing SELL")\
\
sell_result = execution.execute_limit_order(\
    order_id=sell_order["order_id"],\
    user_id=SELLER,\
    symbol=SYMBOL,\
    side="SELL",\
    quantity=SELL_QTY,\
    price=PRICE,\
)\
\
print(sell_result)\
\
\
print("\nSELLER WALLET AFTER OPEN ORDER:")\
\
print(wallet.get_wallet(SELLER, "BTC"))\
\
\
# ============================================================\
# BUY SMALLER QUANTITY\
# ============================================================\
\
print("\n[5] Creating BUY 0.0004 BTC")\
\
buy_order = orders.create_limit_order(\
    user_id=BUYER,\
    symbol=SYMBOL,\
    side="BUY",\
    quantity=BUY_QTY,\
    price=PRICE,\
)\
\
print(buy_order)\
\
\
print("\n[6] Executing BUY")\
\
buy_result = execution.execute_limit_order(\
    order_id=buy_order["order_id"],\
    user_id=BUYER,\
    symbol=SYMBOL,\
    side="BUY",\
    quantity=BUY_QTY,\
    price=PRICE,\
)\
\
print(buy_result)\
\
\
# ============================================================\
# FINAL WALLETS\
# ============================================================\
\
print("\n====================================")\
print(" FINAL WALLETS")\
print("====================================")\
\
print("\nBUYER USDT:")\
print(wallet.get_wallet(BUYER, "USDT"))\
\
print("\nBUYER BTC:")\
print(wallet.get_wallet(BUYER, "BTC"))\
\
print("\nSELLER BTC:")\
print(wallet.get_wallet(SELLER, "BTC"))\
\
print("\nSELLER USDT:")\
print(wallet.get_wallet(SELLER, "USDT"))\
\
\
# ============================================================\
# FINAL ORDERS\
# ============================================================\
\
print("\n====================================")\
print(" FINAL ORDERS")\
print("====================================")\
\
print("\nBUYER ORDERS:")\
\
for order in orders.get_orders(BUYER):\
    print(order)\
\
\
print("\nSELLER ORDERS:")\
\
for order in orders.get_orders(SELLER):\
    print(order)\
\
\
# ============================================================\
# ORDER BOOK\
# ============================================================\
\
print("\n====================================")\
print(" ORDER BOOK")\
print("====================================")\
\
print(\
    execution.snapshot(\
        SYMBOL,\
        levels=20\
    )\
)\
\
\
# ============================================================\
# CHECKS\
# ============================================================\
\
print("\n====================================")\
print(" CHECKS")\
print("====================================")\
\
\
# Buyer should be completely filled\
buyer_orders = orders.get_orders(BUYER)\
\
if buyer_orders[0]["status"] != "FILLED":\
    raise AssertionError(\
        f"BUY status incorrect: {buyer_orders[0]['status']}"\
    )\
\
\
if Decimal(str(buyer_orders[0]["executed_quantity"])) != BUY_QTY:\
    raise AssertionError(\
        "BUY executed quantity incorrect"\
    )\
\
\
# Seller should be partially filled\
seller_orders = orders.get_orders(SELLER)\
\
if seller_orders[0]["status"] != "PARTIALLY_FILLED":\
    raise AssertionError(\
        f"SELL status incorrect: {seller_orders[0]['status']}"\
    )\
\
\
expected_remaining = SELL_QTY - BUY_QTY\
\
actual_remaining = Decimal(\
    str(seller_orders[0]["remaining_quantity"])\
)\
\
if actual_remaining != expected_remaining:\
    raise AssertionError(\
        f"SELL remaining incorrect: "\
        f"{actual_remaining} != {expected_remaining}"\
    )\
\
\
# Seller BTC should remain locked for the remaining order\
seller_wallet = wallet.get_wallet(\
    SELLER,\
    "BTC"\
)\
\
expected_locked = expected_remaining\
\
actual_locked = Decimal(\
    str(seller_wallet["locked"])\
)\
\
if actual_locked != expected_locked:\
    raise AssertionError(\
        f"SELLER locked BTC incorrect: "\
        f"{actual_locked} != {expected_locked}"\
    )\
\
\
# Buyer should receive BTC\
buyer_btc = wallet.get_wallet(\
    BUYER,\
    "BTC"\
)\
\
if Decimal(str(buyer_btc["available"])) != BUY_QTY:\
    raise AssertionError(\
        "Buyer BTC balance incorrect"\
    )\
\
\
print("\n⃼�� PARTIAL FILL TEST PASSED")\
\
print("====================================")\
PY
