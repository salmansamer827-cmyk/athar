            user_id=buyer.user_id,\
            asset=base_asset,\
            amount=quantity,\
            entry_type="TRADE_BUY",\
            reference=trade_reference,\
        )\
\
        # Buyer spends quote asset.\
        self.ledger.record(\
            user_id=buyer.user_id,\
            asset=quote_asset,\
            amount=-quote_amount,\
            entry_type="TRADE_BUY",\
            reference=trade_reference,\
        )\
\
        # Seller spends base asset.\
        self.ledger.record(\
            user_id=seller.user_id,\
            asset=base_asset,\
            amount=-quantity,\
            entry_type="TRADE_SELL",\
            reference=trade_reference,\
        )\
\
        # Seller receives quote asset.\
        self.ledger.record(\
            user_id=seller.user_id,\
            asset=quote_asset,\
            amount=quote_amount,\
            entry_type="TRADE_SE
