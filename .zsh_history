: 1789288495:0;cat > backend/exchange/services/wallet_service.py <<'PY'\
from decimal import Decimal\
\
from backend.exchange.models.wallet import WalletBalance\
from backend.exchange.models.ledger import LedgerType\
from backend.exchange.services.ledger_service import LedgerService\
\
\
class WalletService:\
    def __init__(self, ledger_service=None):\
        self.ledger = ledger_service or LedgerService()\
        self._wallets = {}\
\
    def get_wallet(self, user_id: str, asset: str) -> WalletBalance:\
        asset = asset.upper()\
        key = (user_id, asset)\
\
        if key not in self._wallets:\
            self._wallets[key] = WalletBalance(\
                user_id=user_id,\
                asset=asset,\
            )\
\
        return self._wallets[key]\
\
    def deposit(\
        self,\
        user_id: str,\
        asset: str,\
        amount: Decimal,\
        reference_id=None,\
    ):\
        wallet = self.get_wallet(user_id, asset)\
\
        wallet.deposit(amount)\
\
        self.ledger.record(\
            user_id=user_id,\
            asset=asset,\
            entry_type=LedgerType.DEPOSIT,\
            amount=amount,\
            reference_id=reference_id,\
        )\
\
        return wallet\
\
    def credit(\
        self,\
        user_id: str,\
        asset: str,\
        amount: Decimal,\
        reference_id=None,\
    ):\
        if amount <= 0:\
            raise ValueError("Credit amount must be positive")\
\
        wallet = self.get_wallet(user_id, asset)\
        wallet.available += amount\
\
        return wallet\
\
    def lock(\
        self,\
        user_id: str,\
        asset: str,\
        amount: Decimal,\
        reference_id=None,\
    ):\
        wallet = self.get_wallet(user_id, asset)\
\
        wallet.lock(amount)\
\
        self.ledger.record(\
            user_id=user_id,\
            asset=asset,\
            entry_type=LedgerType.LOCK,\
            amount=amount,\
            reference_id=reference_id,\
        )\
\
        return wallet\
\
    def unlock(\
        self,\
        user_id: str,\
        asset: str,\
        amount: Decimal,\
        reference_id=None,\
    ):\
        wallet = self.get_wallet(user_id, asset)\
\
        wallet.unlock(amount)\
\
        self.ledger.record(\
            user_id=user_id,\
            asset=asset,\
            entry_type=LedgerType.UNLOCK,\
            amount=amount,\
            reference_id=reference_id,\
        )\
\
        return wallet\
\
    def debit_locked(\
        self,\
        user_id: str,\
        asset: str,\
        amount: Decimal,\
        reference_id=None,\
    ):\
        if amount <= 0:\
            raise ValueError("Debit amount must be positive")\
\
        wallet = self.get_wallet(user_id, asset)\
\
        if amount > wallet.locked:\
            raise ValueError("Insufficient locked balance")\
\
        wallet.locked -= amount\
\
        self.ledger.record(\
            user_id=user_id,\
            asset=asset,\
            entry_type=LedgerType.TRADE,\
            amount=amount,\
            reference_id=reference_id,\
        )\
\
        return wallet\
\
    def withdraw(\
        self,\
        user_id: str,\
        asset: str,\
        amount: Decimal,\
        reference_id=None,\
    ):\
        wallet = self.get_wallet(user_id, asset)\
\
        wallet.withdraw(amount)\
\
        self.ledger.record(\
            user_id=user_id,\
            asset=asset,\
            entry_type=LedgerType.WITHDRAW,\
            amount=amount,\
            reference_id=reference_id,\
        )\
\
        return wallet\
PY
: 1789288518:0;cat > backend/exchange/services/settlement_service.py <<'PY'\
from decimal import Decimal\
\
from backend.exchange.models.trade import Trade\
from backend.exchange.services.wallet_service import WalletService\
\
\
class SettlementService:\
    def __init__(self, wallet_service: WalletService):\
        self.wallet = wallet_service\
\
    def settle_trade(self, trade: Trade):\
        symbol = trade.symbol.upper()\
\
        if "/" not in symbol:\
            raise ValueError("Invalid trade symbol")\
\
        base_asset, quote_asset = symbol.split("/", 1)\
\
        quote_amount = trade.price * trade.quantity\
\
        # =========================\
        # BUYER\
        # =========================\
\
        # إزاك�ة اك�أك�ك�اك� اك�ك�حجك�زة ك�ك� اك�ك�شترك�\
        self.wallet.debit_locked(\
            user_id=trade.buyer_user_id,\
            asset=quote_asset,\
            amount=quote_amount,\
            reference_id=trade.trade_id,\
        )\
\
        # إضافة اك�أصك� ك�ك�ك�شترك�\
        self.wallet.credit(\
            user_id=trade.buyer_user_id,\
            asset=base_asset,\
            amount=trade.quantity,\
            reference_id=trade.trade_id,\
        )\
\
        # =========================\
        # SELLER\
        # =========================\
\
        # إزاك�ة اك�أصك� اك�ك�حجك�ز ك�ك� اك�بائع\
        self.wallet.debit_locked(\
            user_id=trade.seller_user_id,\
            asset=base_asset,\
            amount=trade.quantity,\
            reference_id=trade.trade_id,\
        )\
\
        # إضافة USDT ك�ك�بائع\
        self.wallet.credit(\
            user_id=trade.seller_user_id,\
            asset=quote_asset,\
            amount=quote_amount,\
            reference_id=trade.trade_id,\
        )\
\
        return {\
            "trade_id": trade.trade_id,\
            "symbol": trade.symbol,\
            "quantity": trade.quantity,\
            "price": trade.price,\
            "quote_amount": quote_amount,\
        }\
PY
