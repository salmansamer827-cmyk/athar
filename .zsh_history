import 'package:flutter/material.dart';\
import '../services/api_service.dart';\
\
class MarketsScreen extends StatefulWidget {\
  @override\
  _MarketsScreenState createState() => _MarketsScreenState();\
}\
\
class _MarketsScreenState extends State<MarketsScreen> {\
  List marketsList = [];\
  bool isLoading = true;\
\
  @override\
  void initState() {\
    super.initState();\
    fetchMarketsData();\
  }\
\
  Future<void> fetchMarketsData() async {\
    final data = await ApiService.getMarkets();\
    setState(() {\
      marketsList = data['markets'] ?? [];\
      isLoading = false;\
    });\
  }\
\
  @override\
  Widget build(BuildContext context) {\
    return Scaffold(\
      backgroundColor: Color(0xFF0B0E14),\
      appBar: AppBar(\
        backgroundColor: Color(0xFF1E2329),\
        title: Text('اك�أسك�اق اك�حك�ة (EXCORA)', style: TextStyle(color: Colors.white)),\
        actions: [\
          IconButton(\
            icon: Icon(Icons.refresh, color: Colors.white),\
            onPressed: () {\
              setState(() => isLoading = true);\
              fetchMarketsData();\
            },\
          ),\
        ],\
      ),\
      body: isLoading\
          ? Center(child: CircularProgressIndicator(color: Color(0xFFFCD535)))\
          : marketsList.isEmpty\
              ? Center(child: Text('ك�ا تك�جد أسك�اق ك�تاحة حاك�ك�اك�', style: TextStyle(color: Colors.grey)))\
              : ListView.builder(\
                  itemCount: marketsList.length,\
                  itemBuilder: (context, index) {\
                    final market = marketsList[index];\
                    return ListTile(\
                      title: Text(market['symbol'] ?? 'Unknown', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),\
                      subtitle: Text('اك�سعر اك�حاك�ك�', style: TextStyle(color: Colors.grey, fontSize: 12)),\
                      trailing: Text(\
                        market['price']?.toString() ?? '0.00',\
                        style: TextStyle(color: Colors.green, fontSize: 16, fontWeight: FontWeight.bold),\
                      ),\
                    );\
                  },\
                ),\
    );\
  }\
}\
EOF\

