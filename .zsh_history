# إعدادات اك�ك�ظاك� اك�رك�اضك�ة ك�إدارة اك�ك�خاطر اك�ك�تقدك�ة\
INITIAL_CAPITAL = 100.0         # رأس اك�ك�اك� اك�ك�رجعك� ك�ك�حساب (USDT)\
