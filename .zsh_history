            )\
\
        # ----------------------------------------------------\
        # تسجك�ك� اك�حك�اك�ة بعد ك�جاح SL + TP ك�عك�ا\
        # ----------------------------------------------------\
        protective_orders[clean_symbol] = {\
            "sl_id": sl_id,\
            "tp_id": tp_id,\
            "stop_loss": float(stop_loss),\
            "take_profit": float(take_profit),\
