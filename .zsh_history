cat > backend/core/matching_engine.py <<'PY'\
from dataclasses import dataclass\
from decimal import Decimal\
from typing import List\
\
from backend.models.order import OrderSide\
from backend.models.trade import Trade\
from backend.core.order_book import BookOrder, OrderBook\
\
\
@dataclass\
class MatchResult:\
    trades: List[Trade]\
    remaining_quantity: Decimal\
\
\
class MatchingEngine:\
    """\
    EXCORA Spot Matching Engine\
\
    Supports:\
    - LIMIT BUY\
    - LIMIT SELL\
    - MARKET BUY\
    - MARKET SELL\
    - Partial fills\
    - Price-Time Priority\
    - FIFO at the same price\
    - Self-trade prevention\
    """\
\
    def __init__(self):\
        self.order_books = {}\
        self.trade_counter = 0\
\
    # ============================================================\
    # ORDER BOOK\
    # ============================================================\
\
    def get_order_book(self, symbol: str) -> OrderBook:\
        symbol = symbol.upper()\
\
        if symbol not in self.order_books:\
            self.order_books[symbol] = OrderBook(symbol)\
\
        return self.order_books[symbol]\
\
    # ============================================================\
    # LIMIT ORDER\
    # ============================================================\
\
    def submit_limit_order(\
        self,\
        order_id: int,\
        user_id: str,\
        symbol: str,\
        side: OrderSide,\
        quantity: Decimal,\
        price: Decimal,\
        timestamp: int,\
    ) -> MatchResult:\
\
        symbol = symbol.upper()\
\
        quantity = Decimal(str(quantity))\
        price = Decimal(str(price))\
\
        if quantity <= 0:\
            raise ValueError(\
                "Limit order quantity must be greater than zero"\
            )\
\
        if price <= 0:\
            raise ValueError(\
                "Limit order price must be greater than zero"\
            )\
\
        book = self.get_order_book(symbol)\
\
        incoming = BookOrder(\
            order_id=order_id,\
            user_id=user_id,\
            symbol=symbol,\
            side=side,\
            price=price,\
            quantity=quantity,\
            remaining_quantity=quantity,\
            timestamp=timestamp,\
        )\
\
        trades = []\
\
        while incoming.remaining_quantity > 0:\
\
            if incoming.side == OrderSide.BUY:\
                resting = book.best_ask()\
\
                if resting is None:\
                    break\
\
                if incoming.price < resting.price:\
                    break\
\
            else:\
                resting = book.best_bid()\
\
                if resting is None:\
                    break\
\
                if incoming.price > resting.price:\
                    break\
\
            # ----------------------------------------------------\
            # SELF TRADE PREVENTION\
            # ----------------------------------------------------\
\
            if resting.user_id == incoming.user_id:\
                break\
\
            # ----------------------------------------------------\
            # MATCH QUANTITY\
            # ----------------------------------------------------\
\
            trade_quantity = min(\
                incoming.remaining_quantity,\
                resting.remaining_quantity,\
            )\
\
            if trade_quantity <= 0:\
                break\
\
            # ----------------------------------------------------\
            # PRICE-TIME PRIORITY\
            # ----------------------------------------------------\
\
            trade_price = resting.price\
\
            trade = self._create_trade(\
                symbol=symbol,\
                price=trade_price,\
                quantity=trade_quantity,\
                incoming=incoming,\
                resting=resting,\
            )\
\
            trades.append(trade)\
\
            # ----------------------------------------------------\
            # UPDATE QUANTITIES\
            # ----------------------------------------------------\
\
            incoming.remaining_quantity -= trade_quantity\
            resting.remaining_quantity -= trade_quantity\
\
            # ----------------------------------------------------\
            # REMOVE FILLED RESTING ORDER\
            # ----------------------------------------------------\
\
            if resting.remaining_quantity <= 0:\
                resting.remaining_quantity = Decimal("0")\
                book.remove_order(resting)\
\
        # --------------------------------------------------------\
        # ADD REMAINING LIMIT ORDER TO BOOK\
        # --------------------------------------------------------\
\
        if incoming.remaining_quantity > 0:\
            book.add_order(incoming)\
\
        return MatchResult(\
            trades=trades,\
            remaining_quantity=incoming.remaining_quantity,\
        )\
\
    # ============================================================\
    # MARKET ORDER\
    # ============================================================\
\
    def submit_market_order(\
        self,\
        order_id: int,\
        user_id: str,\
        symbol: str,\
        side: OrderSide,\
        quantity: Decimal,\
        timestamp: int,\
    ) -> MatchResult:\
\
        symbol = symbol.upper()\
\
        quantity = Decimal(str(quantity))\
\
        if quantity <= 0:\
            raise ValueError(\
                "Market order quantity must be greater than zero"\
            )\
\
        book = self.get_order_book(symbol)\
\
        incoming = BookOrder(\
            order_id=order_id,\
            user_id=user_id,\
            symbol=symbol,\
            side=side,\
            price=Decimal("0"),\
            quantity=quantity,\
            remaining_quantity=quantity,\
            timestamp=timestamp,\
        )\
\
        trades = []\
\
        while incoming.remaining_quantity > 0:\
\
            # ----------------------------------------------------\
            # FIND BEST LIQUIDITY\
            # ----------------------------------------------------\
\
            if incoming.side == OrderSide.BUY:\
                resting = book.best_ask()\
            else:\
                resting = book.best_bid()\
\
            if resting is None:\
                break\
\
            # ----------------------------------------------------\
            # SELF TRADE PREVENTION\
            # ----------------------------------------------------\
\
            if resting.user_id == incoming.user_id:\
                break\
\
            # ----------------------------------------------------\
            # MATCH\
            # ----------------------------------------------------\
\
            trade_quantity = min(\
                incoming.remaining_quantity,\
                resting.remaining_quantity,\
            )\
\
            if trade_quantity <= 0:\
                break\
\
            trade_price = resting.price\
\
            trade = self._create_trade(\
                symbol=symbol,\
                price=trade_price,\
                quantity=trade_quantity,\
                incoming=incoming,\
                resting=resting,\
            )\
\
            trades.append(trade)\
\
            incoming.remaining_quantity -= trade_quantity\
            resting.remaining_quantity -= trade_quantity\
\
            # ----------------------------------------------------\
            # REMOVE FILLED RESTING ORDER\
            # ----------------------------------------------------\
\
            if resting.remaining_quantity <= 0:\
                resting.remaining_quantity = Decimal("0")\
                book.remove_order(resting)\
\
        # --------------------------------------------------------\
        # IMPORTANT:\
        # MARKET ORDERS ARE NEVER ADDED TO THE BOOK\
        # --------------------------------------------------------\
\
        return MatchResult(\
            trades=trades,\
            remaining_quantity=incoming.remaining_quantity,\
        )\
\
    # ============================================================\
    # TRADE CREATION\
    # ============================================================\
\
    def _create_trade(\
        self,\
        symbol: str,\
        price: Decimal,\
        quantity: Decimal,\
        incoming: BookOrder,\
        resting: BookOrder,\
    ) -> Trade:\
\
        self.trade_counter += 1\
\
        if incoming.side == OrderSide.BUY:\
            buyer_order_id = incoming.order_id\
            seller_order_id = resting.order_id\
\
        else:\
            buyer_order_id = resting.order_id\
            seller_order_id = incoming.order_id\
\
        return Trade(\
            trade_id=self.trade_counter,\
            symbol=symbol,\
            price=price,\
            quantity=quantity,\
            buyer_order_id=buyer_order_id,\
            seller_order_id=seller_order_id,\
        )\
\
    # ============================================================\
    # ORDER BOOK SNAPSHOT\
    # ============================================================\
\
    def snapshot(\
        self,\
        symbol: str,\
        levels: int = 20,\
    ):\
        symbol = symbol.upper()\
\
        if levels <= 0:\
            raise ValueError(\
                "Levels must be greater than zero"\
            )\
\
        return self.get_order_book(symbol).snapshot(\
            levels=levels\
        )\
\
    # ============================================================\
    # CLEAR ORDER BOOK\
    # ============================================================\
\
    def clear_order_book(self, symbol: str):\
        symbol = symbol.upper()\
\
        if symbol in self.order_books:\
            del self.order_books[symbol]\
\
    # ============================================================\
    # CLEAR ALL BOOKS\
    # ============================================================\
\
    def clear_all(self):\
        self.order_books.clear()\
        self.trade_counter = 0\
PY
