const express = require('express');\
const path = require('path');\
const ccxt = require('ccxt');\
require('dotenv').config();\
\
const app = express();\
app.use(express.json());\
app.use(express.static(path.join(__dirname, 'public')));\
\
const binance = new ccxt.binance({\
    apiKey: process.env.BINANCE_API_KEY,\
    secret: process.env.BINANCE_SECRET_KEY,\
    enableRateLimit: true,\
    options: { defaultType: 'future' }\
});\
\
// إجك�اك�ك� رصك�د اك�ك�حفظة اك�افتراضك� ك�اك�حقك�قك�\
app.get('/api/balance', async (req, res) => {\
    try {\
        if (!process.env.BINANCE_API_KEY) {\
            return res.json({ success: true, total: 100.0, available: 100.0 });\
        }\
        const balance = await binance.fetchBalance();\
        res.json({\
            success: true,\
            total: balance.total['USDT'] || 100.0,\
            available: balance.free['USDT'] || 100.0\
        });\
    } catch (e) {\
        res.json({ success: true, total: 100.0, available: 100.0 });\
    }\
});\
\
// تك�فك�ذ اك�صفقات اك�حك�ة بك�ا؃�ك� عك�ك� استراتك�جك�ة EXCORA\
app.post('/api/order', async (req, res) => {\
    const { symbol, side, amount } = req.body;\
    try {\
        if (!process.env.BINANCE_API_KEY) {\
            return res.json({ success: true, orderId: 'DEMO-' + Date.now() });\
        }\
        const marketSymbol = symbol.includes(':') ? symbol : symbol + ':USDT';\
        const orderSide = side === 'BUY' ? 'buy' : 'sell';\
        \
        const order = await binance.createOrder(marketSymbol, 'market', orderSide, parseFloat(amount));\
        res.json({ success: true, orderId: order.id });\
    } catch (e) {\
        res.json({ success: false, error: e.message });\
    }\
});\
\
// جك�ب اك�عقك�د ك�اك�ك�راك�ز اك�ك�شطة\
app.get('/api/positions', async (req, res) => {\
    try {\
        if (!process.env.BINANCE_API_KEY) {\
            return res.json({ success: true, positions: [] });\
        }\
        const positions = await binance.fapiPrivateV3GetPositionRisk();\
        const active = positions.filter(p => parseFloat(p.positionAmt) !== 0);\
        res.json({ success: true, positions: active });\
    } catch (e) {\
        res.json({ success: true, positions: [] });\
    }\
});\
\
const PORT = process.env.PORT || 3000;\
app.listen(PORT, () => {\
    console.log(`EXCORA Server running on port ${PORT}`);\
});\
EOF\
\
