import numpy as np\
import pandas as pd\
\
from core.pipeline.quant_pipeline import QuantPipeline\
\
np.random.seed(42)\
\
n = 300\
\
price = 63000 + np.cumsum(\
    np.random.normal(0, 120, n)\
)\
\
close = price\
open_ = close + np.random.normal(0, 30, n)\
\
high = np.maximum(open_, close) + np.random.uniform(20, 100, n)\
low = np.minimum(open_, close) - np.random.uniform(20, 100, n)\
\
volume = np.random.uniform(\
    5000,\
    50000,\
    n\
)\
\
candles = pd.DataFrame({\
    "open": open_,\
    "high": high,\
    "low": low,\
    "close": close,\
    "volume": volume,\
})\
\
pipeline = QuantPipeline(\
    risk_percent=0.01,\
    reward_risk=3.0,\
    value_area=0.70,\
)\
\
result = pipeline.run(\
    candles=candles,\
    symbol="BTCUSDT",\
    market="CRYPTO",\
    timeframe="15m",\
    wins=72,\
    losses=28,\
    capital=100.0,\
)\
\
print("=" * 70)\
print("EXCORA  � END TO END QUANT PIPELINE")\
print("=" * 70)\
\
