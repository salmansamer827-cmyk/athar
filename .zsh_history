cat > backend/orders/service.py <<'EOF'\
from dataclasses import dataclass\
from decimal import Decimal\
from enum import Enum\
from threading import RLock\
from uuid import uuid4\
from datetime import datetime, timezone\
\
\
class OrderSide(str, Enum):\
    BUY = "BUY"\
    SELL = "SELL"\
\
\
class OrderType(str, Enum):\
    LIMIT = "LIMIT"\
    MARKET = "MARKET"\
\
\
class OrderStatus(str, Enum):\
    NEW = "NEW"\
    PARTIALLY_FILLED = "PARTIALLY_FILLED"\
    FILLED = "FILLED"\
    CANCELED = "CANCELED"\
\
\
@dataclass\
class Order:\
    order_id: str\
    user_id: str\
    symbol: str\
    side: str\
    order_type: str\
    price: Decimal\
    quantity: Decimal\
    remaining_quantity: Decimal\
    status: str\
    created_at: str\
\
\
class OrderService:\
\
    def __init__(self):\
        self._lock = RLock()\
        self._orders = {}\
\
    def create_order(\
        self,\
        user_id: str,\
        symbol: str,\
        side: str,\
        order_type: str,\
        price: Decimal,\
        quantity: Decimal,\
    ):\
\
        if quantity <= 0:\
            raise ValueError("Quantity must be greater than zero")\
\
        side = side.upper()\
        order_type = order_type.upper()\
        symbol = symbol.upper()\
\
        if side not in ("BUY", "SELL"):\
            raise ValueError("Invalid side. Use BUY or SELL")\
\
        if order_type not in ("LIMIT", "MARKET"):\
            raise ValueError("Invalid order type. Use LIMIT or MARKET")\
\
        if order_type == "LIMIT" and price <= 0:\
            raise ValueError("Limit price must be greater than zero")\
\
        order = Order(\
            order_id=str(uuid4()),\
            user_id=user_id,\
            symbol=symbol,\
            side=side,\
            order_type=order_type,\
            price=price,\
            quantity=quantity,\
            remaining_quantity=quantity,\
            status=OrderStatus.NEW.value,\
            created_at=datetime.now(timezone.utc).isoformat(),\
        )\
\
        with self._lock:\
            self._orders[order.order_id] = order\
\
        return order\
\
    def get_order(self, order_id: str):\
\
        with self._lock:\
            return self._orders.get(order_id)\
\
    def get_user_orders(self, user_id: str):\
\
        with self._lock:\
            return [\
                order\
                for order in self._orders.values()\
                if order.user_id == user_id\
            ]\
\
    def fill(\
        self,\
        order_id: str,\
        quantity: Decimal,\
    ):\
\
        quantity = Decimal(quantity)\
\
        if quantity <= 0:\
            raise ValueError(\
                "Fill quantity must be greater than zero"\
            )\
\
        with self._lock:\
\
            order = self._orders.get(order_id)\
\
            if order is None:\
                raise ValueError("Order not found")\
\
            if order.status == OrderStatus.CANCELED.value:\
                raise ValueError(\
                    "Cannot fill canceled order"\
                )\
\
            if order.status == OrderStatus.FILLED.value:\
                raise ValueError(\
                    "Order is already filled"\
                )\
\
            remaining = Decimal(order.remaining_quantity)\
\
            if quantity > remaining:\
                raise ValueError(\
                    f"Fill quantity exceeds remaining quantity: "\
                    f"fill={quantity}, remaining={remaining}"\
                )\
\
            order.remaining_quantity = remaining - quantity\
\
            if order.remaining_quantity == Decimal("0"):\
                order.remaining_quantity = Decimal("0")\
                order.status = OrderStatus.FILLED.value\
\
            else:\
                order.status = (\
                    OrderStatus.PARTIALLY_FILLED.value\
                )\
\
            return order\
\
    def cancel_order(self, order_id: str):\
\
        with self._lock:\
\
            order = self._orders.get(order_id)\
\
            if order is None:\
                raise ValueError("Order not found")\
\
            if order.status in (\
                OrderStatus.FILLED.value,\
                OrderStatus.CANCELED.value,\
            ):\
                raise ValueError(\
                    f"Cannot cancel order with status "\
                    f"{order.status}"\
                )\
\
            order.status = OrderStatus.CANCELED.value\
\
            return order\
EOF
