    <script>\
        function switchTab(tabId, element) {\
            document.querySelectorAll('.section-view').forEach(v => v.classList.remove('active'));\
            document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));\
            document.getElementById(tabId).classList.add('active');\
            element.classList.add('active');\
        }\
\
        function switchSubTab(section, subId, element) {\
            const parent = document.getElementById(section);\
            parent.querySelectorAll('.sub-view').forEach(v => v.classList.remove('active'));\
            parent.querySelectorAll('.sub-tab-btn').forEach(b => b.classList.remove('active'));\
            document.getElementById('sub-' + section + '-' + subId).classList.add('active');\
            element.classList.add('active');\
        }\
\
        // جك�ب اك�أسعار اك�حقك�قك�ة اك�حك�ة ك�ك� API عاك� ك�ك�جاك�ك� (CoinGecko)\
        async function fetchLivePrices() {\
            try {\
                const response = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,ripple&vs_currencies=usd');\
                const data = await response.json();\
                \
                if(data.bitcoin) {\
                    const btcPrice = '$' + data.bitcoin.usd.toLocaleString();\
                    document.getElementById('home-btc-price').innerText = btcPrice;\
                    document.getElementById('market-btc').innerText = btcPrice;\
                }\
                if(data.ethereum) {\
                    document.getElementById('market-eth').innerText = '$' + data.ethereum.usd.toLocaleString();\
                }\
                if(data.solana) {\
                    document.getElementById('market-sol').innerText = '$' + data.solana.usd.toLocaleString();\
                }\
                if(data.ripple) {\
                    document.getElementById('market-xrp').innerText = '$' + data.ripple.usd.toLocaleString();\
                }\
            } catch (e) {\
                console.log('Error fetching live data', e);\
            }\
        }\
\
        // تحدك�ث اك�أسعار فك�را ك�عك�د اك�تحك�ك�ك� ك�ك�ك� 10 ثك�اك�ك� ك�تبقك� حقك�قك�ة ك�تك�بض\
        fetchLivePrices();\
        setInterval(fetchLivePrices, 10000);\
    </script>\
</body>\
</html>\
