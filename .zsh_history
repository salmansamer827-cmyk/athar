</head>\
<body>\
    <div class="app-container">\
        <!-- اك�شرك�ط اك�عك�ك�ك� -->\
        <div class="header">\
            <div class="logo-box">\
                <span class="logo-text">EXCORA</span>\
                <i class="fa-solid fa-bolt bolt-c"></i>\
            </div>\
            <div class="header-icons">\
                <i class="fa-solid fa-qrcode" onclick="alert('QR Scanner')"></i>\
                <i class="fa-solid fa-headset" onclick="alert('اك�دعك� اك�فك�ك�')"></i>\
                <i class="fa-regular fa-bell" onclick="alert('اك�إشعارات')"></i>\
