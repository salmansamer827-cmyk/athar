main {\
    max-width: 1200px;\
    margin: auto;\
    padding: 30px 20px;\
}\
\
.hero {\
    margin-bottom: 30px;\
}\
\
.hero h1 {\
    font-size: 32px;\
    margin-bottom: 10px;\
}\
\
.hero p {\
    color: #8d9bb0;\
}\
\
.dashboard {\
    display: grid;\
    grid-template-columns: repeat(4, 1fr);\
    gap: 15px;\
}\
\
.card {\
    background: #0d1422;\
    border: 1px solid #1c2a40;\
    border-radius: 14px;\
    padding: 22px;\
}\
\
.card h3 {\
    color: #8190a7;\
    font-size: 14px;\
    margin-bottom: 12px;\
}\
\
.card div {\
    font-size: 20px;\
    font-weight: bold;\
}\
\
.controls {\
    display: flex;\
    gap: 12px;\
    margin: 25px 0;\
}\
\
button {\
    border: 0;\
    border-radius: 10px;\
    padding: 14px 25px;\
    font-size: 15px;\
    cursor: pointer;\
}\
\
.primary {\
    background: #168cff;\
    color: white;\
}\
\
.danger {\
    background: #d83b55;\
    color: white;\
}\
\
.signals {\
    background: #0d1422;\
    border: 1px solid #1c2a40;\
    border-radius: 14px;\
    padding: 25px;\
}\
\
.signals h2 {\
    margin-bottom: 20px;\
}\
\
#signalsList {\
    color: #8d9bb0;\
}\
\
@media (max-width: 800px) {\
\
    .dashboard {\
        grid-template-columns: repeat(2, 1fr);\
    }\
\
}\
\
@media (max-width: 500px) {\
\
    .dashboard {\
        grid-template-columns: 1fr;\
    }\
\
    .controls {\
        flex-direction: column;\
    }\
\
}\
EOF
