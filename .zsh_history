        * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }\
        body {\
            margin: 0;\
            background-color: #0b0f19; /* خك�فك�ة داك�ك�ة عك�ك�قة تتك�اسب ك�ع اك�ك�ك�ك�ك� اك�أزرق */\
            color: #f8fafc;\
            padding-bottom: 70px;\
            position: relative;\
            min-height: 100vh;\
        }\
\
        /* اك�عك�اك�ة اك�ك�ائك�ة اك�شفافة ك�ك�شعار فك� خك�فك�ة اك�ك�ك�قع بجك�ك�ع اك�ك�فاصك� */\
        body::before {\
            content: "";\
            position: fixed;\
            top: 50%;\
            left: 50%;\
            transform: translate(-50%, -50%);\
            width: 420px;\
            height: 420px;\
            background: url('logo.png') no-repeat center center;\
            background-size: contain;\
            opacity: 0.035; /* شفافك�ة ك�ك�خفضة ك�تك�ك�ك� عك�اك�ة ك�ائك�ة بصرك�ة ك�تك�اسقة */\
            pointer-events: none;\
            z-index: 0;\
