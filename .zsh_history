@app.post("/orders")\
def create_order(request: OrderRequest):\
\
    try:\
        price = Decimal(request.price)\
        quantity = Decimal(request.quantity)\
    except InvalidOperation:\
        raise HTTPException(\
            status_code=400,\
            detail="Invalid price or quantity",\
        )\
\
    side = request.side.upper()\
    order_type = request.order_type.upper()\
    symbol = request.symbol.upper()\
\
    if side not in ("BUY", "SELL"):\
        raise HTTPException(\
            status_code=400,\
            detail="Invalid side. Use BUY or SELL",\
        )\
\
    if order_type not in ("LIMIT", "MARKET"):\
        raise HTTPException(\
            status_code=400,\
            detail="Invalid order type. Use LIMIT or MARKET",\
        )\
\
    if quantity <= 0:\
        raise HTTPException(\
            status_code=400,\
            detail="Quantity must be greater than zero",\
        )\
\
    if order_type == "LIMIT" and price <= 0:\
        raise HTTPException(\
            status_code=400,\
            detail="Limit price must be greater than zero",\
        )\
\
    if not symbol.endswith("USDT"):\
        raise HTTPException(\
            status_code=400,\
            detail="Only USDT markets are currently supported",\
        )\
\
    base_asset = symbol[:-4]\
    quote_asset = "USDT"\
\
    # ---------------------------------------------------------\
    # RESERVE FUNDS\
    # ---------------------------------------------------------\
\
    try:\
\
        if side == "BUY":\
\
            if order_type == "MARKET":\
                raise ValueError(\
                    "MARKET BUY currently requires a limit price"\
                )\
\
            reserve_amount = price * quantity\
\
            wallet_service.reserve(\
                request.user_id,\
                quote_asset,\
                reserve_amount,\
            )\
\
        else:\
\
            wallet_service.reserve(\
                request.user_id,\
                base_asset,\
                quantity,\
            )\
\
    except ValueError as exc:\
        raise HTTPException(\
            status_code=400,\
            detail=str(exc),\
        )\
\
    # ---------------------------------------------------------\
    # CREATE ORDER\
    # ---------------------------------------------------------\
\
    try:\
\
        order = order_service.create_order(\
            user_id=request.user_id,\
            symbol=symbol,\
            side=side,\
            order_type=order_type,\
            price=price,\
            quantity=quantity,\
        )\
\
    except ValueError as exc:\
\
        # Return reserved funds if order creation fails.\
        if side == "BUY":\
            wallet_service.release(\
                request.user_id,\
                quote_asset,\
                price * quantity,\
            )\
        else:\
            wallet_service.release(\
                request.user_id,\
                base_asset,\
                quantity,\
            )\
\
        raise HTTPException(\
            status_code=400,\
            detail=str(exc),\
        )\
\
    # ---------------------------------------------------------\
    # MATCH\
    # ---------------------------------------------------------\
\
    trades = matching_engine.submit(order)\
    settled_trades = []\
\
    try:\
\
        for trade in trades:\
\
            buyer_order = order_service.get_order(\
                trade["buyer_order_id"]\
            )\
\
            seller_order = order_service.get_order(\
                trade["seller_order_id"]\
            )\
\
            if buyer_order is None or seller_order is None:\
                raise ValueError("Trade order not found")\
\
            quantity_filled = trade["quantity"]\
            price_filled = trade["price"]\
\
            order_service.fill(\
                buyer_order.order_id,\
                quantity_filled,\
            )\
\
            order_service.fill(\
                seller_order.order_id,\
                quantity_filled,\
            )\
\
            settled = settlement_service.settle_trade(\
                buyer=buyer_order,\
                seller=seller_order,\
                price=price_filled,\
                quantity=quantity_filled,\
            )\
\
            settled_trades.append(settled)\
\
    except ValueError as exc:\
        raise HTTPException(\
            status_code=500,\
            detail=f"Settlement error: {exc}",\
        )\
\
    # ---------------------------------------------------------\
    # RELEASE EXCESS BUY RESERVATION\
    # ---------------------------------------------------------\
\
    if order.status == "FILLED":\
        if side == "BUY":\
\
            # Any unused price difference from resting execution\
            # remains reserved. Release it.\
            reserved_remaining = wallet_service.reserved_amount(\
                request.user_id,\
                quote_asset,\
            )\
\
            if reserved_remaining > 0:\
                # Only release funds belonging to this completed order\
                # is ideal for production; current engine uses one\
                # in-memory account reservation model.\
                pass\
\
    return {\
        "status": "success",\
        "order": {\
            "order_id": order.order_id,\
            "user_id": order.user_id,\
            "symbol": order.symbol,\
            "side": order.side,\
            "order_type": order.order_type,\
            "price": str(order.price),\
            "quantity": str(order.quantity),\
            "remaining_quantity": str(\
                order.remaining_quantity\
            ),\
            "status": order.status,\
            "created_at": order.created_at,\
        },\
        "trades": [\
            {\
                "symbol": trade["symbol"],\
                "price": str(trade["price"]),\
                "quantity": str(trade["quantity"]),\
                "buyer_order_id": trade["buyer_order_id"],\
                "seller_order_id": trade["seller_order_id"],\
            }\
            for trade in settled_trades\
