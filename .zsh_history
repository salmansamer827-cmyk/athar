python - <<'PY'\
from pathlib import Path\
\
p = Path("core/pipeline/quant_pipeline.py")\
s = p.read_text()\
\
# ------------------------------------------------------------\
# A) Insert volatility method before _profile_dict\
# ------------------------------------------------------------\
marker = """    @staticmethod\
    def _profile_dict(\
"""\
\
method = '''    @staticmethod\
    def _volatility_ratio(\
        df: pd.DataFrame,\
        recent_window: int = 20,\
        baseline_window: int = 100,\
    ) -> float:\
        """\
        Normalized realized-volatility ratio.\
\
        current volatility:\
            std of recent percentage returns\
\
        baseline volatility:\
            std of longer-term percentage returns\
\
        ratio:\
            current_volatility / baseline_volatility\
        """\
\
        if len(df) < 3:\
            return 1.0\
\
        close = pd.to_numeric(\
            df["close"],\
            errors="coerce",\
        ).dropna()\
\
        if len(close) < 3:\
            return 1.0\
\
        returns = (\
            close\
            .pct_change()\
            .replace([float("inf"), float("-inf")], float("nan"))\
            .dropna()\
        )\
\
        if len(returns) < 2:\
            return 1.0\
\
        recent = returns.tail(\
            min(recent_window, len(returns))\
        )\
\
        baseline = returns.tail(\
            min(baseline_window, len(returns))\
        )\
\
        current_volatility = float(\
            recent.std(ddof=1)\
        )\
\
        baseline_volatility = float(\
            baseline.std(ddof=1)\
        )\
\
        if (\
            not pd.notna(current_volatility)\
            or not pd.notna(baseline_volatility)\
            or baseline_volatility <= 0.0\
        ):\
            return 1.0\
\
        ratio = (\
            current_volatility\
            / baseline_volatility\
        )\
\
        if not pd.notna(ratio):\
            return 1.0\
\
        return max(\
            0.01,\
            float(ratio),\
        )\
\
\
'''\
\
if "def _volatility_ratio(" not in s:\
    if marker not in s:\
        raise SystemExit(\
            "ERROR: _profile_dict marker not found"\
        )\
\
    s = s.replace(\
        marker,\
        method + marker,\
        1,\
    )\
\
    print("AUTO FIX: _volatility_ratio() inserted")\
else:\
    print("SKIP: _volatility_ratio() already exists")\
\
\
# ------------------------------------------------------------\
# B) Replace fake volatility input\
# ------------------------------------------------------------\
old = """            volatility_ratio=1.0,\
"""\
\
new = """            volatility_ratio=self._volatility_ratio(df),\
"""\
\
count = s.count(old)\
\
if count == 0:\
    print(\
        "SKIP: volatility_ratio=1.0 not found"\
    )\
elif count == 1:\
    s = s.replace(old, new, 1)\
\
    print(\
        "AUTO FIX: volatility_ratio=1.0 "\
        "-> self._volatility_ratio(df)"\
    )\
else:\
    raise SystemExit(\
        f"ERROR: Found {count} occurrences of "\
        "'volatility_ratio=1.0'. Refusing ambiguous patch."\
    )\
\
\
p.write_text(s)\
\
print("PATCH COMPLETE")\
PY\
\
