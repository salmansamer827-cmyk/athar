cat > backend/services/futures_risk_service.py <<'PY'\
from decimal import Decimal, getcontext\
\
from backend.database.db import get_connection\
\
getcontext().prec = 28\
\
\
class FuturesRiskService:\
\
    # Prototype configuration.\
    # ك�ذك� اك�قك�ك� قابك�ة ك�ك�تغك�ك�ر ك�احقاك� حسب فئات اك�ك�خاطر.\
    MAINTENANCE_MARGIN_RATE = Decimal("0.005")\
    WARNING_MARGIN_RATIO = Decimal("0.80")\
    LIQUIDATION_MARGIN_RATIO = Decimal("1.00")\
\
    @classmethod\
    def maintenance_margin(cls, notional):\
        notional = Decimal(str(notional))\
\
        if notional <= 0:\
            raise ValueError("Notional must be greater than zero")\
\
        return notional * cls.MAINTENANCE_MARGIN_RATE\
\
    @classmethod\
    def margin_ratio(\
        cls,\
        equity,\
        maintenance_margin,\
    ):\
        equity = Decimal(str(equity))\
        maintenance_margin = Decimal(\
            str(maintenance_margin)\
        )\
\
        if maintenance_margin <= 0:\
            return Decimal("0")\
\
        if equity <= 0:\
            return Decimal("999999")\
\
        return maintenance_margin / equity\
\
    @classmethod\
    def calculate_liquidation_price(\
        cls,\
        side,\
        entry_price,\
        quantity,\
        initial_margin,\
    ):\
        side = side.upper().strip()\
\
        entry_price = Decimal(str(entry_price))\
        quantity = Decimal(str(quantity))\
        initial_margin = Decimal(str(initial_margin))\
\
        if entry_price <= 0:\
            raise ValueError("Entry price must be greater than zero")\
\
        if quantity <= 0:\
            raise ValueError("Quantity must be greater than zero")\
\
        if initial_margin <= 0:\
            raise ValueError("Initial margin must be greater than zero")\
\
        maintenance_rate = cls.MAINTENANCE_MARGIN_RATE\
\
        # Simplified isolated-margin liquidation model.\
        #\
        # LONG:\
        # loss = (entry - liquidation) * quantity\
        # equity reaches maintenance margin.\
        #\
        # SHORT:\
        # loss = (liquidation - entry) * quantity\
\
        if side == "LONG":\
\
            numerator = (\
                initial_margin\
                - (entry_price * quantity * maintenance_rate)\
            )\
\
            denominator = (\
                quantity\
                * (Decimal("1") - maintenance_rate)\
            )\
\
            liquidation = numerator / denominator\
\
        elif side == "SHORT":\
\
            numerator = (\
                initial_margin\
                + (entry_price * quantity * maintenance_rate)\
            )\
\
            denominator = (\
                quantity\
                * (Decimal("1") + maintenance_rate)\
            )\
\
            liquidation = numerator / denominator\
\
        else:\
            raise ValueError(\
                "Side must be LONG or SHORT"\
            )\
\
        if liquidation <= 0:\
            return Decimal("0")\
\
        return liquidation\
\
    @classmethod\
    def calculate_position_risk(cls, position):\
\
        quantity = Decimal(\
            str(position["quantity"])\
        )\
\
        entry_price = Decimal(\
            str(position["entry_price"])\
        )\
\
        mark_price = Decimal(\
            str(position["mark_price"])\
        )\
\
        initial_margin = Decimal(\
            str(position["initial_margin"])\
        )\
\
        unrealized_pnl = Decimal(\
            str(position["unrealized_pnl"])\
        )\
\
        notional = quantity * mark_price\
\
        maintenance = cls.maintenance_margin(\
            notional\
        )\
\
        equity = initial_margin + unrealized_pnl\
\
        ratio = cls.margin_ratio(\
            equity,\
            maintenance\
        )\
\
        liquidation_price = (\
            cls.calculate_liquidation_price(\
                side=position["side"],\
                entry_price=entry_price,\
                quantity=quantity,\
                initial_margin=initial_margin,\
            )\
        )\
\
        if equity <= 0:\
            status = "LIQUIDATION"\
\
        elif ratio >= cls.LIQUIDATION_MARGIN_RATIO:\
            status = "LIQUIDATION"\
\
        elif ratio >= cls.WARNING_MARGIN_RATIO:\
            status = "WARNING"\
\
        else:\
            status = "SAFE"\
\
        return {\
            "position_id": position["id"],\
            "symbol": position["symbol"],\
            "side": position["side"],\
            "quantity": str(quantity),\
            "entry_price": str(entry_price),\
            "mark_price": str(mark_price),\
            "notional": str(notional),\
            "initial_margin": str(initial_margin),\
            "maintenance_margin": str(maintenance),\
            "unrealized_pnl": str(unrealized_pnl),\
            "equity": str(equity),\
            "margin_ratio": str(ratio),\
            "liquidation_price": str(\
                liquidation_price\
            ),\
            "risk_status": status,\
        }\
\
    def get_position_risk(self, position_id):\
\
        conn = get_connection()\
\
        try:\
            row = conn.execute(\
                """\
                SELECT *\
                FROM futures_positions\
                WHERE id = ?\
                """,\
                (position_id,),\
            ).fetchone()\
\
            if row is None:\
                raise ValueError(\
                    "Position not found"\
                )\
\
            position = dict(row)\
\
            return self.calculate_position_risk(\
                position\
            )\
\
        finally:\
            conn.close()\
\
    def get_user_risk(self, user_id):\
\
        conn = get_connection()\
\
        try:\
            rows = conn.execute(\
                """\
                SELECT *\
                FROM futures_positions\
                WHERE user_id = ?\
                  AND status = 'OPEN'\
                ORDER BY id DESC\
                """,\
                (user_id,),\
            ).fetchall()\
\
            return [\
                self.calculate_position_risk(\
                    dict(row)\
                )\
                for row in rows\
            ]\
\
        finally:\
            conn.close()\
PY
