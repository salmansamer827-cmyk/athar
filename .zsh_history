from __future__ import annotations\
\
from dataclasses import dataclass\
from typing import Optional\
\
\
@dataclass(frozen=True)\
class ProfileSignalConfig:\
    """\
    Configuration for the quantitative Volume Profile\
    decision engine.\
\
    The engine intentionally avoids:\
        EMA\
        RSI\
        MACD\
        SMC\
\
    Decision variables:\
        - Value Location\
        - POC Velocity\
        - Value Area Dynamics\
        - Probability\
        - Probability Uncertainty\
        - Expected Value\
        - Transaction Cost\
    """\
\
    min_probability: float = 0.55\
    min_adjusted_probability: float = 0.60\
\
    min_ev_r: float = 0.10\
\
    value_location_long: float = 0.60\
    value_location_short: float = 0.40\
\
    min_poc_velocity: float = 0.0\
\
    require_expansion: bool = True\
\
    max_uncertainty: float = 0.20\
\
    transaction_cost_r: float = 0.05\
\
    reward_risk: float = 3.0\
\
\
class VolumeProfileSignalEngine:\
    """\
    CAPITAL WISE\
    Pure Quantitative Volume Profile Signal Engine.\
\
    Mathematical decision structure:\
\
        Raw Probability\
                ⃦��\
        Uncertainty Adjustment\
                ⃦��\
        Adjusted Probability\
                ⃦��\
        Expected Value\
                ⃦��\
        Value Location\
                ⃦��\
        POC Velocity\
                ⃦��\
        Value Area Dynamics\
                ⃦��\
        Final Signal\
\
    No discretionary technical indicators are used.\
    """\
\
    def __init__(\
        self,\
        config: ProfileSignalConfig | None = None,\
    ) -> None:\
\
        self.config = (\
            config\
            if config is not None\
            else ProfileSignalConfig()\
        )\
\
        self._validate_config()\
\
    # ==========================================================\
    # CONFIGURATION VALIDATION\
    # ==========================================================\
\
    def _validate_config(self) -> None:\
\
        c = self.config\
\
        if not 0.0 < c.min_probability <= 1.0:\
            raise ValueError(\
                "min_probability must be between 0 and 1"\
            )\
\
        if not 0.0 < c.min_adjusted_probability <= 1.0:\
            raise ValueError(\
                "min_adjusted_probability must be between 0 and 1"\
            )\
\
        if c.min_ev_r < 0.0:\
            raise ValueError(\
                "min_ev_r must be >= 0"\
            )\
\
        if not 0.0 <= c.value_location_short < 0.5:\
            raise ValueError(\
                "value_location_short must be in [0, 0.5)"\
            )\
\
        if not 0.5 < c.value_location_long <= 1.0:\
            raise ValueError(\
                "value_location_long must be in (0.5, 1]"\
            )\
\
        if c.min_poc_velocity < 0.0:\
            raise ValueError(\
                "min_poc_velocity must be >= 0"\
            )\
\
        if not 0.0 <= c.max_uncertainty <= 1.0:\
            raise ValueError(\
                "max_uncertainty must be between 0 and 1"\
            )\
\
        if c.transaction_cost_r < 0.0:\
            raise ValueError(\
                "transaction_cost_r must be >= 0"\
            )\
\
        if c.reward_risk <= 0.0:\
            raise ValueError(\
                "reward_risk must be > 0"\
            )\
\
    # ==========================================================\
    # NUMERICAL VALIDATION\
    # ==========================================================\
\
    @staticmethod\
    def _validate_probability(\
        probability: float,\
        name: str,\
    ) -> float:\
\
        value = float(probability)\
\
        if not 0.0 <= value <= 1.0:\
            raise ValueError(\
                f"{name} must be between 0 and 1"\
            )\
\
        return value\
\
    @staticmethod\
    def _validate_positive(\
        value: float,\
        name: str,\
    ) -> float:\
\
        result = float(value)\
\
        if result <= 0.0:\
            raise ValueError(\
                f"{name} must be > 0"\
            )\
\
        return result\
\
    # ==========================================================\
    # ADJUSTED PROBABILITY\
    # ==========================================================\
\
    @staticmethod\
    def _adjust_probability(\
        probability: float,\
        uncertainty: float,\
    ) -> float:\
        """\
        Conservative uncertainty adjustment.\
\
        P_adjusted = P * (1 - U)\
\
        where:\
\
            P = raw empirical probability\
            U = uncertainty ⃨�� [0,1]\
\
        This deliberately penalizes uncertain estimates rather\
        than treating the raw win rate as perfectly reliable.\
        """\
\
        adjusted = probability * (\
            1.0 - uncertainty\
        )\
\
        return max(\
            0.0,\
            min(1.0, adjusted),\
        )\
\
    # ==========================================================\
    # EXPECTED VALUE\
    # ==========================================================\
\
    def _calculate_ev(\
        self,\
        probability: float,\
        reward_risk: float,\
    ) -> float:\
        """\
        Gross expected value:\
\
            EV = P Ã� R - (1-P) Ã� 1\
\
        Then transaction cost is subtracted separately.\
        """\
\
        return (\
            probability * reward_risk\
            - (1.0 - probability)\
        )\
\
    # ==========================================================\
    # MAIN EVALUATION\
    # ==========================================================\
\
    def evaluate(\
        self,\
        profile: dict,\
        dynamics: dict,\
        probability: float,\
        ev_r: float,\
        entry: float,\
        adjusted_probability: Optional[float] = None,\
        uncertainty: float = 0.0,\
    ) -> Optional[dict]:\
\
        # ------------------------------------------------------\
        # BASIC VALIDATION\
        # ------------------------------------------------------\
\
        entry = self._validate_positive(\
            entry,\
            "entry",\
        )\
\
        probability = self._validate_probability(\
            probability,\
            "probability",\
        )\
\
        uncertainty = self._validate_probability(\
            uncertainty,\
            "uncertainty",\
        )\
\
        if adjusted_probability is None:\
\
            adjusted_probability = (\
                self._adjust_probability(\
                    probability=probability,\
                    uncertainty=uncertainty,\
                )\
            )\
\
        else:\
\
            adjusted_probability = (\
                self._validate_probability(\
                    adjusted_probability,\
                    "adjusted_probability",\
                )\
            )\
\
        # ------------------------------------------------------\
        # PROFILE\
        # ------------------------------------------------------\
\
        try:\
            poc = float(profile["poc"])\
            vah = float(profile["vah"])\
            val = float(profile["val"])\
\
        except (KeyError, TypeError, ValueError) as exc:\
\
            raise ValueError(\
                "Invalid Volume Profile data"\
            ) from exc\
\
        if not (\
            val < poc < vah\
        ):\
            raise ValueError(\
                "Invalid Value Area: expected VAL < POC < VAH"\
            )\
\
        # ------------------------------------------------------\
        # DYNAMICS\
        # ------------------------------------------------------\
\
        try:\
            value_location = float(\
                dynamics["value_location"]\
            )\
\
            poc_velocity = float(\
                dynamics["poc_velocity"]\
            )\
\
            value_area_state = str(\
                dynamics["value_area_state"]\
            ).upper()\
\
        except (KeyError, TypeError, ValueError) as exc:\
\
            raise ValueError(\
                "Invalid profile dynamics"\
            ) from exc\
\
        # ------------------------------------------------------\
        # PROBABILITY QUALITY FILTER\
        # ------------------------------------------------------\
\
        if probability < (\
            self.config.min_probability\
        ):\
            return None\
\
        if uncertainty > (\
            self.config.max_uncertainty\
        ):\
            return None\
\
        if adjusted_probability < (\
            self.config.min_adjusted_probability\
        ):\
            return None\
\
        # ------------------------------------------------------\
        # NET EXPECTED VALUE\
        # ------------------------------------------------------\
\
        gross_ev_r = self._calculate_ev(\
            probability=adjusted_probability,\
            reward_risk=self.config.reward_risk,\
        )\
\
        net_ev_r = (\
            gross_ev_r\
            - self.config.transaction_cost_r\
        )\
\
        # The supplied EV must not be silently ignored.\
        # The engine uses the conservative minimum between\
        # externally supplied EV and internally recalculated EV.\
        conservative_ev_r = min(\
            float(ev_r),\
            net_ev_r,\
        )\
\
        if conservative_ev_r <= (\
            self.config.min_ev_r\
        ):\
            return None\
\
        # ------------------------------------------------------\
        # LONG CONDITION\
        # ------------------------------------------------------\
\
        long_condition = (\
            value_location\
            >= self.config.value_location_long\
            and poc_velocity\
            > self.config.min_poc_velocity\
        )\
\
        if long_condition:\
\
            if (\
                self.config.require_expansion\
                and value_area_state\
                != "EXPANDING"\
            ):\
                return None\
\
            price_risk = abs(\
                entry - val\
            )\
\
            if price_risk <= 0.0:\
                return None\
\
            take_profit = (\
                entry\
                + self.config.reward_risk\
                * price_risk\
            )\
\
            return {\
                "direction": "LONG",\
\
                "entry": entry,\
\
                "stop_loss": val,\
\
                "take_profit": take_profit,\
\
                "price_risk": price_risk,\
\
                "reward_risk": self.config.reward_risk,\
\
                "probability": probability,\
\
                "uncertainty": uncertainty,\
\
                "adjusted_probability":\
                    adjusted_probability,\
\
                "gross_ev_r": gross_ev_r,\
\
                "transaction_cost_r":\
                    self.config.transaction_cost_r,\
\
                "ev_r": conservative_ev_r,\
\
                "market_state":\
                    "VALUE_MIGRATION_UP",\
\
                "value_location":\
                    value_location,\
\
                "poc_velocity":\
                    poc_velocity,\
\
                "value_area_state":\
                    value_area_state,\
            }\
\
        # ------------------------------------------------------\
        # SHORT CONDITION\
        # ------------------------------------------------------\
\
        short_condition = (\
            value_location\
            <= self.config.value_location_short\
            and poc_velocity\
            < -self.config.min_poc_velocity\
        )\
\
        if short_condition:\
\
            if (\
                self.config.require_expansion\
                and value_area_state\
                != "EXPANDING"\
            ):\
                return None\
\
            price_risk = abs(\
                vah - entry\
            )\
\
            if price_risk <= 0.0:\
                return None\
\
            take_profit = (\
                entry\
                - self.config.reward_risk\
                * price_risk\
            )\
\
            return {\
                "direction": "SHORT",\
\
                "entry": entry,\
\
                "stop_loss": vah,\
\
                "take_profit": take_profit,\
\
                "price_risk": price_risk,\
\
                "reward_risk": self.config.reward_risk,\
\
                "probability": probability,\
\
                "uncertainty": uncertainty,\
\
                "adjusted_probability":\
                    adjusted_probability,\
\
                "gross_ev_r": gross_ev_r,\
\
                "transaction_cost_r":\
                    self.config.transaction_cost_r,\
\
                "ev_r": conservative_ev_r,\
\
                "market_state":\
                    "VALUE_MIGRATION_DOWN",\
\
                "value_location":\
                    value_location,\
\
                "poc_velocity":\
                    poc_velocity,\
\
                "value_area_state":\
                    value_area_state,\
            }\
\
        # ------------------------------------------------------\
        # NO SIGNAL\
        # ------------------------------------------------------\
\
        return None\
