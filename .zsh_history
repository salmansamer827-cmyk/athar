        }\
        .sub-tab-btn.active {\
            color: #38bdf8;\
        }\
        .sub-tab-btn.active::after {\
            content: '';\
            position: absolute;\
            bottom: 0;\
            left: 0;\
            right: 0;\
            height: 2px;\
            background-color: #38bdf8;\
            box-shadow: 0 0 8px #38bdf8;\
            border-radius: 2px;\
        }\
