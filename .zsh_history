\
python - <<'PY'\
from pathlib import Path\
\
p = Path("core/pipeline/quant_pipeline.py")\
s = p.read_text()\
\
# ============================================================\
# 1. Ensure numpy is available\
# ============================================================\
\
if "import numpy as np" not in s:\
    s = s.replace(\
        "import pandas as pd",\
        "import pandas as pd\nimport numpy as np"\
    )\
\
# ============================================================\
# 2. Add real volatility method inside QuantPipeline\
# ============================================================\
\
marker = "    @staticmethod\n    def _to_dataframe("\
\
method = '''    @staticmethod\
    def _volatility_ratio(\
        df: pd.DataFrame,\
        recent_window: int = 20,\
        baseline_window: int = 100,\
    ) -> float:\
        """\
        Normalized realized-volatility ratio.\
\
        ratio =\
            recent return volatility\
            /\
            baseline return volatility\
\
        > 1.0  = volatility expanding\
        < 1.0  = volatility contracting\
        """\
\
        if len(df) < 3:\
            return 1.0\
\
        close = pd.to_numeric(\
            df["close"],\
            errors="coerce",\
        ).dropna()\
\
        if len(close) < 3:\
            return 1.0\
\
        returns = (\
            close\
            .pct_change()\
            .replace([np.inf, -np.inf], np.nan)\
            .dropna()\
        )\
\
        if len(returns) < 2:\
            return 1.0\
\
        recent = returns.tail(\
            min(recent_window, len(returns))\
        )\
\
        baseline = returns.tail(\
            min(baseline_window, len(returns))\
        )\
\
        current_volatility = float(\
            recent.std(ddof=1)\
        )\
\
        baseline_volatility = float(\
            baseline.std(ddof=1)\
        )\
\
        if (\
            not np.isfinite(current_volatility)\
            or not np.isfinite(baseline_volatility)\
            or baseline_volatility <= 0\
        ):\
            return 1.0\
\
        ratio = (\
            current_volatility\
            / baseline_volatility\
        )\
\
        if not np.isfinite(ratio):\
            return 1.0\
\
        return max(\
            0.01,\
            float(ratio),\
        )\
\
'''\
\
if "_volatility_ratio(" not in s:\
    if marker not in s:\
        raise SystemExit(\
            "ERROR: insertion marker not found"\
        )\
\
    s = s.replace(\
        marker,\
        method + marker,\
        1\
    )\
\
# ============================================================\
# 3. Fix uncertainty ordering\
# ============================================================\
\
old = '''          adaptive_result = self.adaptive_risk_engine.calculate(\
              probability=adjusted_probability,\
              uncertainty=probability_uncertainty,\
              volatility_ratio=1.0,\
              drawdown_percent=0.0,\
          )\
'''\
\
new = '''          volatility_ratio = self._volatility_ratio(df)\
\
          probability_uncertainty = float(\
              getattr(\
                  probability,\
                  "uncertainty",\
                  probability.upper_bound\
                  - probability.lower_bound,\
              )\
          )\
\
          adaptive_result = self.adaptive_risk_engine.calculate(\
              probability=adjusted_probability,\
              uncertainty=probability_uncertainty,\
              volatility_ratio=volatility_ratio,\
              drawdown_percent=0.0,\
          )\
'''\
\
if old in s:\
    s = s.replace(old, new, 1)\
else:\
    print(\
        "WARNING: exact adaptive block not found; "\
        "manual inspection required."\
    )\
\
# ============================================================\
# 4. Remove duplicated uncertainty calculation later\
# ============================================================\
\
duplicate = '''          probability_uncertainty = float(\
              getattr(\
                  probability,\
                  "uncertainty",\
                  0.0,\
              )\
          )\
\
'''\
\
# Keep the first occurrence and remove later duplicates.\
first = s.find(duplicate)\
\
if first >= 0:\
    second = s.find(\
        duplicate,\
        first + len(duplicate)\
    )\
\
    if second >= 0:\
        s = s[:second] + s[second + len(duplicate):]\
\
# ============================================================\
# 5. Write\
# ============================================================\
\
p.write_text(s)\
\
print("=" * 70)\
print("AUTO PATCH: REAL ADAPTIVE INPUTS")\
print("=" * 70)\
print("⃼�� probability_uncertainty ordering fixed")\
print("⃼�� real volatility ratio connected")\
print("⃼�� volatility calculation uses closed pipeline data")\
print("⃼�� backup created")\
print("=" * 70)\
