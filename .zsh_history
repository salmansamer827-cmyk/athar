\
        function openTradeModal(type) {\
            let amount = prompt(`أدخك� اك�ك�بك�غ ك�تك�فك�ذ أك�ر ${type} عك�ك� ${currentSelectedSymbol}:`, "1000");\
            if(amount && !isNaN(amount) && amount > 0) {\
                // إضافة اك�صفقة إك�ك� قائك�ة اك�صفقات اك�حك�ة\
                activePositions.push({\
                    symbol: currentSelectedSymbol,\
                    type: type,\
                    entry: currentPrice,\
                    pnl: (Math.random() * 20 - 5).toFixed(2)\
                });\
                updatePositionsTable();\
                alert(`⃺�� تك� تك�فك�ذ أك�ر ${type} بقك�ك�ة $${amount} عك�ك� ${currentSelectedSymbol} بك�جاح!`);\
            }\
        }\
\
        function updatePositionsTable() {\
            const tbody = document.getElementById('positionsTableBody');\
            if(activePositions.length === 0) {\
                tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; color: var(--text-secondary);">ك�ا تك�جد صفقات ك�فتك�حة حاك�ك�اك�</td></tr>';\
                return;\
            }\
            tbody.innerHTML = '';\
            activePositions.forEach(pos => {\
                let isProfit = Number(pos.pnl) >= 0;\
                let tr = document.createElement('tr');\
                tr.innerHTML = `\
                    <td><b>${pos.symbol}</b></td>\
                    <td><span style="color: ${pos.type === 'LONG' ? 'var(--green)' : 'var(--red)'}; font-weight: bold;">${pos.type}</span></td>\
                    <td>$${pos.entry.toLocaleString()}</td>\
                    <td><span class="change ${isProfit ? 'positive' : 'negative'}">${isProfit ? '+' : ''}$${pos.pnl}</span></td>\
                `;\
                tbody.appendChild(tr);\
            });\
        }\
\
        document.addEventListener("DOMContentLoaded", () => {\
            renderTopTicker();\
            renderMarkets();\
            loadChartWidget('BINANCE:BTCUSDT', 'BTC/USDT');\
        });\
\
        // ك�حاك�اة اك�تحدك�ث اك�حك� ك�ك�أسعار ك�اك�أرباح\
        setInterval(() => {\
            marketPairs.forEach(p => {\
                if(p.symbol === 'BTC/USDT') {\
                    p.price = Number((91400 + Math.random() * 60).toFixed(2));\
                    currentPrice = p.price;\
                }\
            });\
            renderTopTicker();\
            \
            // تحدك�ث عشك�ائك� بسك�ط ك�أرباح اك�صفقات اك�ك�فتك�حة ك�إعطا؃� طابع حقك�قك�\
            activePositions.forEach(pos => {\
                let diff = (Math.random() * 2 - 0.9);\
                pos.pnl = (Number(pos.pnl) + diff).toFixed(2);\
            });\
            if(activePositions.length > 0) {\
                updatePositionsTable();\
            }\
        }, 4000);\
    </script>\
</body>\
</html>\
EOF\
