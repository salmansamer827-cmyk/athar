        async function fetchLivePrices() {\
            try {\
                const response = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana&vs_currencies=usd');\
                const data = await response.json();\
                if(data.bitcoin) {\
                    const p = '$' + data.bitcoin.usd.toLocaleString();\
                    document.getElementById('home-btc-price').innerText = p;\
                    document.getElementById('market-btc').innerText = p;\
                }\
                if(data.ethereum) document.getElementById('market-eth').innerText = '$' + data.ethereum.usd.toLocaleString();\
                if(data.solana) document.getElementById('market-sol').innerText = '$' + data.solana.usd.toLocaleString();\
            } catch(e) {}\
        }\
        fetchLivePrices();\
        setInterval(fetchLivePrices, 10000);\
    </script>\
</body>\
</html>\
EOF\
