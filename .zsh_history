            self.probability_engine.calculate(\
                wins=wins,\
                losses=losses,\
                confidence_level=0.95,\
            )\
        )\
\
        # -------------------------------------------------\
        # 9. EXPECTED VALUE\
        # -------------------------------------------------\
\
        reward_r = 3.0\
        risk_r = 1.0\
\
        expected_value_r = (\
            probability.probability\
            * reward_r\
            - (\
                1.0\
                - probability.probability\
            )\
            * risk_r\
        )\
'''\
\
new = '''        probability = (\
            self.probability_engine.calculate(\
                wins=wins,\
                losses=losses,\
                confidence_level=0.95,\
            )\
        )\
\
        # -------------------------------------------------\
        # 9. STATISTICALLY ADJUSTED PROBABILITY\
        # -------------------------------------------------\
\
        raw_probability = float(\
            probability.probability\
        )\
\
        adjusted_probability = float(\
            getattr(\
                probability,\
                "adjusted_probability",\
                probability.lower_bound,\
            )\
        )\
\
        uncertainty = float(\
            getattr(\
                probability,\
                "uncertainty",\
                probability.upper_bound\
                - probability.lower_bound,\
            )\
        )\
\
        # -------------------------------------------------\
        # 10. EXPECTED VALUE\
        # -------------------------------------------------\
\
        reward_r = float(\
            self.risk_engine.reward_risk\
        )\
\
        risk_r = 1.0\
\
        expected_value_r = (\
            adjusted_probability\
            * reward_r\
            - (\
                1.0\
                - adjusted_probability\
            )\
            * risk_r\
        )\
'''\
\
if old not in text:\
    raise SystemExit(\
        "Expected probability block was not found."\
    )\
\
text = text.replace(old, new)\
\
old_signal = '''                probability=(\
                    probability.probability\
                ),\
                ev_r=expected_value_r,\
                entry=entry,\
            )\
'''\
\
new_signal = '''                probability=raw_probability,\
                adjusted_probability=adjusted_probability,\
                uncertainty=uncertainty,\
                ev_r=expected_value_r,\
                entry=entry,\
            )\
'''\
\
if old_signal not in text:\
    raise SystemExit(\
        "Expected signal call was not found."\
    )\
\
text = text.replace(old_signal, new_signal)\
\
p.write_text(text)\
\
print("UPDATED:", p)\
