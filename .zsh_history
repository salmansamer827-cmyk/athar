cat > backend/core/futures_engine.py <<'PY'\
from dataclasses import dataclass\
from decimal import Decimal\
from enum import Enum\
\
\
class PositionSide(str, Enum):\
    LONG = "LONG"\
    SHORT = "SHORT"\
\
\
@dataclass\
class FuturesPosition:\
    user_id: str\
    symbol: str\
    side: PositionSide\
    quantity: Decimal\
    entry_price: Decimal\
    leverage: int\
    margin: Decimal\
\
    def notional(self) -> Decimal:\
        return self.quantity * self.entry_price\
\
    def unrealized_pnl(self, mark_price: Decimal) -> Decimal:\
        mark_price = Decimal(str(mark_price))\
\
        if self.side == PositionSide.LONG:\
            return (mark_price - self.entry_price) * self.quantity\
\
        return (self.entry_price - mark_price) * self.quantity\
\
\
class FuturesEngine:\
\
    def __init__(self):\
        self.positions = {}\
\
    def open_position(\
        self,\
        user_id: str,\
        symbol: str,\
        side: PositionSide,\
        quantity,\
        entry_price,\
        leverage: int = 1,\
    ):\
        quantity = Decimal(str(quantity))\
        entry_price = Decimal(str(entry_price))\
\
        if quantity <= 0:\
            raise ValueError("Quantity must be greater than zero")\
\
        if entry_price <= 0:\
            raise ValueError("Entry price must be greater than zero")\
\
        if leverage < 1:\
            raise ValueError("Leverage must be at least 1")\
\
        if leverage > 125:\
            raise ValueError("Maximum leverage is 125x")\
\
        notional = quantity * entry_price\
        margin = notional / Decimal(str(leverage))\
\
        key = (user_id, symbol.upper(), side.value)\
\
        position = FuturesPosition(\
            user_id=user_id,\
            symbol=symbol.upper(),\
            side=side,\
            quantity=quantity,\
            entry_price=entry_price,\
            leverage=leverage,\
            margin=margin,\
        )\
\
        self.positions[key] = position\
\
        return position\
\
    def get_position(\
        self,\
        user_id: str,\
        symbol: str,\
        side: PositionSide,\
    ):\
        return self.positions.get(\
            (user_id, symbol.upper(), side.value)\
        )\
\
    def close_position(\
        self,\
        user_id: str,\
        symbol: str,\
        side: PositionSide,\
        exit_price,\
    ):\
        key = (user_id, symbol.upper(), side.value)\
\
        position = self.positions.get(key)\
\
        if position is None:\
            raise ValueError("Position not found")\
\
        exit_price = Decimal(str(exit_price))\
\
        pnl = position.unrealized_pnl(exit_price)\
\
        del self.positions[key]\
\
        return {\
            "user_id": position.user_id,\
            "symbol": position.symbol,\
            "side": position.side.value,\
            "quantity": str(position.quantity),\
            "entry_price": str(position.entry_price),\
            "exit_price": str(exit_price),\
            "leverage": position.leverage,\
            "margin": str(position.margin),\
            "realized_pnl": str(pnl),\
        }\
\
    def snapshot(self):\
        return [\
            {\
                "user_id": position.user_id,\
                "symbol": position.symbol,\
                "side": position.side.value,\
                "quantity": str(position.quantity),\
                "entry_price": str(position.entry_price),\
                "leverage": position.leverage,\
                "margin": str(position.margin),\
            }\
            for position in self.positions.values()\
        ]\
