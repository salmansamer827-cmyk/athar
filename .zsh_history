from decimal import Decimal\
import time\
\
from backend.database.db import init_db, get_connection\
from backend.services.wallet_service import WalletService\
from backend.services.order_service import OrderService\
from backend.services.execution_service import ExecutionService\
\
\
init_db()\
\
wallet = WalletService()\
orders = OrderService()\
execution = ExecutionService()\
\
BUYER = "spot_buyer_test"\
SELLER = "spot_seller_test"\
\
SYMBOL = "BTC/USDT"\
PRICE = Decimal("68000")\
QUANTITY = Decimal("0.001")\
\
\
def reset_test_data():\
    conn = get_connection()\
    try:\
        conn.execute("BEGIN")\
\
        conn.execute(\
            "DELETE FROM ledger_entries WHERE user_id IN (?, ?)",\
            (BUYER, SELLER)\
        )\
\
        conn.execute(\
            "DELETE FROM trades WHERE buyer_user_id IN (?, ?)"\
            " OR seller_user_id IN (?, ?)",\
            (BUYER, SELLER, BUYER, SELLER)\
        )\
\
        conn.execute(\
            "DELETE FROM orders WHERE user_id IN (?, ?)",\
            (BUYER, SELLER)\
        )\
\
        conn.execute(\
            "DELETE FROM wallets WHERE user_id IN (?, ?)",\
            (BUYER, SELLER)\
        )\
\
        conn.commit()\
    except Exception:\
        conn.rollback()\
        raise\
    finally:\
        conn.close()\
\
\
print("\n====================================")\
print(" EXCORA SPOT TRADE TEST")\
print("====================================")\
\
reset_test_data()\
\
# --------------------------------------------------\
# 1. FUND BUYER\
# --------------------------------------------------\
\
print("\n[1] Funding buyer")\
\
wallet.deposit(\
    BUYER,\
    "USDT",\
    Decimal("100")\
)\
\
# --------------------------------------------------\
# 2. FUND SELLER\
# --------------------------------------------------\
\
print("[2] Funding seller")\
\
wallet.deposit(\
    SELLER,\
    "BTC",\
    Decimal("0.002")\
)\
\
print("\nBUYER BEFORE:")\
print(wallet.get_wallet(BUYER, "USDT"))\
\
print("\nSELLER BEFORE:")\
print(wallet.get_wallet(SELLER, "BTC"))\
\
# --------------------------------------------------\
# 3. CREATE SELL ORDER\
# --------------------------------------------------\
\
print("\n[3] Creating SELL order")\
\
sell = orders.create_limit_order(\
    user_id=SELLER,\
    symbol=SYMBOL,\
    side="SELL",\
    quantity=QUANTITY,\
    price=PRICE\
)\
\
print(sell)\
\
# --------------------------------------------------\
# 4. PUT SELL ORDER INTO MATCHING ENGINE\
# --------------------------------------------------\
\
print("\n[4] Executing SELL order")\
\
sell_execution = execution.execute_limit_order(\
    order_id=sell["order_id"],\
    user_id=SELLER,\
    symbol=SYMBOL,\
    side="SELL",\
    quantity=QUANTITY,\
    price=PRICE\
)\
\
print(sell_execution)\
\
# --------------------------------------------------\
# 5. CREATE BUY ORDER\
# --------------------------------------------------\
\
print("\n[5] Creating BUY order")\
\
buy = orders.create_limit_order(\
    user_id=BUYER,\
    symbol=SYMBOL,\
    side="BUY",\
    quantity=QUANTITY,\
    price=PRICE\
)\
\
print(buy)\
\
# --------------------------------------------------\
# 6. MATCH BUY AGAINST SELL\
# --------------------------------------------------\
\
print("\n[6] Executing BUY order")\
\
buy_execution = execution.execute_limit_order(\
    order_id=buy["order_id"],\
    user_id=BUYER,\
    symbol=SYMBOL,\
    side="BUY",\
    quantity=QUANTITY,\
    price=PRICE\
)\
\
print(buy_execution)\
\
# --------------------------------------------------\
# 7. FINAL WALLETS\
# --------------------------------------------------\
\
print("\n====================================")\
print(" FINAL WALLETS")\
print("====================================")\
\
print("\nBUYER USDT:")\
print(wallet.get_wallet(BUYER, "USDT"))\
\
print("\nBUYER BTC:")\
print(wallet.get_wallet(BUYER, "BTC"))\
\
print("\nSELLER BTC:")\
print(wallet.get_wallet(SELLER, "BTC"))\
\
print("\nSELLER USDT:")\
print(wallet.get_wallet(SELLER, "USDT"))\
\
# --------------------------------------------------\
# 8. ORDERS\
# --------------------------------------------------\
\
print("\n====================================")\
print(" ORDERS")\
print("====================================")\
\
print("\nBUYER ORDERS:")\
for order in orders.get_orders(BUYER):\
    print(order)\
\
print("\nSELLER ORDERS:")\
for order in orders.get_orders(SELLER):\
    print(order)\
\
# --------------------------------------------------\
# 9. TRADES\
# --------------------------------------------------\
\
print("\n====================================")\
print(" TRADES")\
print("====================================")\
\
conn = get_connection()\
\
try:\
    trades = conn.execute("""\
        SELECT *\
        FROM trades\
        WHERE buyer_user_id = ?\
           OR seller_user_id = ?\
        ORDER BY id\
    """, (BUYER, SELLER)).fetchall()\
\
    for trade in trades:\
        print(dict(trade))\
\
finally:\
    conn.close()\
\
# --------------------------------------------------\
# 10. LEDGER\
# --------------------------------------------------\
\
print("\n====================================")\
print(" LEDGER")\
print("====================================")\
\
conn = get_connection()\
\
try:\
    ledger = conn.execute("""\
        SELECT *\
        FROM ledger_entries\
        WHERE user_id IN (?, ?)\
        ORDER BY id\
    """, (BUYER, SELLER)).fetchall()\
\
    for entry in ledger:\
        print(dict(entry))\
\
finally:\
    conn.close()\
\
print("\n====================================")\
print(" TEST FINISHED")\
print("====================================")\
PY
