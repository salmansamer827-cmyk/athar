import os\
import time\
import hmac\
import hashlib\
import requests\
from urllib.parse import urlencode\
from dotenv import load_dotenv\
\
load_dotenv()\
\
API_KEY = os.getenv("BINANCE_API_KEY")\
SECRET = os.getenv("BINANCE_SECRET_KEY")\
\
if not API_KEY or not SECRET:\
    print("⃽�� ك�فاتك�ح Binance غك�ر ك�ك�جك�دة فك� .env")\
    exit(1)\
\
base_url = "https://api.binance.com"\
\
params = {\
    "symbol": "BNBUSDT",\
    "timestamp": int(time.time() * 1000),\
    "recvWindow": 5000,\
}\
\
query = urlencode(params)\
signature = hmac.new(\
    SECRET.encode(),\
    query.encode(),\
    hashlib.sha256\
).hexdigest()\
\
params["signature"] = signature\
\
headers = {\
    "X-MBX-APIKEY": API_KEY\
}\
\
response = requests.get(\
    f"{base_url}/sapi/v1/asset/tradeFee",\
    params=params,\
    headers=headers,\
    timeout=10\
)\
\
data = response.json()\
\
if response.status_code != 200:\
    print("⃽�� Binance API Error:")\
    print(data)\
    exit(1)\
\
print("\n========== EXCORA / BINANCE ==========")\
print("Symbol: BNBUSDT")\
\
for item in data:\
    maker = float(item["makerCommission"])\
    taker = float(item["takerCommission"])\
\
    print(f"Maker Fee : {maker * 100:.4f}%")\
    print(f"Taker Fee : {taker * 100:.4f}%")\
\
    print("\n--- صفقة 100 USDT ---")\
\
    entry = 759.48\
    target = 773.41\
    capital = 100\
\
    quantity_before_fee = capital / entry\
\
    buy_fee = capital * maker\
    quantity
