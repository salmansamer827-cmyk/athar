                        <button onclick="executeOrder('SELL')" style="flex: 1; background: var(--accent-red); color: #fff; padding: 14px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px;">بك�ع (SHORT)</button>\
