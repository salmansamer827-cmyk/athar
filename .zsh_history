: 1788545789:0;cat > backend/services/settlement_service.py <<'PY'\
from decimal import Decimal\
import time\
\
from backend.database.db import get_connection\
\
\
TRADING_FEE_RATE = Decimal("0.001")\
\
\
class SettlementService:\
\
    def settle_trade(\
        self,\
        buyer_user_id: str,\
        seller_user_id: str,\
        symbol: str,\
        price: Decimal,\
        quantity: Decimal,\
        buyer_order_id: int,\
        seller_order_id: int,\
    ):\
        symbol = symbol.upper()\
\
        try:\
            base_asset, quote_asset = symbol.split("/")\
        except ValueError:\
            raise ValueError(f"Invalid symbol: {symbol}")\
\
        price = Decimal(str(price))\
        quantity = Decimal(str(quantity))\
\
        if price <= 0:\
            raise ValueError("Trade price must be greater than zero")\
\
        if quantity <= 0:\
            raise ValueError("Trade quantity must be greater than zero")\
\
        gross_value = price * quantity\
\
        buyer_fee = gross_value * TRADING_FEE_RATE\
        seller_fee = gross_value * TRADING_FEE_RATE\
\
        buyer_total = gross_value + buyer_fee\
        seller_net = gross_value - seller_fee\
\
        now = int(time.time())\
\
        conn = get_connection()\
\
        try:\
            conn.execute("BEGIN")\
\
            # ==================================================\
            # BUYER QUOTE WALLET\
            # ==================================================\
\
            buyer_quote = conn.execute(\
                """\
                SELECT available, locked\
                FROM wallets\
                WHERE user_id = ?\
                  AND asset = ?\
                """,\
                (buyer_user_id, quote_asset),\
            ).fetchone()\
\
            if buyer_quote is None:\
                raise ValueError(\
                    f"Buyer has no {quote_asset} wallet"\
                )\
\
            buyer_locked = Decimal(\
                str(buyer_quote["locked"])\
            )\
\
            if buyer_locked < buyer_total:\
                raise ValueError(\
                    f"Buyer locked {quote_asset} balance "\
                    f"is insufficient. "\
                    f"Required: {buyer_total}, "\
                    f"Locked: {buyer_locked}"\
                )\
\
            # Remove quote + buyer fee from locked balance\
            conn.execute(\
                """\
                UPDATE wallets\
                SET\
                    locked = locked - ?,\
                    updated_at = ?\
                WHERE user_id = ?\
                  AND asset = ?\
                """,\
                (\
                    float(buyer_total),\
                    now,\
                    buyer_user_id,\
                    quote_asset,\
                ),\
            )\
\
            # ==================================================\
            # BUYER BASE WALLET\
            # ==================================================\
\
            conn.execute(\
                """\
                INSERT INTO wallets\
                (\
                    user_id,\
                    asset,\
                    available,\
                    locked,\
                    created_at,\
                    updated_at\
                )\
                VALUES (?, ?, ?, 0, ?, ?)\
\
                ON CONFLICT(user_id, asset)\
                DO UPDATE SET\
                    available = wallets.available + excluded.available,\
                    updated_at = excluded.updated_at\
                """,\
                (\
                    buyer_user_id,\
                    base_asset,\
                    float(quantity),\
                    now,\
                    now,\
                ),\
            )\
\
            # ==================================================\
            # SELLER BASE WALLET\
            # ==================================================\
\
            seller_base = conn.execute(\
                """\
                SELECT available, locked\
                FROM wallets\
                WHERE user_id = ?\
                  AND asset = ?\
                """,\
                (seller_user_id, base_asset),\
            ).fetchone()\
\
            if seller_base is None:\
                raise ValueError(\
                    f"Seller has no {base_asset} wallet"\
                )\
\
            seller_locked = Decimal(\
                str(seller_base["locked"])\
            )\
\
            if seller_locked < quantity:\
                raise ValueError(\
                    f"Seller locked {base_asset} balance "\
                    f"is insufficient. "\
                    f"Required: {quantity}, "\
                    f"Locked: {seller_locked}"\
                )\
\
            # Remove sold BTC from locked\
            conn.execute(\
                """\
                UPDATE wallets\
                SET\
                    locked = locked - ?,\
                    updated_at = ?\
                WHERE user_id = ?\
                  AND asset = ?\
                """,\
                (\
                    float(quantity),\
                    now,\
                    seller_user_id,\
                    base_asset,\
                ),\
            )\
\
            # ==================================================\
            # SELLER QUOTE WALLET\
            # ==================================================\
\
            conn.execute(\
                """\
                INSERT INTO wallets\
                (\
                    user_id,\
                    asset,\
                    available,\
                    locked,\
                    created_at,\
                    updated_at\
                )\
                VALUES (?, ?, ?, 0, ?, ?)\
\
                ON CONFLICT(user_id, asset)\
                DO UPDATE SET\
                    available = wallets.available + excluded.available,\
                    updated_at = excluded.updated_at\
                """,\
                (\
                    seller_user_id,\
                    quote_asset,\
                    float(seller_net),\
                    now,\
                    now,\
                ),\
            )\
\
            # ==================================================\
            # TRADE\
            # ==================================================\
\
            cursor = conn.execute(\
                """\
                INSERT INTO trades\
                (\
                    symbol,\
                    price,\
                    quantity,\
                    quote_quantity,\
                    buyer_order_id,\
                    seller_order_id,\
                    buyer_user_id,\
                    seller_user_id,\
                    buyer_fee,\
                    seller_fee,\
                    created_at\
                )\
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\
                """,\
                (\
                    symbol,\
                    float(price),\
                    float(quantity),\
                    float(gross_value),\
                    buyer_order_id,\
                    seller_order_id,\
                    buyer_user_id,\
                    seller_user_id,\
                    float(buyer_fee),\
                    float(seller_fee),\
                    now,\
                ),\
            )\
\
            trade_id = cursor.lastrowid\
\
            # ==================================================\
            # LEDGER\
            # ==================================================\
\
            self._insert_ledger(\
                conn=conn,\
                user_id=buyer_user_id,\
                asset=base_asset,\
                amount=quantity,\
                entry_type="TRADE_BUY",\
                reference_id=str(trade_id),\
                created_at=now,\
            )\
\
            self._insert_ledger(\
                conn=conn,\
                user_id=buyer_user_id,\
                asset=quote_asset,\
                amount=-buyer_total,\
                entry_type="TRADE_BUY",\
                reference_id=str(trade_id),\
                created_at=now,\
            )\
\
            self._insert_ledger(\
                conn=conn,\
                user_id=seller_user_id,\
                asset=base_asset,\
                amount=-quantity,\
                entry_type="TRADE_SELL",\
                reference_id=str(trade_id),\
                created_at=now,\
            )\
\
            self._insert_ledger(\
                conn=conn,\
                user_id=seller_user_id,\
                asset=quote_asset,\
                amount=seller_net,\
                entry_type="TRADE_SELL",\
                reference_id=str(trade_id),\
                created_at=now,\
            )\
\
            conn.commit()\
\
            return {\
                "trade_id": trade_id,\
                "symbol": symbol,\
                "price": str(price),\
                "quantity": str(quantity),\
                "quote_quantity": str(gross_value),\
                "buyer_user_id": buyer_user_id,\
                "seller_user_id": seller_user_id,\
                "buyer_fee": str(buyer_fee),\
                "seller_fee": str(seller_fee),\
            }\
\
        except Exception:\
            conn.rollback()\
            raise\
\
        finally:\
            conn.close()\
\
    def _insert_ledger(\
        self,\
        conn,\
        user_id: str,\
        asset: str,\
        amount: Decimal,\
        entry_type: str,\
        reference_id: str,\
        created_at: int,\
    ):\
        row = conn.execute(\
            """\
            SELECT available, locked\
            FROM wallets\
            WHERE user_id = ?\
              AND asset = ?\
            """,\
            (user_id, asset),\
        ).fetchone()\
\
        if row is None:\
            raise ValueError(\
                f"Wallet not found for ledger: "\
                f"{user_id} {asset}"\
            )\
\
        balance_after = (\
            Decimal(str(row["available"]))\
            + Decimal(str(row["locked"]))\
        )\
\
        balance_before = balance_after - amount\
\
        conn.execute(\
            """\
            INSERT INTO ledger_entries\
            (\
                user_id,\
                asset,\
                amount,\
                balance_before,\
                balance_after,\
                entry_type,\
                reference_id,\
                created_at\
            )\
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)\
            """,\
            (\
                user_id,\
                asset,\
                float(amount),\
                float(balance_before),\
                float(balance_after),\
                entry_type,\
                reference_id,\
                created_at,\
            ),\
        )\
PY
