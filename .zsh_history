* {\
    box-sizing: border-box;\
    margin: 0;\
    padding: 0;\
    font-family: 'IBM Plex Sans Arabic', sans-serif;\
}\
\
body {\
    background-color: #0b0e11;\
    color: #eaecef;\
    direction: rtl;\
    width: 100%;\
    min-height: 100vh;\
    display: flex;\
    justify-content: center;\
    align-items: center;\
}\
\
.app-container {\
    width: 100%;\
    max-width: 480px;\
    background: #0b0e11;\
    display: flex;\
    flex-direction: column;\
    min-height: 100vh;\
    position: relative;\
}\
\
.top-header {\
    height: 48px;\
    background: #181a20;\
    border-bottom: 1px solid #1f2329;\
    display: flex;\
    align-items: center;\
    justify-content: space-between;\
    padding: 0 14px;\
}\
\
.brand-area {\
    display: flex;\
    align-items: center;\
    gap: 6px;\
}\
\
.logo-title {\
    font-size: 15px;\
    font-weight: 700;\
    color: #fff;\
}\
\
.bolt-c {\
    color: #f0b90b;\
    font-size: 13px;\
}\
\
.pro-badge {\
    background: #0052ff;\
    color: #fff;\
    font-size: 9px;\
    font-weight: bold;\
    padding: 1px 5px;\
    border-radius: 3px;\
}\
\
.header-icons {\
    display: flex;\
    gap: 16px;\
    color: #848e9c;\
    font-size: 14px;\
    cursor: pointer;\
}\
\
.ticker-strip {\
    height: 30px;\
    background: #12141c;\
    border-bottom: 1px solid #1f2329;\
    display: flex;\
    align-items: center;\
    gap: 15px;\
    padding: 0 14px;\
    font-size: 11px;\
    overflow-x: auto;\
    white-space: nowrap;\
}\
\
.ticker-strip::-webkit-scrollbar {\
    display: none;\
}\
\
.t-unit {\
    color: #848e9c;\
}\
\
.up-txt {\
    color: #0ecb81 !important;\
    font-weight: 600;\
}\
\
.warning-txt {\
    color: #f0b90b !important;\
    font-weight: 600;\
}\
\
.main-viewport {\
    flex: 1;\
    padding: 10px;\
    display: flex;\
    flex-direction: column;\
    gap: 10px;\
    padding-bottom: 70px;\
}\
\
.trading-pair-bar {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 8px;\
    padding: 10px 14px;\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
}\
\
.pair-info-main h2 {\
    font-size: 14px;\
    color: #fff;\
    margin-bottom: 2px;\
    display: flex;\
    align-items: center;\
    gap: 6px;\
}\
\
.smc-tag {\
    background: rgba(14, 203, 129, 0.15);\
    color: #0ecb81;\
    font-size: 9px;\
    padding: 1px 4px;\
    border-radius: 3px;\
    border: 1px solid rgba(14, 203, 129, 0.3);\
}\
\
.pair-info-main span {\
    font-size: 13px;\
    font-weight: bold;\
}\
\
.pair-stats {\
    text-align: left;\
    font-size: 10px;\
    color: #848e9c;\
}\
\
.pair-stats b {\
    display: block;\
}\
\
.advanced-chart-box {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 8px;\
    overflow: hidden;\
    position: relative;\
}\
\
.chart-toolbar {\
    background: #12141c;\
    border-bottom: 1px solid #1f2329;\
    padding: 6px 12px;\
    display: flex;\
    align-items: center;\
    gap: 8px;\
}\
\
.tf-btn {\
    font-size: 10px;\
    color: #848e9c;\
    background: #1f2329;\
    padding: 2px 6px;\
    border-radius: 4px;\
    cursor: pointer;\
}\
\
.tf-btn.active {\
    background: #0052ff;\
    color: #fff;\
}\
\
.indicator-tag {\
    font-size: 9px;\
    color: #f0b90b;\
    margin-left: auto;\
    background: #2b313a;\
    padding: 2px 6px;\
    border-radius: 4px;\
}\
\
.pro-candles-canvas {\
    height: 160px;\
    background: #0b0e11;\
    display: flex;\
    align-items: flex-end;\
    justify-content: space-around;\
    padding: 15px 10px;\
    position: relative;\
}\
\
.smc-zone-overlay {\
    position: absolute;\
    bottom: 20px;\
    left: 10px;\
    right: 10px;\
    height: 25px;\
    background: rgba(14, 203, 129, 0.08);\
    border: 1px dashed rgba(14, 203, 129, 0.3);\
    border-radius: 4px;\
    z-index: 1;\
}\
\
.c-col {\
    display: flex;\
    flex-direction: column;\
    align-items: center;\
    position: relative;\
    height: 100%;\
    justify-content: flex-end;\
    z-index: 2;\
}\
\
.wick {\
    width: 2px;\
    background: #848e9c;\
    position: absolute;\
    bottom: 0;\
}\
\
.body {\
    width: 10px;\
    border-radius: 2px;\
}\
\
.green-bg {\
    background: #0ecb81;\
}\
\
.red-bg {\
    background: #f6465d;\
}\
\
.trade-execution-panel {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 8px;\
    padding: 10px;\
    display: flex;\
    flex-direction: column;\
    gap: 8px;\
}\
\
.panel-section-title {\
    font-size: 11px;\
    color: #f0b90b;\
    font-weight: bold;\
}\
\
.active-position-card {\
    background: #12141c;\
    border: 1px solid #1f2329;\
    border-radius: 6px;\
    padding: 8px 10px;\
    display: flex;\
    justify-content: space-between;\
    align-items: center;\
}\
\
.pos-info strong {\
    font-size: 11px;\
    color: #fff;\
    display: block;\
}\
\
.pos-info span {\
    font-size: 9px;\
    color: #848e9c;\
}\
\
.pos-profit {\
    font-size: 11px;\
    font-weight: bold;\
}\
\
.action-buttons-grid {\
    display: grid;\
    grid-template-columns: 1fr 1fr;\
    gap: 8px;\
}\
\
.btn-buy {\
    background: #0ecb81;\
    color: #0b0e11;\
    border: none;\
    padding: 10px;\
    border-radius: 6px;\
    font-size: 12px;\
    font-weight: 700;\
    cursor: pointer;\
    text-align: center;\
}\
\
.btn-sell {\
    background: #f6465d;\
    color: #fff;\
    border: none;\
    padding: 10px;\
    border-radius: 6px;\
    font-size: 12px;\
    font-weight: 700;\
    cursor: pointer;\
    text-align: center;\
}\
\
.info-row {\
    background: #181a20;\
    border: 1px solid #1f2329;\
    border-radius: 6px;\
    padding: 12px 14px;\
    display: flex;\
    justify-content: space-between;\
    font-size: 12px;\
}\
\
.bottom-navigation {\
    position: fixed;\
    bottom: 0;\
    left: 0;\
    right: 0;\
    height: 56px;\
    background: #181a20;\
    border-top: 1px solid #1f2329;\
    display: flex;\
    max-width: 480px;\
    margin: 0 auto;\
    z-index: 1000;\
}\
\
.nav-tab {\
    flex: 1;\
    background: transparent;\
    border: none;\
    color: #848e9c;\
    display: flex;\
    flex-direction: column;\
    align-items: center;\
    justify-content: center;\
    gap: 2px;\
    cursor: pointer;\
}\
\
.nav-tab i {\
    font-size: 15px;\
}\
\
.nav-tab span {\
    font-size: 9px;\
}\
\
.nav-tab.active, .nav-tab.active i, .nav-tab.active span {\
    color: #f0b90b;\
}\
EOF\
