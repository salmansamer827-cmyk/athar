from pathlib import Path\
\
p = Path("core/pipeline/quant_pipeline.py")\
s = p.read_text()\
\
# ============================================================\
# 1. IMPORT ADAPTIVE RISK\
# ============================================================\
\
old = """from core.risk.engine import RiskEngine\
"""\
\
new = """from core.risk.engine import RiskEngine\
from core.risk.adaptive import AdaptiveRiskEngine\
"""\
\
if "from core.risk.adaptive import AdaptiveRiskEngine" not in s:\
    if old not in s:\
        raise SystemExit("ERROR: RiskEngine import not found")\
    s = s.replace(old, new, 1)\
\
\
# ============================================================\
# 2. RESULT FIELDS\
# ============================================================\
\
old = """    signal: Optional[dict]\
    risk: Optional[object]\
"""\
\
new = """    signal: Optional[dict]\
    risk: Optional[object]\
\
    # Adaptive Risk\
    adaptive_risk: Optional[object]\
    volatility_ratio: float\
    drawdown_percent: float\
"""\
\
if "adaptive_risk: Optional[object]" not in s:\
    if old not in s:\
        raise SystemExit("ERROR: Result fields not found")\
    s = s.replace(old, new, 1)\
\
\
# ============================================================\
# 3. INIT ADAPTIVE ENGINE\
# ============================================================\
\
old = """        self.risk_engine = RiskEngine(\
            risk_percent=risk_percent,\
            reward_risk=reward_risk,\
        )\
"""\
\
new = """        self.risk_engine = RiskEngine(\
            risk_percent=risk_percent,\
            reward_risk=reward_risk,\
        )\
\
        self.adaptive_risk_engine = AdaptiveRiskEngine(\
            base_risk_percent=risk_percent,\
            base_reward_risk=reward_risk,\
        )\
"""\
\
if "self.adaptive_risk_engine = AdaptiveRiskEngine" not in s:\
    if old not in s:\
        raise SystemExit("ERROR: Risk engine init not found")\
    s = s.replace(old, new, 1)\
\
\
# ============================================================\
# 4. ADD REAL VOLATILITY METHOD\
# ============================================================\
\
marker = """    @staticmethod\
    def _to_dataframe(\
        candles,\
    ) -> pd.DataFrame:\
"""\
\
method = """    @staticmethod\
    def _volatility_ratio(\
        df: pd.DataFrame,\
        recent_window: int = 20,\
        baseline_window: int = 100,\
    ) -> float:\
        \"\"\"\
        Normalized realized-volatility ratio.\
\
        recent volatility / baseline volatility\
\
        Values:\
            1.0  = normal volatility\
            >1.0 = volatility expansion\
            <1.0 = volatility contraction\
        \"\"\"\
\
        if len(df) < 3:\
            return 1.0\
\
        close = pd.to_numeric(\
            df["close"],\
            errors="coerce",\
        ).dropna()\
\
        if len(close) < 3:\
            return 1.0\
\
        returns = (\
            close.pct_change()\
            .replace([float("inf"), float("-inf")], pd.NA)\
            .dropna()\
        )\
\
        if len(returns) < 2:\
            return 1.0\
\
        recent = returns.tail(\
            min(recent_window, len(returns))\
        )\
\
        baseline = returns.tail(\
            min(baseline_window, len(returns))\
        )\
\
        current_volatility = float(\
            recent.std(ddof=1)\
        )\
\
        baseline_volatility = float(\
            baseline.std(ddof=1)\
        )\
\
        if (\
            not pd.notna(current_volatility)\
            or not pd.notna(baseline_volatility)\
            or baseline_volatility <= 0\
        ):\
            return 1.0\
\
        ratio = (\
            current_volatility\
            / baseline_volatility\
        )\
\
        return max(\
            0.01,\
            float(ratio),\
        )\
\
"""\
\
if "def _volatility_ratio(" not in s:\
    if marker not in s:\
        raise SystemExit("ERROR: to_dataframe marker not found")\
    s = s.replace(marker, method + marker, 1)\
\
\
# ============================================================\
# 5. EXTEND RUN SIGNATURE\
# ============================================================\
\
old = """        capital: float = 100.0,\
        entry: Optional[float] = None,\
        stop_price: Optional[float] = None,\
        tick_size: Optional[float] = None,\
"""\
\
new = """        capital: float = 100.0,\
        entry: Optional[float] = None,\
        stop_price: Optional[float] = None,\
        tick_size: Optional[float] = None,\
        current_equity: Optional[float] = None,\
        peak_equity: Optional[float] = None,\
"""\
\
if "current_equity: Optional[float]" not in s:\
    if old not in s:\
        raise SystemExit("ERROR: run signature not found")\
    s = s.replace(old, new, 1)\
\
\
# ============================================================\
# 6. ADD ADAPTIVE INPUTS BEFORE EXPECTED VALUE\
# ============================================================\
\
marker = """        # -------------------------------------------------\
        # 10. EXPECTED VALUE\
        # -------------------------------------------------\
"""\
\
block = """        # -------------------------------------------------\
        # 9.5 ADAPTIVE RISK INPUTS\
        # -------------------------------------------------\
\
        volatility_ratio = self._volatility_ratio(\
            df\
        )\
\
        # Equity is optional for backward compatibility.\
        # LIVE execution must provide real account equity.\
        if current_equity is None:\
            current_equity = capital\
\
        if peak_equity is None:\
            peak_equity = current_equity\
\
        if current_equity <= 0:\
            raise ValueError(\
                "current_equity must be > 0"\
            )\
\
        if peak_equity <= 0:\
            raise ValueError(\
                "peak_equity must be > 0"\
            )\
\
        if current_equity > peak_equity:\
            peak_equity = current_equity\
\
        drawdown_percent = (\
            max(\
                0.0,\
                (\
                    (peak_equity - current_equity)\
                    / peak_equity\
                ) * 100.0,\
            )\
        )\
\
        adaptive_risk = (\
            self.adaptive_risk_engine.calculate(\
                probability=adjusted_probability,\
                uncertainty=probability_uncertainty,\
                volatility_ratio=volatility_ratio,\
                drawdown_percent=drawdown_percent,\
            )\
        )\
\
        # -------------------------------------------------\
        # 10. EXPECTED VALUE\
        # -------------------------------------------------\
"""\
\
if "adaptive_risk = (" not in s:\
    if marker not in s:\
        raise SystemExit("ERROR: Expected Value marker not found")\
    s = s.replace(marker, block, 1)\
\
\
# ============================================================\
# 7. USE ADAPTIVE RR/RISK\
# ============================================================\
\
old = """        reward_r = float(\
            self.risk_engine.reward_risk\
        )\
\
        risk_r = 1.0\
"""\
\
new = """        reward_r = float(\
            adaptive_risk.reward_risk\
        )\
\
        risk_r = 1.0\
"""\
\
if old not in s:\
    raise SystemExit("ERROR: reward_r section not found")\
\
s = s.replace(old, new, 1)\
\
\
# ============================================================\
# 8. ADAPTIVE RISK ENGINE FOR FINAL POSITION RISK\
# ============================================================\
\
old = """              risk = (\
                  self.risk_engine.calculate(\
                      capital=capital,\
                      entry_price=entry,\
                      stop_price=stop_price,\
                  )\
              )\
"""\
\
new = """              adaptive_engine = RiskEngine(\
                  risk_percent=adaptive_risk.risk_percent,\
                  reward_risk=adaptive_risk.reward_risk,\
              )\
\
              risk = (\
                  adaptive_engine.calculate(\
                      capital=capital,\
                      entry_price=entry,\
                      stop_price=stop_price,\
                  )\
              )\
"""\
\
if old not in s:\
    raise SystemExit("ERROR: Risk calculation section not found")\
\
s = s.replace(old, new, 1)\
\
\
# ============================================================\
# 9. RETURN ADAPTIVE DATA\
# ============================================================\
\
old = """              signal=signal,\
              risk=risk,\
          )\
"""\
\
new = """              signal=signal,\
              risk=risk,\
\
              adaptive_risk=adaptive_risk,\
              volatility_ratio=volatility_ratio,\
              drawdown_percent=drawdown_percent,\
          )\
"""\
\
if old not in s:\
    raise SystemExit("ERROR: return section not found")\
\
s = s.replace(old, new, 1)\
\
\
p.write_text(s)\
\
print("=" * 70)\
print("ADAPTIVE RISK AUTO PATCH")\
print("=" * 70)\
print("⃼�� AdaptiveRiskEngine imported")\
print("⃼�� AdaptiveRiskEngine initialized")\
print("⃼�� Real volatility ratio added")\
print("⃼�� Current equity input added")\
print("⃼�� Peak equity input added")\
print("⃼�� Real drawdown calculation added")\
print("⃼�� Drawdown converted to percentage 0-100")\
print("⃼�� Adaptive RR connected")\
print("⃼�� Adaptive risk connected to RiskEngine")\
print("⃼�� Adaptive result exposed")\
