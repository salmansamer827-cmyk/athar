        /* تك�سك�ق حجك� اك�شعار فك� اك�ك�ك�در */\
        .brand-logo {\
            height: 32px;\
            width: auto;\
            object-fit: contain;\
            border-radius: 4px;\
        }\
        .market-ticker-bar {\
            background-color: #161a1e;\
            border-bottom: 1px solid var(--border-color);\
            padding: 8px 15px;\
            display: flex;\
            gap: 20px;\
            overflow-x: auto;\
            white-space: nowrap;\
            font-size: 12px;\
