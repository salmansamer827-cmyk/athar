: 1789833100:0;cat << 'EOF' > public/style.css\
* {\
    box-sizing: border-box;\
}\
\
html,\
body {\
    margin: 0;\
    padding: 0;\
    width: 100%;\
    min-width: 0;\
    overflow-x: hidden;\
}\
\
body {\
    background: #0b0f14;\
    color: #e8edf3;\
    font-family: Arial, "Segoe UI", sans-serif;\
    padding-bottom: 82px;\
}\
\
button,\
input {\
    font: inherit;\
}\
\
button {\
    cursor: pointer;\
}\
\
/* =========================\
   TOP BAR\
========================= */\
\
.topbar {\
    width: 100%;\
    height: 62px;\
    display: flex;\
    align-items: center;\
    justify-content: space-between;\
    padding: 0 14px;\
    background: #151a21;\
    border-bottom: 1px solid #252c35;\
}\
\
.brand {\
    font-size: 22px;\
    font-weight: 700;\
    white-space: nowrap;\
}\
\
.brand b {\
    color: #00d4ff;\
}\
\
.header-actions {\
    display: flex;\
    gap: 7px;\
}\
\
.header-actions button {\
    width: 38px;\
    height: 38px;\
    border: 0;\
    border-radius: 9px;\
    background: #222a33;\
    color: white;\
    font-size: 17px;\
}\
\
/* =========================\
   PRICE TICKER\
========================= */\
\
.ticker {\
    width: 100%;\
    height: 48px;\
    display: flex;\
    direction: ltr;\
    align-items: center;\
    gap: 28px;\
    padding: 0 14px;\
    overflow-x: auto;\
    overflow-y: hidden;\
    white-space: nowrap;\
    background: #10151b;\
    border-bottom: 1px solid #252c35;\
    scrollbar-width: none;\
}\
\
.ticker::-webkit-scrollbar {\
    display: none;\
}\
\
.ticker div {\
    font-size: 14px;\
}\
\
.ticker strong {\
    color: #00d99b;\
    margin-left: 5px;\
}\
\
/* =========================\
   MAIN\
========================= */\
\
main {\
    width: 100%;\
    max-width: 920px;\
    margin: 0 auto;\
    padding: 14px;\
    overflow: hidden;\
}\
\
/* =========================\
   MARKET HEADER\
========================= */\
\
.markets-header {\
    width: 100%;\
    display: flex;\
    align-items: center;\
    justify-content: space-between;\
    gap: 12px;\
    margin-bottom: 14px;\
}\
\
.markets-header h1 {\
    margin: 0;\
    font-size: 28px;\
    white-space: nowrap;\
}\
\
.search {\
    flex: 1;\
    max-width: 320px;\
    min-width: 0;\
    height: 43px;\
    display: flex;\
    align-items: center;\
    gap: 8px;\
    padding: 0 12px;\
    background: #171c23;\
    border: 1px solid #303944;\
    border-radius: 10px;\
}\
\
.search input {\
    width: 100%;\
    min-width: 0;\
    border: 0;\
    outline: 0;\
    background: transparent;\
    color: white;\
    text-align: right;\
}\
\
.search input::placeholder {\
    color: #8b95a1;\
}\
\
/* =========================\
   TRADING CARD\
========================= */\
\
.trading-card {\
    width: 100%;\
    min-width: 0;\
    background: #171c23;\
    border: 1px solid #2a323c;\
    border-radius: 16px;\
    padding: 12px;\
    box-shadow: 0 10px 40px rgba(0, 0, 0, .3);\
    overflow: hidden;\
}\
\
/* =========================\
   MARKET TITLE\
========================= */\
\
.market-title {\
    width: 100%;\
    display: flex;\
    align-items: center;\
    justify-content: space-between;\
    gap: 10px;\
    margin-bottom: 10px;\
}\
\
.market-title > div:first-child {\
    min-width: 0;\
    display: flex;\
    align-items: center;\
    gap: 9px;\
}\
\
.coin {\
    flex: 0 0 40px;\
    width: 40px;\
    height: 40px;\
    display: grid;\
    place-items: center;\
    border-radius: 50%;\
    background: #f7931a;\
    font-size: 22px;\
}\
\
.market-title h2 {\
    margin: 0;\
    font-size: 18px;\
}\
\
.market-title small {\
    display: block;\
    color: #8b95a1;\
    margin-top: 3px;\
}\
\
.price-box {\
    flex: 0 0 auto;\
    text-align: left;\
}\
\
.price-box strong {\
    display: block;\
    font-size: 18px;\
}\
\
.positive {\
    color: #00d99b;\
    font-size: 13px;\
}\
\
/* =========================\
   TIMEFRAME\
========================= */\
\
.timeframes {\
    width: 100%;\
    display: flex;\
    gap: 5px;\
    margin-bottom: 8px;\
    overflow-x: auto;\
    scrollbar-width: none;\
}\
\
.timeframes::-webkit-scrollbar {\
    display: none;\
}\
\
.timeframes button {\
    flex: 0 0 auto;\
    border: 0;\
    background: #252c35;\
    color: #aeb7c2;\
    padding: 8px 12px;\
    border-radius: 8px;\
}\
\
.timeframes .active {\
    background: #3a424d;\
    color: white;\
}\
\
/* =========================\
   TRADINGVIEW\
========================= */\
\
#tradingview_chart {\
    position: relative;\
    width: 100% !important;\
    max-width: 100% !important;\
    height: 430px;\
    min-width: 0;\
    overflow: hidden;\
    border-radius: 10px;\
    background: #0d1014;\
}\
\
#tradingview_chart iframe {\
    width: 100% !important;\
    max-width: 100% !important;\
}\
\
/* =========================\
   ORDER BOOK\
========================= */\
\
.orderbook {\
    width: 100%;\
    margin-top: 12px;\
    padding: 12px;\
    background: #10151b;\
    border-radius: 11px;\
    overflow: hidden;\
}\
\
.orderbook-title {\
    display: flex;\
    justify-content: space-between;\
    gap: 10px;\
    color: #929ca8;\
    font-size: 13px;\
    margin-bottom: 8px;\
}\
\
.asks div,\
.bids div {\
    width: 100%;\
    display: grid;\
    grid-template-columns: 1fr 1fr;\
    padding: 5px 0;\
    font-size: 13px;\
    direction: ltr;\
}\
\
.asks div span:last-child,\
.bids div span:last-child {\
    text-align: left;\
}\
\
.asks div span:first-child {\
    color: #ff5268;\
}\
\
.bids div span:first-child {\
    color: #00d99b;\
}\
\
.current-order-price {\
    width: 100%;\
    text-align: center;\
    font-size: 17px;\
    color: #00d4ff;\
    padding: 9px 0;\
    margin: 5px 0;\
    border-top: 1px solid #252d36;\
    border-bottom: 1px solid #252d36;\
}\
\
/* =========================\
   TRADE PANEL\
========================= */\
\
.trade-panel {\
    width: 100%;\
    margin-top: 12px;\
}\
\
.trade-tabs {\
    display: flex;\
    gap: 7px;\
    margin-bottom: 12px;\
}\
\
.trade-tabs button {\
    flex: 1;\
    border: 0;\
    padding: 12px;\
    border-radius: 9px;\
    background: #252c35;\
    color: #aeb7c2;\
    font-weight: 600;\
}\
\
.trade-tabs .active {\
    background: #00d394;\
    color: #04130e;\
}\
\
.trade-panel label {\
    display: block;\
    margin: 8px 0 5px;\
    color: #929ca8;\
    font-size: 12px;\
}\
\
.trade-panel input {\
    display: block;\
    width: 100%;\
    height: 45px;\
    padding: 0 12px;\
    border: 1px solid #303944;\
    border-radius: 9px;\
    background: #0d1217;\
    color: white;\
    outline: none;\
}\
\
.trade-panel input:focus {\
    border-color: #00d4ff;\
}\
\
.order-summary {\
    width: 100%;\
    display: flex;\
    justify-content: space-between;\
    gap: 10px;\
    padding: 13px 0;\
    color: #929ca8;\
}\
\
.order-summary strong {\
    color: white;\
}\
\
.submit-buy {\
    width: 100%;\
    height: 48px;\
    border: 0;\
    border-radius: 9px;\
    background: #00d394;\
    color: #03130e;\
    font-weight: 700;\
    font-size: 16px;\
}\
\
/* =========================\
   BOTTOM NAV\
========================= */\
\
.bottom-nav {\
    position: fixed;\
    left: 0;\
    right: 0;\
    bottom: 0;\
    z-index: 1000;\
\
    width: 100%;\
    height: 76px;\
\
    display: flex;\
    align-items: center;\
    justify-content: space-around;\
\
    background: #151a20;\
    border-top: 1px solid #292f37;\
}\
\
.bottom-nav a {\
    flex: 1;\
    min-width: 0;\
    text-align: center;\
    color: #89929d;\
    font-size: 11px;\
    text-decoration: none;\
}\
\
.bottom-nav span {\
    display: block;\
    font-size: 21px;\
    margin-bottom: 3px;\
}\
\
.bottom-nav .selected {\
    color: #00d394;\
}\
\
/* =========================\
   MOBILE\
========================= */\
\
@media (max-width: 600px) {\
\
    .topbar {\
        height: 58px;\
        padding: 0 11px;\
    }\
\
    .brand {\
        font-size: 20px;\
    }\
\
    .ticker {\
        gap: 22px;\
        height: 43px;\
    }\
\
    main {\
        padding: 10px;\
    }\
\
    .markets-header {\
        display: block;\
    }\
\
    .markets-header h1 {\
        margin-bottom: 10px;\
        font-size: 30px;\
    }\
\
    .search {\
        width: 100%;\
        max-width: none;\
        height: 42px;\
    }\
\
    .trading-card {\
        padding: 9px;\
        border-radius: 13px;\
    }\
\
    .market-title {\
        align-items: flex-start;\
    }\
\
    .market-title h2 {\
        font-size: 17px;\
    }\
\
    .market-title small {\
        font-size: 12px;\
    }\
\
    .price-box strong {\
        font-size: 16px;\
    }\
\
    #tradingview_chart {\
        height: 390px;\
    }\
\
    .orderbook {\
        padding: 10px;\
    }\
\
    .bottom-nav {\
        height: 72px;\
    }\
\
    .bottom-nav span {\
        font-size: 20px;\
    }\
}\
\
/* =========================\
   VERY SMALL PHONES\
========================= */\
\
@media (max-width: 380px) {\
\
    main {\
        padding: 7px;\
    }\
\
    .ticker {\
        gap: 16px;\
        padding: 0 9px;\
    }\
\
    .market-title {\
        flex-direction: column;\
    }\
\
    .price-box {\
        width: 100%;\
        text-align: right;\
    }\
\
    #tradingview_chart {\
        height: 350px;\
    }\
\
    .bottom-nav a {\
        font-size: 10px;\
    }\
}\
EOF
