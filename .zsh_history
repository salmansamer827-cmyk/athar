import numpy as np\
import pandas as pd\
\
from core.volume_profile.quant.profile import QuantProfileEngine\
\
np.random.seed(42)\
\
n = 1000\
\
base = 63000.0\
\
close = base + np.cumsum(\
    np.random.normal(0, 35, n)\
)\
\
spread = np.random.uniform(\
    10,\
    80,\
    n\
)\
\
high = close + spread\
low = close - spread\
\
volume = np.random.lognormal(\
    mean=10.0,\
    sigma=0.35,\
    size=n\
)\
\
df = pd.DataFrame({\
    "high": high,\
    "low": low,\
    "close": close,\
    "volume": volume,\
})\
\
engine = QuantProfileEngine(\
    value_area=0.70,\
    min_bins=40,\
    max_bins=300,\
)\
\
profile = engine.calculate(df)\
\
print()\
print("=" * 70)\
print("QUANT VOLUME PROFILE  � MATHEMATICAL TEST")\
print("=" * 70)\
\
print(f"Price Low          : {profile.price_low:.6f}")\
print(f"Price High         : {profile.price_high:.6f}")\
print(f"Bins               : {profile.bins}")\
print(f"Bin Size           : {profile.bin_size:.10f}")\
\
print("-" * 70)\
\
print(f"Total Volume       : {profile.total_volume:.6f}")\
print(f"POC                : {profile.poc:.6f}")\
print(f"VAH                : {profile.vah:.6f}")\
print(f"VAL                : {profile.val:.6f}")\
\
print("-" * 70)\
\
print(f"Weighted Mean      : {profile.weighted_mean:.6f}")\
print(f"Variance           : {profile.variance:.6f}")\
print(f"Std                : {profile.std:.6f}")\
print(f"Skewness           : {profile.skewness:.6f}")\
print(f"Kurtosis           : {profile.kurtosis:.6f}")\
\
print("-" * 70)\
\
print(f"Entropy            : {profile.entropy:.6f}")\
print(f"Concentration      : {profile.volume_concentration:.6f}")\
\
print("-" * 70)\
\
print(f"HVN Nodes          : {len(profile.hvn_nodes)}")\
print(f"LVN Nodes          : {len(profile.lvn_nodes)}")\
\
print("-" * 70)\
\
distribution_sum = float(\
    np.sum(profile.probability_distribution)\
)\
\
volume_sum = float(\
    np.sum(profile.volume_distribution)\
)\
\
print(f"Probability Sum    : {distribution_sum:.12f}")\
print(f"Volume Sum         : {volume_sum:.6f}")\
\
assert profile.price_low < profile.val\
assert profile.val < profile.poc\
assert profile.poc < profile.vah\
assert profile.vah <= profile.price_high\
\
assert abs(\
    distribution_sum - 1.0\
) < 1e-10\
\
assert abs(\
    volume_sum - profile.total_volume\
) < max(\
    1e-9,\
    profile.total_volume * 1e-10,\
)\
\
assert profile.entropy >= 0.0\
assert profile.entropy <= 1.0\
\
assert profile.volume_concentration > 0.0\
assert profile.volume_concentration <= 1.0\
\
print("=" * 70)\
print("ALL MATHEMATICAL INVARIANTS: PASS")\
print("STATUS: PROFILE ENGINE HIGH-QUALITY VALIDATED")\
print("=" * 70)\
PY
