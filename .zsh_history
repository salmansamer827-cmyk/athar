        async function fetchRealBalance() {\
            try {\
                const res = await fetch('/api/balance');\
                const data = await res.json();\
                if (data.success) {\
                    const formatted = Number(data.total).toLocaleString();\
                    document.getElementById('homeBalance').innerHTML = `${formatted} <span style="font-size: 13px; color: var(--text-secondary);">USDT</span>`;\
                    document.getElementById('walletTotalBalance').innerText = `${formatted} USDT`;\
                    document.getElementById('walletAvailable').innerText = `${formatted} USDT`;\
                }\
            } catch (e) { console.error(e); }\
        }\
\
        async function executeOrder(side) {\
            const symbol = document.getElementById('tradeSymbol').value;\
            const amount = document.getElementById('tradeAmount').value;\
            const statusDiv = document.getElementById('tradeStatus');\
