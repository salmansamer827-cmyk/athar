from dataclasses import dataclass\
from decimal import Decimal\
from enum import Enum\
\
\
class PositionSide(str, Enum):\
    LONG = "LONG"\
    SHORT = "SHORT"\
\
\
@dataclass\
class FuturesPosition:\
    user_id: str\
    symbol: str\
    side: PositionSide\
    quantity: Decimal\
    entry_price: Decimal\
    leverage: int\
    margin: Decimal\
\
    def notional(self) -> Decimal:\
        return self.quantity * self.entry_price\
\
    def unrealized_pnl(self, mark_price: Decimal) -> Decimal:\
        mark_price = Decimal(str(mark_price))\
\
        if self.side == PositionSide.LONG:\
            return (mark_price - self.entry_price) * self.quantity\
\
        return (self.entry_price - mark_price) * self.quantity\
\
    def margin_ratio(self, mark_price: Decimal) -> Decimal:\
        if self.margin <= 0:\
            return Decimal("0")\
\
        return self.unrealized_pnl(mark_price) / self.margin\
\
\
