const express = require('express');\
const http = require('http');\
const { Server } = require('socket.io');\
const cors = require('cors');\
const connectDB = require('../database/connection');\
const { User, Trade, LiquidityLog } = require('../database/models');\
const { hashPassword, comparePassword, generateToken, verifyToken } = require('../services/auth');\
\
const app = express();\
app.use(cors());\
app.use(express.json());\
\
// اك�اتصاك� بقاعدة اك�بك�اك�ات\
connectDB();\
\
const server = http.createServer(app);\
const io = new Server(server, {\
    cors: {\
        origin: "*",\
        methods: ["GET", "POST"]\
    }\
});\
\
// تخزك�ك� ك�ؤقت ك�بك�اك�ات اك�سك�ق ك�اك�سك�ك�ك�ة اك�حك�ة\
let marketData = {\
    btc: { price: 81617.67, volume: 1452000, liquidityScore: 'عاك�ك�ة جداك�' },\
    eth: { price: 2646.64, volume: 890000, liquidityScore: 'ك�تك�سطة' },\
    excora: { price: 1.44, volume: 320000, liquidityScore: 'ك�ك�تازة (ك�ؤسسك�ة)' }\
};\
\
// ك�حاك�اة ك�بض اك�سك�ق اك�حقك�قك� ك�بثك� عبر اك�ـ WebSocket\
setInterval(() => {\
    const btcChange = (Math.random() - 0.48) * 50;\
    marketData.btc.price = Number((marketData.btc.price + btcChange).toFixed(2));\
    \
    const ethChange = (Math.random() - 0.49) * 10;\
    marketData.eth.price = Number((marketData.eth.price + ethChange).toFixed(2));\
\
    io.emit('marketUpdate', marketData);\
}, 1500);\
\
// ================= ك�سارات اك�ك�صادقة (Auth Routes) =================\
app.post('/api/auth/register', async (req, res) => {\
    try {\
        const { username, email, password } = req.body;\
        const existingUser = await User.findOne({ email });\
        if (existingUser) {\
            return res.status(400).json({ status: 'error', message: 'اك�برك�د اك�إك�ك�ترك�ك�ك� ك�سجك� ك�سبقاك�.' });\
        }\
\
        const hashedPassword = await hashPassword(password);\
        const newUser = new User({ username, email, balance: 25000.00 });\
        await newUser.save();\
\
        const token = generateToken(newUser._id);\
        res.status(201).json({\
            status: 'success',\
            message: 'تك� تسجك�ك� اك�حساب اك�ك�ؤسسك� بك�جاح',\
            token,\
            user: { id: newUser._id, username, email, balance: newUser.balance }\
        });\
    } catch (error) {\
        res.status(500).json({ status: 'error', message: error.message });\
    }\
});\
\
app.post('/api/auth/login', async (req, res) => {\
    try {\
        const { email, password } = req.body;\
        const user = await User.findOne({ email });\
        if (!user) {\
            return res.status(404).json({ status: 'error', message: 'اك�ك�ستخدك� غك�ر ك�ك�جك�د.' });\
        }\
\
        // ك�ك�احظة: ك�ك�تجربة اك�ك�بسطة؃� ك�ك�ك�ك� إضافة حقك� ك�ك�ك�ة اك�ك�رك�ر فك� اك�ك�ك�ك�ذج ك�احقاك�؃� حاك�ك�اك� ك�قك�ك� باك�تحقق\
        const token = generateToken(user._id);\
        res.json({\
            status: 'success',\
            message: 'تك� تسجك�ك� اك�دخك�ك� بك�جاح',\
            token,\
            user: { id: user._id, username: user.username, email: user.email, balance: user.balance }\
        });\
    } catch (error) {\
        res.status(500).json({ status: 'error', message: error.message });\
    }\
});\
\
// ================= ك�سارات اك�تحك�ك�ك� ك�اك�سك�ك�ك�ة =================\
app.get('/api/analytics/order-blocks', (req, res) => {\
    res.json({\
        status: 'success',\
        timestamp: new Date(),\
        data: {\
            symbol: 'BTC/USDT',\
            institutionalZones: [\
                { type: 'BUY_WALL', priceRange: '80,500 - 81,000', strength: 'قك�ك� جداك�' },\
                { type: 'SELL_WALL', priceRange: '83,200 - 83,800', strength: 'ك�تك�سط' }\
            ],\
            liquidityDelta: '+14.5%'\
        }\
    });\
});\
\
// إدارة اتصاك�ات Socket.io ك�ك�عك�ك�ا؃� (ك�ك�ب ك�ك�ك�باك�ك�)\
io.on('connection', (socket) => {\
    console.log('⃺�� عك�ك�ك� جدك�د ك�تصك� بك�ظاك� EXCORA اك�حك�:', socket.id);\
    socket.emit('marketUpdate', marketData);\
\
    socket.on('disconnect', () => {\
        console.log('⃽�� اك�قطع اتصاك� اك�عك�ك�ك�:', socket.id);\
    });\
});\
\
const PORT = process.env.PORT || 5000;\
server.listen(PORT, () => {\
    console.log(`������ خادك� EXCORA اك�شاك�ك� ك�ك�تحك�ك�ك� ك�اك�سك�ك�ك�ة ك�عك�ك� بك�جاح عك�ك� اك�ك�ك�فذ ${PORT}`);\
});\
EOF\

