    short_zone_str = f'{r_low:.2f} - {r_high:.2f}' if r_low > 0 else f'VAH: {vah:.2f}'

    status_color = (
        Colors.GREEN
        if (trend_1d == 'BULLISH' and confirm_4h_trend == 'BULLISH')
        else (
            Colors.FAIL
            if (trend_1d == 'BEARISH' and confirm_4h_trend == 'BEARISH')
            else Colors.WARNING
        )
    )
    status_text = (
        'صاعد (BULLISH)'
        if (trend_1d == 'BULLISH' and confirm_4h_trend == 'BULLISH')
        else (
            'هابط (BEARISH)'
            if (trend_1d == 'BEARISH' and confirm_4h_trend == 'BEARISH')
            else 'تذبذب (RANGING)'
        )
    )

    print(
        f'🔹 {Colors.BOLD}{symbol}{Colors.ENDC} -> الحالة:'
        f' {status_color}{status_text}{Colors.ENDC}'
    )
    print(f'   - الاتجاه (1ي: {trend_1d} | 4س: {confirm_4h_trend})')
    print(f'   - 🟢 منطقة الشراء المقترحة: [{long_zone_str}]')
    print(f'   - 🔴 منطقة البيع المقترحة: [{short_zone_str}]')
    print(
        f'   - VP POC: {poc if poc else 0:.2f} | تطابق HVN:'
        f" {'✅ متوفر' if price_near_hvn else '❌ غير متوفر'}"
    )

    current_signal_state = None

    if trend_1d == 'BULLISH' and confirm_4h_trend == 'BULLISH':
      if (
          (bull_ob_retest or bos_bullish_retest or bull_fvg_retest)
          and price_near_hvn
          and (bull_engulfing or 40 < c_1h['RSI'] < 60)
          and is_volume_confirmed
      ):
        current_signal_state = 'LONG'

    elif trend_1d == 'BEARISH' and confirm_4h_trend == 'BEARISH':
      if (
          (bear_ob_retest or bos_bearish_retest or bear_fvg_retest)
          and price_near_hvn
          and (bear_engulfing or 40 < c_1h['RSI'] < 60)
          and is_volume_confirmed
      ):
        current_signal_state = 'SHORT'

    if current_signal_state is not None:
      entry_price = c_1h['close']
      risk_amount = INITIAL_CAPITAL * RISK_PERCENT
      current_atr = c_1h['ATR']

      if pd.isna(current_atr) or current_atr <= 0:
        current_atr = entry_price * 0.015

      if current_signal_state == 'LONG':
        stop_loss = entry_price - (current_atr * ATR_MULTIPLIER)
        take_profit = entry_price + (
            (entry_price - stop_loss) * REWARD_RATIO
        )
        position_size_usdt = (
            risk_amount / (entry_price - stop_loss)
        ) * entry_price

        print(
            f'   {Colors.GREEN}🚨 [فرصة شراء قوية - LONG]\n'
            f'      السعر الحالي / الدخول: {entry_price}\n'
            f'      وقف الخسارة: {stop_loss:.4f} | الهدف: {take_profit:.4f}\n'
            f'      حجم المركز الموصى به: {position_size_usdt:.2f}'
            f' USDT{Colors.ENDC}'
        )

      elif current_signal_state == 'SHORT':
        stop_loss = entry_price + (current_atr * ATR_MULTIPLIER)
        take_profit = entry_price - (
            (stop_loss - entry_price) * REWARD_RATIO
        )
        position_size_usdt = (
            risk_amount / (stop_loss - entry_price)
        ) * entry_price

        print(
            f'   {Colors.FAIL}🚨 [فرصة بيع قوية - SHORT]\n'
            f'      السعر الحالي / الدخول: {entry_price}\n'
            f'      وقف الخسارة: {stop_loss:.4f} | الهدف: {take_profit:.4f}\n'
            f'      حجم المركز الموصى به: {position_size_usdt:.2f}'
            f' USDT{Colors.ENDC}'
        )
    print('-' * 65)


