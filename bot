        'BULLISH'
        if c_1d['close'] > c_1d['EMA200']
        and c_1d['EMA50'] > c_1d['EMA200']
        else 'BEARISH'
    )
    confirm_4h_trend = 'BULLISH' if c_4h['close'] > c_4h['EMA200'] else 'BEARISH'

