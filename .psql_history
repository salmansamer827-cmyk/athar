CREATE EXTENSION IF NOT EXISTS pgcrypto;CREATE TABLE IF NOT EXISTS users (    user_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),    email TEXT UNIQUE NOT NULL,    password_hash TEXT NOT NULL,    status TEXT NOT NULL DEFAULT 'ACTIVE',    created_at TIMESTAMPTZ NOT NULL DEFAULT now());CREATE TABLE IF NOT EXISTS wallets (    wallet_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),    user_id UUID UNIQUE NOT NULL REFERENCES users(user_id),    status TEXT NOT NULL DEFAULT 'ACTIVE',    created_at TIMESTAMPTZ NOT NULL DEFAULT now());CREATE TABLE IF NOT EXISTS wallet_balances (    wallet_id UUID NOT NULL REFERENCES wallets(wallet_id),    asset TEXT NOT NULL,    available NUMERIC(38,18) NOT NULL DEFAULT 0,    locked NUMERIC(38,18) NOT NULL DEFAULT 0,    updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),    PRIMARY KEY (wallet_id, asset),    CHECK (asset IN ('USDT', 'USDC', 'POINTS')),    CHECK (available >= 0),    CHECK (locked >= 0));CREATE TABLE IF NOT EXISTS ledger_entries (    entry_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),    user_id UUID NOT NULL REFERENCES users(user_id),    asset TEXT NOT NULL,    amount NUMERIC(38,18) NOT NULL,    direction TEXT NOT NULL,    reference_type TEXT NOT NULL,    reference_id TEXT NOT NULL,    idempotency_key TEXT UNIQUE NOT NULL,    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),    CHECK (asset IN ('USDT', 'USDC', 'POINTS')),    CHECK (amount > 0),    CHECK (direction IN ('CREDIT', 'DEBIT')));CREATE INDEX IF NOT EXISTS idx_ledger_userON ledger_entries(user_id, created_at DESC);CREATE TABLE IF NOT EXISTS point_orders (    order_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),    user_id UUID NOT NULL REFERENCES users(user_id),    payment_asset TEXT NOT NULL,    payment_amount NUMERIC(38,18) NOT NULL,    points_amount NUMERIC(38,0) NOT NULL,    price_per_million NUMERIC(38,18) NOT NULL,    status TEXT NOT NULL DEFAULT 'PENDING',    idempotency_key TEXT UNIQUE NOT NULL,    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),    confirmed_at TIMESTAMPTZ,    CHECK (payment_asset IN ('USDT', 'USDC')),    CHECK (payment_amount > 0),    CHECK (points_amount > 0));CREATE TABLE IF NOT EXISTS audit_logs (    audit_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),    user_id UUID REFERENCES users(user_id),    action TEXT NOT NULL,    entity_type TEXT NOT NULL,    entity_id TEXT,    metadata JSONB NOT NULL DEFAULT '{}'::jsonb,    created_at TIMESTAMPTZ NOT NULL DEFAULT now());
\dt
\q
INSERT INTO users (    email,    password_hash)VALUES (    'demo@valora.local',    'DEMO_ONLY')ON CONFLICT (email) DO NOTHINGRETURNING user_id;
\q
